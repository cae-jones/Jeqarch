  if((map.objects[i].name=="security door")&&(map.objects[i].solid)&&(map.objects[i].collide(r))&&(
 ((@inside==null)&&(map.objects[i].z==1))||((@inside!=null)&&(map.objects[i].z==inside.z))
)) {playsound("sounds/accessGranted.wav", bounds.x, bounds.y);
 if(map.objects[i].slot>=0) pool.destroy_sound(map.objects[i].slot);
 map.objects.remove_at(i);
 found=true;
}// Open door.
 else if(map.objects[i].name=="security door") doors++;
 }// Loop.
 if((found)&&(doors==0)) {
 Object@ o=newObject("service key", newRectangle(random(map.bounds.x, map.bounds.x+map.bounds.width), 0, 0.25, 0.25));
 o.collectable=true; o.solid=false;
 o.snd="sounds/beacon.wav";
 for(uint i=0; i<map.objects.length(); i++) {
 if(o.collide(map.objects[i].bounds)) o.bounds.y=map.objects[i].bounds.y+map.objects[i].bounds.height;
}// Make sure it's not colliding with anything that would get in the way.
 map.objects.insert_last(o); adjust(map);
 }// Make service key appear.
}// Access cards.
 else if((holding.name=="service key")&&(@map!=null)) {
 Rectangle@ r=newRectangle(bounds.x, bounds.y, bounds.width+1, bounds.height);
 if(!east) r.x-=1;
 for(uint i=0; i<map.objects.length(); i++) {
  if(((map.objects[i].name=="locked elevator")||(map.objects[i].name=="manhole"))&&(map.objects[i].solid)&&(map.objects[i].collide(r)))
 {playsound("sounds/accessGranted.wav", bounds.x, bounds.y);
 if(map.objects[i].slot>=0) pool.destroy_sound(map.objects[i].slot);
 bounds.y=-40;
 for(int j=map.objects.length()-1; j>=0; j--) {
 if((map.objects[j].collide(bounds))&&(map.objects[j].canEnter)) {@inside=map.objects[j]; j=0;
 if(@this==@me) {garbage_collect(); wait(150);}
 playsound("sounds/steps/" + inside.terrain + "/run" + random(1, 9) + ".wav", bounds.x, bounds.y);
 bounds.y=inside.bounds.y;
 if(!inside.collide(bounds)) alert("WTF!", "How is this not colliding? " + name + " is at " + round(bounds.x, 0) + ", " + round(bounds.y, 0) + ", and the " + inside.name + " is from " + inside.bounds.x + " to " + (inside.bounds.x+inside.bounds.width) + ", " + inside.bounds.y + " to " + (inside.bounds.y+inside.bounds.height) + "! ");
}
 }// Make sure we're inside something so we don't get bounced back to the surface.
}// Open door.
 }// Loop.
}// service keys.

 }// Holding something.
 }// Usually a weapon or something.

 }// Meeps.
}// Char.

Char@ newChar(string n) {Char ret(n); return ret;}
 Char@ newChar(string n, string[] s) {Char ret(n, s); return ret;}
 Char@ newChar(string n, string[] s, double hp) {Char ret(n, s); ret.hp=hp; return ret;}

class Map {
 Object@[] objects;
 Char@[] enemies;
 Char@[] civilians;
  Char@ boss; // How this works is that if there is no boss, the level is completed by going past the X edge farthest from the start point.
 Rectangle@ bounds;
 vector start;
 string bgm;
 string atmosphere; // Day, night, smog, Martian, Red Sun, space, water, anything else you can think of...
 string name;
 string amb;
 string terrain;

 Map() {init();}
 // Crap crap crap crap crap crap crap...
 Map(Rectangle@ b, Object@[] o, int ocount, Char@[] e, int ecount, Char@[] c, int ccount=10) {
 init();
// Build it.
 @bounds=b;
 for(uint i=0; i<ocount; i++) {
 Object@ obj=o[random(0, o.length()-1)].clone();
 obj.bounds.x=random(bounds.x, bounds.x+bounds.width);
 // Now, check existing objects for illegal collisions.
 // You know, I think overlap is only valid in the creation phase.
 bool col=false;
 uint tries=0;
 do {
 for(uint j=0; j<objects.length(); j++) {
 if((obj.z==objects[j].z)&&(obj.collide(objects[j]))&& ((!obj.overlap)||(!objects[j].overlap) ||(objects[j].name==obj.name)) ) {col=true; j=objects.length();}
 }// Loop for collision detection.
 if(col)  obj.bounds.x=random(bounds.x, bounds.x+bounds.width); tries++;
 } while((col)&&(tries<500));

 objects.insert_last(obj);
 }// Add objects.
 for(uint i=0; i<ecount; i++) {
 Char@ en=(e.length()==1) ? e[0] : e[random(0, e.length()-1)];
 @en=newChar(en.name, en.skills, en.hp);
 @(en.bounds)=newRectangle(en.bounds.x, en.bounds.y, en.bounds.width, en.bounds.height);
  en.bounds.x=random(bounds.x, bounds.x+bounds.width-1);
 enemies.insert_last(en);
}// Enemies.
 if(c.length()>0) for(uint i=0; i<ccount; i++) {
 Char@ en=c[random(0, c.length()-1)];
 @en=newChar(en.name, en.skills, en.hp);
 @(en.bounds)=newRectangle(en.bounds.x, en.bounds.y, en.bounds.width, en.bounds.height);
  en.bounds.x=random(bounds.x, bounds.x+bounds.width-1);
 civilians.insert_last(en);

 }// Meh.
 }// Gadzuks!
 void init() {
 objects.reserve(20);
 enemies.reserve(20);
 civilians.reserve(20);
 @boss=null;
 @bounds=newRectangle(0, 0, 100, 100);
 start.x=0; start.y=0;
 bgm="";
 atmosphere=""; // Earth default.
 name="";
 amb="";
 terrain="concrete";
}// init.
 }// Map.

class Projectile {
 string name;
 string type;
 string snd;
 int slot;
 bool hitsCivs; bool hitsEnemies; bool hitsPlayer;
 vector v;
 int hits; // Total number of hits.
 double damage; // Max/normal.
 vector f;
 double stun; // Normal max.
 double counter; // Time limit.
 // Anything else at all? Creator, perhaps?
 Char@ creator;
 Rectangle@ bounds;
 Object@ container; // In case it's restricted.
 string hitsound; string blocksound; // Really? I forgot these for that long?
 Projectile() {init();}
 Projectile(string n) {init(); name=n;}
 Projectile(string n, Rectangle@ b) {init(); name=n; @bounds=b;}
 void init() {
 name="";
 type="";
 snd="";
 slot=-1;
 hitsCivs=false; hitsEnemies=true; hitsPlayer=true;
 v.x=0; v.y=0;
 hits=1;
 damage=0;
 f.x=0; f.y=0; f.z=0;
 stun=0;
 counter=-1.0; // It only has a time limit if it starts above 0.

 @creator=null;
 @bounds=newRectangle(0, 0, 0.1, 0.1);
 @container=null;
 weightless=true;
 }// Init.
 bool weightless;
 Projectile@ clone() {
 Projectile ret(name, bounds.clone());
 ret.type=type;
 ret.snd=snd;
 ret.weightless=weightless;
 ret.hitsCivs=hitsCivs; ret.hitsEnemies=hitsEnemies; ret.hitsPlayer=hitsPlayer;
 ret.v.x=v.x; ret.v.y=v.y; ret.v.z=v.z;
 ret.hits=hits;
 ret.damage=damage;
 ret.f.x=f.x; ret.f.y=f.y; ret.f.z=f.z;
 ret.stun=stun;
 ret.counter=counter;

 @(ret.creator)=creator;
 
 @(ret.container)=container;
 ret.hitsound=hitsound; ret.blocksound=blocksound;
 return ret;
 }// Clone.
 }// Projectile.

 float guessRange(string s) {
 // This is dumb.
 if(s=="fists") return 1;
 else if(s=="pipe") return 2; // Because 3 is silly.
 else if(s=="knife") return 1.25;
 else if(s=="hook-hand") return 1.25;
 else if(s=="pistol") return 10;
 else if(s=="uzi") return 10;
 else if(s=="grenade") return 5;
 else if(s=="BatGrenade") return 5;
 else if(s=="rocket") return 30;
 else if(s=="laser") return 10;
 else if(s=="HeatVision") return 5;
 else if(s=="longbow") return 10;
 else if(s=="sword") s=2.5;
 else if(s=="hephaestus") return 2.5;
 else if(s=="mace") return 2.5;
 else if(s=="batarang") return 10;
 else if(s=="staff") return 3.5;
 else if(s=="whip") return 3.5;
 else if(s=="OmegaBeam") return 100;
 return random(0, 10);
}// Guess range.


