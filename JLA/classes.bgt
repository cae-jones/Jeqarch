#include "custom_voice.bgt"
#include "sound_pool.bgt"



 // If given the endpoints for two line segments, this function returns the point at which they intersect.
 // If the segments do not intersect, the return value will be null.
 Point@ lineIntersects(vector p1, vector p2, vector p3, vector p4) {
 // Let's be sure that our points are in left-right order.
 double x1=p1.x; double x2=p2.x; double x3=p3.x; double x4=p4.x;
 double y1=p1.y; double y2=p2.y; double y3=p3.y; double y4=p4.y;
 if(x3>x4) {x3=p4.x; x4=p3.x; y3=p4.y; y4=p3.y;}
 if(x1>x2) {x1=p2.x; x2=p1.x; y1=p2.y; y2=p1.y;}

 // Now, find the slopes.
 // Ur, be aware that vertical lines might happen...
 double m1;
 if(x1==x2) m1=1999999999;
 else m1=(y2-y1)/(x2-x1); 
 double m2;
 if(x3==x4) m2=1999999999;
 else m2=(y4-y3)/(x4-x3);

 double b1=y1-(m1*x1);
 double b2=y3-(m2*x3);
 if(m1==m2) {
 if(b1==b2) {
 // One point must be between the other two.
 if((x3>=x1)&&(x3<=x2)) return newPoint(x3, y3);
 else if((x4>=x1)&&(x4<=x2)) return newPoint(x4, y4);
 else if((x1>=x3)&&(x1<=x4)) return newPoint(x1, y1);
 else if((x2>=x3)&&(x2<=x4)) return newPoint(x2, y2);
 else return null;
 }
 else return null;
 }// They don't collide unless b1 and b2 are the same.
 else {
double rx=(b2-b1)/(m1-m2);
 if((rx>=x1)&&(rx<=x2)&&(rx>=x3)&&(rx<=x4)) {
 double ry = (m1*rx)+b1;

 return newPoint(rx, ry);
} else return null;
}
// return null;
 }
 class Point {
double x; double y;
 Point() {x=0; y=0;}
 Point(double xx, double yy) {x=xx; y=yy;}
}// Point.
 Point@ newPoint(double x, double y) {Point ret(x, y); return ret;}
 vector newVector(double x, double y, double z=0) {vector ret(x, y, z); return ret;}

class Rectangle {
 float x; float y;
 float width; float height;
 Rectangle() {x=0; y=0; width=0; height=0;}
 Rectangle(float xx, float yy, float w, float h) {x=xx; y=yy; width=w; height=h;}
 void moveTo(float tx, float ty) {x=tx; y=ty;}
 void moveBy(float dx, float dy) {x+=dx; y+=dy;}
 bool collide_line(vector p, float angle) {return collide_line(p.x, p.y, angle);}
 bool collide_line(float lx, float ly, float angle) {
// Convert to cartesian, please.
 // I think the slope is just the tangent of the angle, so:
 float m=tangent(angle);
 vector p1(lx, ly);
 vector p2(lx+100, ly+(100.0*m));
 vector[] points=getPoints();
 for(uint i=0; i<points.length(); i++) {
 vector p3=points[i];
 vector p4=points[i%points.length()];
  Point@ res=lineIntersects(p1, p2, p3, p4);
 if(@res!=null) return true;
 }// Collisions. Does it really work this way?
 return false;
 }// Collide_line. Or ray, to be more precise.
 bool collide(Rectangle@ r) {
 if(@r==null) return false;
return collide(r.x, r.y, r.width, r.height);}
 bool collide(float rx, float ry, float rw, float rh) {
 float x1=x; float x2=x+width;
 float x3=rx; float x4=rx+rw;
 float y1=y; float y2=y+height;
 float y3=ry; float y4=ry+rh;
 return (
 (((x3>=x1)&&(x3<=x2))||((x4>=x1)&&(x4<=x2))||
((x1>=x3)&&(x1<=x4))||((x2>=x3)&&(x2<=x4))
)&&
(
((y3>=y1)&&(y3<=y2))||((y4>=y1)&&(y4<=y2))||
((y1>=y3)&&(y1<=y4))||((y2>=y3)&&(y2<=y4))
)
);
}// Collide.

// Returns points starting from (x, y) and continuing counterclockwise along the edge of the rectangle.
 vector[] getPoints() {
 vector[] ret={
 newVector(x, y),
 newVector(x, y+height),
 newVector(x+width, y+height),
 newVector(x+width, y)
};
 return ret;
 }
 Rectangle@ clone() {
 return newRectangle(x, y, width, height);
 }
 Rectangle@ rotate() {
 return newRectangle(x, y, height, width);
}
 string save() {return "" + x + ", " + y + ", " + width + ", " + height;}
}// Rectangle.
 Rectangle@ newRectangle(float x, float y, float width, float height) {Rectangle ret(x, y, width, height); return ret;}
 Rectangle@ loadRectangle(string txt) {
 string[] parts=string_split(txt, ", ", true);
 Rectangle@ ret=newRectangle(0, 0, 1, 1);
 if(parts.length()>0) ret.x=string_to_number(parts[0]);
 if(parts.length()>1) ret.y=string_to_number(parts[1]);
 if(parts.length()>2) ret.width=string_to_number(parts[2]);
 if(parts.length()>3) ret.height=string_to_number(parts[3]);
 return ret;
}// Load rectangle.

class Object {
 Rectangle@ bounds;
 string name;
 int8 z; // 0=background, 1=midground, 2=foreground. There are some for which we don't really care.
string snd;
bool solid; // More for getting thrown into it or landing atop it than anything.
string terrain; // GRR...
 bool collectable;
 vector v;
 bool loop; // if true, the object loops through the stage if it moves out of bounds; if false, it changes direction.
 bool weightless; // At this point, enough bools to justify using an int.
 bool overlap; // For random stage design.
 bool canEnter; //Hmm.
 int slot;
 Object() {init();}
 Object(string n) {init(); name=n;}
 Object(Rectangle@ b) {init(); @bounds=b;}
 Object(string n, Rectangle@ b) {init(); name=n; @bounds=b;}
 void init() {
 slot=-1;
 @bounds=newRectangle(0, 0, 1, 1);
 
 z=0;
 snd="";
 solid=true; // Buildings, cars and poles are going to be more common than water, fire and random sound sources, ne?
 terrain="";
 collectable=false;
 v.x=0; v.y=0; v.z=0;
 loop=false;
 weightless=false;
 canEnter=false; overlap=false;
 }// Init.
 bool collide(Rectangle@ b) {if(@bounds==null) return false; return bounds.collide(b);}
 bool collide(Object@ o) {if(@bounds==null) return false; if(@o==null) return false; return collide(o.bounds);}
 bool collide(Char@ c) { if(@c==null) return false; return collide(c.bounds);}
 bool atop(Rectangle@ b) {
 if((@bounds==null)||(@b==null)) return false;
 return (
 (round(b.y, 1)==round(bounds.y+bounds.height, 1))&&(
((b.x>=bounds.x)&&(b.x<=bounds.x+bounds.width))||((b.x+b.width>=bounds.x)&&(b.x+b.width<=bounds.x+bounds.width))
)
);
}// Atop.
 Object@ clone(float x) {Object@ ret=clone(); ret.bounds.x=x; return ret;}
 Object@ clone() {
 Object@ ret=newObject(
name, newRectangle(bounds.x, bounds.y, bounds.width, bounds.height)
);

 
 ret.z=z;
 ret.snd=snd;
 ret.solid=solid;
 ret.terrain=terrain;
 ret.collectable=collectable;
 ret.v.x=v.x; ret.v.y=v.y; ret.v.z=v.z;
 ret.loop=loop;
 ret.weightless=weightless;
 ret.overlap=overlap; ret.canEnter=canEnter;

 return ret;
}// Clone.
 }// Object.
 Object@ newObject() {Object ret; return ret;}
 Object@ newObject(string n) {Object ret(n); return ret;}
 Object@ newObject(Rectangle@ b) {Object ret(b); return ret;}
 Object@ newObject(string n, Rectangle@ b) {Object ret(n, b); return ret;}

class Char {
 double counter;
 Rectangle@ bounds;
 vector v;
 string name;
 bool canFly;
 uint skill;
 string[] skills;
 float[] ranges;
 float[] levels;
 float hp;
 float mp;
 float strength;
 float speed;
 float endurance; // Resistance to damage.
 float stamina; // ?
 string weak; // Umm.
 string strong; // again, umm.
 float jump; // Jump speed, or flight speed for fliers.
 Object@ holding;
 Object@ inside; // Vehicles, buildings, dark alleys, tunnels...
 bool grounded; // As of the last movement of the character.
 Object@ atop;
 bool east; // facing.
 double aspeed;
Char(string n) {init(); name=n;}
 Char(string n, string[] s) {init(); name=n; skills=s; levels.resize(s.length());
 ranges.resize(s.length());
 for(uint i=0; i<ranges.length(); i++) {ranges[i]=guessRange(skills[i]);}
 }
 void init() {
 counter=0.0; // negative is stunned, positive is in the process of doing whatever it is you're doing.
 @bounds=newRectangle(0, 0, 1, 2);
 v.x=0; v.y=0; v.z=0;
 name="";
 canFly=false;
 skill=0;
 skills.resize(6); skills[0]="fists";
 levels.resize(skills.length()); for(uint i=0; i<levels.length(); i++) levels[i]=1.0;
 hp=100;
 mp=10;
 strength=random(1, 10);
 speed=random(1, 3);
 endurance=random(0, 3);
 if(endurance==0) endurance=0.5;
 stamina=random(0, 3);
 weak="";
 strong="";
 jump=5; // Just under two meters is about 6.5 m/s, and most people can't jump 2 meters, so default is 5.
 @holding=null; @inside=null;
 @atop=null; grounded=false;
 east=false;
 aspeed=random(25, 99)*0.01;
}// Init.
// Umm?
 void act() {
 if((skill>=0)&&(skill<skills.length())) {
 if((skill>=0)&&(skill<levels.length())&&(levels[skill]<=0)) {playsound("sounds/" + skills[skill] + "empty.wav", bounds.x+(0.5*bounds.width), bounds.y); counter=-aspeed*0.5; return;}
 if(skill>=levels.length()) levels.resize(skill+1);
 if(!file_exists("sounds/" + skills[skill] + ".wav")) {
 if(name=="GreenLantern") playsound("sounds/gl" + skills[skill] + ".wav", bounds.x+(bounds.width*0.5), bounds.y);

 }// No sound for the skill in question.
 else playsound("sounds/" + skills[skill] + ".wav", bounds.x+(bounds.width*0.5), bounds.y);
 if((skills[skill]=="fists")||(skills[skill]=="extra speed")) {playsound("voices/" + name + "/attack" + random(1, 5) + ".wav", bounds.x+(bounds.width*0.5), bounds.y);
 counter=aspeed;
 }// fists.
 // Do we want to check for stuff here?
 else if(skills[skill]=="pistol") {
 levels[skill]--;
 if(levels[skill]<=0) playsound("sounds/pistolempty.wav", bounds.x+(bounds.width*0.5), bounds.y);
 counter=0.3;
 Projectile p("bullet", newRectangle(bounds.x-0.15, bounds.y+1.5, 0.1, 0.1));
 p.v.x=-10;
 p.v.y=2; p.weightless=false;
 if(east) {p.bounds.x=bounds.x+bounds.width+0.05; p.v.x=10;}
 p.snd="sounds/bullet.wav";
 p.damage=random(5, 15);
 p.stun=random(1, 10)*0.05;
// p.hitsound="sounds/hit" + random(1, 5) + ".ogg"; p.blocksound="sounds/block" + random(1, 5) + ".wav";
 p.hitsound="sounds/bullet/hit_by_bullet" + random(1, 3) + ".wav";
 p.blocksound="sounds/bullet/bullet _ricochet" + random(1, 4) + ".wav";
 p.hits=1; p.counter=0.8+(0.1*random(0, 8));
 // maybe blocksound should be a more traditional bullet-deflecting sound?
 @(p.creator)=this;
 p.hitsCivs=true; p.hitsPlayer=true;
 p.hitsEnemies=((@this==@me)||(random(0, 5)>3));
 addProjectile(p);
 }// pistol
 else if(skills[skill]=="uzi") {
 levels[skill]--;
 if(levels[skill]<=0) playsound("sounds/uziempty.wav", bounds.x+(bounds.width*0.5), bounds.y);
 counter=0.3;
 Projectile p("bullet", newRectangle(bounds.x-0.15, bounds.y+1.5, 0.1, 0.1));
 p.v.x=-10;
 p.v.y=2; p.weightless=false;
 if(east) {p.bounds.x=bounds.x+bounds.width+0.05; p.v.x=10;}
 p.snd="sounds/uzi_end.wav";
 p.damage=random(10, 35);
 p.stun=random(1, 10)*0.05;
 p.hitsound="sounds/hit" + random(1, 5) + ".ogg"; p.blocksound="sounds/block" + random(1, 5) + ".wav";
 p.hitsound="sounds/bullet/hit_by_bullet" + random(1, 3) + ".wav";
 p.blocksound="sounds/bullet/bullet _ricochet" + random(1, 4) + ".wav";

 p.hits=1; p.counter=0.8+(0.1*random(0, 8));
 // maybe blocksound should be a more traditional bullet-deflecting sound?
 @(p.creator)=this;
 p.hitsCivs=true; p.hitsPlayer=true;
 p.hitsEnemies=((@this==@me)||(random(0, 5)>3));
 addProjectile(p);

 }// Uzi.
 else if(skills[skill]=="batarang") {
  levels[skill]--;
 // There needs to be a way to catch batarangs.
 Projectile p("batarang", newRectangle(bounds.x+bounds.width+0.2, bounds.y+1.5, 0.25, 0.25));
 p.v.x=(speed+2.5);
 p.damage=strength+random(0, 4);
 p.stun=random(1, 10)*0.05;
 p.hits=random(1, 3);
 p.counter=5;
 p.snd="sounds/batarang.wav";
 p.hitsound="sounds/hit" + random(1, 5) + ".ogg"; p.blocksound="sounds/block" + random(1, 5) + ".wav";
 if(!east) {p.v.x=-(speed+2.5); p.bounds.x=bounds.x-0.5;}
 p.hitsEnemies=true;
 @(p.creator)=this;
 p.hitsPlayer=(@this!=@me);
 addProjectile(p);
 }// Batarang.
 else if(skills[skill]=="knife") {
 Projectile p("knife", newRectangle(bounds.x-0.25, bounds.y+(0.5*bounds.height), 0.25, 0.25));
 p.v.x=-2;
 p.hits=1;
 p.damage=random(strength-1, strength+7);
 p.v.y=5; p.weightless=false;
 p.counter=random(25, 100)*0.01;
 p.hitsound="sounds/cut" + random(1, 3) + ".wav"; p.blocksound="sounds/clang" + random(0, 3) + ".ogg";
 if(east) {p.v.x*=-1; p.bounds.x=bounds.x+bounds.width+0.01;}
 @(p.creator)=this;
 if(@this==@me) {p.hitsPlayer=false; p.hitsCivs=false; p.hitsEnemies=false;}
 else {p.hitsPlayer=true; p.hitsCivs=true; p.hitsEnemies=false;}
 // Never give civilians knives!
 addProjectile(p);
 counter=random(15, 50)*0.01;
 }// Knife.
 else if(skills[skill]=="pipe") {
 Projectile p("pipe", newRectangle(bounds.x, bounds.y+(0.5*bounds.height), 2.5, 2));
 p.v.x=random(1, 4); p.v.y=random(-2, 4);
 p.weightless=true;
 p.f.x=random(0, 4);
 p.f.y=random(-2, 4);
 if(!east) {p.bounds.x-=bounds.width; p.v.x*=-1; p.f.x*=-1;}
 p.hits=random(1, 5);
 p.damage=random(strength, strength+7);
 p.stun=random(2, 15)*0.1;

 p.counter=random(3, 15)*0.1;
 p.snd="sounds/pipefly.wav"; // add that?
 p.hitsound="sounds/hit" + random(1, 5) + ".ogg"; p.blocksound="sounds/block" + random(1, 5) + ".wav";
 counter=random(3, 10)*0.1;
 @(p.creator)=this;
 if(@this==@me) {p.hitsPlayer=false; p.hitsCivs=false; p.hitsEnemies=true;}
 else {p.hitsPlayer=true; p.hitsCivs=true; p.hitsEnemies=(random(1, 5)<3);}

 addProjectile(p);
 }// Pipe.
 else if(skills[skill]=="whip") {
 Projectile p("knife", newRectangle(bounds.x-0.25, bounds.y+(0.5*bounds.height), 1.25, 1.25));
 p.v.x=-2;
 p.hits=1;
 p.damage=random(strength-1, strength+7);
 p.stun++;
 p.v.y=5; p.weightless=false;
 p.counter=random(55, 125)*0.01;
 p.hitsound="sounds/cut" + random(1, 3) + ".wav"; p.blocksound="sounds/block" + random(1, 4) + ".wav";
 if(east) {p.v.x*=-1; p.bounds.x=bounds.x+bounds.width+0.01;}
 @(p.creator)=this;
 if(@this==@me) {p.hitsPlayer=false; p.hitsCivs=false; p.hitsEnemies=false;}
 else {p.hitsPlayer=true; p.hitsCivs=true; p.hitsEnemies=false;}
 // Never give civilians knives!
 addProjectile(p);
 counter=aspeed*(0.1*random(7, 15));

}// Whip.
 else if(skills[skill]=="grapplinghook") {
 counter=random(15, 55)*0.01;
 // Lose it if it doesn't hit anything?
 levels[skill]--;
}// Grapplinghook.
 else if((skills[skill]=="grenade")||(skills[skill]=="BatGrenade")) {
 Projectile p("grenade", newRectangle(bounds.x+bounds.width+0.25, bounds.y, 0.25, 1.25));
 p.v.x=speed+2;
 p.weightless=false;
 p.counter=1.5;
 p.hits=random(1, 5);
 p.damage=random(10, 30);
 levels[skill]--;
 if(!east) {p.v.x=p.v.x*-1; p.bounds.x=bounds.x-p.bounds.width-0.2;}
 @(p.creator)=this;
 p.hitsEnemies=true; p.hitsCivs=true; p.hitsPlayer=true;
 p.stun=random(50, 200)*0.01;
 p.f.x=random(-6, 6);
 p.f.y=random(0, 10);
 p.snd="sounds/grenadeRoll.wav";
 p.hitsound="sounds/grenadeExplode.wav";
 p.blocksound="sounds/block" + random(1, 5) + ".wav";
 // Anything else?
 addProjectile(p);

 }// Grenade.
 else if(skills[skill]=="AcidSpray") {
 if(levels[skill]<1) return;
 levels[skill]--;
 Projectile p("acid", newRectangle(bounds.x+bounds.width+0.05, bounds.y+(0.75*bounds.height), 0.75, 0.3));
 p.hitsound="sounds/acidburn.wav";
 p.v.x=random(1, 5); p.v.y=random(0, 5);
 p.weightless=false;
 p.damage=random(3, 15);
 p.stun=random(50, 300)*0.01;
 p.counter=random(25, 200)*0.01;
 p.hits=random(1, 5);
 @(p.creator)=this;
 if(!east) {p.v.x*=-1; p.bounds.x=bounds.x-p.bounds.width-0.05;}
 if(@this==@me) {p.hitsPlayer=false; p.hitsEnemies=true; p.hitsCivs=false;}
 else {p.hitsPlayer=true; p.hitsCivs=true; p.hitsEnemies=(random(1, 5)<3);}
 addProjectile(p);
 counter=random(25, 75)*0.01;

 }// Acid.
 else if(skills[skill]=="laser") {
 if(mp<1) {counter=-1; return;}
 mp--;
 Projectile p("laser", newRectangle(bounds.x+bounds.width+0.1, bounds.y+1, 1.5, 1));
 @(p.creator)=this;
 p.v.x=15;
 p.weightless=true; p.v.y=0;
 if(!east) {p.bounds.x=bounds.x-p.bounds.width-0.1; p.v.x=p.v.x*-1;}
 p.damage=random(5, 15);
 p.stun=random(5, 15)*0.05;
 p.f.x=random(-2, 2); if(p.f.x<0) p.f.x=0;
 p.f.y=random(-2, 2); if(p.f.y<0) p.f.y=0;
 p.counter=4.68;
 p.hits=random(1, 5);
 p.snd="sounds/laserfly.wav";
 p.hitsound="sounds/hit" + random(1, 5) + ".ogg"; p.blocksound="sounds/block" + random(1, 5) + ".wav";
  // anything else? Surely.
// p.hitsEnemies=true;
 p.hitsPlayer=(@me!=@this);
 p.hitsEnemies=(!p.hitsPlayer);
 p.hitsCivs=false;
 addProjectile(p);
 }// laser.
 else if(skills[skill]=="rocket") {
 if(levels[skill]<1) return;
 levels[skill]--;
 Projectile p("rocket", newRectangle(bounds.x+bounds.width+0.1, bounds.y+(bounds.height*0.6), 1, 0.5));
 p.v.x=random(10, 15);
 p.v.y=random(0, 5);
 p.weightless=false;
 p.f.x=random(-5, 5); p.f.y=random(-5, 5);
 p.damage=random(20, 45);
 p.hits=1;
 if(!east) {p.v.x=-p.v.x; p.bounds.x=bounds.x-p.bounds.width-0.1;}
  @(p.creator)=this;
 p.hitsCivs=false;
 if(@this==@me) {p.hitsPlayer=false; p.hitsEnemies=true;}
 else {p.hitsPlayer=true; p.hitsEnemies=(random(0, 7)==4);}
 p.snd="sounds/rocket1.wav";
 p.counter=random(10, 30)*0.1;
 p.hitsound="sounds/grenadeExplode.wav";
 p.stun=random(4, 10)*0.1;
 addProjectile(p);
 counter=random(25, 100)*0.01;

}// rocket.
 else if(skills[skill]=="HeatVision") {
 if(mp<1) return;
 mp--;

 Projectile p("Heat Vision", newRectangle(bounds.x+bounds.width, bounds.y+bounds.height-0.5, 5, 1));
 p.hitsCivs=false;
 p.snd="sounds/laserfly.wav";
 p.hitsound="sounds/burn" + random(1, 3) + ".wav"; p.blocksound="sounds/block" + random(1, 5) + ".wav";
 p.v.x=15; p.counter=random(1, 2);
 p.weightless=true;
 p.hitsEnemies=true;
 p.hitsPlayer=(@me!=@this);
 @(p.creator)=this;
 if(!east) {p.bounds.x=bounds.x-p.bounds.width; p.v.x=p.v.x*-1;}
 p.hits=random(1, 5);
 p.damage=random(5, 25);
 p.stun=random(2, 10)*0.1;
 p.f.x=5; if(!east) p.f.x=-5;
 // Umm?
 addProjectile(p);
 }// Heat Vision.
 else if(skills[skill]=="smokescreen") {
 if(levels[skill]<1) return;
 levels[skill]--;
 counter=random(5, 20)*0.01;
 // I'd prefer a different sound than a projectile would make, but feh.
 Projectile p("smokescreen", newRectangle(bounds.x-2, bounds.y-1, bounds.width+4, bounds.height+5));
 p.v.y=1; p.hits=random(5, 20);
 p.counter=random(10, 25)*0.1;
 p.weightless=true;
 p.v.x=random(-10, 10)*0.1;
 p.stun=random(15, 95)*0.1;
 p.damage=random(1, 15)*0.1;
  p.hitsEnemies=true;
 p.hitsCivs=true;
 p.hitsPlayer=(@this!=@me);
 @(p.creator)=this;
 addProjectile(p);
 }// Smokescreen?
 else if(skills[skill]=="batclaw") {
 if(levels[skill]<1) return;
 levels[skill]--;
 counter=random(1, 30)*0.01;
}// Batclaw.
 else if(skills[skill]=="staff") {
 Projectile p("staff", newRectangle(bounds.x+random(-2, 1), bounds.y, random(2, 4), random(1, 3)));
 playsound("sounds/staff" + random(1, 4) + ".wav", bounds.x+(0.5*bounds.width), bounds.y);
 counter=random(2, 7)*0.1;
 p.counter=counter+0.15;
 p.hits=random(1, 4);
 p.damage=random(strength, strength+3);
