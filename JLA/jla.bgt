 map.boss.bounds.y=random(map.bounds.y, map.bounds.y+map.bounds.height);
 map.boss.mp=random(15, 40);
 map.boss.counter=random(-20, -10);
 map.boss.jump+=random(1, 7);
 string[] ms={"fists", "laser", "pistol", "uzi"};
 @enemy=newChar("Metallo", ms, 100);
 map.enemies.insert_last(enemy);
 enemy.bounds.x=random(map.bounds.x, map.bounds.x+map.bounds.width);
 enemy.bounds.y=random(map.bounds.y, 0.5*map.bounds.height);
 enemy.canFly=true;
 enemy.speed=random(4, 9);
 enemy.strength=random(6, 10);
 enemy.endurance=random(3, 9);
 enemy.jump+=random(0, 5);


}; break;
