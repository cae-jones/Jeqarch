 o.canEnter=true;
 o.overlap=true;
 o.solid=true; o.terrain="roof";
 // The idea is that pressing enter on an elevator will send you to the highest point in range, or to the top of the elevator if there is none.
 objs.insert_last(o);


 // Civilians.
 Char@ civ;
 Char@[] civs; civs.reserve(5);
 @civ=newChar("man"); civs.insert_last(civ);
