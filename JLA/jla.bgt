 @civ=newChar("police");
 civ.skills.resize(4);
 civ.skills[0]="fists"; civ.skills[1]="pistol"; civ.skills[2]="uzi"; civ.skills[3]="grenade";
 civ.levels.resize(civ.skills.length());
 civ.levels[0]=1; civ.levels[1]=random(3, 16); civ.levels[2]=random(0, 24); civ.levels[3]=random(0, 3);
 civs.insert_last(civ);

 Char@ enemy;
 Char@[] enemies;
 // Mobsters.
 @enemy=newChar("mobster");
 enemy.skills.resize(5);
 enemy.levels.resize(enemy.skills.length());
 enemy.skills[0]="fists"; enemy.levels[0]=1;
 enemy.skills[1]="pipe"; enemy.levels[1]=random(0, 1);
 enemy.skills[2]="knife"; enemy.levels[2]=random(0, 1);
 enemy.skills[3]="pistol"; enemy.levels[3]=random(0, 16);
 enemy.skills[4]="uzi"; enemy.levels[4]=random(0, 24);
 enemies.insert_last(enemy);
 // This is the Joker kind, with acid.
 @enemy=newChar("mobster");
 enemy.skills.resize(6);
 enemy.levels.resize(enemy.skills.length());
 enemy.skills[0]="fists"; enemy.levels[0]=1;
 enemy.skills[1]="pipe"; enemy.levels[1]=random(0, 1);
 enemy.skills[2]="knife"; enemy.levels[2]=random(0, 1);
 enemy.skills[3]="pistol"; enemy.levels[3]=random(0, 16);
 enemy.skills[4]="uzi"; enemy.levels[4]=random(0, 24);
 enemy.skills[5]="AcidSpray";
 enemies.insert_last(enemy);

 Map temp(newRectangle(-1, 0, 100, 50), objs, 40, enemies, 55, civs);
 @map=temp;
 map.atmosphere="night";
 for(uint i=0; i<map.enemies.length(); i++) {
 if(random(0, 5)>3) {
 @o=map.objects[random(0, map.objects.length()-1)];
 if(o.solid) {map.enemies[i].bounds.x=random(o.bounds.x, o.bounds.x+o.bounds.width-1); map.enemies[i].bounds.y=o.bounds.y+o.bounds.height; map.enemies[i].counter=-random(1, 10);}
 else if(o.canEnter) {map.enemies[i].bounds.y=o.bounds.y; map.enemies[i].bounds.x=random(o.bounds.x, o.bounds.x+o.bounds.width-1); @(map.enemies[i].inside)=o;}
 }// Move the enemy.
 }// Moving some enemies.
 // Add a sewer.
 @o=newObject("locked elevator", newRectangle(random(map.bounds.x-5, map.bounds.x+map.bounds.width+5), 0, 2, 3));
 o.snd="sounds/elevator.wav";
 o.z=2;
 o.solid=true;
 o.canEnter=false;
 map.objects.insert_last(o);
