 o.canEnter=false;
 map.objects.insert_last(o);

 @o=newObject("controlroom", newRectangle(map.bounds.x, -40, map.bounds.width, 30));
 o.solid=false; o.canEnter=true; o.terrain="wood";
 // mais non, ce n'est pas tout!
 o.z=2;
 map.objects.insert_last(o);
 @o=newObject("server room", newRectangle(random(map.bounds.x, map.bounds.x+map.bounds.width), -40, 10, 10));
 o.snd="sounds/light1.wav";
 o.solid=false; o.z=0; o.canEnter=true; o.terrain="steel";
 map.objects.insert_last(o);

 

