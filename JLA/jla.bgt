 o.canEnter=true; o.z=0; o.solid=false;
 // Is that all?
 map.objects.insert_last(o);
 @o=newObject("pipe", newRectangle(map.bounds.x-5, -40, map.bounds.width+12, 15));
 o.z=2; o.solid=false; o.canEnter=true; o.terrain="pipe";
