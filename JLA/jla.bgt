}// Deadman.
else @me=null;

if(@map!=null)  for(uint i=0; i<ammos.length(); i++) {
 Object@ o=newObject(ammos[i], newRectangle(random(map.bounds.x, map.bounds.x+map.bounds.width), 0, 1, 1));
 o.solid=false;
 o.snd="sounds/beacon.wav";
 if((o.name=="food")||(o.name=="hotdogs")) o.snd="sounds/grill.wav";
 o.canEnter=false; o.collectable=true;
 for(uint j=0; j<map.objects.length(); j++) {
 if(o.collide(map.objects[j])) {
 if(map.objects[j].canEnter) {o.z=map.objects[j].z; j=map.objects.length();}
 else if((map.objects[j].solid)&&(round(map.objects[j].v.length(), 0)==0)) {o.bounds.y=map.objects[j].bounds.y+map.objects[j].bounds.height; j=map.objects.length(); o.z=1;}
 }// Collision.
 }// Check for objects to collide with.
 map.objects.insert_last(o);
 @o=newObject(ammos[i], newRectangle(random(map.bounds.x, map.bounds.x+map.bounds.width), 0, 1, 1));
 o.solid=false;
 o.snd="sounds/beacon.wav";
 if((o.name=="food")||(o.name=="hotdogs")) o.snd="sounds/grill.wav";
 o.canEnter=false; o.collectable=true;
 for(uint j=0; j<map.objects.length(); j++) {
 if(o.collide(map.objects[j])) {
 if(map.objects[j].canEnter) {o.z=map.objects[j].z; j=map.objects.length();}
 else if((map.objects[j].solid)&&(round(map.objects[j].v.length(), 0)==0)) {o.bounds.y=map.objects[j].bounds.y+map.objects[j].bounds.height; j=map.objects.length(); o.z=1;}
 }// Collision.
 }// Check for objects to collide with.
 map.objects.insert_last(o);

 }// Ammos.
 adjust(map); // Umm?
 get_characters();
 return ret;
 }// Select char.

void step(double dt) {
 dt*=0.001; //?????
double camX=0; double camY=0;
 if((@me!=null)&&(@(me.bounds)!=null)) {camX=me.bounds.x; camY=me.bounds.y;}
 timer lt;
 lagtimer.restart(); lagtimer.resume();
 if(AICounter%spread==0) stepChar(me, dt*spread);
 if(llog) {loglag("Stepping me", lagtimer.elapsed); lagtimer.restart(); lagtimer.resume();}
 if(AICounter%2==0) pool.update_listener_2d(me.bounds.x+(me.bounds.width*0.5), me.bounds.y); // Hmm.
 loglag("step me and update sounds", lt.elapsed);
 lt.restart(); lt.resume();
 if((@backup!=null)&&(possessiontimer.elapsed>=16000)) {
 if(me.levels[0]==1) map.civilians.insert_last(me); else map.enemies.insert_last(me);
 @me=backup; @backup=null;
 possessiontimer.restart(); possessiontimer.resume();
 voice.speak_interrupt_wait("Possession time up!");
 playsound("sounds/menu/error.wav", me.bounds.x, me.bounds.y+random(-10, 10));
 me.bounds.y+=3; me.v.y+=10; me.counter=-1;
}// Deadman's possession runs out.
 if((me.name=="Superman")||(me.name=="Supergirl")||(me.name=="Starfire")) {
 if((me.skill==me.skills.length()-1)&&(me.skills[me.skill]=="ClarkKent")) {
 me.canFly=false;
 if(map.atmosphere!="redsun") me.hp+=dt;
}// Clark Kent.
 else me.canFly=true;
 if(map.atmosphere=="day") {
 if(me.counter==0.0) {
 if(me.mp<10+me.stamina) me.mp+=dt*0.1*me.stamina;
 if(me.hp<100) me.hp+=0.05*dt*me.stamina;
 }// Heal/mp.
 }// Daylight is good for superman.
 else if(map.atmosphere=="redsun") {
 if(me.strength>1.5) me.strength-=0.5*dt;
 if(me.mp>0) me.mp-=0.5*dt;
 if(me.speed>4) me.speed-=0.5*dt;
  else me.canFly=false;

 }// Opposite.
 }// Superman.
 else if(me.name=="CaptainMarvel") {
 if(me.skill==me.skills.length()-1) {
 if(me.mp<10+me.stamina) me.mp+=0.1*dt;
 else if(me.hp<100+me.stamina) me.hp+=0.01*dt;
}// Captain Marvel recharges while not using his powers.
}// Captain Marvel.
 else if(me.name=="Static") {
 if(me.skill==me.skills.length()-1) {
 Object@ found=null;
 if((@(me.atop)!=null)&&((me.atop.terrain=="steel")||(me.atop.terrain=="pipe"))) @found=me.atop;
 else if((@(me.inside)!=null)&&((me.inside.terrain=="steel")||(me.inside.terrain=="pipe"))) @found=me.inside;
 else { for(uint i=0; i<map.objects.length(); i++) {
 Object@ o=map.objects[i];
 if((o.collide(me.bounds))&&((o.terrain=="steel")||(o.terrain=="pipe"))) @found=o;
}}// Loop.
 if(@found!=null) {
  if(me.mp<10+me.stamina) me.mp+=0.1*dt;
 else if(me.hp<100+me.stamina) me.hp+=0.01*dt;
 if((@found!=@(me.inside))&&(!found.atop(me.bounds))) {
 if((me.bounds.y<found.bounds.y+found.bounds.height)&&(me.v.y>=0)) {me.bounds.y=found.bounds.y+found.bounds.height; playsound("sounds/steps/" + found.terrain + "/run" + random(1, 6) + ".wav", me.bounds.x+(0.5*me.bounds.width), me.bounds.y); garbage_collect();}

}// Not atop, but...
  found.bounds.x=me.bounds.x; if(me.bounds.y>=map.bounds.y+found.bounds.height) found.bounds.y=me.bounds.y-found.bounds.height;
 @(me.atop)=found;
 found.v.x=me.v.x; found.v.y=me.v.y; //? Safe?
 if(me.v.y>0) clipboard_copy_text("Static up");
 else if(me.v.y<0) clipboard_copy_text("Static down");

}// Found.
 else me.canFly=false;
}// Check?
 else me.canFly=false;
}// Static.
 lt.restart(); lt.resume();
 int taunt=-1;
 if(taunttimer.elapsed>1000) {taunttimer.restart(); taunttimer.resume(); taunt=random(0, map.enemies.length()+map.civilians.length());}

 for(uint i=0; i<map.enemies.length(); i++) {
 if(AICounter%spread==i%spread) stepChar(map.enemies[i], dt*spread);
 if(llog) {loglag("Stepping enemy " + i + ", " + map.enemies[i].name, lagtimer.elapsed); lagtimer.restart(); lagtimer.resume();}
 if(i>=map.enemies.length()) continue; // Umm.
 if(map.enemies[i].hp<=0.0) {
 if(map.enemies[i].name=="Bane") bonuses|=1;
 else if(map.enemies[i].name=="KillerCroc") bonuses|=256;
 else if(map.enemies[i].name=="Cheeta") bonuses|=32;
 else if(map.enemies[i].name=="SwampThing") bonuses|=1024;
 else if(map.enemies[i].name=="LexLuthor") bonuses|=16;
 else if((map.enemies[i].name=="StarSapphire")&&(stage<8)) bonuses|=8192;
 else if(map.enemies[i].name=="Larfleeze") bonuses|=4096;
 else if(map.enemies[i].name=="Despairo") bonuses|=8;
 else if(map.enemies[i].name=="Indigo1") bonuses|=512;
 else if((map.enemies[i].name=="BlackLantern")&&(map.enemies[i].skills.length()>2)&&(map.enemies[i].skills[1]=="batarang")) bonuses|=(8192<<2);

 if((maxLevel>=stagenames.length())&&(random(0, 5)>1)&&(map.enemies[i].name!="robot")) {
