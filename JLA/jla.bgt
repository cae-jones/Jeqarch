 }// Try next.

 }// Switch if possible.
cont=false; i+=5; //=map.objects.length();
}
 }// Herm.
 }// Yeah.
 }// Meh.
 // Check for civilians.
 // And if nothing else has happened, use this to try and throw enemies.
 }// Enter.
 else {int n=number_pressed()-1;
 if(n>-2) {
 if(n<0) {
 if(@(me.holding)!=null) {
 me.skill=n;
 voice.speak_interrupt(me.holding.name);
} else voice.speak_interrupt("No item");
 }// Item.
 else {
 if(n<me.skills.length()) {

  if(me.name=="CaptainMarvel") {
 if((n!=me.skill)&&(me.skill==me.skills.length()-1)) {playsound("voices/BillyBatson/Shazam.wav", me.bounds.x+(0.5*me.bounds.width), me.bounds.y);
 me.bounds.width=1.0; me.bounds.height=2.0; me.canFly=true;
 me.speed*=2; me.jump*=2; me.endurance*=2;
 clipboard_copy_text("SHAZAM! up");
}// Return to Captain Marvel.
 else if((n==me.skills.length()-1)&&(me.skill!=n)) {playsound("voices/Captain Marvel/Shazam.wav", me.bounds.x+(0.5*me.bounds.width), me.bounds.y);
 me.bounds.width=0.5; me.bounds.height=1.0; me.endurance/=2; me.speed/=2; me.jump/=2; me.canFly=false;
 clipboard_copy_text("SHAZAM! down");
}// captain marvel returns to the form of Billy Batson.
}// Captain Marvel.

me.skill=n; voice.speak_interrupt(me.skills[n]);}
 else voice.speak_interrupt("You don\'t have that many abilities.");
 }// Skill.
}// Valid.
}// Number.
 }// It's possible to actually do stuff.
 bool superspeed=((me.skill>=0)&&(me.skill<me.skills.length())&&(me.skills[me.skill]=="extra speed"));
 bool swimming=((@(me.inside)!=null)&&(me.inside.name=="water"));

 if(key_down(KEY_RIGHT)) {
 if(!me.east) {me.east=true; pool.play_2d("sounds/turn.wav", me.bounds.x, me.bounds.y, me.bounds.x+(me.bounds.width*2), me.bounds.y, false);}
 else me.v.x= ((key_down(KEY_LSHIFT))||(key_down(KEY_RSHIFT))) ? me.speed : me.speed*0.5;
 if((superspeed)||((swimming)&&(me.name=="Aquaman"))) me.v.x*=2.0;
 }// Right.
else if(key_down(KEY_LEFT)) {
 if(me.east) {me.east=false; pool.play_2d("sounds/turn.wav", me.bounds.x, me.bounds.y, me.bounds.x-(me.bounds.width*2), me.bounds.y, false);}
 else me.v.x= ((key_down(KEY_LSHIFT))||(key_down(KEY_RSHIFT))) ? -me.speed : -me.speed*0.5;
 if((superspeed)||((swimming)&&(me.name=="Aquaman"))) me.v.x*=2.0;
 }// Left.
 else if(me.counter>=0.0) {
 if(swimming) me.v.x*=0.25;
 else me.v.x=0.0; // Heh?
}

 if(key_down(KEY_UP)) {
 // Important: If you've started an attack, this does not work.
 if(me.counter==0.0) {
 if(me.name=="WonderWoman") {
 me.canFly=(me.mp>=8);
 }// Wonder woman.
  if((me.canFly)||(swimming)) {
  double vy=me.jump*0.5;
 if((key_down(KEY_LSHIFT))||(key_down(KEY_RSHIFT))) vy=me.jump;
 if((swimming)&&(me.name=="Aquaman")) vy*=1.5;
 if(me.v.y<vy) playsound(
((swimming) ? "sounds/swim" + random(1, 4) + ".wav" : "sounds/fly" + random(1, 3) + ".wav"), me.bounds.x, me.bounds.y);
 me.v.y=vy;
}
 else {
 bool land=false;
 if(round(me.bounds.y, 2)==round(map.bounds.y, 2)) land=true;
 else {
 for(uint i=0; i<solids.length(); i++) {
 if((solids[i].solid)&&(solids[i].atop(me.bounds))) {land=true; i=solids.length();}
}// Loop.
 }// Loop.
 if(land) {
 me.v.y=me.jump;
 if((!key_down(KEY_LSHIFT))&&(!key_down(KEY_RSHIFT))) me.v.y*=0.75; // ???
 if(superspeed) me.v.y*=2;
 playsound("sounds/jump" + random(1, 3) + ".wav", me.bounds.x, me.bounds.y);
}// Go.
 }// No flying, can only jump while on something solid.
 }// Can't jump or fly up mid attack, because otherwise aiming would be a nightmare.

 }// Jump/fly up.
 else if(key_down(KEY_DOWN)) {
 if(((me.canFly)||(swimming))&&(me.counter==0.0)) {
  double vy=me.jump*0.5;
 if((key_down(KEY_LSHIFT))||(key_down(KEY_RSHIFT))) vy=me.jump;
 if(me.v.y>-vy) playsound(
((swimming) ? "sounds/swim" + random(1, 4) + ".wav" : "sounds/fly" + random(1, 3) + ".wav"), me.bounds.x, me.bounds.y);
 me.v.y=-vy;
 
 }// Aiming.
 else {
 if(@org==null) {@org=me.bounds; @(me.bounds)=newRectangle(me.bounds.x, me.bounds.y, me.bounds.width, me.bounds.height*0.5); playsound("sounds/crouch.wav", me.bounds.x+(0.5*me.bounds.width), me.bounds.y); }
}// Duck.
 }// Duck / fly down. Although I'm not sure how well ducking works.
else {
 if(@org!=null) {@(me.bounds)=org; @org=null;}
if((me.counter>=0.0)&&((me.canFly)||(swimming))) {
 me.v.y=0;
 }// Umm. Yeah.
}// Up and down not pressed.
 }// No alt.

 }// Oh, dear.
 int playsound(string fn, double x, double y) {
 double camX=0; double camY=0;
 if((@me!=null)&&(@(me.bounds)!=null)) {camX=me.bounds.x+(me.bounds.width*0.5); camY=me.bounds.y;}

 // Add echo.
 if(@map!=null) {
 if(echo_on) {
 Rectangle@ r=newRectangle(x-10, y-10, 20, 20);
 for(uint i=0; i<solids.length(); i++) {
 if((solids[i].solid)&&(solids[i].collide(r))) {
 vector v(solids[i].bounds.x-x, solids[i].bounds.y-y); double d=v.length();
 EchoD ech(fn,
 solids[i].bounds.x+(solids[i].bounds.width*0.5),
 camY-36+solids[i].bounds.height-solids[i].bounds.y, // ...
 0, 0.025*d);
 echoes.insert_last(ech);
 }// Echo.
 }// Meh.
} }// Echo.

 return pool.play_2d(fn, camX, camY, x, y, false);
 }// Sound.
 void look(Rectangle@ r) {
 if(@map==null) {voice.speak_interrupt_wait("Error: Looking without a map."); return;}
 t.pause();
 pool.pause_all();
 pool.play_stationary("sounds/menu/activate.wav", false);
 garbage_collect();
 string[] itms; itms.reserve(10);
 Rectangle@[] boxes; boxes.reserve(10);
  Object@ inside=null;
 if(@me!=null) @inside=me.inside;
 for(uint i=0; i<map.objects.length(); i++) {if(map.objects[i].collide(r)) {
 itms.insert_last(map.objects[i].name + ", X " + round(map.objects[i].bounds.x, 2) + ", Y " + round(map.objects[i].bounds.y, 2) + ", Z " + map.objects[i].z); boxes.insert_last(map.objects[i].bounds);
}}// Objects.
 Char@[] enemies=map.enemies;
 for(uint i=0; i<map.enemies.length(); i++) {if((map.enemies[i].bounds.collide(r))&&(
(@inside==@(enemies[i].inside))||((@inside!=null)&&(@(enemies[i].inside)!=null)&&(inside.z==map.enemies[i].inside.z)))
) {
 itms.insert_last(map.enemies[i].name + ", X " + round(map.enemies[i].bounds.x, 2) + ", Y " + round(map.enemies[i].bounds.y, 2)); boxes.insert_last(map.enemies[i].bounds);
}}// enemies.

 Char@[] civilians=map.civilians;
 for(uint i=0; i<map.civilians.length(); i++) {if((map.civilians[i].bounds.collide(r))&&(
(@inside==@(civilians[i].inside))||((@inside!=null)&&(@(civilians[i].inside)!=null)&&(inside.z==map.civilians[i].inside.z)))
) {
 itms.insert_last(map.civilians[i].name + ", X " + map.civilians[i].bounds.x + ", Y " + map.civilians[i].bounds.y); boxes.insert_last(map.civilians[i].bounds);
}}// civilians.

 if(@(map.boss)!=null) {
 Char@ boss=map.boss;
if((map.boss.bounds.collide(r))&&(
(@inside==@(boss.inside))||((@inside!=null)&&(@(boss.inside)!=null)&&(inside.z==map.boss.inside.z)))
) {
 itms.insert_last(map.boss.name + ", X " + round(map.boss.bounds.x, 2) + ", Y " + round(map.boss.bounds.y, 2)); boxes.insert_last(map.boss.bounds);
}

 }// Boss.


 int z=1; if(@(me.inside)!=null) z=me.inside.z;
 itms.insert_last("You are at " + round(me.bounds.x, 2) + ", " + round(me.bounds.y, 2) + ", " + z); boxes.insert_last(me.bounds);
 Menu looker;
 looker.items=itms; looker.select=mainmenu.select;
voice.speak_interrupt("" + itms.length() + " items found. Use arrow keys to navigate.");
// looker.run(pool, voice, curbgm);
int x=-1;
 while(true) {
 systemKeys();
  playsong(curbgm); // if(music!="") playsong(music);
 bool speak=true;
 if((key_pressed(KEY_LEFT))||(key_pressed(KEY_UP))) x--;
 else if((key_pressed(KEY_RIGHT))||(key_pressed(KEY_DOWN))) x++;
 else if(key_pressed(KEY_ESCAPE)) {speak=false; break;}
 else if((key_pressed(KEY_RETURN))||(key_pressed(KEY_SPACE))) {speak=false; break;}
 else speak=false;
 if(x<0) x=looker.items.length()-1; else if(x>=looker.items.length()) x=0;
 if(speak) {
 pool.play_extended_2d(looker.select,
me.bounds.x+(0.5*me.bounds.width), me.bounds.y,
 boxes[x].x, boxes[x].y, 0, boxes[x].width, 0, boxes[x].height,
false, 0,
 0, 0, 100,
 false);
 voice.speak_interrupt(looker.items[x]);
}

 wait(5);
 }// Menu.


 pool.play_stationary("sounds/menu/cancel.wav", false);
 garbage_collect();
 pool.resume_all();
 t.resume();
 }// look.

EchoD@[] echoes;
 class EchoD {

 string filename; // the sound to be echoed.
 double x; double y; // The spacial position of the sound to be echoed.
 double decay; // How much quieter the sound should be than the source sound. Note that playing it at a distance will likely cut the volume even further.
 double delay; // How long before the echo plays.
 double pitchBend; // If the echo is pitched compared to the original.
 EchoD() {pitchBend=100;}
 EchoD(string fn) {filename=fn; pitchBend=100;}
 EchoD(string fn, double xx, double yy, double dec, double del) {filename=fn; x=xx; y=yy; decay=dec; delay=del; pitchBend=100;}
 EchoD(string fn, double xx, double yy, double dec, double del, double pb) {filename=fn; x=xx; y=yy; decay=dec; delay=del; pitchBend=pb;}

 EchoD clone() {return this;} //?

 // This version of clone changes the filename, but leaves everything else the same.
 // This is a quick way to use the EchoD object for echoes of individual sounds based on a master EchoD templet.
 EchoD clone(string fn) {
 EchoD ret(fn, x, y, decay, delay, pitchBend);
 return ret;
 }

}// EchoD.
 int losses=0;
 void level_clear() {
 pool.destroy_all();
 fadeOut(35);
 voice.speak_interrupt("Level complete. You lost " + losses + " civilians.");
 if(stage==stagenames.length()-1) {

 voice.speak_interrupt("You have defeated the self-proclaimed god, Darksied, and saved countless worlds from death or enslavement! Though he is a brutal dictator seeking the conquest of nothing less than the whole of reality, the people of Apocalypse love him enough to treat his wounds. This might not be the last you see of Darksied!");
 if(countBonuses()+stagenames.length()>=chars.length()) voice.speak_interrupt("Darksied is truly vanquished! But it is not Darksied\'s destruction that can end the Blackest Night...");
 if((countBonuses()>=9)&&(maxLevel>=stagenames.length())) bonuses|=16384;
}// Game complete.
 @map=null;
 @me=null;
 projectiles.resize(0);
 if(stage==maxLevel) maxLevel++;
 losses=0;
 @org=null; // No cheating by holding down at the end of a level!
 garbage_collect();
 keys_pressed(); // just to be careful.
 wait(500); // Happens too easy.
 while(true) {
 systemKeys();
 int[] keys=keys_pressed();
 if(keys.length()>0) return;
 wait(50);
 }// Meh.
 }

void stepChar(Char@ c, double dt) {
 if(@c==null) return;
 if(c.hp<=0.0) playsound("voices/" + c.name + "/die.wav", c.bounds.x, c.bounds.y);
 Object@ atop=null;
 bool swimming=((@(c.inside)!=null)&&(c.inside.name=="water"));

 if(swimming) {
 // Oh jees oh jees oh jees that was annoying!
 // So here's the catch: we can still collide with solids, maybe.
 int8 z=c.inside.z;
 Rectangle@ targ=newRectangle(c.bounds.x+(c.v.x*dt), c.bounds.y+(c.v.y*dt), c.bounds.width, c.bounds.height);
 bool moved=((targ.y>=c.inside.bounds.y)&&(targ.x>=c.inside.bounds.x)&&(targ.x+targ.width<=c.inside.bounds.x+c.inside.bounds.width));

if(moved)  for(uint i=0; i<solids.length(); i++) {
 if((solids[i].z==z)&&(targ.collide(solids[i].bounds))) moved=false;
 }// Dealing with solids.
 if(moved) {
 if((round(c.bounds.x, 0)!=round(targ.x, 0))||(round(c.bounds.y, 0)!=round(targ.y, 0))) playsound("sounds/swim" + random(1, 4) + ".wav", targ.x+(0.5*targ.width), targ.y);
  c.bounds.x=targ.x; c.bounds.y=targ.y;
}// Move.
if(!c.bounds.collide(c.inside.bounds)) {@(c.inside)=null; playsound("sounds/steps/water" + random(1, 9) + ".wav", c.bounds.x+(0.5*c.bounds.width), c.bounds.y);}
 else if((c.name=="Aquaman")||(c.name=="fish")||(c.name=="shark")||(c.name=="whale")||(c.name=="dolphin")||(c.name=="octapus")||(c.name=="BlackManta")||(c.name=="SwampThing")) {
 if(c.hp<100+c.stamina) c.hp+=0.05*dt;
 if(c.mp<10+c.stamina) c.mp+=0.1*dt;
 }// Sea creatures.
 else {
 if(c.mp>0.0) c.mp-=0.01*dt/((c.stamina==0) ? 0.5 : c.stamina);
 else c.hp-=0.005*dt/((c.stamina==0) ? 0.5:c.stamina);
 }// Air-breathers.
 }// Swimming
 else {
 bool grounded=(round(c.bounds.y, 2)==round(map.bounds.y, 2));
 if((grounded)&&(@c==@me)) {
 if(ledge1>=0) {pool.destroy_sound(ledge1); ledge1=-1;}
 if(ledge2>=0) {pool.destroy_sound(ledge2); ledge2=-1;}
 }// Remove ledges.
 if(!grounded) {
 if((@(c.inside)!=null)&&(round(c.bounds.y, 1)==round(c.inside.bounds.y, 1))) grounded=true;
 else if((@(c.atop)!=null)&&(c.bounds.collide(c.atop.bounds))) {grounded=true; @atop=c.atop;}
 else  for(uint i=0; i<solids.length(); i++) {
 if((solids[i].solid)&&(solids[i].atop(c.bounds))) {grounded=true; @atop=solids[i]; @(c.atop)=atop;
 if((@c==@me)&& ((ledge1<0)||(ledge2<0))) {
 // I'd rather find ledges than the edge of whatever you're standing on; there might be another object to the left or right that you can walk to.
 // But I really don't feel like nesting another loop inside this thing.
 ledge1= pool.play_extended_2d("sounds/ledge.wav", me.bounds.x+(0.5*me.bounds.width), me.bounds.y, solids[i].bounds.x, solids[i].bounds.y+solids[i].bounds.height, 0, 0, 0, 0, true, 0, 0, random(-10, 0), random(90, 110));
 ledge2= pool.play_extended_2d("sounds/ledge.wav", me.bounds.x+(0.5*me.bounds.width), me.bounds.y, solids[i].bounds.x+solids[i].bounds.width, solids[i].bounds.y+solids[i].bounds.height, 0, 0, 0, 0, true, 0, 0, random(-10, 0), random(90, 110));
}// Ledge detection.
 i=solids.length();}
 }// Stuff.
 }// Check for being on ledges and what-naught.
 if((!grounded)&&((!c.canFly)||(c.counter<0.0))) c.v.y=c.v.y-(9.0*dt); // What about places like Mars and Enceladus, where the gravity is different?

int curx=round(c.bounds.x, 0);
 int cury=round(c.bounds.y, 0);
 // This will require changing.
 double cvx=c.v.x; if(@(c.atop)!=null) cvx+=c.atop.v.x;

 c.bounds.x+=cvx*dt;
 if((@(c.inside)!=null)&&(!c.inside.collide(c.bounds))) {
 c.bounds.x-=cvx*dt;
 c.v.x=0;
 if((@(c.inside)!=null)&&(!c.inside.collide(c.bounds))) @(c.inside)=null;
 }// This would be a problem.

 uint8 z=1;
 if(@(c.inside)!=null) z=c.inside.z;
 if((c.v.x!=0.0)||(c.v.y!=0.0)) {
 // I am sick of doing this loop so many times. -_-.
 if((@c==@me)||(c.bounds.x<map.bounds.x))  for(uint i=0; i<map.objects.length(); i++) {
 Object@ o=map.objects[i];
 if((o.z==z)&&(o.collide(c.bounds))) {
 // Do damage if it's a damaging object.
 // Or heal if it's a healing object, whatever.
 if((o.solid)&&(@o!=@(c.atop))) {
 playsound("sounds/hitwall" + random(1, 3) + ".wav", c.bounds.x+(c.bounds.width*0.5), c.bounds.y);
 c.bounds.x-=cvx*dt;
 c.v.x=0;

 }// Or get ye out of the way if it's a solid object.
 }// Collision!
 }// Objects.
}// Only worry about that loop if we actually move.
 if(cury!=round(c.bounds.y, 0)) @atop=null;
 @(c.atop)=atop; //???
 if((!grounded)||(c.v.y<-5)||(c.v.y>=0)) {
 double cvy=c.v.y; if(@(c.atop)!=null) cvy+=c.atop.v.y;
 c.bounds.y+=cvy*dt;
 if((@(c.inside)!=null)&&(c.bounds.y<c.inside.bounds.y)) {
 c.bounds.y=c.inside.bounds.y;
 c.v.y=0; //?
 if(c.counter<0) playsound("sounds/fall" + c.inside.terrain + random(1, 4) + ".wav", c.bounds.x+(0.5*c.bounds.width), c.bounds.y);
 else playsound("sounds/steps/" + c.inside.terrain + "/run" + random(1, 6) + ".wav", c.bounds.x+(0.5*c.bounds.width), c.bounds.y);
}// Thing.
  // Umm. Anything else?
}

 bool landed=false; bool fall=(c.counter<0.0);
 if((c.bounds.y<map.bounds.y)&&((@(c.inside)==null)||(round(c.inside.bounds.y, 1)>=round(map.bounds.y, 1)))) {
 if(@(c.inside)!=null) {if(@c==@me) clipboard_copy_text(c.name + " is inside a " + c.inside.name + ", which has a y of " + c.inside.bounds.y + ". This is not being treated as a valid subterranean location.");
 if(c.inside.bounds.y<map.bounds.y) alert("WTF!", "No, seriously, WTF? You literally just met the conditions for not entering this block!");
}// Inside is non-null. Possibly stupidity.

c.v.y=0; c.bounds.y=map.bounds.y; grounded=true; landed=true;}
 else if(c.v.y<0.0) {
 if((@atop!=null)||((@(c.atop)!=null)&&(c.atop.atop(c.bounds)))) {
 landed=true;
 if((!fall)&&(c.v.y>=-5)) c.v.y=0;
}// Atop.
