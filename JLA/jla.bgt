int selectStage() {
 voice.speak_interrupt("Select level");
 Menu stagemenu;
 stagemenu.select=mainmenu.select;
 for(uint i=0; ((i<=maxLevel)&&(i<stagenames.length())); i++) stagemenu.add(stagenames[i]);

 int ret = stagemenu.run(pool, voice, "music/justiceleague.ogg");
 if(ret<0) {
 pool.play_stationary("sounds/menu/cancel.wav", false);
return -1;
}
 pool.play_stationary("sounds/menu/activate.wav", false);
 voice.speak_interrupt("Loading level.");
 garbage_collect();
 switch (ret) {
case 0 : {
// "Gotham",

Object@ o;
 Object@[] objs; objs.reserve(8);

 // Foreground buildings.
@o=newObject("building", newRectangle(0, 0, 10, 10)); o.z=2; o.solid=true;
 o.terrain="roof"; o.overlap=false;
 o.snd="sounds/bigbuilding.wav";
 objs.insert_last(o);
 // Background buildings.
@o=newObject("building", newRectangle(0, 0, 10, 13)); o.z=0; o.solid=true;
 o.terrain="roof"; o.overlap=true;
 o.snd="sounds/bigbuilding.wav";
 objs.insert_last(o);

 // street lamps.
 @o=newObject("lamp post", newRectangle(0, 0, 0.5, 5));
 o.overlap=false; o.z=2;
 o.snd="sounds/light1.wav";
 // Is it solid? I don't know.
 o.solid=true;
 o.terrain="steel";
 objs.insert_last(o);

 // Cars.
 @o=newObject("car", newRectangle(0, 0, 3, 1));
 o.solid=true; o.terrain="roof";
 o.z=1;
 o.v.x=10;
 o.snd="sounds/car.wav";
 o.loop=false; //?
 o.canEnter=true;
 o.terrain="carpet";
 objs.insert_last(o);
 // Towers
 @o=newObject("tower", newRectangle(0, 0, 8, 24));
 o.solid=true; o.terrain="roof"; // I'd like it better if these were multi tiered.
 o.overlap=true;
 o.z=0;
 o.snd="sounds/bigbuilding.wav";
 objs.insert_last(o);

 // Houses
 @o=newObject("house", newRectangle(0, 0, 10, 5));
 o.z=0; o.overlap=false;
 o.snd="sounds/smallbuilding.wav";
 o.terrain="roof";
  o.solid=true;
 // I kinda want it to be possible to hide inside of a house, heh.
 objs.insert_last(o);
 // Dark Alleys
  @o=newObject("alley", newRectangle(0, 0, 15, 10));
 o.overlap=true;
 o.solid=false;
 o.snd="sounds/alley.wav";
 o.canEnter=true;
 o.terrain="concrete";
 objs.insert_last(o);
 // Small shops (with alarms?)
 @o=newObject("shop", newRectangle(0, 0, 5, 5));
 o.z=2;
 o.overlap=false;
 o.snd="sounds/alarm1.wav";
 o.solid=true;
 // Hmm. Items inside buildings?
 o.terrain="roof";
 objs.insert_last(o);

 // Civilians.
 Char@ civ;
 Char@[] civs; civs.reserve(5);
 @civ=newChar("man"); civs.insert_last(civ);
 @civ=newChar("woman"); civs.insert_last(civ);
 @civ=newChar("teenagers"); civs.insert_last(civ);
 @civ=newChar("tweens"); civs.insert_last(civ);
 // Police.
 @civ=newChar("police");
 civ.skills.resize(4);
 civ.skills[0]="fists"; civ.skills[1]="pistol"; civ.skills[2]="uzi"; civ.skills[3]="grenade";
 civ.levels.resize(civ.skills.length());
 civ.levels[0]=1; civ.levels[1]=random(3, 16); civ.levels[2]=random(0, 24); civ.levels[3]=random(0, 3);
 civs.insert_last(civ);

 Char@ enemy;
 Char@[] enemies;
 // Mobsters.
 @enemy=newChar("mobster");
 enemy.skills.resize(5);
 enemy.levels.resize(enemy.skills.length());
 enemy.skills[0]="fists"; enemy.levels[0]=1;
 enemy.skills[1]="pipe"; enemy.levels[1]=random(0, 1);
 enemy.skills[2]="knife"; enemy.levels[2]=random(0, 1);
 enemy.skills[3]="pistol"; enemy.levels[3]=random(0, 16);
 enemy.skills[4]="uzi"; enemy.levels[4]=random(0, 24);
 enemies.insert_last(enemy);

 Map temp(newRectangle(-1, 0, 100, 50), objs, 40, enemies, 35, civs);
 @map=temp;
 map.atmosphere="night";
 map.start.x=map.bounds.x-2; // So people don't start out being hit by cars!
 // Put some on rooftops?

 // Make Catwoman the boss?
 string[] cs={"fists", "knife", "pistol", "whip", "grapplinghook"};
@(map.boss)=newChar("Catwoman", cs, 100);
 map.boss.levels[1]=10; map.boss.levels[2]=20; map.boss.levels[3]=2; map.boss.levels[4]=random(5, 30);
 map.boss.speed=random(3, 7); map.boss.jump+=random(1, 5);
 map.boss.bounds.x=random(map.bounds.x+(0.75*map.bounds.width), map.bounds.x+map.bounds.width);
 map.boss.bounds.y=0;
 for(uint i=0; i<map.objects.length(); i++) {
 @o=map.objects[i];
 if(o.collide(map.boss.bounds)) {
 if(o.solid) map.boss.bounds.y=o.bounds.y+o.bounds.height;
 else if(o.canEnter) @(map.boss.inside)=o;
 }// Herm.
 }// Catwoman on rooftops.


 // Adjust some things if the difficulty is low enough.
 if(difficulty+maxLevel<=random(1, 2)) {
 // 1. Reduce cars.
 int cars=0;
 for(uint i=0; i<map.objects.length(); i++) {
 if(map.objects[i].v.x!=0) {cars++;
 if(cars>6+difficulty+random(0, 3)) map.objects.remove_at(i);
}}// Cars.
 for(uint i=0; i<map.enemies.length(); i++) {
 map.enemies[i].bounds.x+=random(10, 30);
 map.enemies[i].counter=-5;
 if(difficulty==0) map.enemies[i].endurance/=2;
}// Make the enemies spread out.
}// Improve some things.

 // Bane is a hidden boss.
 string[] bs={"fists", "mace", "grenade"};
 Char@ bane=newChar("Bane");
 bane.levels[2]=10;
 bane.hp=100;
 bane.mp=random(15, 55);
 bane.strength+=random(2, 5);
 bane.endurance+=random(1, 4);
 bane.speed+=random(1, 3);
 bane.jump++;
// bane.bounds.height++;
 bane.aspeed=random(10, 30)*0.01;
 bane.levels[1]=30;
 // Create somewhere to put him, and a means of accessing it.

@o=newObject("manhole", newRectangle(random(map.bounds.x, map.bounds.width-1), 0, 1, 1));
 o.solid=true; o.canEnter=false;
 o.z=2; o.terrain="pipe";
// map.objects.insert_last(o);
 // Should it make a sound? Such as water leaking down a drain?
 o.snd="sounds/pipedrain.wav";
 map.objects.insert_last(o);
// o.bounds.x=1; // Debug. I'm too frustrated to test this properly.
 @o=newObject("elevator", newRectangle(random(0, 98), -40, 2, 38));
 o.solid=true; o.snd="sounds/elevator.wav";
 map.objects.insert_last(o);

 @o=newObject("sewer", newRectangle(0, -40, 100, 15));
 o.terrain="sewer"; o.solid=false; o.canEnter=true;
 o.snd="sounds/sewer.ogg";
 o.z=0;
 o.solid=false;
 map.objects.insert_last(o);
 @o=newObject("pipe", newRectangle(0, -40, 100, 15));
 o.solid=false; o.canEnter=true; o.z=2; o.terrain="pipe";
 map.objects.insert_last(o);
 bane.bounds.x=random(0, 100); bane.bounds.y=-40; @(bane.inside)=o; map.enemies.insert_last(bane); 

 @o=newObject("service key", newRectangle(0, 0, 0.25, 0.25));
 o.solid=false; o.snd="sounds/beacon.wav"; o.collectable=true; o.z=0;
 Object@[] towers;
 for(uint i=0; i<map.objects.length(); i++) {
 if(map.objects[i].name=="tower") towers.insert_last(map.objects[i]);
 }// Put it on a tower.
 if(towers.length()==0) {o.bounds.x=random(0, 100); o.bounds.y=random(0, 10);}
 else if(towers.length()==1) {o.bounds.x=random(towers[0].bounds.x, towers[0].bounds.x+towers[0].bounds.width); o.bounds.y=towers[0].bounds.y+towers[0].bounds.height;}
 else {
 Object@ tower=towers[random(0, towers.length()-1)];
 o.bounds.x=random(tower.bounds.x, tower.bounds.x+tower.bounds.width);
 o.bounds.y=tower.bounds.y+tower.bounds.height;
 }// Pick a tower.
 map.objects.insert_last(o);
// o.bounds.x=0; o.bounds.y=0; // Debug.


 // Add Penguin's Aviary if you've advanced far enough in the game and come back.
 if(maxLevel>2) {
 // Penguin himself, and Mr. Freeze will be hanging out up there, if it can be done. It's suspiciously difficult to keep an enemy where he/she/it belongs.
 @o=newObject("tower", newRectangle(map.bounds.x-30, map.bounds.y, 10, 20));
 o.z=2; o.solid=true; o.snd="sounds/bigbuilding.wav";
 o.terrain="roof";
 map.objects.insert_last(o);
 @o=newObject("aviary", newRectangle(map.bounds.x-40, map.bounds.y+20, 30, 20));
 o.solid=false; o.z=0; o.canEnter=true;
 o.terrain="grass"; o.snd="sounds/treewind.ogg";
 map.objects.insert_last(o);
 // Put in various birds.
 Object@ a=o;
 for(uint i=0; i<5; i++) {
 @o=newObject("bird", newRectangle(random(a.bounds.x, a.bounds.x+a.bounds.width), random(a.bounds.y, a.bounds.y+a.bounds.height), 0.5, 0.5));
 o.snd="sounds/birds" + random(1, 3) + ".wav";
 o.solid=false; o.z=0; o.canEnter=false;
 map.objects.insert_last(o);
}// birds.

 string[] ps={"fists", "sword", "pistol", "uzi", "sword"};
 @enemy=newChar("Penguin", ps, 100);
 enemy.endurance+=random(1, 2);
 enemy.speed*=0.5; // He's not fast.
 enemy.mp=100;
 for(uint i=0; i<enemy.levels.length(); i++) {enemy.levels[i]+=random(5, 30);}
 @(enemy.inside)=a;
 enemy.bounds.x=random(a.bounds.x, a.bounds.x+a.bounds.width-2); enemy.bounds.y=a.bounds.y;
 enemy.bounds.width=1.5; // Because, you know, he's fat.
 map.enemies.insert_last(enemy);
 string[] fs={"fists", "pipe", "FreezeBreath", "FreezeBreath"};
 @enemy=newChar("MisterFreeze", fs, 100);
 enemy.endurance+=random(1, 4);
 enemy.mp=100;
 @(enemy.inside)=a;
 enemy.bounds.x=random(a.bounds.x, a.bounds.x+a.bounds.width-1); enemy.bounds.y=a.bounds.y;
 enemy.strength+=difficulty;
 map.enemies.insert_last(enemy);
}// Penguin.
}; break;
case 1 : {
// "Arkalm Island",

// Watchtowers must be placed carefully to avoid overlapping with other buildings.
 Object@ o;
 Object@[] objs;
 @o=newObject("guardtower", newRectangle(0, 0, 8, 30));
 o.overlap=false; o.solid=true; o.z=2;
 o.terrain="wood";
 o.snd="sounds/bigbuilding.wav";
 objs.insert_last(o);
 @o=newObject("statue", newRectangle(0, 0, 1.5, 3));
 o.solid=true; //?????
 o.z=0;
 o.overlap=false;
 o.terrain="concrete";
 objs.insert_last(o);
 @o=newObject("bayside cliff", newRectangle(0, 0, 5, 2));
 o.solid=false; o.overlap=false;
 o.z=random(0, 2);
 o.terrain="water"; // Umm.
 o.canEnter=true;
 o.snd="sounds/sesea.wav"; // ADD THAT!
 objs.insert_last(o);

