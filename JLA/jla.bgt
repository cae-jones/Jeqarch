 for(uint i=0; i<enemies.length(); i+=random(1, 2)) {
 for(uint j=0; j<map.objects.length(); j++) {
 if((map.objects[j].solid)&&(map.enemies[i].bounds.collide(map.objects[j].bounds))) {map.enemies[i].bounds.y=map.objects[j].bounds.y+map.objects[j].bounds.height;}
}// Meh!
}// Enemies, move to high places.
 // Access card.
 // In this case, let's make the service card a necessity for completing the level.
  double leftmost=map.bounds.x+map.bounds.width;
 for(uint i=0; i<map.objects.length(); i++) {
 if((map.objects[i].name=="security door")&&(map.objects[i].bounds.x<leftmost)) leftmost=map.objects[i].bounds.x;
}// Look for doors.
 if(leftmost>=map.bounds.x+map.bounds.width) {
 @o=newObject("security door", newRectangle(random(map.bounds.x, map.bounds.x+map.bounds.width), 0, 1, 20));
 o.solid=true; o.terrain="steel";
 o.z=1; // UhOh!
 o.overlap=false; // Not that it matters. :(
 o.canEnter=false;
 // Or you could be Superman and just smash them. Either way works.
 map.objects.insert_last(o);
 leftmost=o.bounds.x;
 }// Not enough doors!
 Object@[] rooms;
 for(uint i=0; i<map.objects.length(); i++) {
 if((map.objects[i].name!="security door")&&(map.objects[i].bounds.x<leftmost)) rooms.insert_last(map.objects[i]);
}
 Object@ card=newObject("access card", newRectangle(random(map.bounds.x, leftmost-1), 0, 0.25, 0.25));
 card.solid=false; card.snd="sounds/beacon.wav";
 card.collectable=true;
 if(rooms.length()==1) rooms.insert_last(rooms[0]);
 if(rooms.length()>1) {
 Object@ r=rooms[random(0, rooms.length()-1)];
card.bounds.x=random(r.bounds.x, r.bounds.x+r.bounds.width-1);
 if(r.solid) { card.bounds.y=r.bounds.y+r.bounds.height;}
 else if(r.canEnter) {card.z=r.z; map.objects.insert_at(0, card);}
 }
 card.weightless=true;
 if(card.bounds.x>=leftmost) card.bounds.x=leftmost-1;
 map.objects.insert_last(card);

 @o=newObject("locked elevator", newRectangle(random(map.bounds.x, map.bounds.x+map.bounds.width), 0, 2.5, 30));
