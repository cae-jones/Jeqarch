ha.width++; ha.height++; ha.x-=0.5;
 for(uint i=0; i<map.objects.length(); i++) {
 Object@ o=map.objects[i];
 if((o.solid)&&(o.collide(ha)) &&(round(ha.y+ha.height, 0)>=round(o.bounds.y+o.bounds.height, 0))) {
 playsound("sounds/hookledge.wav", ha.x+(0.5*ha.width), ha.y+ha.height);
c.bounds.y=o.bounds.y+o.bounds.height; c.counter=0.0; c.v.y=0.0; if(c.bounds.x+c.bounds.width<o.bounds.x) c.bounds.x=o.bounds.x;
 @(c.atop)=o;
 //i=solids.length();
 if(@c==@me) {
 if(ledge1>=0) {pool.destroy_sound(ledge1); ledge1=-1;}
 if(ledge2>=0) {pool.destroy_sound(ledge2); ledge2=-1;}
 }// Ledge sounds.
 }
else if((o.solid)&&(@(c.atop)==null)&&(o.collide(ha))&&(o.terrain!="steel")&&(o.terrain!="pipe")) {
  c.v.y=c.jump; 
  pool.play_2d("sounds/bullet/hit_by_bullet" + random(1, 3) + ".wav", me.bounds.x+0.5*me.bounds.width, me.bounds.y, ha.x+1, ha.y+1, false);
  if(@c==@me) me.v.y=(key_down(KEY_UP)) ? me.jump : 0.0;
 }// Hooks for climbing! Like Megaman!
 else if((o.collectable)&&(o.collide(ha))) {o.bounds.x=c.bounds.x; o.bounds.y=c.bounds.y; if(o.slot>=0) pool.update_sound_2d(o.slot, o.bounds.x, o.bounds.y);}
}// Hooked.

 }// Hook hand.
 else if(s=="vines") {
 Rectangle@ ha=newRectangle(c.bounds.x-2.5, c.bounds.y-15, c.bounds.width+5, c.bounds.height+25);
 // Climb up whatever it touches.

 for(uint i=0; i<solids.length(); i++) {
 Object@ o=solids[i];
 if((@c==@me)||(@c==@(map.boss))) {
 if(
 ((@c==@me)&&(key_down(KEY_DOWN))&&(o.bounds.y+o.bounds.height>=c.bounds.y+c.bounds.height))||
 ((@c==@me)&&(key_down(KEY_UP))&&(o.bounds.y+o.bounds.height<=c.bounds.y))||
 ((@c==@(map.boss))&&(@me!=null)&&(
 ((me.bounds.y>c.bounds.y)&&(o.bounds.y+o.bounds.height<me.bounds.y))||((me.bounds.y<c.bounds.y)&&(o.bounds.y+o.bounds.height>c.bounds.y))
))
) continue;
}// Catch aiming.
 if((o.collide(ha))&&(@o!=@(c.atop))) {c.bounds.y=o.bounds.y+o.bounds.height; i=solids.length();
 if(c.bounds.x<o.bounds.x) c.bounds.x=o.bounds.x; else if(c.bounds.x>=o.bounds.x+o.bounds.width) c.bounds.x=o.bounds.x+o.bounds.width-c.bounds.width;
 playsound("sounds/steps/" + o.terrain + "/run" + random(1, 6) + ".wav", c.bounds.x+(0.5*c.bounds.width), c.bounds.y);
}// climbed.
}// Climby.

 if((@c==@me)&&((key_down(KEY_LEFT))||(key_down(KEY_RIGHT)))) @ha=ha.rotate();

 if(@c==@me) {
 int hits=0;
 for(uint i=0; i<map.enemies.length(); i++) {
 if(ha.collide(map.enemies[i].bounds)) {
 Char@ enemy=map.enemies[i];
 if(damage(enemy, c.strength, "sounds/hit" + random(1, 5) + ".ogg", "sounds/block" + random(1, 4) + ".wav")) {
 hits++;
 if(enemy.bounds.x<c.bounds.x) enemy.bounds.x=c.bounds.x-enemy.bounds.width; else if(enemy.bounds.x>c.bounds.x) enemy.bounds.x=c.bounds.x+c.bounds.width;
 enemy.bounds.y=c.bounds.y+(c.bounds.height-enemy.bounds.height);
 enemy.v.x=0; enemy.v.y=0; enemy.counter=-5/((enemy.endurance==0) ? 0.5 : enemy.endurance);

}// Success.
}// Hit enemy.
}// Loop.
 if((hits<random(1, 3))&&(@(map.boss)!=null)&&(ha.collide(map.boss.bounds))) {
 Char@ enemy=map.boss;
 if(damage(enemy, c.strength, "sounds/hit" + random(1, 5) + ".ogg", "sounds/block" + random(1, 4) + ".wav")) {
 hits++;
 if(enemy.bounds.x<c.bounds.x) enemy.bounds.x=c.bounds.x-enemy.bounds.width; else if(enemy.bounds.x>c.bounds.x) enemy.bounds.x=c.bounds.x+c.bounds.width;
 enemy.bounds.y=c.bounds.y+(c.bounds.height-enemy.bounds.height);
 enemy.v.x=0; enemy.v.y=0; enemy.counter=-5/((enemy.endurance==0) ? 0.5 : enemy.endurance);
 hits++;
}// Success.

 }// hit boss.
}// Hit enemies and/or boss.
 else {
 if(ha.collide(me.bounds)) {
 Char@ enemy=me;
 if(damage(enemy, c.strength, "sounds/hit" + random(1, 5) + ".ogg", "sounds/block" + random(1, 4) + ".wav")) {

 if(enemy.bounds.x<c.bounds.x) enemy.bounds.x=c.bounds.x-enemy.bounds.width; else if(enemy.bounds.x>c.bounds.x) enemy.bounds.x=c.bounds.x+c.bounds.width;
 enemy.bounds.y=c.bounds.y+(c.bounds.height-enemy.bounds.height);
 enemy.v.x=0; enemy.v.y=0; enemy.counter=-5/((enemy.endurance==0) ? 0.5 : enemy.endurance);

}// Success.

}// Hit player.
}// hit player.

}// vines.
 else if(s=="channel") {

 // No one is safe.
 // Except other indigos.

 string names=" GreenLantern Sinestro Corps member RedLantern OrangeLanternConstruct StarSapphire Larfleeze BlueLantern SaintWalker BlackLantern Deadman Atrocitus ";

 Rectangle@ ha=newRectangle(c.bounds.x-2, c.bounds.y-2, c.bounds.width+4, c.bounds.height+4);
 Char@[] cand; cand.reserve(50);
 if((@c!=@me)&&(me.bounds.collide(ha))) cand.insert_last(me);
 else if((@c!=@(map.boss))&&(map.boss.bounds.collide(ha))) cand.insert_last(map.boss);
 for(uint i=0; i<map.enemies.length(); i++) {
 if((@(map.enemies[i])!=@c)&&(ha.collide(map.enemies[i].bounds))) cand.insert_last(map.enemies[i]);
}// Enemies.
 for(uint i=0; i<map.civilians.length(); i++) {
 if((@(map.civilians[i])!=@c)&&(ha.collide(map.civilians[i].bounds))) cand.insert_last(map.civilians[i]);
}// civilians.

// Now, go:
 int total=random(1, 5);
 if(cand.length()==1) cand.insert_last(cand[0]);
if(cand.length()>0) for(uint i=0; i<total; i++) {
 int targdex=((cand.length()==1) ? 0 : random(0, cand.length()-1));
 if((targdex<0)||(targdex>=cand.length())) continue;
 Char@ targ=cand[targdex];
 if(string_contains(names, targ.name, 1)<0) {
 cand.remove_at(targdex);
 i--;
 if(cand.length()<1) i=total;
 continue;
}// Not found.
 c.mp+=0.25*targ.mp; targ.mp*=0.75;
 targ.counter=-1;
 targ.v.x*=0.25; targ.v.y*=0.25;
 playsound("sounds/lightningcharge.wav", c.bounds.x+(0.5*c.bounds.width), c.bounds.y);
}// Do the channeling.


}// channeling, like an Indigo.
 else if(s=="BlueLight") {
 if(c.mp<1) {playsound("sounds/GLConstructBroken.wav", c.bounds.x+(0.5*c.bounds.width), c.bounds.y); }
 else {
 Rectangle@ ha=newRectangle(c.bounds.x, c.bounds.y, c.bounds.width+5, c.bounds.height);
 
 if(@c==@me) {
 if(key_down(KEY_UP)) {ha.height=ha.width; ha.width=c.bounds.width;}
 else if(key_down(KEY_DOWN)) {ha.height=ha.width; ha.width=c.bounds.width; ha.y=ha.y-ha.height+c.bounds.height;}
 else if(!c.east) ha.x=ha.x-ha.width+c.bounds.width;
}// Aim.
 else if(!c.east) ha.x=ha.x-ha.width+c.bounds.width;

 int hits=0;
 bool glfound=false;
 for(uint i=0; i<=map.enemies.length(); i++) {
 Char@ enemy=((i<map.enemies.length()) ? map.enemies[i] : map.boss);
 if(@enemy==null) continue;
 if(!ha.collide(enemy.bounds)) continue;
 // BlueLight is ... complicated.
 // It drains the mp from Sinestro and Sinestro Corps members.
 if((enemy.name=="Sinestro")||(enemy.name=="Sinestro Corps member")) {enemy.counter-=0.1*random(0, 20); enemy.mp-=random(1, 10);}
 // It can nullify Orange Lantern Constructs? I'm not entirely sure how that's going to work. Probably just destroys their projectiles and possibly weakens them (but does not weaken Larfleeze)?
 else if(enemy.name=="OrangeLanternConstruct") {
 enemy.mp-=random(0, 5);
 enemy.hp-=random(0, 10);
 if(enemy.hp<=0) playsound("sounds/GLConstructBroken.wav", enemy.bounds.x+(0.5*enemy.bounds.width), enemy.bounds.y);
}// Orange Lantern constructs.
 // There's a random chance that it will neutralize a Red Lantern? (But not Atrocitus)
 else if(enemy.name=="RedLantern") {
 damage(enemy, random(c.strength, c.strength*3), "sounds/GLConstruct.wav", "sounds/GLConstructBroken.wav");
}// Red Lantern.
 // and Green Lanterns are supercharged by it. (Hm, should decide what to do if GreenLantern picks up a BlueLantern, then?)
 else if(enemy.name=="GreenLantern") {enemy.hp+=random(0, c.strength*3); enemy.mp*=2; enemy.strength*=2; glfound=true;}
 // If there are no other wielders of power rings around, the BlueLight is strengthened by the hope of people nearby. This is a bit complicated, unfortunately.
 // Oh, if there is a GreenLantern present, this will create a typical Laser-bolt-thing. :P
 // The effect on Mobsters is probably stunning.
 else if((enemy.name=="Mobster")||(enemy.name=="mobster")) {enemy.counter-=1.0; playsound("sounds/GLConstruct.wav", enemy.bounds.x+(0.5*enemy.bounds.width), enemy.bounds.y);}
 // Probably no effect on Mercinaries (because they're jerks) or robots (because robots and hope is a strange combination...).
 // Oh! And the BlueLight heals! Both him and nearby civilians.
 // It'd be nice if it could make Larfleeze less aggressive, but... Hm.
 else if(enemy.name=="Larfleeze") {enemy.counter=-0.5;}
 else if(enemy.name=="Amazon") {
 enemy.hp++;
 if(enemy.hp>=random(10, 15)) {map.enemies.remove_at(i); map.civilians.insert_last(enemy); playsound("sounds/GLConstruct.wav", enemy.bounds.x+(0.5*enemy.bounds.width), enemy.bounds.y);}
 else playsound("sounds/GLConstructBroken.wav", enemy.bounds.x+(0.5*enemy.bounds.width), enemy.bounds.y);
}// Amazons.
 else if((enemy.name=="MisterFreeze")||(enemy.name=="KillerCroc")) {
  c.hp++;
 map.enemies.remove_at(i); map.civilians.insert_last(enemy);
if(enemy.east) enemy.v.x=10; else enemy.v.x=-10; // enemy.v.x=((enemy.east) ? 10 : -10); // <-- that gave a compiler warning about implicit sign conversion. Huh?
 playsound("sounds/GLConstruct.wav", enemy.bounds.x+(0.5*enemy.bounds.width), enemy.bounds.y);
}// Villains who could stand a dose of hope.

 hits++;
}// Enemies loop.
 // Check civilians as well.
 for(uint i=0; i<map.civilians.length(); i++) {
 Char@ civ=map.civilians[i];
 if(!civ.bounds.collide(ha)) continue;

 civ.hp+=random(1, 10);
 playsound("sounds/BlueLight.wav", civ.bounds.x+(0.5*civ.bounds.width), civ.bounds.y);
 if((civ.name=="man")||(civ.name=="woman")||(civ.name=="boy")||(civ.name=="girl")||(civ.name=="police")) c.hp++;
 else if(civ.name=="GreenLantern") glfound=true;
 hits++;
 
}// Civilians.
 // And bosses.

 // And projectiles! Destroy orange projectiles!
 for(uint i=0; i<projectiles.length(); i++) {
 Projectile@ p=projectiles[i];
 if(!ha.collide(p.bounds)) continue;
 if((@(p.creator)!=null)&&((p.creator.name=="Larfleeze")||(p.creator.name=="OrangeLanternConstruct")||(p.creator.name=="BlackLantern"))) {p.hits=0;
 projectiles.remove_at(i);
 playsound("sounds/GLConstructBroken.wav", p.bounds.x+(0.5*p.bounds.width), p.bounds.y);
}

}// Projectiles.


 // Heal if hits are low enough.
 if(hits<random(1, 7)-difficulty) c.hp+=random(1, 10);


// Shoot lasers if a GreenLantern was found.
 // I guess that'd only happen on Oa, huh?
 if(glfound) {
 string s2=c.skills[c.skill];
 c.skills[c.skill]="laser";
 c.mp++;
 c.act();
 c.counter=0; c.skills[c.skill]=s2;
}// Meh. 

 c.mp--;
}// You have the power for it.
}// BlueLight.
 else if(s=="inertia amplifier") {
 Rectangle@ ha=newRectangle(c.bounds.x-0.5, c.bounds.y-0.5, c.bounds.width+1, c.bounds.height+1);
 for(uint i=0; i<=map.enemies.length(); i++) {
 Char@ enemy=((i<map.enemies.length()) ? map.enemies[i] : map.boss);
 if(@enemy==null) continue;
 if(!ha.collide(enemy.bounds)) continue;
 enemy.v.x/=2; enemy.speed/=2; enemy.aspeed*=2;
 enemy.jump*=0.5;
 playsound("sounds/vibration.wav", enemy.bounds.x+(0.5*enemy.bounds.width), enemy.bounds.y);

}// Enemies loop.

 c.counter=-0.5;
}// Inertia amplifier.
 else if((s=="possess")&&(@c==@me)) {

 bool found=false;
 @backup=me;

 // Give priority to civilians.
 for(uint i=0; i<map.civilians.length(); i++) {
 if(map.civilians[i].bounds.collide(me.bounds)) {
 @me=map.civilians[i];
 found=true;
 me.hp+=me.stamina*random(1, 4);
 voice.speak_interrupt_wait("Possessed " + me.name + "!");
 playsound("sounds/lightningcharge.wav", backup.bounds.x+(0.5*backup.bounds.width), backup.bounds.y+5);
 me.mp+=me.stamina*random(1, 3);
 map.civilians.remove_at(i); i=map.civilians.length();
 backup.levels[0]=1; // 1 means civilian, 2 means enemy.
}// Found.
}// Civilians.

 // Then enemies.
 if(!found)  for(uint i=0; i<map.enemies.length(); i++) {
 if(map.enemies[i].bounds.collide(me.bounds)) {
 @me=map.enemies[i];
 backup.levels[0]=2;
 map.enemies.remove_at(i);
 me.hp+=backup.stamina; me.mp+=backup.stamina;
 voice.speak_interrupt_wait("Possessed " + me.name + "!");
 playsound("sounds/lightningcharge.wav", backup.bounds.x+(0.5*backup.bounds.width), backup.bounds.y+5);
 i=map.enemies.length(); found=true;
}// Possessing enemy.
}// Possess enemies.
 // Bosses are not usually allowed.

 if(!found) {voice.speak_interrupt("There is no body close enough to possess."); @backup=null;}
 if(@backup==@me) {@backup=null;}
 possessiontimer.restart(); possessiontimer.resume();
}// Deadman possesses people.
 }// Action complete.
 }// Herm...

 bool superspeed=((me.skill>=0)&&(me.skill<me.skills.length())&&(me.skills[me.skill]=="extra speed"));
 if(superspeed) {me.mp-=0.01*dt; if(me.mp<=0) {me.mp=0; me.skill=0;}}
 }// Step Char.

 Char@ backup=null; // For deadman.
 timer possessiontimer;

 bool damage(Char@ targ, double dmg, string hitsound, string blocksound) {
 if(@targ==null) return false; // This... what?
 // Generally?
 string s="";
 if((targ.skill>=0)&&(targ.skill<targ.skills.length())) s=targ.skills[targ.skill];
 else if(@(targ.holding)!=null) s=targ.holding.name;
 if((targ.counter>0.0)&&((s=="shield")||(s=="wingshield")||((s=="vibration")&&(random(0, 5)>=difficulty)))) {
 playsound(blocksound, targ.bounds.x+(0.5*targ.bounds.width), targ.bounds.y);
 return false;
}// Block?
 else if( (targ.counter>0.0)&&(targ.counter<0.5*targ.aspeed)&&((s=="hephaestus")||(s=="mace")||((s=="fists")&&(targ.name=="WonderWoman")))) {
 if((s=="hephaestus")||(s=="sword")) playsound("sounds/sword_block" + random(1, 4) + ".wav", targ.bounds.x+(0.5*targ.bounds.width), targ.bounds.y);
 playsound(blocksound, targ.bounds.x+(0.5*targ.bounds.width), targ.bounds.y);
 return false;

}// Blocked, sorta.

 targ.hp-=(targ.endurance==0) ? 2.0*dmg : dmg/targ.endurance; // Is that how it works?
 playsound(hitsound, targ.bounds.x+(targ.bounds.width*0.5), targ.bounds.y);
 playsound("voices/" + targ.name + "/hit" + random(1, 3) + ".wav", targ.bounds.x+(targ.bounds.width*0.5), targ.bounds.y);
 return true;
 }// Hit people.

void hitObj(Object@ o, double dmg, string skill) {

 if(o.collectable) {
 o.bounds.x+=random(-dmg, dmg); 
o.bounds.y+=random(-dmg, dmg);
 if(o.slot>=0) pool.update_sound_2d(o.slot, o.bounds.x, o.bounds.y);
 }// Move collectable objects to somewhere nicer.
 if(!o.solid) {

}// What'cha gonna do?
 else {
 if(dmg>random(7, 18)) {
 int area=o.bounds.width*o.bounds.height; // For the sound.
 if(o.name=="armory") {
 Rectangle@ old=o.bounds; o.bounds=newRectangle(old.x-1.5, old.y-1.5, old.width+3, old.height+3);
 for(uint i=0; i<map.civilians.length(); i++) {
 if(o.collide(map.civilians[i].bounds)) {map.civilians[i].hp+=random(0, 10); map.civilians[i].mp+=random(0, 10);
 for(uint j=0; j<map.civilians[i].levels.length(); j++) map.civilians[i].levels[j]+=random(0, 10);
} }// Civilians benefit.
 if((@me!=null)&&(o.collide(me.bounds))) {
 me.hp+=random(15, 70); // Increased because the odds of getting crushed afterward are pretty high.
 me.mp+=random(5, 20);
 for(uint j=1; j<me.levels.length(); j++) me.levels[j]+=random(0, 10);
 }// And me too.
 @(o.bounds)=old;
}// Broken armory.
 o.name="destroyed " + o.name;
 if(o.slot>=0) {pool.destroy_sound(o.slot); o.slot=-1;}
int dx=random(-1, 1);
 int dy=random(-1, 1);
 string toplay="buildingfall";
 if(area<=3) toplay="shatter";
 else /*if(area<=16)*/ toplay="crash";

 int camX=0; int camY=0;
 if(@me!=null) {camX=me.bounds.x+(0.5*me.bounds.width); camY=me.bounds.y;}
 pool.play_extended_2d("sounds/" + toplay + random(1, 4) + ".wav", camX, camY, o.bounds.x, o.bounds.y, 0, o.bounds.width, 0, o.bounds.height, false, 0, 0, 0, random(95, 105));
 // Figure out if it needs to move, and if so, what can stop it once it's started.
 o.loop=true; // Because bouncing buildings is just silly.
 o.v.x+=dx*dmg/area;
 o.v.y+=dy*dmg/area;
 // And what sound it makes. Fire is good, usually.
 o.slot= pool.play_extended_2d("sounds/fire" + random(1, 3) + ".wav", camX, camY, o.bounds.x, o.bounds.y, 0, o.bounds.width, 0, o.bounds.height, true, 0, 0, -10, random(95, 105));
 bool found=false;
 for(uint i=0; i<movers.length(); i++) {if(@(movers[i])==@o) found=true;}
 if(!found) movers.insert_last(o);
 }// Break it.
 }// Try to break things.

 }// Hit objects.
 int number_pressed() {
// string n=get_characters();
// int ret=string_to_number(n);
// if((ret==0)&&(n!="0")) ret=-1;
 int ret=-1;
 if(key_pressed(KEY_0)) ret=0;
 else if(key_pressed(KEY_1)) ret=1;
 else if(key_pressed(KEY_2)) ret=2;
 else if(key_pressed(KEY_3)) ret=3;
 else if(key_pressed(KEY_4)) ret=4;
 else if(key_pressed(KEY_5)) ret=5;
 else if(key_pressed(KEY_6)) ret=6;
 else if(key_pressed(KEY_7)) ret=7;
 else if(key_pressed(KEY_8)) ret=8;
 else if(key_pressed(KEY_9)) ret=9;
 return ret;
 }// Number pressed.
 Projectile@[] projectiles;
 void addProjectile(Projectile@ p) {
 if(@p==null) return;
 double camX=0; double camY=0;
 if((@me!=null)&&(@(me.bounds)!=null)) {camX=me.bounds.x+(me.bounds.width*0.5); camY=me.bounds.y;}

 p.slot=pool.play_2d(p.snd, camX, camY, p.bounds.x+(0.5*p.bounds.width), p.bounds.y, true);
 projectiles.insert_last(p);
 if(@(p.creator)!=null) @(p.container)=p.creator.inside;
 if(@(p.creator)==@me) {
  if(key_down(KEY_DOWN)) {
 @(p.bounds)=p.bounds.rotate();
 double vx=p.v.x; double vy=p.v.y;
 p.v.y=-absolute(vx);
 p.v.x=vy;

}// down
 else if(key_down(KEY_UP)) {
 @(p.bounds)=p.bounds.rotate();
 double vx=p.v.x; double vy=p.v.y;
 p.v.y=absolute(vx);
 p.v.x=vy;

 }// Up.
 }// Aiming.
 else if((@map!=null)&&(@(map.boss)!=null)&&(@(p.creator)==@(map.boss)) &&(@me!=null)) {

 if(me.bounds.y<map.boss.bounds.y) {
 @(p.bounds)=p.bounds.rotate();
 double vx=p.v.x; double vy=p.v.y;
 p.v.y=-absolute(vx);
 p.v.x=vy;

}// down
 else if(me.bounds.y>map.boss.bounds.y) {
 @(p.bounds)=p.bounds.rotate();
 double vx=p.v.x; double vy=p.v.y;
 p.v.y=absolute(vx);
 p.v.x=vy;

 }// Up.

}// Bosses can aim, too!
}// add Projectile.
int AICounter=0;
 Rectangle@ org=null;
timer lagtimer;
 void loglagMSG(string msg, double time) {
 if(!laglog.active) laglog.open("laglog.txt", "a");
laglog.write("\n" + msg + ": " + time + "\r");

}
 string[] msgs; int[] times;
 void loglag(string msg, int time) {msgs.insert_last(msg); times.insert_last(time);}

 bool contains(Rectangle@ r, float x, float y) {
 return ((x>=r.x)&&(x<=r.x+r.width)&&(y>=r.y)&&(y<=r.y+r.height));
 }// Contains.
