 o.name="destroyed control panel"; o.v.x=random(-10, 10); o.v.y=random(-10, 10); movers.insert_last(o); o.snd="sounds/fire" + random(1, 3) + ".wav"; o.slot=-1;
 if(map.enemies.length()<=50) {bonuses|=128;
 voice.speak_interrupt("Red power battery? Here?");}

}// Unlock Atrocitus.
}// Done, check for red lantern ring.

}// control panels on Oa.
else if(o.canEnter) {
 // Oh, wait! We need to make sure we aren't colliding with any non-enterable objects at the same z.
 bool yeah=true;
 for(uint j=0; j<map.objects.length(); j++) {
 if((map.objects[j].solid)&&(map.objects[j].z==o.z)&&(!map.objects[j].canEnter)&&(me.bounds.collide(map.objects[j].bounds))) yeah=false;
}
 if(yeah) {
 if(@(me.inside)==null) {@(me.inside)=o;
 playsound("sounds/steps/" + me.inside.terrain + "/run" + random(1, 6) + ".wav", me.bounds.x+(me.bounds.width*0.5), me.bounds.y);
}// Yeah?
 else {

 if((me.bounds.y<map.bounds.y)&&(@(me.inside)!=@o)) {@(me.inside)=o; pool.play_stationary("sounds/steps/" + o.terrain + "/run" + random(1, 5) + ".wav", false); return;}
 if((@(me.inside)==@o)&&(o.name=="water")&&(me.bounds.y<map.bounds.y-me.bounds.height)) {
 voice.speak_interrupt("You aren\'t close enough to the surface!");
 }// Do not escape that easily.
 else {@(me.inside)=null; playsound("sounds/steps/" + map.terrain + "/run" + random(1, 6) + ".wav", me.bounds.x+(me.bounds.width*0.5), me.bounds.y);}}
 if(me.bounds.y<map.bounds.y) {
// clipboard_copy_text("Underground");
 if((i>=1)&&(me.bounds.collide(map.objects[i-1].bounds))&&(map.objects[i-1].canEnter)) {
 @(me.inside)=map.objects[i-1];
 playsound("sounds/steps/" + me.inside.terrain + "/run" + random(1, 6) + ".wav", me.bounds.x+(0.5*me.bounds.width), me.bounds.y);
 clipboard_copy_text("Previous.");
 return;
 }// Try the previous object.

 else if((i<map.objects.length()-2)&&(me.bounds.collide(map.objects[i+1].bounds))&&(map.objects[i+1].canEnter)) {
 clipboard_copy_text("next");
 @(me.inside)=map.objects[i+1];
 playsound("sounds/steps/" + me.inside.terrain + "/run" + random(1, 6) + ".wav", me.bounds.x+(0.5*me.bounds.width), me.bounds.y);
