 timer taunttimer;
int ledge1=-1, ledge2=-1;
Object@[] movers; // Hopefully this can speed up the moving objects code? Though I'm not convinced it will make a uge difference.
Object@[] solids; // Considering how many of these there tend to be, it probably won't help much, but might as well.

 uint countBonuses() {
 uint count=0;
 for(uint i=0; i<=16; i++) {
 if( (bonuses&(1<<i))!=0) count++;
}
 return count;
}