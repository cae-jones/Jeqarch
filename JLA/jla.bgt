 @map=temp;
 map.atmosphere="day";
 // Lex Luthor obviously needs a tower his own with secret stuffs.
 @o=newObject("Lex Corp Tower", newRectangle(random(15, 100), 0, 20, 30));
 o.z=2; o.canEnter=false; o.solid=true;
 o.weightless=true;
 map.objects.insert_last(o);
 Object@ tower=o;
 @o=newObject("security door", newRectangle(0, 0, 1, 20));
 o.z=1;
 o.solid=true;
 Object@ f=newObject("Tower Room", newRectangle(0, 0, 5, 1));
 f.solid=true; f.weightless=true;
 string[] ls={"fists", "pistol", "uzi", "laser", "shield", "rocket", "summon"};
 @enemy=newChar("LexLuthor", ls, 100);
 for(uint i=0; i<enemy.skills.length(); i++) enemy.levels[i]=random(10, 50);
 enemy.mp=random(20, 100);
 // Now, build the tower,
 for(uint i=0; i<20; i++) {
 Object@ s=o.clone();
 s.bounds.x=random(tower.bounds.x, tower.bounds.x+tower.bounds.width);
 s.bounds.y=random(tower.bounds.y+10, tower.bounds.y+tower.bounds.height);
 map.objects.insert_last(s);
 @s=f.clone();
 s.bounds.x=random(tower.bounds.x, tower.bounds.x+tower.bounds.width);
 s.bounds.y=random(tower.bounds.y+10, tower.bounds.y+tower.bounds.height);
 map.objects.insert_last(s);

 // And lots of robots and mercs.
 Char@ es=newChar("Mercinary");
 es.bounds.x=random(tower.bounds.x, tower.bounds.x+tower.bounds.width);
 es.bounds.y=random(tower.bounds.y+10, tower.bounds.y+tower.bounds.height);
 map.enemies.insert_last(es);
 @es=newChar("robot", rs);
 es.bounds.x=random(tower.bounds.x, tower.bounds.x+tower.bounds.width);
 es.bounds.y=random(tower.bounds.y+10, tower.bounds.y+tower.bounds.height);
 map.enemies.insert_last(es);


 }// Build the tower.
 // Add an access card,
 Object@ card=newObject("access card", newRectangle(random(map.bounds.x, tower.bounds.x+tower.bounds.width+1), 0, 0.25, 0.25));
 card.solid=false; card.snd="sounds/beacon.wav";
 card.collectable=true;
 card.bounds.x=random(tower.bounds.x-10, tower.bounds.x+tower.bounds.width+10);
 card.bounds.y=random(tower.bounds.y, tower.bounds.y+tower.bounds.height);
 map.objects.insert_last(card);

 // And finally, put Lex in a safe place that he's not likely to stumble out of. Meaning surrounded by security doors.
 enemy.bounds.x=random(tower.bounds.x+1, tower.bounds.x+tower.bounds.width-1);
 enemy.bounds.y=random(tower.bounds.y+15, tower.bounds.y+tower.bounds.height-2);
 map.enemies.insert_last(enemy);
 o.bounds.x=enemy.bounds.x-2; o.bounds.y=enemy.bounds.y-1; map.objects.insert_last(o.clone());
 @o=o.clone();
 o.bounds.x=enemy.bounds.x+2; o.bounds.y=enemy.bounds.y-1; map.objects.insert_last(o);
 @f=f.clone(); f.bounds.x=enemy.bounds.x-2; f.bounds.y=enemy.bounds.y-1; map.objects.insert_last(f);



 // But I think throwing in Superman's rogues as enemies is better.
 // Metallo and bizarro specifically. Maybe bizarro is the boss?
