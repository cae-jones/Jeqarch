 o.terrain="water";
 map.objects.insert_last(o);
o.solid=false;
 // Add fish and stuff.
 string[] ss={"fists", "chomp", "knife", "chomp"};
 string[] os={"fists", "lasso", "smokescreen"};
 string[] ws={"fists", "chomp", "telepathy", "lasso"};

 for(uint i=0; i<5; i++) {
 @civ=newChar("fish");
 civ.hp=random(3, 25);
 civ.speed+=random(1, 3);
 @(civ.inside)=o;
 civ.bounds.x=random(o.bounds.x, o.bounds.x+o.bounds.width-1);
 civ.bounds.y=random(o.bounds.y, o.bounds.y+o.bounds.height-1);
 civ.bounds.width=1; civ.bounds.height=0.5;
 map.civilians.insert_last(civ);
 @civ=newChar("fish");
 civ.hp=random(3, 25);
 civ.speed+=random(1, 3);
 @(civ.inside)=o;
 civ.bounds.x=random(o.bounds.x, o.bounds.x+o.bounds.width-1);
 civ.bounds.y=random(o.bounds.y, o.bounds.y+o.bounds.height-1);
 civ.bounds.width=1; civ.bounds.height=0.5;
 map.civilians.insert_last(civ);

 @civ=newChar("shark", ss, random(10, 50));
 civ.speed+=random(1, 3);
 @(civ.inside)=o;
 civ.bounds.width=3; civ.bounds.height=1;
 civ.bounds.x=random(o.bounds.x, o.bounds.x+o.bounds.width-civ.bounds.width);
 civ.bounds.y=random(o.bounds.y, o.bounds.y+o.bounds.height-civ.bounds.height);
 civ.strength+=random(1, 3);
 civ.endurance++;
  civ.mp+=10;
 map.civilians.insert_last(civ);


 @civ=newChar("octapus", os, random(1, 50));
 civ.speed+=random(1, 3);
 @(civ.inside)=o;
 civ.bounds.x=random(o.bounds.x, o.bounds.x+o.bounds.width-1);
 civ.bounds.y=random(o.bounds.y, o.bounds.y+o.bounds.height-1);
 civ.bounds.width=random(1, 2); civ.bounds.height=random(1, 2);
 map.civilians.insert_last(civ);


 }// Sea creatures.
 @civ=newChar("whale", ws, 100);
 civ.bounds.width=5; civ.bounds.height=3;
 civ.strength+=random(1, 4);
 civ.endurance+=random(1, 3);
 civ.speed+=random(0, 3);
 @(civ.inside)=o;
 civ.bounds.x=random(o.bounds.x, o.bounds.x+o.bounds.width-civ.bounds.width);
 civ.bounds.y=random(o.bounds.y, o.bounds.y+o.bounds.height-civ.bounds.height);

 // And maybe there's a plane flying above with Cheeta on it.
 // Or a submarine.
 @o=newObject("submarine", newRectangle(random(map.bounds.x-100, map.bounds.x), random(-45, 0), 7, 3));
 o.solid=true;
 o.z=1;
 o.canEnter=true;
 o.terrain="steel";
 o.snd="sounds/submarine.wav";
 o.solid=false; // Feh.
 map.objects.insert_last(o);

string[] cs={"fists", "knife", "hook-hand", "chomp"};
 @enemy=newChar("Cheeta", cs, 100);
 enemy.bounds.x=random(o.bounds.x, o.bounds.x+o.bounds.width-enemy.bounds.width); enemy.bounds.y=o.bounds.y;
 @(enemy.inside)=o;
 enemy.counter=-5;
 enemy.mp+=random(10, 25);
 enemy.speed=random(5, 8);
 enemy.strength=random(2, 5);
 enemy.endurance+=random(0, 2);
 enemy.aspeed=random(10, 30)*0.01;
 enemy.jump+=random(1, 3);
 map.enemies.insert_last(enemy);
}; break;
