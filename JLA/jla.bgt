default : {
 // Something completely random that incorporates something for everyone.
 }// Default.

 }// Stage switch for initializing.
 adjust(map);
 pool.update_listener_2d(-10, 10); // Cars are loud.
  if(@map!=null) map.bgm=bgms[ret];
 return ret;
}// Stage select.

 void adjust(Map@ m) {
 if(@m==null) return;
 pool.destroy_all(); // Avoid redundant sounds.
 // Adjust sizes, placement, and stats for civilians and enemies.
 for(uint i=0; i<m.enemies.length(); i++) {
 Char@ enemy=m.enemies[i];
if(absolute(enemy.bounds.x-m.start.x)<=2*enemy.bounds.width) enemy.bounds.x=random(m.bounds.x, m.bounds.width+m.bounds.x);
 if((enemy.name=="mobster")||(enemy.name=="Mobster")) { enemy.canFly=false; enemy.jump+=random(1, 5);
 enemy.hp=random(5, 25);
if(enemy.endurance>2) enemy.endurance=2;
 if(enemy.levels.length()<5) enemy.levels.resize(5); 

 enemy.levels[0]=1; enemy.levels[1]=random(-1, 1); enemy.levels[2]=random(-1, 1); enemy.levels[3]=random(-5, 16); enemy.levels[4]=random(-10, 25);
 if(enemy.levels.length()>5) enemy.levels[5]=random(1, 30);
 }// mobsters.
 else if((enemy.name=="mercinary")||(enemy.name=="Mercinary")) {
 if(stage<=10) enemy.canFly=false; enemy.jump+=random(1, 5);
 enemy.hp=random(10, 30);
 string[] s2={"fists", "pistol", "uzi", "knife", "grenade", "rocket"};
 enemy.skills=s2;
 enemy.levels.resize(s2.length());
 enemy.levels[0]=1;
 for(uint i=1; i<enemy.levels.length(); i++) {enemy.levels[i]=random(0, 10);}
 enemy.levels[2]=random(-40, 100);

 }// mercinaries.
 else if(enemy.name=="Amazon") { enemy.canFly=false; enemy.jump+=random(2, 7);
 enemy.hp=random(10, 50);
 enemy.levels[1]=1; enemy.levels[2]=random(-4, 15);
 enemy.strength++; enemy.endurance++; enemy.speed++;
 }// Amazons.
 else if(enemy.name=="robot") {
 for(uint i=0; i<enemy.levels.length(); i++) enemy.levels[i]=random(10, 50);
 enemy.hp=random(5, 65);

 }// Robots.
 else if(enemy.name=="living plant") { enemy.canFly=(stage>=11);
 for(uint js=0; js<enemy.levels.length(); js++) {enemy.levels[js]+=random(5, 40);}
 enemy.mp+=random(5, 30);
 enemy.strength++; enemy.endurance*=0.01*random(25, 250);
 enemy.bounds.height++;
}// plant.
else if(string_contains(enemy.name, "Lantern", 1)>0) {
 enemy.mp+=random(difficulty, 20);
 enemy.canFly=true;
}// Lanterns.
else {for(uint js=0; js<enemy.levels.length(); js++) {enemy.levels[js]+=random(1, 10); } enemy.mp+=random(1, 10);}
if(enemy.ranges.length()!=enemy.skills.length()) {enemy.ranges.resize(enemy.skills.length()); for(uint r=0; r<enemy.ranges.length(); r++) enemy.ranges[r]=guessRange(enemy.skills[r]);}
 }// Enemies.
 for(uint i=0; i<m.civilians.length(); i++) {
 Char@ civ=m.civilians[i];
 if(civ.name=="police") {
 civ.skills.resize(4);
 civ.skills[0]="fists"; civ.skills[1]="pistol"; civ.skills[2]="uzi"; civ.skills[3]="grenade";
 civ.levels.resize(civ.skills.length());
 civ.levels[0]=1; civ.levels[1]=random(3, 16); civ.levels[2]=random(0, 24); civ.levels[3]=random(-1, 3);

 }// Police.
 else if((civ.name=="boy")||(civ.name=="girl")) {
 civ.bounds.width=0.5; civ.bounds.height=1.0;
 civ.strength=random(1, 20)*0.1;
} // Children
 else if((civ.name=="tweens")||(civ.name=="teenagers")) {civ.bounds.width=random(5, 10)*0.1; civ.bounds.height=random(10, 20)*0.1; civ.strength-=random(0, 15)*0.1;}
 else if(civ.name=="Amazon") {
 civ.hp=random(10, 50);
 civ.levels[1]=1; civ.levels[2]=random(-4, 15);
 civ.endurance++; civ.strength++; civ.speed++;
 }// Amazons.

 // Do something for fish and such. Later.
 }// Civilians.


// Objects.
 movers.resize(0); movers.reserve(map.objects.length());
 solids.resize(0); solids.reserve(map.objects.length());
 for(uint i=0; i<map.objects.length(); i++) {
 Object@ o=map.objects[i];
 if(o.solid) solids.insert_last(o);
 if(o.snd!="") {
 o.slot=pool.play_extended_2d(o.snd,
 map.start.x, map.start.y,
 o.bounds.x, o.bounds.y,
 0, o.bounds.width, 0, o.bounds.height,
 true, 0,
 0, 0, ((o.z==2) ? 95 : 100)
);
 }// Sound.
 if((o.v.x!=0)||(o.v.y!=0)) {
 movers.insert_last(o);
 while(absolute(o.bounds.x-m.start.x)<=2*o.bounds.width) o.bounds.x=random(m.bounds.x, m.bounds.x+m.bounds.width);

 }// Moving objects.
 }// Objects.

 }// Adjust map.
