 for(uint i=0; i<map.enemies[i].levels.length(); i++) {map.enemies[i].levels[i]+=random(1, 10);}
 playsound("sounds/blacklantern.wav", map.enemies[i].bounds.x+(map.enemies[i].bounds.width*0.5), map.enemies[i].bounds.y);
}// Black Lantern.
 else map.enemies.remove_at(i);
}// Death.
 else if((AICounter==i)&&(map.enemies[i].counter==0)&&(random(0, 4)<=difficulty)) {

 if((taunt==i)||(
taunt%(map.enemies.length()/4)==i%(map.enemies.length()/4)
)) playsound("voices/" + map.enemies[i].name + "/taunt" + random(1, 5) + ".wav", map.enemies[i].bounds.x+(0.5*map.enemies[i].bounds.width), map.enemies[i].bounds.y);
 // Depending on the enemy, they might want to target civilians, or maybe just the hero.
 // Also depends on the stage.
 Char@ enemy=map.enemies[i];
 if((stage==1)&&(enemy.name=="KillerCroc")&&((@(enemy.inside)==null)||(enemy.bounds.y>=map.bounds.y))) {
 enemy.bounds.y=-40;
 enemy.bounds.x=random(0, 90);
for(int j=map.objects.length()-1; j>=0; j--) {
 if(map.objects[j].name=="sewer") {@(enemy.inside)=map.objects[j]; j=-1; enemy.counter=-5;}
 }// Get in there and stay in there!!!
 clipboard_copy_text("Killer Croc Escape! " + AICounter);
 }// Get back in the sewer!
 else if((stage==4)&&(@(enemy.inside)==null)&&(enemy.name=="Cheeta")) {
 for(uint oj=map.objects.length()-1; oj>=0; oj--) {
 if((oj>=map.objects.length())||(oj<0)) continue; // WTF?
 if(map.objects[oj].name=="submarine") {@(enemy.inside)=map.objects[oj]; oj=0; enemy.bounds.x=enemy.inside.bounds.x; enemy.bounds.y=enemy.inside.bounds.y; enemy.counter=-5; enemy.v.x=0; enemy.v.y=0;
 clipboard_copy_text("Cheeta left the submarine, " + AICounter + ". ");
}// Get in, and stay in!
}// Find that submarine.

}// Get back in the Submarine!

 Char@ closest=me;
 vector dv(enemy.bounds.x-me.bounds.x, enemy.bounds.y-me.bounds.y);
