#include "classes.bgt"
#include "custom_voice.bgt"
#include "sound_pool.bgt"
#include "custom_menu.bgt"


/* 
 (For reference, whenever I get around to recording)
The Blackest Night falls from the skies,
The darkness grows as all light dies,
We crave your hearts and your demise,
By my black hand, the dead shall rise!
*/

custom_voice voice("voice.cfg");
 sound_pool pool(500);
file laglog;
 bool llog=false;
 uint maxLevel=0;
 int stage=-1;
 float BGMVolume=-10;
 int difficulty=1;
 string[] difs={"easy", "normal", "hard", "superhuman"};
 Map@ map=null;
 sound bgm;
 string curbgm="";
 float emergencySpeed=0;
 uint spread=4; // LAG MUST DIE!

 void playsong(string fn) {
 if(curbgm==fn) {bgm.play(); bgm.volume=BGMVolume;}
 else {bgm.stop(); bgm.load(fn); curbgm=fn; bgm.volume=BGMVolume; bgm.play();}
}// playsong.
 void fadeOut(double delay) {
 while(bgm.playing) {
 bgm.volume=bgm.volume-1;
 if(bgm.volume<=-50) bgm.stop();
 wait(delay);
 }// loop.

}// Fade out.
 void fadeIn(string fn, double delay) {
 float b2=BGMVolume;
 BGMVolume=-50;
 playsong(fn);
 BGMVolume=b2;
 while(bgm.volume<BGMVolume) {bgm.volume=bgm.volume+1;
 wait(delay);
 }// loop.
 }// fade in

 string[] menu={
 "play game", "help", "voice options", "music volume", "difficulty", "echoes", "exit"};
 int menuX=-1;

void systemKeys() {
 if(((key_down(KEY_LMENU))||(key_down(KEY_RMENU)))&&(key_pressed(KEY_F4))) { save_exit();}
else if((key_pressed(KEY_LCONTROL))||(key_pressed(KEY_RCONTROL))) voice.stop();
 else if(key_pressed(KEY_PRIOR)) {BGMVolume++; if(BGMVolume>0) BGMVolume=0; bgm.volume=BGMVolume;}
 else if(key_pressed(KEY_NEXT)) {BGMVolume--; if(BGMVolume<-100) BGMVolume=-100; bgm.volume=BGMVolume;}
 else if(key_pressed(KEY_F5)) voice.options_menu();
 else if(key_pressed(KEY_O)) {
 if(@map==null) voice.speak_interrupt("No map loaded");
 else voice.speak_interrupt("There are " + map.objects.length() + " objects, " + map.enemies.length() + " enemies, and " + map.civilians.length() + " civilians.");
}// Debug data.
 else if(key_pressed(KEY_F2)) {
//emergencySpeed=(emergencySpeed==0) ? 100 : 0; voice.speak_interrupt("Emergency speed is " + emergencySpeed);
 string inp=input_box("Emergency speed", "Enter emergency speed");
 if(inp!="") {
 emergencySpeed=string_to_number(inp);
 voice.speak_interrupt("Emergency speed set to " + emergencySpeed + ". ");
}
 else voice.speak_interrupt("Canceled");
}
// else if(key_pressed(KEY_F3)) {llog=!llog; voice.speak_interrupt("Performance will " + ((!llog) ? "not " : "") + "be recorded.");}
 else if(key_pressed(KEY_F3)) {
 string inp=input_box("Step spread", "Enter step spread. The number of characters being stepped each frame will be divided by this value.");
 if(inp!="") {
 spread=string_to_number(inp);
 if(spread<1) spread=1;
 voice.speak_interrupt("Spread set to " + spread + ". ");
 }
 else voice.speak_interrupt("Canceled.");
 }// Step spread.
 else if(key_pressed(KEY_F1)) {
 pool.play_stationary("sounds/menu/submenu.wav", false);
 voice.speak_interrupt("Control list");
 controlList.run(pool, voice, curbgm);
 pool.play_stationary("sounds/menu/cancel.wav", false);
}// Control menu help.
}// SystemKeys.

 void save() {
string txt="" + maxLevel + "\n" + BGMVolume + "\n" + difficulty + "\n" + bonuses + "\n";
 file fout; fout.open("progress.ini", "w"); fout.write(txt); fout.close();
}// Save.
 void save_exit() {
// generate_profile("profile.dat");
/*
 string txt="--- stores data regarding the time required by each element of the code. Toggle this feature by pressing F3.\n";
// alert("Logging", "Logging " + msgs.length() + " messages.");
 for(uint i=0; i<msgs.length(); i++) {
 txt += "\n" + msgs[i] + ": " + times[i] + "\r";
}
 laglog.open("laglog.txt", "w");
 laglog.write(txt);
if(laglog.active) laglog.close();
*/
 save();
 if(screen_reader_is_running(JAWS)) uninstall_keyhook();
 exit();
}// save and exit.
 void loadSettings() {
 if(!file_exists("progress.ini")) return;
 file fin; fin.open("progress.ini", "r");
 string txt=fin.read(0);
 fin.close();
 string[] parts=string_split(txt, "\n", true);
 maxLevel=string_to_number(parts[0]);
  BGMVolume=string_to_number(parts[1]);
 difficulty=string_to_number(parts[2]);
 bonuses=string_to_number(parts[3]);
 }
 bool echo_on=true; // For echoes.
 Menu mainmenu, controlList, help;
void main() {
// start_profiling();
 show_game_window("Justice League belongs to DC. Game by C. A. E. Jones.");
 playsong("music/justiceleague.ogg");
 pool.volume_step=2;
// pool.pan_step=2;
 pool.max_distance=35;
 voice.speak_interrupt("Justice League, audio game by C A E Jones. Characters and concepts are from DC.");
 if(screen_reader_is_running(JAWS)) install_keyhook();
 pool.behind_pitch_decrease=4;
loadSettings();
 laglog.open("laglog.txt", "w");
 laglog.write("--- stores data regarding the time required by each element of the code. Toggle this feature by pressing F3.\n");
 laglog.close();
 msgs.reserve(1000); times.reserve(1000);

 mainmenu.items=menu;
 mainmenu.select="sounds/menu/select.wav";
 controlList.select=mainmenu.select;
 help.select=mainmenu.select;
 string[] controls={"Jump, or fly up: up arrow", "crouch, or fly down: down arrow", "left: left arrow", "right: right arrow", "attack, or use item: spacebar", "interact or pick up item: enter", "select power or item: 1-9", "hold shift while moving to move faster", "look: hold alt and press a direction", "look in bounds: alt+space", "Hear ammo: A", "hear health: H", "hear coordinates: C", "Hear power: P", "Hear current skill or item: S", "Voice options: F5", "Control list: F1", "Pause / main menu: Escape"};
 controlList.items=controls;
 help.add("Press escape to return to main menu.");
 help.add("This game is a 2D sidescroller. Use the arrow keys to navigate menus or select your character, or to move your character while in-game.");
 help.add("While in menus, the enter, or spacebar keys will activate the currently selected item. In the case of character selection, this will have you enter the game with the selected character. Pressing escape will attempt to close or cancel a menu.");
 help.add("The game consists of several levels, each constructed randomly based on a certain theme. Levels are cleared by either defeating that level\'s boss, or by reaching the exit.");
 help.add("Clearing some levels will unlock new heroes that you can use in-game. You can also play levels that you\'ve already cleared with the unlocked heroes. Your progress is automatically saved when a level is cleared or you exit the game.");
 help.add("Your goals will vary from level to level, but as a general rule, you want to defeat enemies (the ones that make threatening remarks and/or attack people) and protect civilians (the ones screaming for help and/or going about their business).");
 help.add("Each character has a variety of skills. You can select which skill to use with the number row--pressing 1 usually sets you to using fists, for example. Press space to use the selected skill.");
 help.add("Some skills have limited ammo, or draw on your power reserves. You can check these with the A and P keys.");
 help.add("There will be times in which you need to interact with your environment in a more direct way, such as collecting items, moving or talking to civilians, or hiding in dark alleys. Most of these can be accomplished by pressing enter.");
 help.add("For a complete list of controls, press F1.");
 while(voice.speaking()) {
 systemKeys();
  int[] keys=keys_pressed();
 if(keys.length()>0) voice.stop(); //????
 wait(50);
}// Meh, silly intro.
 bool needsay=true;
 while(true) {
 systemKeys();

 if(@map==null) {
 if(needsay)  voice.speak_interrupt("Main menu");
int mx=mainmenu.run(pool, voice, "music/justiceleague.ogg");
 needsay=true;
 switch (mx) {
 case 0 : {
 pool.play_stationary("sounds/menu/submenu.wav", false);
 stage=selectStage();
}; break;
 case 1 : {
 pool.play_stationary("sounds/menu/submenu.wav", false);
 voice.speak_interrupt("Press down arrow to read help.");
help.run(pool, voice, curbgm);
 pool.play_stationary("sounds/menu/cancel.wav", false);
}; break;
 case 2 : {
  pool.play_stationary("sounds/menu/activate.wav", false);
voice.options_menu();
 pool.play_stationary("sounds/menu/cancel.wav", false);
}; break;
 case 3 : {
 pool.play_stationary("sounds/menu/activate.wav", false);
 if((key_down(KEY_LSHIFT))||(key_down(KEY_RSHIFT))) {
 BGMVolume+=10; if(BGMVolume>=0) BGMVolume=0;
}
 else {
 BGMVolume-=10; if(BGMVolume<=-100) BGMVolume=-100;
 }
 bgm.volume=BGMVolume;
 needsay=false;
}; break;
 case 4 : {
 pool.play_stationary("sounds/menu/activate.wav", false);
 if((key_down(KEY_LSHIFT))||(key_down(KEY_RSHIFT))) {difficulty--; if(difficulty<0) difficulty=difs.length()-1;}
 else {difficulty++; if(difficulty>=difs.length()) difficulty=0;}
 voice.speak_interrupt_wait("Difficulty set to " + difs[difficulty%difs.length()] + ". ");
 needsay=false;
}; break;
 case 5 : {echo_on=!echo_on; needsay=false;
 voice.speak_interrupt("echo " + ((echo_on) ? "on" : "off" ));
}; break;
 case 6 : save_exit(); break;
 }// mainmenu results.
}// Main menu.
 else {
 playsong("music/" + map.bgm + ".ogg");
 if((@me==null)||(me.hp<=0.0)) {

 if((@me!=null)&&(me.name=="Sinestro")&&(stage==stagenames.length()-2)) bonuses|=2048;
 if((@me!=null)&&(maxLevel>=stagenames.length())) {
 me.name="BlackLantern"; me.hp=random(10, 100); me.mp+=random(5, 20);
 for(uint i=0; i<me.levels.length(); i++) {me.levels[i]+=random(difficulty, 10*(difficulty+1));}
 map.enemies.insert_last(me);
 playsound("sounds/blacklantern.wav", me.bounds.x+(me.bounds.width*0.5), me.bounds.y);
 @me=null;
 wait(1000);
 voice.speak_interrupt("You have been killed!"); wait(1000); keys_pressed();
 pool.pause_all();
 voice.speak_interrupt_wait("You have been killed! Press enter to continue!");

while(!key_pressed(KEY_RETURN)) {wait(5);}
 pool.resume_all();
}// Black Lantern.
 if(@me!=null) {

 voice.speak_interrupt("You have been killed!"); wait(1000); keys_pressed();
 pool.pause_all();
 voice.speak_interrupt_wait("You have been killed! Press enter to continue!");

while(!key_pressed(KEY_RETURN)) {wait(5);}
 pool.resume_all();
}
selectChar();
 if(@me==null)  pool.play_stationary("sounds/menu/error.wav", false);
 else  pool.play_stationary("sounds/menu/activate.wav", false);
}
 else {
 handleKeys();
 // Joystick / mouse?

 int telapsed=t.elapsed;
 t.restart(); t.resume();

 step(telapsed+5+emergencySpeed);

 }// Mehps.
 }// In-game.

 int telapsed=t.elapsed;
 t.restart(); t.resume();
 if(telapsed<20) wait(20-telapsed);
 else loglag("Main loop is taking a while. ",  telapsed);

 }
}// Main.
timer t;

 // No idea what order we want.
