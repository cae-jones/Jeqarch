 string[] ks={"fists", "chomp"};
 @enemy=newChar("KillerCroc", ks, 100);
  enemy.bounds.width=2;
 enemy.strength+=random(2, 4);
 enemy.endurance+=random(1, 4);
  @(enemy.inside)=map.objects[map.objects.length()-3];
 enemy.bounds.x=random(map.bounds.x, map.bounds.x+map.bounds.width); enemy.bounds.y=-40;
 enemy.counter=-10;
 map.enemies.insert_last(enemy);

 // The Joker is the boss.
