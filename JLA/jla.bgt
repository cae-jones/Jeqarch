}// No point in wasting actions.
}// Keep in range, just to be vaguely fair.


 if((map.boss.name=="Darksied")&&(map.boss.hp<500)) map.boss.hp+=0.001*dt*map.enemies.length(); // He Heals so long as he has followers! Killing all the enemies makes him much! easier to defeat!R
 }// AI happens.
 if(llog) {loglag("Boss AI", lagtimer.elapsed); lagtimer.restart(); lagtimer.resume();}
 }// Boss AI.
}// Boss.
 else {
 if((absolute(map.start.x-map.bounds.x)>absolute(map.bounds.x+map.bounds.width-map.start.x))&&(me.bounds.x<map.bounds.x)) level_clear();
 else if(me.bounds.x>map.bounds.x+map.bounds.width) level_clear();
 }// Walk out victory.

lagtimer.restart(); lagtimer.resume();
 for(uint i=0; i<echoes.length(); i++) {
echoes[i].delay-=dt; if(echoes[i].delay<=0.0) {
 pool.play_2d(echoes[i].filename, camX, camY, echoes[i].x, echoes[i].y, false); // No pitch bending?
 echoes.remove_at(i);
 }// Play
}// Echoes.
 if(llog) {loglag("Updating echoes", lagtimer.elapsed); lagtimer.restart(); lagtimer.resume();}

 // Projectiles?
 for(uint i=0; i<projectiles.length(); i++) {
 Projectile@ p=projectiles[i];

 if(p.hits<=0) {
 pool.destroy_sound(p.slot);
 projectiles.remove_at(i);
 continue;
}// done hitting.


  Object@ c=p.container;
 p.bounds.x+=p.v.x*dt;
 p.bounds.y+=p.v.y*dt;

 if((p.name=="OmegaBeam")&&(@(p.creator)==@(map.boss))&&(@me!=null)) {
 p.v.x=me.bounds.x-p.bounds.x; p.v.y=(me.bounds.y+(0.5*me.bounds.height))-p.bounds.y;
 p.v.x*=0.5; p.v.y*=0.5;
}// Redirect the OmegaBeam as necessary.

 if(!p.weightless) p.v.y-=9.0*dt;
 if(p.counter>0.0) {p.counter-=dt;
 if(p.counter<=0.0) {
 if(string_right(p.name, 4)=="rang") {
 p.v.x=p.v.x*-1;
 p.v.y=p.v.y*-1;
 p.f.x=p.f.x*-1;
 p.f.y=p.f.y*-1;
 p.counter=5.0;
 }// Batarang, boomarang, etc.
 else {
 if(p.slot>=0) pool.destroy_sound(p.slot);
 projectiles.remove_at(i);
 // If it's explosive or something, do stuff.
}// Not a boomarang.
 }}// Counter above 0.
 if(p.slot>=0) pool.update_sound_2d(p.slot, p.bounds.x+(p.bounds.width*0.5), p.bounds.y);

 if((p.hits>0)&&(p.hitsPlayer)) {
 if((p.bounds.collide(me.bounds))&&(@c==@(me.inside))) {
 // This could be offset by things making players invincible. Catch those?
 if((@(p.creator)!=null)&&((me.name=="Superman")||(me.name=="Supergirl")||(me.name=="Superboy"))&&((p.creator.name=="LexLuthor")||(p.creator.name=="Metallo"))) me.endurance*=0.5;
 if((@(p.creator)!=null)&&(p.creator.name=="GreenLantern")&&(me.name=="Larfleeze")) {
 p.hits=0; p.damage=0; p.f.x=0; p.f.y=0; p.stun=0;
 playsound("sounds/GLConstructBroken.wav", p.bounds.x+(0.5*p.bounds.width), p.bounds.y);
}// Destroy it.
 if(damage(me, p.damage, p.hitsound, p.blocksound)) {
 me.counter=-p.stun/
((me.endurance==0) ? 0.5 : (me.endurance*0.5));
 me.v.x+=p.f.x/(0.5*me.endurance);
 me.v.y+=p.f.y/(0.5*me.endurance);
 }// Hit successful.
 p.hits--;

 }// Hit player.
else {
 // A blocked projectile isn't always ignored.
 // For instance, green lantern constructs can be destroyed by orange lanterns.

 }// Blocked.

 }// Try to hit player.
 if((p.hits>0)&&(p.hitsCivs)) {
 for(uint i=0; i<map.civilians.length(); i++) {
 if(p.hits<=0) {i=map.civilians.length(); continue;}
 Char@ civ=map.civilians[i];
 if((p.bounds.collide(civ.bounds))&&(@c==@(civ.inside))) {
 // This could be offset by things making players invincible. Catch those?
 if(damage(civ, p.damage, p.hitsound, p.blocksound)) {
 civ.counter=-p.stun/(
(civ.endurance==0) ? 0.5 : (civ.endurance*0.5));
 civ.v.x+=p.f.x/(0.5*civ.endurance);
 civ.v.y+=p.f.y/(0.5*civ.endurance);
 }// Hit successful.
 p.hits--;

 }// Hit player.

 }// Civ loop.
 }// hit civilians.
 if((p.hits>0)&&(p.hitsEnemies)) {
 for(uint i=0; i<map.enemies.length(); i++) {
 if(p.hits<=0) {i=map.enemies.length(); continue;}
 Char@ enemy=map.enemies[i];
 if((p.bounds.collide(enemy.bounds))&&(@c==@(enemy.inside))) {
 // This could be offset by things making players invincible. Catch those?

 if((@(p.creator)!=null)&&(p.creator.name=="GreenLantern")&&(enemy.name=="OrangeLanternConstruct")) {
 p.hits=0; p.damage=0; p.f.x=0; p.f.y=0; p.stun=0;
 playsound("sounds/GLConstructBroken.wav", p.bounds.x+(0.5*p.bounds.width), p.bounds.y);
}// Destroy it.


 if(damage(enemy, p.damage, p.hitsound, p.blocksound)) {
 enemy.counter=-p.stun/
( (enemy.endurance==0) ? 0.5 : (enemy.endurance*0.5));
 enemy.v.x+=p.f.x/(0.5*enemy.endurance);
 enemy.v.y+=p.f.y/(0.5*enemy.endurance);
 }// Hit successful.
 p.hits--;

 }// Hit player.

 }// enemies loop.

 // Boss.
 // Different bosses should react differently, ne?
 // I think Solemon Grundi should just plain deflect projectiles by chance.
 if((p.hits>0)&&(@(map.boss)!=null)) {
 if((p.bounds.collide(map.boss.bounds))&&(@c==@(map.boss.inside))) {
 // This could be offset by things making players invincible. Catch those?
 if((map.boss.name=="SolemonGrundy")&&(random(-1, 3)<=difficulty)) {
 p.v.x=p.v.x*-1; @(p.creator)=map.boss; p.hitsEnemies=false; p.hitsPlayer=true; p.counter+=random(2, 6);
 p.v.y=p.v.y*-1;
 p.hits+=random(0, 3);
 playsound(p.blocksound, (p.bounds.x+map.boss.bounds.x)/2, p.bounds.y);
}// Deflected.
 else {
 if(damage(map.boss, p.damage, p.hitsound, p.blocksound)) {
 map.boss.counter=-p.stun/
((map.boss.endurance==0) ? 0.5 : (map.boss.endurance*0.5));
 map.boss.v.x+=p.f.x/(0.5*map.boss.endurance);
 map.boss.v.y+=p.f.y/(0.5*map.boss.endurance);
 }// Hit successful.
 p.hits--;
}// Not deflected.
 }// Hit boss.
 }// Try to hit boss.

 }// Hit enemies.
 if((@(p.creator)==@me)&&(p.name=="batarang")&&(p.bounds.collide(me.bounds))) {
 projectiles.remove_at(i);
 pool.destroy_sound(p.slot);
 for(uint i=0; i<me.skills.length(); i++) {if(me.skills[i]=="batarang") me.levels[i]++;}
 }// Batarang caught?
 }// Projectiles.
 if(llog) {loglag("Updating projectiles", lagtimer.elapsed); lagtimer.restart(); lagtimer.resume();}

 // And finally, another freakin' object loop.
if(@map!=null)  for(uint i=0; i<movers.length(); i++) {
 if(AICounter%spread!=i%spread) continue; //?????
 if((movers[i].v.x==0.0)&&(movers[i].v.y==0.0)) {movers.remove_at(i); continue;}
 if((movers[i].v.x!=0)||(movers[i].v.y!=0)) {
 Object@ o=movers[i];
 o.bounds.x+=o.v.x*dt*spread;
 o.bounds.y+=o.v.y*dt*spread;
 if(o.bounds.x<map.bounds.x) {
 if(!o.loop) {o.bounds.x++; o.v.x=o.v.x*-1;}
 else o.bounds.x=map.bounds.x+map.bounds.width;
}
 else if(o.bounds.x>map.bounds.x+map.bounds.width) {
 if(!o.loop) {o.v.x=o.v.x*-1; o.bounds.x--;}
 else o.bounds.x=map.bounds.x;
}// Right.
 if(o.bounds.y<map.bounds.y) {
 if(o.loop) o.bounds.y=map.bounds.y+map.bounds.height;
 else {o.v.y=o.v.y*-1; o.bounds.y=map.bounds.y;}
}
 else if(o.bounds.y>map.bounds.y+map.bounds.height) {
 if(o.loop) o.bounds.y=map.bounds.y;
 else {o.v.y=o.v.y*-1; o.bounds.y--;}
 }// Bottom.
 if(o.slot>=0)  pool.update_sound_2d(o.slot, o.bounds.x+(o.bounds.width*0.5), o.bounds.y);

 // Cars are annoying. Let's blow them up with bat grenades.
 for(uint j=0; j<projectiles.length(); j++) {
 if(projectiles[j].bounds.collide(o.bounds)) {
 if(projectiles[j].damage>random(6, 20)) {
 playsound(projectiles[j].hitsound, o.bounds.x, o.bounds.y);
 playsound("sounds/crash" + random(1, 5) + ".wav", o.bounds.x+(o.bounds.width*0.5), o.bounds.height);
 o.v.x=0; o.v.y=0; pool.destroy_sound(o.slot); 
 o.snd="sounds/fire" + random(1, 3) + ".wav";
o.slot=pool.play_extended_2d(o.snd, me.bounds.x+(me.bounds.width*0.5), me.bounds.y, o.bounds.x+(o.bounds.width*0.5), o.bounds.y,
 0, o.bounds.width, 0, o.bounds.height, true, 0,
 0, random(-10, -5), random(95, 105)
);
 o.name="destroyed " + o.name;
}// Destroy that thang!
 }// Meh. Meh. Meh.
}// Projectiles.

 if(o.solid) {
 if((@me!=null)&&(o.collide(me.bounds))) {
 if(((@(me.inside)==null)&&(o.z==1))||((@(me.inside)!=null)&&(o.z==me.inside.z))) {
 if(me.counter>=0.0) {
 if(damage(me, o.bounds.width*o.bounds.height, "sounds/bighit" + random(1, 5) + ".wav", "sounds/block" + random(1, 5) + ".wav")) {
 me.counter=-0.1*random(0, 15)/me.endurance;
 if(@me!=null) me.v.x=o.v.x*1.1;
 if(@me!=null) me.v.y=random(0, 5);
 }// Hit.
}// Meh.
}// Hit.
}// Hit by something, like a car.

// Maybe hit enemies. Maybe-maybe.
if((difficulty<=random(-1, 2))&&(AICounter>=0)&&(AICounter<map.enemies.length()) &&(map.enemies[AICounter].counter>=0.0)) {
 Char@ enemy=map.enemies[AICounter];
 if((@enemy!=null)&&(o.bounds.collide(enemy.bounds.x, enemy.bounds.y, enemy.bounds.width, enemy.bounds.height))) {
 if(((@(enemy.inside)==null)&&(o.z==1))||((@(enemy.inside)!=null)&&(o.z==enemy.inside.z))) {
 if(enemy.counter>=0.0) {
 if(damage(enemy, o.bounds.width*o.bounds.height, "sounds/bighit" + random(1, 5) + ".wav", "sounds/block" + random(1, 5) + ".wav")) {
 enemy.counter=-0.1*random(0, 15)/enemy.endurance;
 if(@enemy!=null) enemy.v.x=o.v.x*1.1;
 if(@enemy!=null) enemy.v.y=random(0, 5);
 }// Hit.
}// enemyh.
}// Hit.
}// Hit by soenemything, like a car.
}// Might hit an enemy if it's a particularly painful day. And the dificulty is on easy. Although honestly, adding duck and speeding up the grappling hook has made the game a lot easier than it was.
}// Only solid objects can do damage!
}// Yeah. Woo hoo?
}// Meh.
 if(llog) {loglag("Checking for vehicles and moving objects", lagtimer.elapsed); lagtimer.restart(); lagtimer.resume();}
 if(@map!=null) {
 AICounter++;
 if(AICounter>map.enemies.length()) AICounter=0;
}
 if((@me!=null)&&(me.hp<=0)) {
 if(@backup!=null) {@me=backup; playsound("sounds/teleport.wav", me.bounds.x, me.bounds.y); @backup=null;}
 if((@(me.holding)!=null)&&(@map!=null)) {
 me.holding.bounds.moveTo(me.bounds.x, me.bounds.y);
  map.objects.insert_last(me.holding); @(me.holding)=null;
 }// Drop whatever is holding.
 }// Dead.
 if(llog) loglag("Total time for step", t.elapsed);
 }// step.

 void handleKeys() {
 if(@me==null) {
 if(@map==null) selectStage();
 selectChar();
return;
 }// Huh?

 if((key_down(KEY_LMENU))||(key_down(KEY_RMENU))) {
 if(key_pressed(KEY_SPACE)) look(me.bounds);
 else if(key_pressed(KEY_RIGHT)) look(newRectangle(me.bounds.x+(me.bounds.width*0.5), me.bounds.y, 20, 15));
 else if(key_pressed(KEY_LEFT)) look(newRectangle(me.bounds.x-20, me.bounds.y, 20, 15));
 else if(key_pressed(KEY_UP)) look(newRectangle(me.bounds.x-10, me.bounds.y+me.bounds.height, 20, 22));
 else if(key_pressed(KEY_DOWN)) look(newRectangle(me.bounds.x-10, me.bounds.y-22, 20, 22));
 }// Looking.
 else {
 if(key_pressed(KEY_C)) voice.speak_interrupt("X " + round(me.bounds.x, 2) + ", Y " + round(me.bounds.y, 2));
 else if(key_pressed(KEY_H)) voice.speak_interrupt("Health: " + me.hp);
 else if(key_pressed(KEY_P)) voice.speak_interrupt("Power: " + round(me.mp, 2));
 else if(key_pressed(KEY_S)) {
 if((me.skill<0)||(me.skill>=me.skills.length())) voice.speak_interrupt( (@(me.holding)==null) ? "None selected" : me.holding.name);
 else voice.speak_interrupt(me.skills[me.skill]);
}// Speak skill.
 else if(key_pressed(KEY_A)) {
 if((me.skill>=0)&&(me.skill<me.levels.length())) voice.speak_interrupt("" + me.levels[me.skill]);
 }// Ammo.
 else if(key_pressed(KEY_B)) {if(@(map.boss)==null) voice.speak_interrupt("No boss");
 else voice.speak_interrupt("" + map.boss.name + " is at X " + round(map.boss.bounds.x, 2) + ", Y " + round(map.boss.bounds.y, 2) + ". ");
}
else if((key_pressed(KEY_N))&&(@(map.boss)!=null)) voice.speak_interrupt(map.boss.name + " has " + round(map.boss.hp, 2) + " health remaining.");
 else if(key_pressed(KEY_ESCAPE)) {
pool.pause_all();
 voice.speak_interrupt("Main menu");
 pool.play_stationary("sounds/menu/submenu.wav", false);
 bool needsay=true;
 while(needsay) {
 t.pause();
int n= mainmenu.run(pool, voice, curbgm);
 t.resume();
 switch (n) {
case 0 : {
needsay=true;
 pool.play_stationary("sounds/menu/submenu.wav", false);
 if(selectStage()>=0) {selectChar(); needsay=false;}
 else pool.play_stationary("sounds/menu/cancel.wav", false);
}; break;
 case 1 : {
 pool.play_stationary("sounds/menu/submenu.wav", false);
help.run(pool, voice, curbgm);
 pool.play_stationary("sounds/menu/cancel.wav", false);
}; break;
 case 2 : voice.options_menu(); break;
 case 3 : {
 pool.play_stationary("sounds/menu/activate.wav", false);
 if((key_down(KEY_LSHIFT))||(key_down(KEY_RSHIFT))) {
 BGMVolume+=10; if(BGMVolume>=0) BGMVolume=0;
}
 else {
 BGMVolume-=10; if(BGMVolume<=-100) BGMVolume=-100;
 }
 bgm.volume=BGMVolume;
 needsay=true;
}; break;
 case 4 : {
 pool.play_stationary("sounds/menu/activate.wav", false);
 if((key_down(KEY_LSHIFT))||(key_down(KEY_RSHIFT))) {difficulty--; if(difficulty<0) difficulty=difs.length()-1;}
 else {difficulty++; if(difficulty>=difs.length()) difficulty=0;}
 voice.speak_interrupt_wait("Difficulty set to " + difs[difficulty%difs.length()] + ". ");
 needsay=true;
}; break;
 case 5 : {
 echo_on=!echo_on; needsay=false;
 voice.speak_interrupt("echo " + ((echo_on) ? "on" : "off" ));
}; break;
 case 6 : save_exit(); break;
 default : needsay=false;
 }// I don't like this.
 wait(5);
}// Meh.
 pool.play_stationary("sounds/menu/cancel.wav", false);
 pool.resume_all();
}
 if(me.counter==0.0) {
 if(key_pressed(KEY_SPACE)) me.act();
 else if(key_pressed(KEY_RETURN)) {
 bool cont=true;
 // Check for objects.
 for(uint i=0; i<map.objects.length(); i++) {
 if(me.bounds.collide(map.objects[i].bounds)) {
 Object@o =map.objects[i];

 if(o.collectable) {
 map.objects.remove_at(i);
 if(o.slot>=0) pool.destroy_sound(o.slot);
 i=map.objects.length();
 cont=false;
 pool.play_stationary("sounds/getItem.wav", false);
 voice.speak_interrupt("Found " + o.name);
 bool found=false;
 for(uint j=0; j<me.skills.length(); j++) {if(me.skills[j]==o.name) {found=true; me.levels[j]+=random(1, 3);}}
 if(!found) {
 if(o.name=="medkit") {
 me.hp+=5*me.stamina; if(me.hp>100+me.stamina) me.hp=100+me.stamina;
}// Healing
 else if(o.name=="arrows") {
 for(uint i=0; i<me.skills.length(); i++) {
 if(me.skills[i]=="longbow") me.levels[i]+=10;
}// Look for the right skill.
 }// Arrows.
else if((o.name=="food")&&((me.name=="Flash")||(me.name=="Impulse")||(me.name=="KidFlash"))) {me.mp=10+me.stamina; if(me.hp<100) me.hp+=random(0, 15);}
 else if((o.name=="hotdogs")&&(me.name=="Aquaman")) me.mp+=random(1, 10);
 else if((o.name=="oreos")&&(me.name=="MartianManhunter")) me.mp+=random(me.stamina, 10+me.stamina);
 else if((me.name=="GreenLantern")&&(o.name=="GreenLantern")) me.mp=10+me.stamina;
 else if((me.name=="Larfleeze")&&(o.name=="OrangeLantern")) me.mp=10+me.stamina;
 else if(((me.name=="Sinestro")&&(o.name=="YellowLantern"))||((me.name=="Atrocitus")&&(o.name=="RedLantern"))||((me.name=="StarSapphire")&&(o.name=="VioletCrystal"))||((me.name=="SaintWalker")&&(o.name=="BlueLantern"))||((me.name=="Deadman")&&(o.name=="WhiteLantern"))) me.mp=10+me.stamina;
 else if((o.name=="BlueLantern")&&(me.name=="GreenLantern")) {me.mp=20+me.stamina; me.strength*=2; me.endurance++; playsound("sounds/lightningcharge.wav", me.bounds.x+(0.5*me.bounds.width), me.bounds.y);}
 else if((o.name=="Grenade")||(o.name=="grenade")||(o.name=="BatGrenade")) {
   for(uint bg=0; bg<me.skills.length(); bg++) {if(string_contains(me.skills[bg], "renade", 1)>0) me.levels[bg]+=random(1, 5);}
}// Let our grenade-users share.
 else if((@(me.holding)==null)||(me.holding.name!="access card")||(o.name=="service key")) @(me.holding)=o;
}// Not found.
 }// Collectable item.
 else if(o.name=="elevator") {
 playsound("sounds/elevator.wav", me.bounds.x+(me.bounds.width*0.5), me.bounds.y);
 Object@ targ=null;
 Rectangle@ r=newRectangle(o.bounds.x-5, o.bounds.y, o.bounds.width+10, o.bounds.height);
 for(uint j=0; j<map.objects.length(); j++) {
  if((@o!=@(map.objects[j]))&&(map.objects[j].collide(r))&&((@targ==null)||(map.objects[j].bounds.y+map.objects[j].bounds.height>targ.bounds.y+targ.bounds.height))) @targ=map.objects[j];
 if((map.objects[j].collectable)&&(map.objects[j].collide(o.bounds))) {map.objects[j].bounds.y=o.bounds.y+o.bounds.height;
 if(map.objects[j].slot>=0) pool.update_sound_2d(map.objects[j].slot, map.objects[j].bounds.x, map.objects[j].bounds.y);
}
 }// Elevator loop.
 if(@targ!=null) {me.bounds.y=targ.bounds.y+targ.bounds.height; me.bounds.x=targ.bounds.x; if(targ.bounds.x<o.bounds.x) me.bounds.x=targ.bounds.x+targ.bounds.width;}
 else me.bounds.y=o.bounds.y+o.bounds.height;
 cont=false;
 }// Elevator.
 else if(o.name=="computer terminal") {
 int[] doors; int[] computers;
 Object@ targ=null; int targdex=-1;
 for(uint cj=0; cj<map.objects.length(); cj++) {
 if(map.objects[cj].name=="security door") {doors.insert_last(cj);
 if((@targ==null)||(absolute(targ.bounds.x-o.bounds.x)>absolute(map.objects[cj].bounds.x-o.bounds.x))) {@targ=map.objects[cj]; targdex=cj;}
}
 else if(map.objects[cj].name=="computer terminal") computers.insert_last(cj);
}// Look for stuff.

 playsound("sounds/accessGranted.wav", o.bounds.x+(0.5*o.bounds.width), o.bounds.y);
 if(@targ!=null) {
 map.objects.remove_at(targdex);

 playsound("sounds/doorOpen.wav", targ.bounds.x+(0.5*targ.bounds.width), me.bounds.y);
 o.name="disabled computer terminal";
  string[] os={"fists", "laser", "hammer", "shield"};
 Char@ enemy=newChar("OrangeLanternConstruct", os);
 enemy.bounds.x=random(map.bounds.x, map.bounds.x+map.bounds.width);
 enemy.canFly=true;
 enemy.bounds.y=random(map.bounds.y, map.bounds.y+map.bounds.height);
 map.enemies.insert_last(enemy);
}
 else {
 for(uint cj=0; cj<computers.length(); cj++) {map.objects[cj].name="disabled computer terminal";}
  string[] os={"fists", "laser", "hammer", "shield"};
for(uint oc=0; oc<10+(2*difficulty); oc++) {
 Char@ enemy=newChar("OrangeLanternConstruct", os);
 enemy.bounds.x=random(map.bounds.x, map.bounds.x+map.bounds.width);
 enemy.canFly=true;
 enemy.bounds.y=random(map.bounds.y, map.bounds.y+map.bounds.height);
 map.enemies.insert_last(enemy);
}
 
 string[] ls={"fists", "shield", "laser", "hammer", "sword", "mace", "trap", "GLHand"};
 Char@ larfleeze=newChar("Larfleeze", ls, 200);
 larfleeze.bounds.x=random(map.bounds.x, map.bounds.x+map.bounds.width);
 larfleeze.canFly=true;
 larfleeze.bounds.y=random(map.bounds.y, map.bounds.height);
 larfleeze.speed+=random(2, 5); larfleeze.strength+=random(1, 4);
 larfleeze.endurance+=random(2, 5);
 larfleeze.jump+=random(1, 5);
 larfleeze.stamina+=5;
 larfleeze.mp+=50;
 map.enemies.insert_last(larfleeze);
 voice.speak_interrupt("All systems in safe mode. Abnormal amounts of orange light detected.");
 o.name="disabled computer terminal";
}// Larfleeze time.

}// Computers Make doors disappear, and Larfleeze appear.
 else if(o.name=="control panel") {

 bool found=false;
 for(uint cj=0; cj<map.objects.length(); cj++) {
 if(map.objects[cj].name=="prison cell") {
 found=true;
