 @(map.boss)=newChar("Joker", js, 100);
 for(uint i=0; i<map.boss.skills.length(); i++) {map.boss.levels[i]=random(10, 50);} // Because joker.
 map.boss.bounds.x=random(map.bounds.x+(0.75*map.bounds.width), map.bounds.x+map.bounds.width); map.boss.bounds.y=0;
 map.boss.endurance+=random(1, 3);
 for(uint i=0; i<map.objects.length(); i++) {
 @o=map.objects[i];
 if((o.solid)&&(o.collide(map.boss.bounds)))  {map.boss.bounds.y=o.bounds.y+o.bounds.height; @(map.boss.atop)=o;}
 }// The Joker can wait atop buildings. He really needs to be able to aim, though?
 map.boss.counter=-5; // To prevent him from ruining the surprise, of course!
// Add an access card before the first door. That doesn't mean make it easy to find. Perhaps give it to an enemy, civilian or something...? Eh, make it easier to find than the way to get to the sewer.
 Object@[] rooms;
 int leftmost=250;
 for(uint i=0; i<map.objects.length(); i++) {if((map.objects[i].name=="security door")&&(map.objects[i].bounds.x<leftmost)) {
 if(map.objects[i].bounds.x<10) map.objects[i].bounds.x=10;
leftmost=map.objects[i].bounds.x;}}
 for(uint i=0; i<map.objects.length(); i++) {
 if((map.objects[i].name!="security door")&&(map.objects[i].bounds.x<leftmost)) rooms.insert_last(map.objects[i]);
}
 Object@ card=newObject("access card", newRectangle(random(map.bounds.x, leftmost-1), 0, 0.25, 0.25));
 card.solid=false; card.snd="sounds/beacon.wav";
 card.collectable=true;
 if(rooms.length()==1) rooms.insert_last(rooms[0]);
 if(rooms.length()>1) {
 Object@ r=rooms[random(0, rooms.length()-1)];
card.bounds.x=random(r.bounds.x, r.bounds.x+r.bounds.width-1);
 if(r.solid) { card.bounds.y=r.bounds.y+r.bounds.height;}
 else if(r.canEnter) {card.z=r.z; map.objects.insert_at(0, card);}
 }
 card.weightless=true;
 if(card.bounds.x>=leftmost) card.bounds.x=leftmost-1;
 map.objects.insert_last(card);
