};

Char@ me=null;

int selectChar() {
 voice.speak_interrupt("Select character");
 string[] ops; ops.reserve(maxLevel);
 for(uint i=0; i<=maxLevel; i++) {ops.insert_last(chars[i]);}
for(int i=0; i<(chars.length()-stagenames.length()); i++) {
 if( (bonuses&(1<<i ))!=0) ops.insert_last(chars[stagenames.length()+i]);
}
 Menu charmenu; charmenu.select=mainmenu.select;
 charmenu.items=ops;
 int ret=charmenu.run(pool, voice, curbgm);
 if(ret<0) return -1;
  string name=ops[ret];
 string[] ammos={"medkit", "medkit"}; // ammos.reserve(3); // for Adding powerup-type things.

 if((name=="Batman")||(name=="Nightwing")) {
 string[] skills={"fists", "batarang", "batclaw", "grapplinghook", "smokescreen", "BatGrenade"};
 @me=newChar(name, skills, 100);
 me.speed=4.5;
 me.strength=3;
 me.endurance=4;
 me.stamina=4.5;
 me.aspeed=0.25;
 me.levels[0]=1; me.levels[1]=7; me.levels[2]=4; me.levels[3]=2; me.levels[4]=10; me.levels[5]=5;
 for(uint i=1; i<me.skills.length(); i++) {ammos.insert_last(me.skills[i]);}
 if(name=="Nightwing") {
 me.skills.insert_last("staff"); me.levels.insert_last(1);
 me.strength=2; me.aspeed=0.22; me.endurance--; me.jump++;
}// Nightwing.
 me.canFly=false;
 me.strong="night";
 }// Batman.
 else if(name=="The Flash") {
 string[] skills={"fists", "extra speed", "vibration"};
 @me=newChar("Flash", skills, 100);
 ammos.insert_last("food");  ammos.insert_last("food");  ammos.insert_last("food");  ammos.insert_last("food");
 me.speed=12.0;
 me.strength=1.5;
 me.endurance=2.5;
 me.stamina=3;
 me.strong="food"; // In general. 
 me.canFly=false; // But he can run up buildings?
 me.aspeed=0.05;
 me.jump+=random(1, 4); // He needs to reach rooftops!
 }// Flash.
 else if(name=="Green Lantern") {
 // This one's tough, because technically he can make anything imaginable.
 string[] skills={"fists",
 "laser", "shield", "trap", "armor", "hammer", "GLHand"
};
 @me=newChar("GreenLantern", skills, 100);
 me.strength=2; me.speed=4.5;
 me.endurance=4;
 me.stamina=random(10, 45)*0.1;
 me.weak="yellow light";
 me.canFly=true;
 me.aspeed=0.3;
  ammos.insert_last("GreenLantern");   ammos.insert_last("GreenLantern");   ammos.insert_last("GreenLantern");   ammos.insert_last("GreenLantern");
 }// Green Lantern.
 else if(name=="Wonder Woman") {
 string[] skills={"fists", "lasso", "hephaestus"};
 @me=newChar("WonderWoman", skills, 100);
 me.strength=9;
 me.aspeed=0.25;
 me.speed=random(4, 5);
 me.endurance=6; // If she blocks with her armbands (by attacking with fists when an attack hits), it's much higher.
 me.stamina=random(4, 5);
 me.levels[0]=1; me.levels[1]=1; me.levels[2]=1; // Hephaestus uses up MP fast.
 me.canFly=false; me.jump=9; // If she tries to jump while in air and her HP/MP is high enough, she will be able to fly.
 }// Wonderwoman.
 else if(name=="Hawkgirl") {
 string[] skills={"fists", "mace", "wingshield"}; // Umm, meh on that last one.
 @me=newChar(name, skills, 100);
 me.strength=4; me.speed=4; me.endurance=2; // But she can block with her mace and wings.
 me.stamina=random(1, 6);
 me.aspeed=0.25;
  me.canFly=true;
 // Her mace is ridiculously strong and can block attacks (if timed right), and uses mp (not as quickly as Hephaestus for Wonderwoman...!)
 // wingshield is me desperately looking for something else to give her. Blocks more easily than the mace, does little damage but pushes enemies back, and hits on both sides. If she's flying while using it, she drops like a rock.
 }// Hawkgirl.
 else if((name=="Superman")||(name=="Supergirl")) {
 string[] skills={"fists", "HeatVision", "FreezeBreath", "extra speed", "ClarkKent"};
 @me=newChar(name, skills, 100);
 me.strength=15; me.endurance=15; me.speed=10;
 me.canFly=true;
 me.stamina=random(2, 6);
 me.aspeed=0.28;
 me.weak="red sun";
 me.strong="day";
 me.jump=9;
 // Oh, and he can turn into ClarkKent to be treated as a civilian, meaning ignored by some enemies, picked on by others. Not that there's much reason for that in most cases. (Will have to make a situation where Clark Kent has an advantage over Superman...). All of his stats are reduced in this form and pressing space just has him... talk or something.
 if(name=="Supergirl") {
 me.skills.remove_at(me.skills.length()-1);

 me.bounds.height=1.5; me.bounds.width=0.75;
 me.stamina++;
}// Supergirl.
 }// Superman. 
 else if(name=="Aquaman") {
 string[] skills={"fists", "telepathy", "hook-hand"};
 @me=newChar(name, skills, 100);
 me.speed=5;
 me.stamina=15;
 me.strength=random(6, 11);
 me.jump=8;
 me.endurance=random(8, 10);
 me.strong="hotdogs";
 me.aspeed=0.22;
 // His already impressive stats rival Superman if he's in water.
 // Telepathy not only instructs aquatic creatures to help move civilians and attack enemies (when applicable, which is not often), but if he's nowhere near water or aquatic creatures, he can use it to mess with the fish part of human minds to knock people out (which requires much more MP than using it on actual fish).
// His hook-hand can strike and grab simultaneously. It can pull people or objects closer to him (though those were probably in interaction range anyway), and can pull him onto ledges if he's too low to land on them but close enough to hook them. It can block certain attacks (specifically from melee weapons).
 me.canFly=false;
 ammos.insert_last("hotdogs");
 }// Aquaman.
 else if(name=="Captain Marvel") {
