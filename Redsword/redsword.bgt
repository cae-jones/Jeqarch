			string[] snds={sfx2 + "EXPLOSIO.WAV", sfx2 + "ManyRocks.ogg", jla + "teleport.wav", "voice\\Silver Guardian\\teleport.wav", jla + "pistol.wav", jla + "uzi.wav", sfx2 + "ABATTERY.WAV", sfx + "robolaser.wav", sfx + "axebullet.wav", sfx2 + "ScreamMale.wav", jla + "rocket.wav", sounds + "CSM\\Laser 1.WAV", sounds + "CSM\\Laser 2.WAV", sounds + "CSM\\Laser 3.WAV", sfx + "bp_ignite_01.wav"};
			for(int i=1; i<5; i++) {snds.insert_last("voice\\Big Robot\\hit" + i + ".wav"); if(i>0 and i<4) snds.insert_last(sfx + "ignite_0" + i + ".wav"); snds.insert_last(sfx + "sword" + i + ".ogg");}
			string[] files=find_files(sfx + "*rock*.wav");
			for(uint i=0; i<files.length(); i++) snds.insert_last((pack.file_exists(files[i])) ? files[i] : (sfx + files[i]));
			for(uint i=0; i<snds.length(); i++) {
				pool.play_2d(snds[random(0, snds.length()-1)], 0, 0, random(-10, 10), random(-5, 5), false);
				wait(random(50, 250));
			}// Hmm.
			wait(1000);
			bgm.volume=bgm.volume-4;
			sound snd;
			if(snd.load("voice\\" + geti("lang") + "\\level5.ogg")) snd.play();
			else voice.speak("If the Redsword is good for anything, it should defeat Master Jupiter!");
			while(voice.speaking() or snd.playing) {
				systemKeys();
				if(key_pressed(key.a) or key_pressed(key.b) or (pad.active and (pad.button_pressed(joy.a) or pad.button_pressed(joy.b) or pad.button_pressed(joy.start)))) {voice.stop(); snd.stop();}
				fps.tick();
			}
			wait(500);
			snd.load("voice\\Big Robot\\die.wav");
			snd.play_wait();
			nextTrack="music\\level5.ogg";
		}// scene.
		else if(curbgm=="music\\psibeat1.ogg" or nextTrack=="music\\psibeat1.ogg") {a.set("0.x", 53.5); a.set("0.y", 7.0); nextTrack="music\\psibeat1.ogg"; addEnemy("Big Robot", 66, 5, 100.0); a.set("keys", 1);} // Checkpoint.
		else if(curbgm=="music\\orchestral8.ogg" or nextTrack=="music\\orchestral8.ogg" or curbgm=="music\\slowbangin.ogg" or nextTrack=="music\\slowbangin.ogg" or geti("checkpoint.x")>150) {
			setVector(0, 163, 10);
			addEnemy("Master Jupiter", 165, 10, 100);
			if(curbgm!="music\\orchestral8.ogg") nextTrack="music\\orchestral8.ogg";
		}// Bossfight.
		else if(a.exists("checkpoint.x")) setVector("0", getvector("checkpoint"));
	}
	else if(s==6) {
		pool.destroy_all();
		string[] diag={
"          lll                 ",
"-         222                 ",
"--                            ",
"---                           ",
"----                          ",
"-----                         ",
"-----------------------       ",
"----------------------        ",
"---------------------         ",
"--------------------          ",
"                              ",
""
		};
		a.set("charsize", 0);
		addEnemy("Redsword", 5, 2, 100.0);
		addEnemy("Swordkiller", 17, 2, 9999999.9);
		newMap(diag, 0); // Although I like the fire deal.
		string[] diag2(diag.length());
		for(uint i=0; i<diag2.length(); i++) diag2[i]="";
		newMap(diag2, 1);
		if(s!=geti("stage")) {
			fadeout(40);
			playsong("music\\orchestral5.ogg");
			sound snd;
			int pitch=voice.pitch;
			voice.pitch=-2;
			if(snd.load("voice\\" + geti("lang") + "\\level6.ogg")) snd.play_wait();
			else voice.speak_wait("I hope you weren\'t trying to hide. I have a fancy sword of my own, now, but you still have the one I was supposed to get.");
			voice.pitch=pitch;
			measure=0;
			wait(1000);
			//nextTrack=curbgm;
		}// Scene.
		else {
			string[] tracks={"music\\kickass.ogg", "music\\darkshit.ogg", "music\\level3.ogg", "music\\level5.ogg", "music\\orchestral5.ogg", "music\\orchestral8.ogg", "music\\slowbangin.ogg", "music\\psibeat1.ogg", "music\\youdie.ogg"};
			nextTrack=tracks[random(0, tracks.length()-1)];
		}
	}// Last level.
	else {
		fadeout(20);
		voice.speak_wait("Game over. You win. Sorry about that.");
		fadeout(); exit();
	}
	if(nextTrack=="") nextTrack="music\\level" + s + ".ogg";
	a.set("stage", s);
}// setStage.

void addEnemy(string name, double x, double y, double hp=10.0) {
	int charsize=geti("charsize");
	if(charsize<0) charsize=0;
	a.set(charsize + ".name", name);
	a.set(charsize + ".x", x);
	a.set(charsize + ".y", y);
	setVector(charsize + ".v", 0, 0);
	a.set(charsize + ".counter", 0.0);
	a.set(charsize + ".face", KeyC_L);
	a.set(charsize + ".hp", hp);
	a.set(charsize + ".slot", -1);
	a.set("charsize", charsize+1);
}

string getAlt(string terrain) {
	if(terrain=="pipe") return "metal";
	
	return "stone";
}
string getFall(string terrain) {
	//alert("Falling", "Get fall: " + terrain);
	if(pack.file_exists(steps + terrain + "\\run1.wav")) {
		string ext=".ogg";
		if(!pack.file_exists(steps + terrain + "\\fall1.ogg")) ext=".wav";
		if(ext==".wav" and !pack.file_exists(steps + terrain + "\\fall1.wav")) return jla + "FallDirt" + random(1, 4) + ".wav";
		int rn=random(1, 4);
		int tries=0;
		while(tries<16 and !pack.file_exists(steps + terrain + "\\fall" + rn + ext)) {rn=random(1, 4); tries++;}
		return steps + terrain + "\\fall" + rn + ext;
	}// steps.
	else if(pack.file_exists(jla + "Fall" + terrain + "1.wav")) return jla + "fall" + terrain + random(1, 4) + ".wav";
	return (terrain=="carpet") ? (jla + "FallCarpet" + random(1, 4) + ".wav") : getFall("carpet");
}

vector[] projectiles;
double radartime=0.0;
bool radaron=false, sonifier=false;

void radar(double dt) {
	radartime-=dt;
	if(radartime<=0.0) {
		radartime=1.0;
		vector me=getvector("0");
		vector above(-1, -1);
		vector wall(-1, me.y);
		int dx=(geti("0.face")==KeyC_L) ? -1 : 1;
		int ex=me.x+(15*dx);
		vector drop(-1, -1); // Gah!
		for(int x=me.x; x!=ex; x+=dx) {
			bool pit=true;
			if(last=="") last="-"; //!!! Also, python could make that normal sized.
			for(int y=0; last!=""; y++) {
				vector c(x, y);
				if(isSolid(getC(x, y))) {
					if(y<floor(me.y) and (c-me).length()<=(above-me).length()) above=c;
					else if(y==floor(me.y) and x!=floor(me.x) and (wall-me).length()>=(c-me).length()) wall=c;
					else if(y>me.y) {
						if(pit and last=="" and absolute(me.x-x)<absolute(drop.x-x)) drop=c;
						pit=false;
					}// drop.
				}
			}// y
		}// x
		//clipboard_copy_text(clipboard_read_text() + "\r\nSonar:\rme: " + me.x + ", " + me.y + "\rAbove: " + above.x + ", " + above.y + "\rWall: " + wall.x + ", " + wall.y + "\rDrop: " + drop.x + ", " + drop.y);
		pool.play_2d(sounds + "Env\\platform1.wav", camera.x, camera.y, above.x, above.y, false);
		pool.play_2d(sounds + "Env\\high.wav", camera.x, camera.y, wall.x, wall.y, false);
		if(drop.x>-1) pool.play_1d(sounds + "Env\\drop3.wav", camera.x, drop.x, false);
		//alert("Sonar", "This should work:\nAbove: " + above.x + ", " + above.y + "\nWall: " + wall.x + ", " + wall.y + "\nDrop: " + drop.x + ", " + drop.y);
	}// ping.
}// radar.

int addProjectile(double x, double y, double vx, double vy, double damage, bool duck, bool clean=false) {
	vector p(x, y);
	vector v(vx, vy);
	projectiles.insert_last(p);
	pv.insert_last(v);
	pd.insert_last(damage);
	pc.insert_last(duck);
	if(clean) a.set("pslot" + (projectiles.length()-1), -1);
	return projectiles.length()-1;
}// projectiles.

vector[] pv;
double[] pd;
bool[] pc;

void removeProjectile(int index) {
	if(index<0 or index>=projectiles.length()) return;
	//clipboard_copy_text(clipboard_read_text() + "\r\nRemoving " + index + "...");
	projectiles.remove_at(index);
	pd.remove_at(index);
	pv.remove_at(index);
	pc.remove_at(index);
	int slot=geti("pslot" + index);
	//if(index==0) clipboard_copy_text(clipboard_read_text() + "\r\nBefore: pslot0 is " + slot + ", pslot1 is " + geti("pslot1") + ". ");
	if(slot>=0) {
		//clipboard_copy_text(clipboard_read_text() + " Destroying sound " + slot + "...");
		pool.destroy_sound(slot);
	}
	//else clipboard_copy_text(clipboard_read_text() + "\r\nProjectile" + index + " had slot " + slot + ". ");
	for(int j=index; j<projectiles.length(); j++) {
		a.set("pslot" + j, geti("pslot" + (j+1)));
	} // FINALLY! However, this seems horribly inefficient.
	a.set("pslot" + projectiles.length(), "-1"); // Why? Why do I need to do this? Shouldn't the above loop have taken care of it?
	//if(index==0) clipboard_copy_text(clipboard_read_text() + "\r\nAfter: pslot0 is " + geti("pslot0") + ", pslot1 is " + geti("pslot1") + ". ");
	//a.set("pslot" + index, -1);
}
void projectileStep(int index, double dt) {
	if(index<0 or index>=projectiles.length()) return;
	//clipboard_copy_text(clipboard_read_text() + "\r\nStepping " + index + ". Pslot0 is " + geti("pslot0"));
	int x=projectiles[index].x;
	int y=projectiles[index].y;
	projectiles[index]+=pv[index]*dt;
	int nx=projectiles[index].x;
	int ny=projectiles[index].y;
	
	bool removeme=false;
	int slot=geti("pslot" + index);
	int charsize=geti("charsize");
	for(int i=0; i<charsize; i++) {
		vector me=getvector("" + i);
		if(round(me.x, 0)==nx and round(me.y, 0)==ny and ((!pc[index]) or string_contains(gets(i + ".state"), "crouch", 1)<0)) {
			string hitsound=jla + "bullet\\hit_by_bullet" + random(1, 3) + ".wav";
			if(projectiles[index].z==2) hitsound=sfx2 + "EXPLOSIO.WAV"; // Umm.
			else if(projectiles[index].z==3) hitsound=sfx + "bp_ignite_01.wav";
			else if(projectiles[index].z==4) hitsound=jla + "elechit.ogg"; //sfx2 + "ABATTERY.WAV";
			if(i==0 and gets("1.name")=="Cohere" and slot>=0 and pool.items[slot].filename==sfx2 + "EXPLOSIO.WAV") {
				// YOU CAN'T SHOOT THE PLAYER!!!
				a.set("1.counter", 1.0);
			}// This is pissing me off.
			else {
				hit(i, pd[index], hitsound);
				if(geti("difficulty")<random(0, 2)) removeme=true;
			}// not the friendly fire.
			//if(i==0 and gets("1.name")=="Cohere") clipboard_copy_text("Hitting: player at " + me.x + ", " + me.y + "\r\nProjectile at " + projectiles[index].x + ", " + projectiles[index].y + ".\nPlayer vx: " + getd("0.v.x") + ", projectile: " + pv[index].x);
		}// Hit.
	}// hitting people.
	if(index>=projectiles.length()) return; // Master Jupiter does this when he shoots himself.
	if(slot>=0 and pool.sound_is_playing(slot)) pool.update_sound_2d(slot, projectiles[index].x, projectiles[index].y);
	else if(slot>=0) removeme=true;
	//else {clipboard_copy_text(clipboard_read_text() + "\r\nProjectile" + index + ", sound slot is " + slot + "\\" + geti("pslot" + index) + ". " + ((slot>=0) ? (pool.sound_is_playing(slot) + ", " + pool.items[slot].filename) : "")); if(geti("stage")==4) for(uint i=0; i<pool.highest_slot; i++) {if(i!=geti("pslot" + (index+1)) and (pool.items[i].persistent and !pool.items[i].looping) or string_contains(pool.items[i].filename, "sword", 1)>0) {a.set("pslot" + index, i); i+=100;}}}
	
	if(x!=nx or y!=ny) {
		string cn=getC(nx, ny);
		if(isSolid(cn)) {
			string toplay=jla + "bullet\\bullet_ricochet" + random(1, 4) + ".wav";
			if(projectiles[index].z==2) toplay=sfx2 + "EXPLOSIO.WAV";
			else if(projectiles[index].z==3) toplay=sfx + "bp_ignite_01.wav";
			else if(projectiles[index].z==4) toplay=sfx2 + "ABATTERY.WAV"; // Hmm.
			removeme=true;
			// Identify projectiles by projectiles[i].z and pv[i].z.
			if(string_is_digits(cn)) {
				int damage=1;
				int rx=nx/30;
				cn="" + (string_to_number(cn)-damage);
				if(cn=="0") {cn=" "; pool.play_2d(sfx2 + "manyRocks.ogg", camera.x, camera.y, nx, ny, false);} // Replace with one of the quarry sounds from downloads/sounsd?
				last=string_left(last, nx%30) + cn + string_right(last, last.length()-(nx%30)-1); // There's a 1 in there, somewhere.
				a.set(rx + ", " + ny, last);
			}// destruction.
			
			if(toplay!="") pool.play_2d(toplay, camera.x, camera.y, nx, ny, false);
		}// hits something solid.
	
	if(removeme) removeProjectile(index);
	}// hit detection.
}

bool hit(int index, double damage, string hitsound="", double stun=0.0, string targetState="") {
	vector me=getvector(index);
	double hp=getd(index + ".hp");
	//if(index==0) clipboard_copy_text("hitting: hp" + hp + ", damage" + damage);
	if(hp<=0.0) return false;
	if(damage<random(5, 7) and string_contains("Steel Guardian Gold Guardian", gets(index + ".name"), 1)>=0) {pool.play_2d(sfx2 + "Arm_hit_" + random(1, 16) + ".wav", camera.x, camera.y, me.x, me.y, false); return true;}
	else if(damage<50 and gets(index + ".name")=="Sapphire Helmsman") {pool.play_extended_2d(sfx2 + "arm_hit_" + random(1, 16) + ".wav", camera.x, camera.y, me.x, me.y, 0, 0, 2, 0, false, 0, 0, 0, random(75, 90)); return true;}
	else if(gets(index + ".name")=="Master Jupiter" and geti(index + ".slot")>=0) {pool.play_2d(sfx + "robolaser.wav", camera.x, camera.y, me.x, me.y, false); if(gets(index + ".state")=="") {a.set(index + ".state", "throw"); a.set(index + ".counter", 0.048);} return true;}
	else if(hitsound!="" and (string_contains(gets(index + ".name"), "Robot", 1)<0) and gets(index + ".name")!="Drone") pool.play_2d(hitsound, camera.x, camera.y, me.x, me.y, false);
	else if(hitsound!="") pool.play_extended_2d(sfx + "clang" + random(0, 3) + ".ogg", camera.x, camera.y, me.x, me.y, 0, 0, 0, 0, false, 0, 0, 0, 90+(20.0*math_random()));
	// Hitcries? Ouch. Maybe.
	hp-=damage;
	if(hp>0.0) {
		if(random(0, 5)>2 and directory_exists("voice\\" + gets(index + ".name"))) {
			int max=1;
			string name=gets(index + ".name");
			string ext=".ogg"; if(pack.file_exists("voice\\" + name + "\\hit1.wav")) ext=".wav";
			while(pack.file_exists("voice\\" + name + "\\hit" + max + ext)) max++;
			pool.play_2d("voice\\" + name + "\\hit" + random(0, max-1) + ext, camera.x, camera.y, me.x, me.y, false);
			//if(name=="Big Robot") clipboard_copy_text("Robot hits:" + max);
			if(name=="Ninja Master") pool.play_2d("voice\\" + name + "\\hit_m" + random(0, 4) + ".wav", camera.x, camera.y, me.x, me.y, false);
		}// hitcries.
		if(stun!=0.0 and targetState!="") {
			a.set(index + ".counter", -stun);
			a.set(index + ".state", targetState);
			if(targetState=="fall") {
				vector v(2, -4);
				if(index==0) v.x++;
				if(geti(index + ".face")==KeyC_L) v.x=v.x*-1;
				setVector(index + ".v", v);
			}// falling.
		}// stuns.
	}// positive hp.
	else {
		string name=gets(index + ".name");
		string toplay="voice\\" + name + "\\die.ogg";
		if(!pack.file_exists(toplay)) toplay="voice\\" + name + "\\die.wav";
		if(name=="Robot" or name=="Drone") toplay="voice\\Big Robot\\hit" + random(1, 5) + ".wav";
		else if(name=="Timberwolf" or name=="Alpha Wolf") toplay="voice\\wolf\\wolf_die_0" + random(1, 4) + ".wav";
		if(!pack.file_exists(toplay)) toplay=sfx2 + "ScreamMale.wav";
		if(geti(index + ".slot")>=0) pool.destroy_sound(geti(index + ".slot"));
		a.set(index + ".slot", pool.play_2d(toplay, camera.x, camera.y, me.x, me.y, false, true));
		a.set(index + ".state", "dead");
		a.set(index + ".counter", -5.0);
		a.set(index + ".v.y", random(-1, -14));
		a.set(index + ".v.x", (-3+(math_random()*6)));
		if(name=="Ninja Master" and geti("stage")==1) {
			if(getd("0.x")<100 or getd("0.y")>6) {a.set(index + ".hp", random(45, 100)); a.set(index + ".x", 103); a.set(index + ".y", 1); a.set(index + ".v.x", 0.0); a.set(index + ".counter", 2.0);}
			else {wait(1000); setStage(2);}
		}
		else if(name=="Big Robot") {
			//clipboard_copy_text(clipboard_read_text() + "\r\n" + toplay + " exists: " + pack.file_exists(toplay) + ".");
			if(curbgm=="music\\psibeat1.ogg") {
				if(geti(index + ".slot")>=0) pool.destroy_sound(geti(index + ".slot"));
				else for(uint i=0; i<pool.highest_slot; i++) {if(string_contains(pool.items[i].filename, "walk", 1)>=0) pool.destroy_sound(i);}
				vector me=getvector(index);
				pool.play_2d("voice\\Big Robot\\die.wav", camera.x, camera.y, me.x, me.y, false); // This is irritating the HFIL out of me.
				wait(1000);
				nextTrack="music\\level" + geti("stage") + ".ogg";
				if(me.y>9) me.y=8;
				for(int x=me.x-4; x<=me.x+4; x++) {
					pool.play_2d(sfx2 + "EXPLOSIO.WAV", camera.x, camera.y, x, me.y, false);
					addProjectile(x, me.y+1, random(-1, 1), random(0, 1), 0.0001, true);
					fps.tick();
					step(fps.delay*0.001);
					wait(100);
				}// Deathxplosion.
				a.set("0.hp", math_max(getd("0.hp"), 30));
			}
			else {hp=100.0; a.set(index + ".hp", 100.0);}
		}
		else if(name=="Silver Guardian") {
			if(geti("0.x")%30>15 or (getvector(index)-getvector(0)).length()>3.0) {hp=random(50, 100); a.set(index + ".state", ""); a.set(index + ".counter", 0.0);}
			else {
				int x=geti(index + ".x");
				int y=geti(index + ".y");
				getC(x, y);
				int rx=x/30;
				a.set(rx + ", " + y, string_left(last, x%30) + "%" + string_right(last, last.length()-(x%30)-1));
			}// drop keys.
		}// Silver Guardians.
		else if(name=="Steel Guardian" and geti("stage")<4) {
			wait(1000);
			fadeout(40);
			setStage(4);
		}// Steel Guardian.
		else if(name=="Alpha Wolf") {
			if(geti("0.x")<120 or absolute(geti("0.x")-geti(index + ".x"))>15 or geti(index + ".y")<geti("0.y")) {hp=100; a.set(index + ".state", ""); a.set(index + ".counter", 2.0); setVector(index, 123, 1);}
			else {wait(1000); fadeout(50); setStage(5);}
		}// Alpha Wolf, which should not be so necessary to kill. T.T
		else if(name=="Gold Guardian") {
			vector me=getvector(index), c=getvector(0);
			if((me-c).length()<3.14159265) {
				int rx=me.x; rx/=30;
				int x3=me.x; x3%=30;
				int y=me.y;
				getC(me.x, me.y);
				a.set(rx + ", " + y, string_left(last, x3) + "%" + string_right(last, last.length()-x3-1));
				getC(0, 4);
				a.set("0, 4", "@" + string_right(last, last.length()-1));
			}// You can plausibly have defeated them. Notice that this means Cohere can't do it.
			else if(gets("1")=="Cohere" and getd("1.hp")>25.0) hp=random(1, 25);
			else hp=random(50, 100);
		}// Gold Guardian.
		//else if(name=="Lady Diamond" and getd("0.x")<150) hp=random(1, 25);
		else if(name=="Sapphire Helmsman") a.set("keys", geti("keys")+1);
		else if(name=="Master Jupiter") setStage(geti("stage")+1);
		else if(name=="Swordkiller") {fadeout(75); sound snd; if(snd.load("voice\\" + geti("lang") + "\\ending.ogg")) snd.play_wait(); else voice.speak_wait("With your murderous rival defeated, and Master Jupiter neutralized, you can finally put down the red sword. But should you?"); a.set("loc", "main");}
	}// dead.
	a.set(index + ".hp", hp);
	return true;
}

const string brailles=" acc3jgghhhhhhhh\'kmm4w}}||||||||-uxx7)==hhhhhhhh-uxx7)==hhhhhhhh";
int[] braillesize={0, 30, 20, 18, 12};
string getBraille(vector c=camera, bool flash=false) {
	int l=geti("braille");
	if(l<=0) return "";
	int x=math_max(c.x-(l/2), 0);
	int endx=x+l;
	int y=c.y;
	// Doing this so often is a little... well, seems like a mistake.
	getC(x, y);
	if(last=="") return "";
	string cur=last;
	getC(endx, y);
	if(last=="") {endx=endx-(endx%30)-1; x=endx-l;}
	string ret;
	for(x=x; x<=endx; x++) {
		int n=0;
		uint shift=0;
		for(y=c.y-4; y<=c.y+4; y++) {
			if(y<0) continue;
			shift=(y<c.y-2) ? 0 : (y<c.y) ? 1 : (y==c.y) ? 2 : (y>c.y+2) ? 4 : 5;
			string cn=getC(x, y);
			if(last=="") continue;
			if(isSolid(cn)) n|=1<<shift;
			if(cn=="+" and (flash or fps.frame%30<15)) n|=8;
			else if(cn=="~" and absolute(c.y-y)<2) n|=64;
			else if(cn=="@" and round(c.y, 0)==y and (flash or fps.frame%30<=15)) n=54;
		}
		if((n&64)==0) ret += brailles[n];
		else if((n&112)>64) ret += "_";
		else ret += "~";
		// I'm kinda tempted to use [, on the grounds that it kinda looks like a lightning bolt.
	}// loop.
	
	// Enemies.
	int charsize=geti("charsize");
	y=c.y;
	x=endx-l;
	for(uint i=0; i<charsize; i++) {
		if(geti(i + ".y")==c.y) {
			int ex=geti(i + ".x");
			if(ex<x or ex>endx) continue;
			ret=string_left(ret, ex) + gets(i + ".name")[0] + string_right(ret, ret.length()-ex-1);
			if(i==0 and string_contains(gets("0.state"), "attack", 1)>=0) {
				int dx=(geti("0.face")==KeyC_L) ? -1 : 1;
				ret=string_left(ret, ex+dx) + ((dx<0) ? "e" : "i") + string_right(ret, ret.length()-(ex+dx)-1);
			}// the player is attacking.
		}// in frame. No aboves or belows? Feels cheap.
	}
	
	for(uint i=0; i<projectiles.length(); i++) {
		int py=projectiles[i].y-y;
		int px=projectiles[i].x; // Mostly because of the right edge, which, yes, is pretty annoying.
		if(py>=-4 and py<=4 and px>=x and px<=endx) {
			// I feel like I just failed a "efficient rectangle collision" test.
			string cn=(py<-2) ? "`" : (py<0) ? "c" : (py>2) ? "," : (py>0) ? "-" : "\""; // Python is going to hate me if I ever port this that way.
			ret=string_left(ret, px) + cn + string_right(ret, ret.length()-px-1); // You know, you could have used l in place of ret.length. They should be the same.
		}// on screen.
	}// Projectiles.
	
	if(ret!="") show_game_window(ret); // Umm...
	return ret;
}

void fadeout(double delay=20) {
	while(bgm.playing and bgm.volume>-50) {bgm.volume=bgm.volume-1; wait(delay);}
}

void access_cursor(int c) {
			vector acam=getvector("acam");
			bool playit=true;
			if(c==KeyC_U) acam.y--;
			else if(c==KeyC_D) acam.y++;
			else if(c==KeyC_L) acam.x--;
			else if(c==KeyC_R) acam.x++;
			else if(c==KeyC_A) acam=getvector("0");
			else {
				playit=false;
				string cn=getC(acam.x, acam.y);
				int mey=getd("0.y");
				string toplay="";
				for(int y=0; last!=""; y++) {
					cn=getC(acam.x, y);
					if(isSolid(cn)) {
						if(absolute(y-mey)<=1) toplay=sounds + "Env\\high.wav";
						else if(y<mey) {if(toplay==sounds + "Env\\platform1.wav") continue; else toplay=sounds + "Env\\platform1.wav";}
						else if(last!="") {if(toplay==sounds + "Env\\drop1.wav") continue; else toplay=sounds + "Env\\drop1.wav";}
						else if(toplay=="") toplay=sounds + "Env\\drop3.wav";
					}// solids.
					else toplay="";
					if(toplay!="") {pool.play_2d(toplay, camera.x, camera.y, acam.x, y, false); wait(250);}
				}// Vertical loop.
			}// Vertical scan?
			if(acam.x<0) acam.x=0;
			if(acam.y<0) acam.y=0;
			//if(acam.y>2 and last=="" and acam.x>=0 and acam.x<90) acam.y--;
			setVector("acam", acam);
			
			if(playit) {
				if(acam.y<0) acam.y=0;
				string toplay=sounds + "Env\\brownsweep.wav";
				string cn=getC(acam.x, acam.y);
				if(last=="") {acam.y--; toplay=sounds + "Env\\drop" + ((isSolid(getC(acam.x, acam.y))) ? "1" : "3") + ".wav";}
				else if(string_is_digits(cn)) toplay=sounds + "Env\\rockbump.wav";
				else if(cn=="+") toplay=sounds + "CSM\\Pop.WAV";
				else if(string_contains("<>^Vv", cn, 1)>=0) toplay=sounds + "Env\\platform1.wav";
				else if(cn=="@") toplay=sounds + "Env\\path.wav"; // Hmm.
				else if(isSolid(cn)) toplay=sounds + "Env\\high.wav";
				else if(cn=="%") toplay=sfx2 + "key2.wav";
				else if(cn=="!") toplay=sounds + "MHI\\metal_scrape1.ogg";
				else if(cn=="~") toplay="sfx2\\waterstrike0.wav";
				pool.play_2d(toplay, camera.x, camera.y, acam.x, acam.y, false);
				getBraille(acam);
			}
}// access cursor.

sound water;
int measure=0; // Any key changes, if we want the music to not be so redundant.
sound blast1, blast2; // For flangers.

bool setDifficulty() {
	dynamic_menu dif;
	dif.set_tts_object(voice);
	dif.configure_joystick(pad, joy.a, (joy.a==1) ? 0 : 1);
	string ext="";
	int lang=geti("lang");
	if(pack.file_exists("voice\\" + lang + "\\dif0.ogg")) ext=".ogg";
	else if(pack.file_exists("voice\\" + lang + "\\dif1.wav")) ext=".wav";
	
	if(ext=="") {
		dif.add_item_tts("Easy", "0");
		dif.add_item_tts("Normal", "1");
		dif.add_item_tts("hard", "2");
		dif.add_item_tts("hardest", "3");
		dif.add_item_tts("Go Back", "back");
	}
	else {
		for(uint i=0; i<4; i++) dif.add_item("voice\\" + lang + "\\dif" + i + ext, "" + i);
		dif.add_item("voice\\" + lang + "\\back" + ext, "back");
	}
	dif.set_callback(main_callback, "difficulty");
	int n=dif.run((ext=="") ? "Choose difficulty" : ("voice\\" + lang + "\\difficulty" + ext), ext=="");
	string rn=dif.get_item_name(n);
	if(rn=="back") return false;
	a.set("difficulty", string_to_number(rn));
	return true;
}// Difficulty, mostly just affects projectiles.

sound@[] tones(25);
void sonify(int x, int y, string cn="") {
	if(@(tones[0])==null or !tones[0].active) {
		tone_synth synth;
		float f=880.5;
		for(uint i=0; i<tones.length(); i++) {
			synth.waveform_type=4; // ?
			synth.volume=-12;
			
			synth.freq_ms("" + round(f, 0), 1000);
			@(tones[i])=synth.write_wave_sound();
			f/=1.059463;
			synth.reset();
		}// generate.
	}// initialize.
	
	
	if(y<0 or y>=tones.length()) return;
	if(cn=="") cn=getC(x, y);
	
	if(isSolid(cn)) {
		position_sound_1d(tones[y], camera.x, x, pool.pan_step, pool.volume_step);
		if(!tones[y].playing) tones[y].play();
	}
	else tones[y].stop();
}

pack_file pack;