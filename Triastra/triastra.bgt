custom_voice voice;
sound_pool pool;
sound charge, flight; // Uh Oh.


// Officially not bothering with doing it right. Let's go with Oldschool Javascript TAG style.

const string fx="downloads/fx/", sounds="c:\\jeqo\\games\\sounds\\", sounds2="downloads/sounds/", jla="downloads/games/jla/jla/sounds/", steps="c:\\jeqo\\games\\lc2015\\sounds\\steps\\";
// I don't think there will be any collisions.

string slog="string[] files={";

void log_sound(string fn) {
if(string_contains(slog, "\"" + fn + "\"", 1)<0) slog = slog + "\n\"" + fn + "\",\r";
}

void fade_all(double time=1.0) {
	double delay=time*20; // *1000/50, for ms and the maximum volume decrease.
	
	for(uint i=0; i<50; i++) {
		if(bgm.volume>-50) bgm.volume=bgm.volume-1;
		for(uint i=0; i<pool.items.length(); i++) {
			if( @(pool.items[i])!=null and @(pool.items[i].handle)!=null and pool.items[i].handle.playing and pool.items[i].handle.volume>-50) {
				pool.items[i].handle.volume=pool.items[i].handle.volume-1;
				if(bgm.volume==-50 and pool.items[i].handle.volume>bgm.volume) bgm.volume=-49;
			}
		}
	
	wait(delay);
	}
	bgm.stop();
	pool.destroy_all(); // Hopefully.
}

void save_exit() {
// etc.
	fade_all();
	file fout;
	fout.open("trisound.log", "w");
	fout.write(slog);
	fout.close();
	exit();
}


dictionary a;

// Sick of this dictionary crap.
string gets(string key) {
	string ret=""; // Originally was "undefined", but I decided "" was better. 9:44 PM 9/26/2015.
	if(a.exists(key)) a.get(key, ret);
	return ret;
}

double getd(string key) {
	double ret=0.0; // I'd prefer NaN.
	if(a.exists(key)) a.get(key, ret);
	return ret;
}
double geti(string key) {
	int ret=-1;
	if(a.exists(key)) a.get(key, ret);
	return ret;
}

void put(string key, string value) {a.set(key, value);}
void put(string key, double value) {a.set(key, value);}
void put(string key, int value) {a.set(key, value);}

int menu_position=0;
int main_callback(dynamic_menu@ menu, string data) {
	system_keys();
	if(menu_position!=menu.get_position()) pool.play_stationary(jla + "menu/select.wav", false);
	menu_position=menu.get_position();
	return 0;
}


// So, I'm a bit lost as to what exactly I'm going to do. Especially for controls. Meh.

const int[] dirs={KEY_LEFT, KEY_A, KEY_RIGHT, KEY_D, KEY_S, KEY_DOWN, KEY_W, KEY_UP};
clock time(50);

void main() {
	voice.load_config("voice.cfg");
	voice.config_path="voice.cfg";
	
	//set_sound_storage("*");
	playsong("downloads/217848__soughtaftersounds__anime-piano-film-score-soundscape-far-away.wav");
	charge.load(sp(sounds2 + "sounds2/Crystal Glass-SoundBible.com-1933015283.wav")); // Jeqocon2: sp() // Hmm. Up for changing.
	flight.load(sp(sounds2 + "sounds2/Wings Flapping-SoundBible.com-889456791.wav")); // Jeqocon2: sp()
	//flight.play_wait(); // Something's weird, here.
	
	pool.volume_step*=1.25; // Hmm.
	// 5:13 PM 9/28/2015: Changed from 1.5 to 1.25. I like the 1.5, but I'm afraid it will confuse people, especially at the ocean parts.
	
	
	// Load more settings? Progress?
	
	// unit vectors for faces. Gah.
	uvs.set("E", get_vector(1, 0, 0));
	uvs.set("NE", get_vector(square_root(2)/2, square_root(2)/2, 0));
	uvs.set("N", get_vector(0, 1, 0));
	uvs.set("NW", get_vector(-square_root(2)/2, square_root(2)/2, 0)); // Should I be saving sqrt(2) to speed this up?
	uvs.set("W", get_vector(-1, 0, 0));
	uvs.set("SW", get_vector(-square_root(2)/2, -square_root(2)/2, 0));
	uvs.set("S", get_vector(0, -1, 0));
	uvs.set("SE", get_vector(square_root(2)/2, -square_root(2)/2, 0));
	// ^ BECAUSE I REMEMBER THE UNIT CIRCLE, BASTICHES!
	
	show_game_window("Triastra 0.1A");
	
	dynamic_menu menu;
	menu.wrap=false;
	menu.allow_escape=true;
	menu.enable_home_and_end=true;
	menu.set_callback(main_callback, "");
	for(uint i=1; i<5; i++) menu.add_item_tts("Play in slot " + i);
	menu.add_item_tts("Voice options...", "voice");
	menu.add_item_tts("Joystick...", "joystick");
	menu.add_item_tts("Character Voices...", "cv");
	menu.add_item_tts("Exit", "exit");
	
	put("loc", "main");

	
	while(true) {
		system_keys();
		
		int[] keys=keys_pressed();
		for(uint i=0; i<keys.length(); i++) keyPressed(keys[i]);
		
		keys=keys_released();
		for(uint i=0; i<keys.length(); i++) keyReleased(keys[i]);
		
		// Joystick something something.
		
		string loc=gets("loc");
		if(loc=="main") {
			int result=menu.run("Triastra main menu. ", true);
			if(result<1) save_exit();
			string n=menu.get_item_name(result);
			if(n=="") {
				if(file_exists("trisave" + result + ".dat")) {
					keys_pressed();
					
					dynamic_menu conf;
					conf.wrap=false;
					conf.allow_escape=true;
					conf.enable_home_and_end=true;
					conf.set_callback(main_callback, "");
					conf.add_item_tts("Continue");
					conf.add_item_tts("Restart");
					keys_pressed();
					keys_released();
					int r=conf.run("Would you like to continue from your previous game, or restart? ", true);
					if(r<=0) {
						pool.play_stationary(jla + "menu/cancel.wav", false);
						wait(500);
					}
					else if(r==2) new_game(result);
					else load_game(result);
				}
				else new_game(result);
			}// Slot.
			else if(n=="voice") {
				pool.play_stationary(jla + "menu/submenu.wav", false);
				wait(100);
				voice.options_menu();
			}// Voice options.
			else if(n=="cv") {
				if(a.exists("cv")==false or gets("cv")=="off") a.set("cv", "on");
				else a.set("cv", "off");
				voice.speak_interrupt_wait("Character voices " + gets("cv") + ". ");
				wait(500);
			}// Individual voices.
			else if(n=="exit") save_exit();
		}// main menu.
		wait(2);
		if(time.update()) step(time.delay);
	}
	
	fade_all();
}


void system_keys() {
	if(key_pressed(KEY_F4) and (key_down(KEY_LMENU) or key_down(KEY_RMENU))) save_exit();
	else if(key_down(KEY_LCONTROL) or key_down(KEY_RCONTROL)) {
		voice.stop();
		if(gets("cv")=="on") {
			string[] keys=voices.get_keys();
			for(uint i=0; i<keys.length(); i++) {
				custom_voice@ v;
				custom_voice temp; // OK, that's the 4th time I've had to do this. Should have made a function for it.
				@v=temp;
				voices.get(keys[i], @v);
				v.stop();
			}// Loop.
		}
	}// Stop speech.
	else if(key_pressed(KEY_F5)) voice.options_menu();
	
	else if(key_pressed(KEY_PRIOR)) changeBGMVolume(2);
	else if(key_pressed(KEY_NEXT)) changeBGMVolume(-2);
	
}

void changeBGMVolume(double dv) {
	bgm.volume=bgm.volume+dv;
	double v=getd("bgmVolume");
	v+=dv;
	if(v<-50) v=-50;
	else if(v>0) v=0;
	a.set("bgmVolume", v);
}

sound bgm;
string curbgm="";
void playsong(string fn, bool looping=true) {
	if(curbgm!=fn) {
		bgm.stop();
		bgm.load(sp(fn)); // Jeqocon2: sp()
		curbgm=fn;
	log_sound(fn);
	}
	bgm.volume=getd("bgmVolume");
	if(looping)bgm.play_looped();
	else bgm.play();
}

void loop(int l) {
	playsong(fx + "complete music/loops/Loop " + l + ".wav");
}
void sting(int s) {
	playsong(fx + "complete music/stingers/stinger " + s + ".wav", false);
}


void keyPressed(int k) {
	
	
	string loc=gets("loc");
	
	if(loc=="game") {
		
		int stage=geti("stage");
		int gloc=geti("gloc"); // Should I just... never mind.
		
		if(gets("mode")=="move") {
			if(dirs.find(0, k)>=0) {
				// I don't think we need to worry about what happens if shift is not held.
				if(key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)) playsound(sounds2 + "hawk_takeoff_0" + random(1, 2) + ".wav", false);
				a.set("act", gets("act") + ((k==KEY_UP or k==KEY_W) ? "U" : (k==KEY_LEFT or k==KEY_A) ? "L" : (k==KEY_DOWN or k==KEY_S) ? "D" : "R"));
				if((geti("skills")&2)==2 and (gets("act")=="Z(U" or (gets("act")=="U" and key_down(KEY_Z)) ) and getd("e")>=1000 and getd("counter")==0.0) {
					a.set("counter", 1.0);
					playsound(sounds2 + "sounds2/30319_Production_Element_Imaging_Accent_Radio_Impact_Burst_Digital.wav", false);
					double e=getd("e");
					vector me=getPose(-1);
					for(uint i=0; i<10; i++) {
						if(getd("name" + i)!="" and dist3d2(me, getPose(i))<=50) {
							if((i<2 and getd("hp" + i)>100+(1<<geti("stage"))) or (i>=2 and getd("hp" + i)<=0.0)) continue;
							if(i<2) a.set("hp" + i, (100+(1<<geti("stage"))));
							else hurt(i, e/150.0);
							e*=4.0/7.0; //???
						}// found.
					}
					a.set("hp", math_max(getd("hp"), e/100.0)); // ?
					a.set("e", 0);
				}// Heal/smite.
			}// Movement.
		}// Moving.
		
		if(k==KEY_Z and (stage>0 or gloc>1) and getd("counter")==0 and getd("e")<=math_max(12000, 10000+(stage*1000))) {
			// 10:45 PM 9/26/2015: counter must be 0.0, e cannot exceed 12000+(stage*1000), and we set act to "z(".

			// Limits?
			a.set("e", getd("e")+1000); // Too much? Too little?
			
			if(!charge.playing) charge.play();
			a.set("act", "Z("); //?
		}// Power UP.
		else if((k==KEY_SPACE or k==KEY_G) and gets("mode")=="move" and (stage>0 or gloc>3 or (geti("skills")&1)==1)) {
			string act=gets("act");
			// So... This is kinda weird.
			double counter=getd("counter");
			if(counter==0.0) {
				a.set("act", act + "A");
				// Check for... stuff.
				if(string_right(act, 6)=="Z(LLRA" and getd("e")>=7000 and (geti("skills")&8)==8) {
					counter=0.25; // Kingdom Hearts had a lengthy intro for this sort of thing.
					a.set("counter", counter);
					// Play a sound?
				}// Blast.
				else if(string_right("act", 6)=="Z(DUDA" and getd("e")>=7000 and (geti("skills")&32)==32) {
					// )), because those unclosed parentheses are freaking me out. )
					counter=0.02;
				a.set("counter", counter);
					
				}// Blindness.
				else {
					counter=0.25; // Too quick?
					a.set("counter", counter);
					playsound(fx + "weapon swings/STAB/" + random(1, 6) + ".ogg", false); // Jeqocon2: was stab/, same folder
				}// Regular attacks.
			}// Start appending?
			else if(counter<0.0 and string_right(act, 1)=="A" and (stage>0 or gloc>2 or (geti("skills")&1)==1)) {
					a.set("act", act + "A");
					counter=0.25; // Too quick?
					a.set("counter", counter);
					playsound(fx + "weapon swings/STAB/" + random(1, 6) + ".ogg", false); // Jeqocon2: was stab/, same folder
			}// Combo.
		}// Attack.
		else if(k==KEY_TAB and (stage>0 or gloc>3)) {
			int targ=geti("targ");
			// Can you target allies? I think you should.
			int dx=(key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)) ? -1 : 1;
			targ+=dx;
			
			if(targ<-1) targ=9;
			else if(targ>9) targ=-1;
			bool cont=true;
			while(cont) {
				//clipboard_copy_text(clipboard_read_text() + ", " + targ);
				if(targ==-1) break;
				if(targ<-1) targ=9;
				if(a.exists("x" + targ)==false or gets("name" + targ)=="") targ+=dx;
				// Hopefully, the above will let us target dead people and items, without targeting ghosts. ... Unless we have to fight ghosts.
				else cont=false;
				if(targ>9) targ=-1;
			}// Loop for target searching.
			a.set("targ", targ);
			if(targ>=0) {
				pool.play_3d("downloads/31523_Science_Fiction_Beep_Shimmer_Mid_01.wav", getd("x"), getd("y"), getd("z"), getd("x" + targ), getd("y" + targ), getd("z" + targ), false);
				voice.speak_interrupt(gets("name" + targ) + ", HP" + getd("hp" + targ));
			}// Set.
			else playsound(sounds + "menu/yn_cancel.ogg", false);
		}// Umm... Is this supposed to be so shallow? Just one layer deep?
		else if(k==KEY_R and geti("swordslot")>=0) {
			vector sword(getd("swordx"), getd("swordy"), getd("swordz"));
			vector me(getd("x"), getd("y"), getd("z"));
			// We want a beacon, not the exact position.
			//double theta=get_angle(me, sword);
			//double d=(sword-me).length();
			//sword=get_vector(cosine(theta), sine(theta), 0);
			//if(absolute(d)>=10.0) d=10.0;
			//sword=me+(sword*d);
			// 11:54 PM 10/7/2015: The above didn't work, so replacing it with a box.
			if(sword.x<me.x-7) sword.x=me.x-7;
			else if(sword.x>me.x+7) sword.x=me.x+7;
			if(sword.y<me.y-7) sword.y=me.y-7;
			else if(sword.y>me.y+7) sword.y=me.y+7;
			sword.z=(sword.z<me.z) ? (me.z-1) : me.z;
			playsound("downloads/31523_Science_Fiction_Beep_Shimmer_Mid_01.wav", sword.x, sword.y, sword.z, false);
			clipboard_copy_text("Radar: " + str(sword));
		}// Radar.
		
		if(k==KEY_F1) {
			clipboard_copy_text(gets("act") + ", " + getd("counter"));
		}// Debug information.
		
		if(k==KEY_X) voice.speak_interrupt(gets("desc"));
		else if(k==KEY_Q) voice.speak_interrupt(gets("mission"));
		else if(k==KEY_C) voice.speak_interrupt("You are at " + round(getd("x"), 0) + ", " + round(getd("y"), 0) + ", " + round(getd("z"), 0) + ". ");

		if(k==KEY_ESCAPE) {
			bgm.volume=math_max(bgm.volume-10, -50);
			pool.pause_all();
			playsound(jla + "menu/submenu.wav", false);
			dynamic_menu pause;
			pause.wrap=false;
			pause.allow_escape=true;
			pause.enable_home_and_end=true;
			pause.set_callback(main_callback, "paused");
			pause.add_item_tts("Resume Game");
			pause.add_item_tts("Voice options");
			pause.add_item_tts("BGM Volume: " + getd("bgmVolume") + " (pg up / pg down)");
			pause.add_item_tts("Health: " + getd("hp"));
			pause.add_item_tts("Energy: " + getd("e"));
			pause.add_item_tts("Position: " + round(getd("x"), 0) + ", " + round(getd("y"), 0) + ", " + round(getd("z"), 0));
			pause.add_item_tts("Mission: " + gets("mission")); // Oh, dear.
			pause.add_item_tts("Area Description: " + gets("desc"));
			pause.add_item_tts("Character voices", "cv");
			pause.add_item_tts("Save Game", "save");
			pause.add_item_tts("Save and quit", "sq");
			pause.add_item_tts("Quit without save", "quit");
			int result=-1;
			
			do {
				result=pause.run("Pause menu. ", true);
				
				if(result==2) voice.options_menu();
				else if(result==3) changeBGMVolume((key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)) ? -2 : 2);
				else if(pause.get_item_name(result)=="save") {
					voice.speak_interrupt("Saving...");
					save_game(geti("slot"));
					playsound(jla + "menu/activate.wav", false);
				}// save.
				else if(pause.get_item_name(result)=="sq" or pause.get_item_name(result)=="quit") {
					if(confirm("Are you sure you want to quit?")) {
						if(pause.get_item_name(result)=="sq") save_game(geti("slot"));
						fade_all();
						a.set("loc", "main");
						playsong("downloads/217848__soughtaftersounds__anime-piano-film-score-soundscape-far-away.wav");
						return;
					}// Quit.
				}// Save and quit.
				else if(pause.get_item_name(result)=="cv") {
					if(gets("cv")=="on" or confirm("Character voices are not currently enabled. Would you like to enable them?")) {
						if(gets("cv")!="on") {
							a.set("cv", "on");
							string[] cfg=find_files("tri_*.cfg");
							custom_voice temp;
							for(uint j=0; j<cfg.length(); j++) voices.set(string_mid(cfg[j], 5, cfg[j].length()-8), temp);
						}// So much nesting!
						set_voices(voices.get_keys());
					}// Character voices.
				}// Voices.
				wait(5);
			} while(result>1);
			playsound(jla + "menu/cancel.wav", false);
			bgm.volume=getd("bgmVolume");
			pool.resume_all();
		}// Confirm if you want to quit.
	}// Game in key Pressed.
}// Key Pressed.
void keyReleased(int k) {}
void step(double dt) {
	
	string loc=gets("loc");
	if(loc=="game") {
		int gloc=geti("gloc");
		int stage=geti("stage");
		vector me(getd("x"), getd("y"), getd("z"));
		switch (stage) {
			case 0  : {
				// stage 0.
				
				if(bgm.active and !bgm.playing) loop(7);
				
				if(gets("mode")=="move") {
					// Islands are ... places...
					double[] islands={0, 0,
 30, 100,
 100, 10,
 -25, -60,
 -50, -110,
 10, -180,
 70, -160,
 -128, 15,
 200, 0,
 -10, 200,
 -80, 100,
 -20, 125
 }; // islands. Ugh.
					bool onisland=false;
					vector nearest(0, 0);
					double nd=9000;
					if(me.y<256) for(uint i=0; i<islands.length(); i+=2) {
						vector next(islands[i], islands[i+1]);
						double d=distance2(me, next);
						if(d<nd) {
							nd=d;
							nearest=next;
							if(i>=islands.length()-2) onisland=true;
						}// Nearer.
					}// Island loop.
					else {
						
						// Trees and junk.
						double[] trees={
 -100, 275, -89, 276, -78, 277, -67, 278, -56, 280, -43, 280, -38, 299, -25, 285, -14, 286, -5, 279,
 50, 280, 80, 277, 80, 288, 90, 290, 100, 280, 105, 286, 55, 300, 44, 295, 33, 284,
 75, 310, 85, 311, 96, 311, 107, 312, 120, 310, 124, 290, 120, 280, 136, 310, 136, 280,
 50, 300, 45, 295, 40, 300, 33, 305, 25, 307, 20, 311, 15, 315, 10, 312, 5, 317, -1, 315, -3, 305, -7, 311, -10, 315, -11, 290, -14, 302, -17, 311, -20, 315, -15, 320, -25, 316, -30, 320, -44, 333, -50, 340, 0, 330, 10, 320,
 -101, 285, -90, 290, -110, 285, -120, 300, -129, 305
 };
						// Loop. Yay.
						for(uint i=0; i<trees.length(); i+=2) {
							vector tree(trees[i], trees[i+1]);
							double next=distance2(me, tree);
							if(next<=nd) {
								nd=next;
								if(nd<=(1.5*1.5) and me.z<=4) {
									playsound(steps + "leaves/bump.ogg", me.x, me.y, tree.x, tree.y, false);
									if(me.z>3.9) me.z=4.1;
									else if(me.x<tree.x) me.x=tree.x-1.6;
									else if(me.x>tree.x) me.x=tree.x+1.6;
								if(me.z<4 and me.y<tree.y) me.y=tree.y-1.6;
									else if(me.z<4 and me.y>tree.y) me.y=tree.y+1.6;
								}// 9 Tabs is half a line in 4 space mode!
							}// I do not like being this many layers deep!
						}
						nearest.x=me.x;
						nearest.y=255;
						
					}// Mainland.
					
					// Now, position the ocean and beach. This is kinda tricky with the beach, since it's a ring.
					// Well, actually, let's do this first:
					move(me, get_vector(0, ((me.y>250 and me.y<300 and me.z<=0.0 and absolute(me.x-70)<5) ? -1.0 : 0.0),0), (me.z>0.20 and (me.y<260 or nd>16 or round(me.z, 0)!=4)) ? "sky" : (absolute(me.x)<=5 and absolute(me.y)<=5) ? (sounds + "steps/gravel") : (me.y>256 and absolute(me.x-70)<=4 and me.y<300) ? (sounds + "steps/swim") : (round(me.y, 0)==255 or (me.y>255 and me.y<=305 and absolute(me.x-70)<6) or (absolute(me.y-300)<5 and me.x>=65)) ? (steps + "water") : (me.y>256 and me.y<266) ? (steps + "sand") : (me.y>270 and nd<11.75 and me.z<=0.20) ? (steps + "stone") : (me.y>266 and nd<36) ? (steps + "leaves") : (me.y>266) ? (steps + "dirt") : (nd<100) ? (steps + "dirt") : (nd<=256) ? (steps + "sand") : (nd<370) ? (steps + "water")  : (sounds + "steps/swim"), dt, (nd<625 or me.z<=-(square_root(nd)-16))); // Is that all?
					
					double theta=get_angle(nearest, me);
					if(me.y>255) {
						pool.update_sound_3d(geti("slot1"), me.x, 255, 0);
						pool.update_sound_3d(geti("slot2"), me.x, 245, 0);
						// River? Lake? Trees? UGH!
						a.set("desc", (me.y<267) ? "(At the edge of the mainland, all islands to the south)" : ((absolute(me.x-70)<=5 and me.y<300) or (absolute(me.y-300)<=5 and me.x>=60)) ? "(In the wilderness, overlooking a crystal-clear stream lined with sparce trees)" : (nd<=36) ? "(Amid sparce trees, seemingly untouched by evil)" : "(Over the mainland, mostly dry and rocky, most life in hiding)");
					}
					else if(nd<225) {
						pool.update_sound_3d(geti("slot2"), nearest.x+(25.0*cosine(theta)), nearest.y+(25.0*sine(theta)), 0);
						pool.update_sound_3d(geti("slot1"), nearest.x+(15.0*cosine(theta)), nearest.y+(15.0*sine(theta)), 0);
						if(absolute(me.x)>=20 or absolute(me.y)>=20) a.set("desc", "You are on an island, currently unoccupied.");
						else a.set("desc", "An ancient harbor, its collapsed ruins buried in sand.");
					}// You are on an island.
					else if(nd<625) {
						pool.update_sound_3d(geti("slot1"), me.x, me.y, 0);
						pool.update_sound_3d(geti("slot2"), nearest.x+(25.0*cosine(theta)), nearest.y+(25.0*sine(theta)), 0);
						a.set("desc", "You overlook the sea from an island\'s shore.");
					}// You are at beach range.
					else {
						pool.update_sound_3d(geti("slot2"), me.x, me.y, 0);
						pool.update_sound_3d(geti("slot1"), nearest.x+(25.0*cosine(theta)), nearest.y+(25.0*sine(theta)), 0);
						a.set("desc", "(Flying over the sea.  It is fairly clear and tranquil, but beneath the beauty is a glimmer of deadness to the water.)");
					}// You are over da sea.
					
					if(me.x<=-128 and me.y<260) a.set("desc", "(The islands below seem faded.) \'The island is to the east...\'");
					if(me.x<-200.0) a.set("x", -190);
					if(me.x>156 and me.y<256) a.set("desc", "(Land seems very far away.) \'Nothing lives this far out.\'");
					if(me.x>200) a.set("x", 180);
					if(me.y>250 and gloc<2) a.set("desc", "(the mainland appears close by) \'This is too far...\'");
					else if(me.y>350) a.set("desc", "\'There is someone further south" + ((me.x>-50) ? ", and west" : (me.x<-150) ? ", and the east" : "") + ".\'");
					if(me.y<-200) a.set("desc", "(A  sun-backed seascape, with islands like the backs of whales scattered about) \'His island was far to the north of here...\'");
					if(me.y<-300) a.set("y", -290);
					if(gloc>2 and me.y>250 and me.x<-150) a.set("desc", "\'There is someone a little to the east of here\'");
					else if(gloc==3 and me.y>250 and me.x>160) a.set("desc", "\'It would be better to search in the west...\'");
					
					
					if(me.z<0.0) {
						if(flight.playing) {
							flight.stop();
							if(nd>625 and (me.y<256 or (absolute(me.x-70)<=5 and me.y<300))) playsound(jla + "FallWater" + random(1, 4) + ".wav", false);
							else if((nd>400 and nd<=625 and me.y<256) or (absolute(me.y-300)<=5 and me.x>65)) playsound(steps + "water/run" + random(1, 6) + ".wav", false);
							else if(me.y>260 and nd<36) playsound(steps + ((nd<11.75) ? "stone/" : "leaves/") + "run" + random(1, 6) + ".wav", false);
							else if((nd<625 and nd>225) or (me.y>255 and me.y<266)) playsound(steps + "sand/run" + random(1, 6) + ".wav", false);
							else if(absolute(me.x)<=5 and absolute(me.y)<=5) playsound(sounds + "steps/gravel/run" + random(1, 6) + ".wav", false);
							else playsound(steps + "dirt/run" + random(1, 6) + ".wav", false); // Ugh, I'm going to have to repeat this for every stage, aren't I? >.<.
						}// Landing sounds.
						if(nd<625 or me.y>255) {
							me.z=0.0;
							if(distance2(me, get_vector(getd("swordx"), getd("swordy")))<3.0) a.set("swordz", me.z);
						}// Islands.
						else me.z=math_max(getd("z"), math_max(-25, -(square_root(nd)-25)));
						a.set("z", me.z);
						if(me.z<-0.25) {
							a.set("desc", "You are under the sea. It seems tranquil to the naked eye, but the tingle of chaos surrounds you, waiting.");
							if(nd>625 and nd<2500 and geti("swordslot")>=0 and distance2(me, get_vector(getd("swordx"), getd("swordy")))<=4 and getd("swordz")<-20) {
								a.set("swordz", math_min(getd("swordz")+0.02, -1.0));
								pool.update_sound_3d(geti("swordslot"), getd("swordx"), getd("swordy"), getd("swordz"));
							}// I'm sick of this sword being buried.
						}// Under water.
					}// Landings and stuff.
					else if(me.z>0.0 and !flight.playing) flight.play_looped();
					else if(me.z>50) {
						a.set("z", 40);
						playsound(sounds + "CSM/Big Storm.WAV", me.x, me.y, me.x+random(-10, 10), me.y+random(-5, 5), false);
						a.set("e", math_max(getd("e")-1000, 0));
						if(getd("e")<=0) {;} // Handle falling there, when falling happens.
					}// Too high.
					
					if(nd<730 and nearest.x==islands[2] and nearest.y==islands[3]) {
						if(gloc<1) {
							gloc++;
						pool.play_extended_3d("downloads/39540_Sound_DesignAngelMagicPixie_Dust_MoveTinkly_8.wav", me.x, me.y, me.z, nearest.x, nearest.y, absolute(me.z)/4, 15, 15, 15, 15, false, 0, 0, 0, 100);
							double theta=get_angle(me, nearest);
							string direction="southeast";
							if(absolute(theta)<pi/8) direction="east";
							else if(theta>0 and theta<3*pi/8) direction="northeast";
							else if(theta>0 and theta<5*pi/8) direction="north";
							else if(theta>0 and theta<=7*pi/8) direction="northwest";
							else if(theta>0 and theta<9*pi/8) direction="west";
							else if((theta>pi and theta<3*pi/2) or (theta>-pi and theta<-5*pi/8)) direction="southwest";
							else if((theta>0 and theta<=13*pi/8) or (theta<-3*pi/8 and theta>=-5*pi/8)) direction="south";
							voice.speak_interrupt("There it is. Just a bit to the " + direction + ".");
						}// first sight.
						else if(nd<50 and gloc<2 and me.z<=0.0) {
							gloc=2;
							fadeout(0.5);
							playsound(sounds2 + "sounds2/39032_WoodSplinterChunkNice_2.wav", me.x, me.y, nearest.x, nearest.y, false);
							playsound(sounds2 + "sounds2/27259_Impact_Wood_Beam_Drop_On_Cement_Wobble_01.wav", me.x, me.y, me.x+random(-5, 5), me.y+random(-3, 3), false);
							playsound(sounds2 + "sounds2/23266_Foley_Pigeon_Clay_Set_Down_Wobble_01.wav", me.x, me.y, me.x+random(-5, 5), me.y+random(-5, 5), false);
							voice.speak_interrupt_wait("All that\'s left is a splintered door, and I can\'t know if it is the work of storms, or devils, or Jannai!");
							wait(500);
							playsound(sounds2 + "sounds2/16729_AccentTime_WarpDeep_3.wav", false);
							wait(500);
							voice.speak_wait("Whatever his fate, I must purify this place.");
							wait(1000);
							playsound(sounds + "menu/yes_no_option.wav", false);
							wait(500);
							voice.speak("(Rapidly tap the Z key to gather energy.)");
							a.set("e", 0);
							a.set("mode", "charge");
							a.set("mission", "Gather enough energy to purify this island!");
						}// Found.
					}// Island.
				
					
					if(gloc==3 and me.y>250) {

					}// Mainland.
					
					if(a.exists("swordslot")) {
						// Maybe this goes in move, eh?
						if(geti("swordslot")>=0 and absolute(me.x-getd("swordx"))<=1.5 and absolute(me.y-getd("swordy"))<=1.5 and absolute(me.z-getd("swordz"))<=1.5) {
							fadeout(0.5);
							a.set("sword", stage); // ... Yeah.
							a.set("skills", geti("skills")|(1<<stage));
							sting(1);
							bgm.volume=bgm.volume-5;
							voice.speak_interrupt_wait(sdescs[stage*2]);
							wait(500);
							playsound("downloads/31712_Science_Fiction_Computing_Digital_Ascend_01.wav", false);
							pool.destroy_sound(geti("swordslot"));
							a.set("swordslot", -1);
							wait(1250);
							voice.speak_interrupt_wait("(Gained Skill " + stage + ": " + skills[stage*2]);
							
						}// Got sword.
					}// Sword.
					
					if(gloc==3 and me.y>290 and me.x<-30 and distance2(me, get_vector(-100, 350))<=2500) {
						playsound(sounds2 + "hawk_wingstretch_0" + random(1, 3) + ".wav", false);
						double vz=0.0;
						while(bgm.playing or me.z>0.0) {
							bgm.volume=bgm.volume-1;
							if(bgm.volume<=-50) bgm.stop();
							if(me.z>0.0) me.z=me.z-vz;
							else me.z=0.0;
							vz+=9.0*0.02;
							pool.update_listener_3d(me.x, me.y, me.z);
							wait(20);
						}// Landing loop.
						a.set("z", 0.0);
						playsound(sounds2 + "sq_bighit_0" + random(1, 8) + ".wav", me.x, me.y, me.x+5, me.y-5, false);
						wait(150);
						if(noskip()) for(uint i=0; i<4; i++) {
							playsound(steps + "dirt/run" + (6-i) + ".wav", me.x, me.y, me.x+8-i, me.y+4-i, false);
							if(noskip()) wait(250);
						}// Walking loop.
						if(flight.playing) flight.stop();
						if(noskip()) playsound(steps + "dirt/slide.wav", me.x, me.y, me.x+4, me.y, false);
						if(noskip()) wait(500);
						if(!key_down(KEY_LCONTROL) and !key_down(KEY_RCONTROL)) voice.speak_interrupt_wait("\'Bath Kothar, kin to the Hadadites. You dare dwell in this land?\'");
						wait(100);
						if(noskip()) playsound(fx + "weapon swings/POUND/" + random(1, 6) + ".ogg", false);
						if(noskip()) wait(500);
						if(noskip()) voice.speak_interrupt_wait("Bath Kothar: Yes, I dare. I also have a new Thunder Club that wants testing.");
						wait(1000);
						loop(1);
						bgm.volume=bgm.volume-6;
						voice.speak_wait("(Press tab to lock on to a target. Use G or the spacebar to attack.)");
						keys_pressed();
						keywait();
						bgm.volume=getd("bgmVolume")-2;
						a.set("hp2", 50);
						a.set("e2", 0.0);
						a.set("name2", "Bath Kothar");
						a.set("x2", me.x+5);
						a.set("y2", me.y);
						a.set("z2", 0.0);
						a.set("target", -1);
						gloc=4;
					}// Cutscene with Kefa and Bath Kothar.
					else if(gloc==4 and getd("hp2")<=0.0) {
						gloc=5;
						fadeout();
						int rock=pool.play_3d(sounds2 + "rock_whoosh_0" + random(1, 9) + ".wav", me.x, me.y, me.z, me.x-10, me.y, me.z, false);
						for(uint i=0; i<50; i++) {
							time.tick();
							pool.update_sound_3d(rock, me.x-10+(i*0.2), me.y, me.z); // That seems awfully fast...
						}
						playsound(sounds2 + "rock_nailsperson_01.wav", false);
						for(uint i=0; i<7; i++) {
							pool.play_3d(steps + "dirt/run" + random(1, 6) + ".wav", me.x, me.y, me.z, me.x-10+i, me.y, me.z, false);
							wait(200);
							if(i==2) pool.play_3d(sounds2 + "rockmiss_0" + random(2, 9) + ".wav", me.x, me.y, me.z, me.x+(0.1*random(-25, 25)), me.y+(0.1*random(-25, 25)), 0, false);
						}// Kefa running loop.
						
						script(false, "\"So, you are Kefa?\"");
						if(gets("cv")=="on") set_voices("Ramiel", "Kefa", "Bath Kothar");
						playsound(steps + "dirt/slide.wav", me.x, me.y, me.x-2, me.y, false);
						wait(300);
						playsound(steps + "dirt/fall" + random(1, 4) + ".wav", me.x, me.y, me.x-1, me.y, false);
						wait(500);
						playsong("downloads/217850__soughtaftersounds__mystical-film-score-soundscape-allude.wav");
						script(false, "Kefa: Sorry! I thought you were a bandit!", "\"Stand. I am only Ramiel.\"", "Bath Kothar: Wait, so are you the Angel of Thunder, or the Angel of Mercy and Hope?", "Ramiel: Both.", "Bath Kothar: So the Angel of Mercy accused me because...?", "Ramiel: I was under the impression you were here to take advantage of a moment of weakness!", "Bath Kothar: After how that turned out for Amalek? - Nice Mercy and Hope there, by the way.", "Ramiel: King Agag had set into motion a mass sacrifice to create more Amorite Nymph Gems! What do you think Moloch would have done with them?");
						playsound(steps + "dirt/run3.wav", me.x, me.y, me.x-2, me.y, false);
						wait(200);
						playsound(steps + "dirt/run5.wav", me.x, me.y, me.x-1, me.y, false);
						wait(200);
						playsound(steps + "dirt/run2.wav", false);
						wait(300);
						script(false, "Kefa: Ah, Ramiel? Bath Kothar is here because I brought her out of Babylon.", "Kefa: It was years ago, when I was twelve years old. A long story, involving my friends, a sorceror, a demonic Ostrich and Satiyr.", "Ramiel: Ah... I remember. You were hiding from Hyenas and Jackals, and prayed for mercy.", "Ramiel: And it was my job to tell you to be merciful in turn.", "Bath Kothar: That explains the thunder that scared the demons long enough for us to escape.", "Bath Kothar: It\'s strange that you need reminding. Why are you here, exactly?");
						fadeout();
						playsong("downloads/217848__soughtaftersounds__anime-piano-film-score-soundscape-far-away.wav");
						script(false, "Ramiel: There has been war in Heaven. The Accuser found Jannai\'s attrocities evil enough to complete his case against humanity.", "Ramiel: The lord said he would send mercy before wrath. And he took exception to that.", "Ramiel: Michael and the angels fought. Many fell to Earth during the battle.", "Ramiel: I saw Sariel falling. If I cannot bring him back...", "Ramiel: ... Then I must speak with Shimeon, brother of the Queen.", "Ramiel: Something is amiss, and I can\'t simply storm King Jannai\'s palace alone.");
						playsound(fx + "weapon swings/POUND/" + random(1, 3) + ".ogg", false);
						wait(300);
						playsound(sounds2 + "rockmiss_1" + random(0, 1) + ".wav", false);
						wait(1500);
						script(false, "Bath Kothar: All I have from Kothar wa Khasis is the talent of building things. Ben Yam inherited a bit more.", "Bath Kothar: Are you an angel of Mercy, or not?", "Bath Kothar: Ben Yam is in hiding, somewhere near this coast, to the east.", "Bath Kothar: Bring him out. Together, we can handle Jannai.", "Ramiel: It was said that no children of Yam should live...", "Bath Kothar: Ben Yam had children himself, when last I saw him. Are they condemned, too?", "Ramiel: I will find Ben Yam, but it will not be the blood of idols that restores hope to this land!");
						playsound(sounds2 + "hawk_wingstretch_0" + random(1, 3) + ".wav", false);
						fadeout();
						loop(20);
						bgm.volume=bgm.volume-4;
						if((geti("skills")&1)==0) script(true, "(Your original sword would be helpful. You can almost feel it, to the " + getDir(get_angle(me, get_vector(getd("swordx"), getd("swordy"), getd("swordz")))) + "...)", "(Yam was said to have power over the sea. If Ben Yam inherited some of that power, his hideout probably has an underwater entrance.)");
						a.set("mission", "Find Ben Yam.");
						a.set("hp", 100);
						pool.play_extended_3d(sounds2 + "ambient - high quality/river_01.wav", me.x, me.y, me.z, 180, 255, -23, 20, 20, 10, 10, true, 0, 0, 0, 100);
					}// Next.
					else if(gloc>=5 and me.x>160 and me.z<-12 and absolute(me.y-256)<=1.6) {
						playsound("downloads/31106_Production_Element_Imaging_Accent_Stab_Dark_Hit_Reverb_04.wav", false);
						fadeout();
						fade_all();
						pool.destroy_all();
						stage=1;
						gloc=(gloc==5) ? 0 : (gloc-4);
						a.set("stage", stage);
						a.set("gloc", gloc);
						a.set("z", -30.0);
						scapeme();
						//script(true, "Ramiel: 
					}// Found it.
					else if(gloc==5 and me.z<0 and getd("hp3")<=0.0 and getd("hp4")<=0.0 and getd("hp5")<=0.0 and random(1, 1200)==666) {
						fadeout(0.33);
						a.set("hp3", random(10, 30));
						a.set("hp4", random(-10, 30));
						a.set("hp5", random(-20, 30));
						if(getd("hp4")>0) a.set("name4", "Seamonster");
						else a.set("name4", "");
						a.set("name3", "Seamonster");
						a.set("name5", (getd("hp5")>0) ? "Seamonster" : "");
						a.set("x3", random(me.x-20, me.x+20));
						a.set("y3", random(me.y-20, math_min(254, me.y+20)));
						a.set("z3", random(-25, 0));
						// I am officially switching to something that doesn't require such deep nesting. -_-.
						a.set("x4", random(me.x-20, me.x+20));
						a.set("y4", random(me.y-20, me.y+20));
						a.set("z4", random(-25, 0));
						a.set("x5", random(me.x-20, me.x+20));
						a.set("y5", random(me.y-20, me.y+20));
						a.set("z5", random(-25, 0));
						loop(12);
						
					}// Random encounter.
				}// moving.
				
				if(gloc==2) {
					double e=geti("e"); // Umm.
					if(e>=dt) e-=dt;
					else e=0;
						// Sound?
					a.set("e", e);
					if(e>12000 and stage==0) {
						gloc=3;
						a.set("gloc", 3);
						a.set("mode", "move");
						playsound(sounds + "CSM/Big Storm.WAV", false);
						playsound(sounds2 + "ignite_0" + random(1, 3) + ".wav", getd("x"), getd("y"), 30, 100, false); // Is that... even... ?
						wait(2000);
						voice.speak_interrupt_wait("To bring hope is my duty. Thy will be done!");
						loop(20);
						bgm.volume=bgm.volume-4; // A bit loud.
						wait(1000);
						if(gets("name2")=="Ben Yam") a.set("name0", "Ben Yam");
						clearDead();
						voice.speak_interrupt("I will go north, to the mainland. There are still a few would be righteous souls who have survived Jannai\'s reign of terror.");
						a.set("mission", "Go to the mainland and find people.");
					}// Success. ... Kinda sad that 9000 isn't a reasonable threshold. But that's been done to death, anyway.
				}// Charging.
				if(gloc==5 and (gets("name3")!="" or gets("name4")!="" or gets("name5")!="")) {
					// For posterity, the first time I did this, I screwed it up so that beating one caused loop 20 to play in pingarific slow motion.
					int alive=0;
					for(uint i=3; i<=5; i++) {
						if(getd("hp" + i)<=0.0 and gets("name" + i)!="") put("name" + i, "");
						else if(getd("hp" + i)>0.0) alive++;
					
					}// How did I wind up at the same depth as before? Gah!
					
					if(me.z>0.0) {
						alive=0;
						playsound(jla + "FallWater" + random(1, 4) + ".wav", false);
						alive=0;
						a.set("name3", "");
						a.set("name4", "");
						a.set("name5", "");
						a.set("hp3", 0);
						a.set("hp4", 0);
						a.set("hp5", 0);
					}// They leave. Kinda lame, but I figured, might as well.
					if(alive<1) {
						fadeout(0.33);
						loop(20);
						a.set("targ", -1);
					}// Victory.
				}// Mobs. This is not an efficient way to do this, and I should come up with something better.
				
				if(gloc>6 and me.y>500-me.x) {
					fade_all();
					pool.destroy_all();
					bgm.stop();
					stage=2;
					gloc=(gloc>7) ? (gloc-2) : 0; // Umm.
					a.set("stage", 2);
					a.set("gloc", gloc);
					scapeme(false);
					// BGM?
				}// Stage change.
			}; break;
			case 1 : {
				vector v=keyV();
				
				vector temp(me.x, me.y, me.z);
				me=tunnelmove(me, v, dt*0.001);
				//if(me.y<245) {alert("ERROR!", "You just bounced to " + round(me.x, 0) + ", " + round(me.y, 0) + ", " + round(me.z, 0) + ", all the way from " + round(temp.x, 0) + ", " + round(temp.y, 0) + ", " + round(temp.z, 0) + "! Isn\'t that ridiculous? I think that\'s ridiculous!");}
				
				if(gloc==0 and me.x>230 and me.x<240 and me.y>260 and me.y<270) {
					playsound(sounds2 + "hawk_landing_01.wav", false);
					while(me.z!=-16) {
						if(me.z<-16) {
							me.z+=0.04;
							if(me.z>-16) me.z=-16;
						}
						else if(me.z>-16) {
							me.z-=0.04;
							if(me.z<-16) me.z=-16;
						}
						pool.update_listener_3d(me.x, me.y, me.z);
						time.tick();
					}// Land.
					wait(1000);
					log_sound(sounds + "MHI/throw_weapon_lr.ogg");
					pool.play_stationary_extended(sounds + "MHI/throw_weapon_lr.ogg", false, 0, 0, 0, 50);
					wait(1250);
					playsound(jla + "steps/dirt/run" + random(1, 6) + ".wav", me.x-1, me.y+1, me.z, false);
					wait(500);
					playsound(sounds + "MHI/cloth_light_" + random(0, 3) + ".ogg", false);
					wait(1000);
					script(true, "Ramiel: Ben Yam.", "\"If you have come to kill me, I might retaliate.\"", "\"If you\'ve come for my children, you will die.\"");
					time.tick();
					for(uint i=1; i<5; i++) {
						playsound(sounds2 + "rock_water_0" + i + ".wav", 235+(5*cosine(i*(PI/4))), 265+(5*sine(i*(PI/4))), -16);
						wait(150);
					}// Splashes.
					wait(1000);
					clearDead();
					a.set("name2", "Ben Yam");
					a.set("hp2", 75);
					a.set("x2", 233);
					a.set("y2", 265);
					a.set("z2", -16);
					gloc=1;
				}// Found.
				
				if(gloc==1 and getd("hp2")<=0.0) {
					gloc=2;
					fadeout();
					if(gets("cv")=="on") set_voices("Ben Yam");
					script(false, "Ben Yam: What you do to me is unimportant. My children left hours ago on a vision given to Elisha.", "Ramiel: Vision? Tell me of this vision.", "Ben Yam: If you are an angel of he who sent it, shouldn\'t you know?", "Ramiel: Zechariel arrived late to a meeting of the Archangels. Yours seems the sort of family Zachariel would protect.", "Ben Yam: Watcher of children of sinners, yes.", "Ben Yam: An urgent meeting of messengers, a lost one, and Elisha told to watch the sky... So, it is celestial war, then?", "Ramiel: I have not come to bring judgment, but hope.", "Ben Yam: Hope? Do you aim to rally the people against King Jannai, then?", "Ramiel: Not war; hope. Hope, mercy, and a bit of thunder.", "Ben Yam: Well, then. Best you leave the way Elisha did.");
					a.set("mission", "Find the exit!");
					playsound(sounds + "MHI/cloth_light_" + random(0, 3) + ".ogg", false);
					a.set("z2", -16);
					a.set("y2", 265);
					vector bey(getd("x2"), getd("y2"), getd("z2"));
					while(bey.x<250) {
						bey=tunnelmove(bey, get_vector(4.0, 0, 0.1), 0.02, false);
						time.tick();
						system_keys(); // be safe.
					}// Moving.
					a.set("x2", 220);
					a.set("y2", 288);
					a.set("z2", -10);
					
					while(bgm.volume<getd("bgmVolume")-4) {
						bgm.volume=bgm.volume+1;
						time.tick();
					}// fade in
					script(true, "Ben Yam: There is an opening near the river, covered by a boulder. I trust yours is a power that can move it.");
					a.set("targ", -1);
				}// Victory.

				// Do we get attacked here? The maze is annoying enough without attackers. Sure, in certain areas.
				if(gloc<2 and random(0, 1200)==666 and (me.z<=-25 or (me.x>240 and me.x<255)) and clearDead()) {
					int alive=0;
					for(uint i=2; i<5; i++) {
						a.set("hp" + i, random(-10, 30));
						if(getd("hp" + i)>0) {
							alive++;
							a.set("name" + i, "sea monster");
							vector enemy(me.x+random(-15, 5), me.y+random(-5, 5), me.z+random(-10, 10));
							enemy=tunnelmove(enemy, get_vector(0, 0, 0), 0.04, false);
							a.set("x" + i, enemy.x);
							a.set("y" + i, enemy.y); 
							a.set("z" + i, enemy.z);
						}// Added.
					}
					if(alive>0) playsound(sounds2 + "rock_water_0" + random(1, 8) + ".wav", me.x+random(-5, 5), me.y+random(-5, 5), me.z+random(-5, 5)); // Jeqocon2: was sounds, the files are in sounds2
				}// Random Encounter.
				
				if(gloc>=2 and me.y<=250) {
					stage=0;
					gloc=gloc+4;
					fade_all();
					if(gets("name2")=="Ben Yam") a.set("name0", "Ben Yam");
					clearDead();
					a.set("stage", 0);
					a.set("gloc", gloc);
					scapeme(false);
				}// Go out the way you came in? Is that allowed?
				a.set("x", me.x);
				a.set("y", me.y);
				a.set("z", me.z);
			}; break;
			case 2 : {
				vector v=keyV();
				me=desertmove(me, v, dt*0.001, gets("act")=="fall");
				a.set("x", me.x);
				a.set("y", me.y);
				a.set("z", me.z);
				if(me.x>280 and me.y>410 and me.x<460 and me.y<480) {
					if(me.z>0) a.set("desc", "(A sandy ridge, probably roost to vultures and den to jackals)");
					if(me.z>0 and me.z<3) a.set("desc", "(In a narrow ravine, largely in shadow.)");
					else if(me.z<0 and me.y>425) {
						if(me.x>370 and me.y<450 and me.x<405) a.set("desc", "In a rocky tunnel, suspiciously artificial-looking scratches marring the walls.");
						else if(me.x<363 and me.y>460) a.set("desc", "Overlooking a smelting pit, still glowing with the heat of molten iron.");
						else if(me.x>425) a.set("desc", "In a dimly lit stretch of cavern, a few dark holes in the walls and ceiling too small for soldiers to fit through.");
						else if(me.y>445) a.set("desc", "In a dry, dusty cave, enough of the walkspace swept clear of debris for several men to walk abreast.");
						if(gloc==1 and me.x<360 and me.y>455) {
							playsound(sounds2 + "bellow" + random(1, 4) + "v.wav", false);
							wait(1000);
							script(true, "Ramiel: They aren\'t smelting Angellic equipment. Just ordinary iron.", "Ramiel: Nevertheless, that demon and its companions are using this to make wicked things.");
							gloc=2;
							a.set("name2", "Jannaean Soldier");
							a.set("x2", 370);
							a.set("y2", me.y);
							a.set("z2", -13);
							a.set("hp2", 75);
							a.set("name3", "Jannaean Soldier");
							a.set("x3", 372);
							a.set("y3", 461);
							a.set("z3", -13);
							a.set("hp3", 75);
							a.set("gloc", gloc);
						}// Cut scene?
					}// Inside.
				}// Hideout.
				
				if(gloc==0 and clearDead())  {
					for(uint i=0; i<10; i++) {
						playsound(steps + "dirt/run" + random(1, 6) + ".wav", me.x+i, me.y, 0, false);
						wait(200);
					}// running away.
					script(true, "Sapphira: Their captain is running away!", "Elisha: That was no mere man, was it?", "Ramiel: No. It is the body of a man, but the spirit of a demon.");
					for(uint i=0; i<10; i++) {
						playsound(steps + "dirt/run" + random(1, 6) + ".wav", me.x-10+i, me.y, 0, false);
						wait(150);
					}
					script(true, "Bath Kothar: Demon, eh? And I just thought people could be viceous on their own.", "Elisha: Bath Kothar, I take it? Ben Yam was rather vague about his time in Babylon.");
					playsound(sounds + "MHI/cloth_light_" + random(0, 3) + ".ogg", false);
					wait(1000);
					script(true, "Ben Yam: There is no time for pleasantries, if you want to find that demon.", "Ramiel: He was after things fallen from Heaven. That could be wounded angels, or holy weapons and armor, or angels corrupted to darkness.", "Kefa: Then what are we waiting for?");
					a.set("mission", "Find the possessed soldier!");
					gloc=1;
					a.set("name1", "");
					a.set("targ", -1);
					// Party select.
				}// First battle won.
				else if(gloc==3 and dist3d2(me, get_vector(440, 460, -10))<100) {
					if(gets("cv")=="on") set_voices("Jackal");
					script(true, "\"Baals. I can\'t convince you to join us, can I?\"", "Ramiel: You can\'t fool me! What\'s your name?", "\"Jackal of Babylon. So, to be clear, you\'re refusing the offer?\"", "Ramiel: I am a servant of mercy! Of course I refuse!", "Jackal: This body let me in because of its hate and lust for blood, but many of my kin have found hosts because they had no other hope.", "Jackal: They pray to demons when your master lets them down. And you are a bringer of hope?", "Ramiel: I exist to serve something greater than myself, unlike you.", "Jackal: Oh? Who says I don\'t have a dayjob, too?", "Ramiel: If you serve the accuser, that doesn\'t help your case.", "Jackal: Not quite. I\'d say talk to Joanah, but he\'s dead.", "Jackal: I\'d say talk to Sandalphon, but you seem to have lost track of your fellow angels.");
					//fadeout(0.33);
					//playsong("downloads/217849__soughtaftersounds__mystical-film-score-soundscape-wonder.wav", true);
					//script(false, "Elisha: One who denies the accuser while wearing his robes makes a fool of himself before one who withstands him by mercy.", "Jackal: Maybe, but look at those kids.", "Jackal: Now look at me, back to the kids, back to me.", "Jackal: I am not those kids. Now look at the angel...", "Jackal: Now look at the bear, back to the angel, now back to the kids...", "Jackal: Where\'s the bear? She ran off. Maybe she\'s had a crisis of faith? Is that her, behind that rock?");
					/*for(uint i=0; i<10; i++) {
						playsound(steps + "dirt/run" + random(1, 6) + ".wav", me.x+i, me.y, 0, false);
						wait(200);
					}// running away.
					
					fadeout();
					bgm.stop();
					script(false, "Ramiel: Trying to run away? You can\'t hide that easily!");
					a.set("gloc", 1);
					a.set("mission", "Follow the Jackal of Babylon!");
					a.set("hp0", 100);
					a.set("hp1", 0);
					a.set("name1", "");*/
					// Party select? You can get away with picking anyone, if we can reasonably bring in Kefa and Bath Kothar, here.
					// Ananiah and Sapphira are strong at close quarters, but have poor defense. They make up for it with quick, lunging attacks, and I'd kinda like them to keep some of those javelins, but those have like no playtime for projectile purposes.
					a.set("gloc", 4);
					gloc=4;
					a.set("name3", "Jackal");
					a.set("hp3", 150);
					a.set("x3", 440);
					a.set("y3", 455);
					a.set("z3", -13);
					//fadeout();
					playsound(fx + "weapon swings/SLICE/" + random(1, 6) + ".ogg", false);
					playsong("A Challenge Met.ogg", true);
					bgm.volume=bgm.volume-4; //???
					wait(500);
					script(true, "Ramiel: Enough! Come out of him!", "Jackal: If you insist.");
					playsound(sounds2 + "sounds2/21122_XW1_P04_177Whoosh_LowMechanic_03.wav", false);
					wait(1000);
					playsound(steps + "stone/run" + random(1, 5) + ".wav", false);
					wait(25);
					playsound(steps + "stone/run" + random(2, 6) + ".wav", false);
					wait(500);
					script(true, "Jackal: Anything else I can do for you?", "Ramiel: Tell me, where are all the items you, yours, and this army have collected today?", "Jackal: Are you looking for anything in particular?", "Ramiel: So arrogant...", "Ramiel: Are you going to answer me?", "Jackal: I don\'t know; feasting on your bones is looking pretty good, right about now.");
					playsound(sounds + "MHI/swing_rough" + random(0, 2) + ".ogg", getd("x3"), getd("y3"), getd("z3"));
					wait(1000);
					bgm.volume=bgm.volume+4;
					
				}// First battle won.
				else if(gloc==4 and clearDead()) {
					playsound("54985__syna-max__anime-sword-hit.wav", false);
					wait(1000);
					script(true, "Jackal: Ugh... still don\'t count yourself fallen, huh?", "Ramiel: What?", "Jackal: You want to know something true?", "Jackal: All the things we\'ve found have already been sent back to King Jannai.");
					gloc=5;
					a.set("gloc", 5);
					fadeout();
					loop(4);
					a.set("mission", "Find Shimeon, or Sariel.");
				}// Victory!
				else if(gloc==2 and absolute(me.x-357)<5 and absolute(me.y-460)<5 and me.z<-10 and key_down(KEY_Z) and getd("e")>=12000) {
					gloc=3;
					a.set("gloc", 3);
					playsound(sounds + "CSM/Storm.WAV", false);
					playsound(sounds2 + "bellow" + random(1, 4) + "v.wav", 356, 460, -13);
					a.set("e", 0);
					a.set("hp2", getd("hp2")/2);
					a.set("hp3", getd("hp3")/2);
					a.set("hp0", math_min(getd("hp0")+40, 100));
					a.set("hp1", math_min(getd("hp1")+40, 100));
					a.set("hp", getd("hp")+40);
					
				}// Clean up.
				
				// 10:56 PM 10/14/2015: Change the below to not care so much about gloc, so we can have random encounter after clearing this part?
				if(gloc==1 and random(0, 2400)==666 and clearDead()) {
					uint alive=0;
					for(uint i=2; i<6; i++) {
						a.set("hp" + i, random(-15, 50));
						a.set("x" + i, me.x+random(-10, 10));
						a.set("y" + i, me.y+random(-10, 10));
						a.set("z" + i, (me.z<-3 and me.x>350 and me.x<450 and me.y>440 and me.y<470) ? -13.0 : 0.0);
						vector enemy(getd("x" + i), getd("y" + i), getd("z" + i));
						if(getd("hp" + i)>0) {
							alive++;
							a.set("name" + i, (me.z<-3 and me.x>350 and me.x<450 and me.y>400 and me.y<500) ? "Jannaean Soldier" : "Bandit");
							
							playsound((gets("name" + i) == "Bandit") ? (sounds + "MHI/swing_med" + random(0, 5) + ".ogg") : (sounds2 + "javelin_toss_0" + random(1, 4) + ".wav"), enemy.x, enemy.y, enemy.z, false);
							enemy=desertmove(enemy, get_vector(0, 0, -1), 0.04, false);
							setPose(i, enemy);
							wait(100);
						}// Ugh.
						if(getd("hp" + i)>0 and gets("name" + i)=="Bandit") for(uint j=0; j<map.length(); j++) {
							if(map[j].contains(enemy)) {
								Box2@ b=cast<Box2>(map[j]);
								if(@b!=null) a.set("z" + i, b.getTop(enemy.x, enemy.y));
								if(@b!=null) continue;
								Sphere@ s=cast<Sphere>(map[j]);
								if(@s!=null) a.set("z" + i, s.z-square_root( s.radius*s.radius - distance2(enemy, s.getCenter())));
								if(@s!=null) continue;
								Box@ b2=map[j].getBounds(); // Default.
								a.set("z" + i, b2.z+b2.depth);
							}// GAAAAH! NO! NOT 9 LEVELS DEEP!
						}// Don't let them spawn inside solid objects.
					}// Enemy loop.
					
				}// Attacks.
				
				if(me.y<500-me.x) {
					gloc=7+math_max(0, gloc-5); // Hopefully?
					stage=0;
					a.set("gloc", gloc);
					a.set("stage", 0);
					fade_all(0.33);
					pool.destroy_all();
					scapeme(false);
				}// Go back to stage 0. Warning! Gloc!
				
				if(bgm.active and !bgm.playing) playsong("downloads/Mystic Land.ogg", true);
			}; break;
		}// stageswitch in step.
		pool.update_listener_3d(me.x, me.y, me.z);
		a.set("gloc", gloc);
		
		if(gets("mode")=="move") fight(dt);
					if(a.exists("swordslot")) {
						// Maybe this goes in move, eh?
		if(stage>0 and geti("swordslot")>=0 and absolute(me.x-getd("swordx"))<=1.5 and absolute(me.y-getd("swordy"))<=1.5 and absolute(me.z-getd("swordz"))<=1.5) {
							//fadeout(0.5);
							a.set("sword", stage); // ... Yeah.
							a.set("skills", geti("skills")|(1<<stage));
							//sting(1);
							bgm.volume=bgm.volume-5;
							voice.speak_interrupt_wait(sdescs[stage]);
							wait(500);
							playsound("downloads/31712_Science_Fiction_Computing_Digital_Ascend_01.wav", false);
							pool.destroy_sound(geti("swordslot"));
							a.set("swordslot", -1);
							wait(1250);
							voice.speak_interrupt_wait("(Gained Skill " + stage + ": " + skills[stage]);
							bgm.volume=bgm.volume+5; //?
						}// Got sword.
		}// Sword.
		
		if(stage>1 and key_down(KEY_R)) radar(dt*0.001);
	}// Game.
	
}// step.
void new_game(int slot) {
	// Yeah, This is going to be annoying. Does dictionary serialization actually work?
	
	a.set("slot", slot);
	a.set("x", 0);
	a.set("y", 0);
	a.set("z", 0); // Uuugh.
	a.set("loc", "game");
	a.set("stage", 0);
	a.set("ychar", "Remeel");
	a.set("gloc", 0);
	a.set("hp", 100);
	a.set("e", 0);
	a.set("skills", 0);
	
	
	fade_all();
	scapeme();
	
}// New Game.
void load_game(int slot) {
	file fin;
	fin.open("trisave" + slot + ".dat", "rb");
	string txt=fin.read(0);
	fin.close();
	a=deserialize(string_decrypt(txt, "Perfect fusion I siagree!"));
	// Umm.
	// This requires more work. Sure, everything is set correctly, but we might want to set up some other things, like music and stuff.
	fade_all();
	scapeme(false); // Should handle most of it? I'm not sure about cutscenes and such.
}// Load.
void save_game(int slot=-1) {
	if(slot<1) slot=geti("slot");
	if(slot<1) {
		alert("ERROR", "Tried to save with no slot.");
		return;
	}
	string txt=serialize(a);
	file fout;
	fout.open("trisave" + slot + ".dat", "wb");
	fout.write(string_encrypt(txt, "Perfect fusion I siagree!"));
	fout.close();
}


void scapeme(bool scene=true) {
	
	int stage=geti("stage");
	int gloc=geti("gloc");
	switch (stage) {
		case 0 : {
			//sound@ wind=getsound(sounds2 + "ambient - high quality/windheavy_01.wav");
			//wind.play();
			pool.play_extended_3d(sounds2 + "ambient - high quality/windheavy_01.wav", 0, 0, 30, 0, 0, 30, 5000, 5000, 1000, 1000,
true, 0,
0, 0, 100);
			pool.play_3d(sounds2 + "gulls_03.wav", 0, 0, 30, -10, 0, 5, true);
			pool.play_3d(sounds2 + "gulls_04.wav", 0, 0, 30, 10, 5, 5, true);
			pool.play_3d(sounds2 + "gulls_06.wav", 0, 0, 30, -3, 10, 5, true);
			a.set("slot1", pool.play_3d(sounds2 + "ambient - high quality/beach_01.wav", 0, 0, 30, 0, 15, 0, true)); // This should reposition itself to always be at the shortest distance between the player and the beach.
			a.set("slot2", pool.play_3d(sounds2 + "ambient - high quality/beach_01.wav", 0, 0, 30, 0, 25, 0, true)); // Likewise. Islands have radius 15, the beach sound is a ring 10 thick.
			pool.play_extended_3d(sounds2 + "ambient - high quality/brook_01.wav", 0, 0, 30, 75, 300, 0, 0, 200, 5, 5, true, 0, 0, 0, 100);
			pool.play_extended_3d(sounds2 + "ambient - high quality/river_01.wav", 0, 0, 30, 65, 255, 0, 0, 10, 0, 50, true, 0, 0, 0, 100);
			playsong("downloads/217846__soughtaftersounds__film-score-soundscape-stray.wav", false);
			if(scene) wait(500);
			double[] islands={ 30, 100,
 100, 10,
 -25, -60,
 -50, -110,
 10, -180,
 70, -160,
 -128, 15,
 200, 0,
 -10, 200,
 -80, 100,
 -20, 125
 }; // islands. Ugh.
			pool.play_extended_3d(sounds2 + "gulls_03.wav", 0, 0, 0, 30, 100, 0, 25, 25, 25, 25, true, 0, 0, 0, 100);
			pool.play_extended_3d(sounds2 + "gulls_01.wav", 0, 0, 0, 30, 100, 10, 25, 25, 25, 25, true, 0, 0, 0, 100);
			for(uint i=0; i<islands.length(); i+=2) pool.play_extended_3d(sounds2 + "gulls_0" + ((i%6)+1) + ".wav", 0, 0, 0, islands[i]+random(-15, 15), islands[i+1]+random(-15, 15), random(4, 10), 5, 5, 5, 5, true, 0, 0, 0, 100);
			// Trees?
			double[] trees={
 -100, 275, -89, 276, -78, 277, -67, 278, -56, 280, -43, 280, -38, 299, -25, 285, -14, 286, -5, 279,
 50, 280, 80, 277, 80, 288, 90, 290, 100, 280, 105, 286, 55, 300, 44, 295, 33, 284,
 75, 310, 85, 311, 96, 311, 107, 312, 120, 310, 124, 290, 120, 280, 136, 310, 136, 280,
 50, 300, 45, 295, 40, 300, 33, 305, 25, 307, 20, 311, 15, 315, 10, 312, 5, 317, -1, 315, -3, 305, -7, 311, -10, 315, -11, 290, -14, 302, -17, 311, -20, 315, -15, 320, -25, 316, -30, 320, -44, 333, -50, 340, 0, 330, 10, 320,
 -101, 285, -90, 290, -110, 285, -120, 300, -129, 305
 };
			for(uint i=0; i<trees.length(); i+=4) {
				if(i==4) pool.play_extended_3d(sounds2 + "ambient - high quality/windlight_01.wav", 0, 0, 30, trees[i], trees[i+1], 4, -20, 20, -7, 10, true, 0, 0, 0, 100);
				else if(i%12==0) pool.play_extended_3d(sounds2 + "ambient - high quality/birdssparse_01.wav", 0, 0, 30, trees[i], trees[i+1], 5, 7, 7, 7, 7, true, 0, 0, 0, 100);
			}// Every tree does not get a sound, because I said so.
			
			// Lake?
			// House?
			// 4:38 PM 10/15/2015: Add the entrance to Ben Yam's hideout.
			pool.play_extended_3d("juskiddink__waves-caves2.ogg", 0, 0, 30, 180, 255, -16, 20, 15, 5, 5, true, 0, 0, 0, 200);
			pool.play_extended_3d("juskiddink__waves-caves2.ogg", 0, 0, 30, 180, 255, -16, 20, 15, 5, 5, true, 0, 0, 0, 50);
			pool.play_extended_3d("juskiddink__waves-caves2.ogg", 0, 0, 30, 180, 255, -16, 20, 15, 5, 5, true, 0, 0, 0, 50); // Umm. I guess. that's... pretty clear?
			//pool.max_distance=70; // Just... you know.
			// Angel sword? I do not feel great about this. I'm assuming there will be multiples, because multiple angels fell.
			if(a.exists("sword")==false) {
				a.set("swordx", random(-100, 100));
				a.set("swordy", random(-100, 200));
				double nd=9000;
				vector sword(getd("swordx"), getd("swordy"));
				for(uint i=0; i<islands.length(); i+=2) {
					vector island(islands[i], islands[i+1]);
					double next=distance2(island, sword);
					if(next<nd) nd=next;
				}// Position the sword vertically. It's at the bottom.
				sword.z=((nd<=625) ? 0 : math_max(-25, -absolute(square_root(nd)-25)));
				a.set("swordz", sword.z);
				a.set("swordslot", pool.play_3d("downloads/39540_Sound_DesignAngelMagicPixie_Dust_MoveTinkly_8.wav", 0, 0, 30, sword.x, sword.y, sword.z, true));
				clipboard_copy_text("(Debug): " + sword.x + ", " + sword.y + ", " + round(sword.z, 0));
			}// Sword in the ocean.
			
			if(!scene) {
				playBGM(0);
				return; // Umm...
			}// No scene.
			for(int i=30; i>=0; i--) {
				//wind.volume=wind.volume-1; // Oh, I'm now hoping this doesn't get graphics.
				pool.update_listener_3d(0, 0, i);
			if(i>30) {alert("Error", "Wrong direction."); exit();}
			else if(i<0) {alert("Error", "Too far."); exit();}
				wait(40);
			}// Fade wind.
			playsound(steps + "sand/fall4.wav");
