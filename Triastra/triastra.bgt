vector tunnelmove(vector me, vector v, double dt, bool falling=false, int stage=1) {
	vector next=me+(v*dt);
	
	int nearest=-1;
	int inside=-1;
	double nd=12345678;
	
	string terrain="sky";
	bool move=false;
	bool player=(floor(me.x)==pool.last_listener_x and floor(me.y)==pool.last_listener_y and ceiling(me.z)==pool.last_listener_z);
	vector tempnext;
	bool rotmove=false;
	for(uint i=0; i<map.length(); i++) {
		double d=dist3d2(me, map[i].getCenter());
		if(d<=nd) {
			nearest=i;
			nd=d;
		}// Nearest to center.
		
		if(map[i].contains(me)) {
			inside=i;
			if(map[i].contains(next)==false) {
				// One exception: I want you to walk on the curves of cylinders and conics. No idea how to make this work. Maybe just move next toward center? ... *Sigh*
				Cylinder@ cy=cast<Cylinder>(map[i]);
				if(@cy!=null) {
					// Am I going to have to use a line3d? I don't wanna!
					// Is there a faster way--like, since we know the axis, we can just... *Sigh* never mind, I'll get the angles and multiply, of course.
					if(cy.axis==ZAXIS) {
						continue; // I was hoping for landing, but you might be going down into something else. Gah!
					}// These are easiest.
					vector av((cy.axis==XAXIS) ? next.z : next.x, (cy.axis==YAXIS) ? next.z : next.y);
					double theta=get_angle(get_vector((cy.axis==XAXIS)? cy.z : cy.x, (cy.axis==YAXIS) ? cy.z : cy.y), av); // Right?
					av=get_vector(cosine(theta)*cy.radius, sine(theta)*cy.radius);
					if(av.x<0) av.x+=0.001;
					else if(av.x>0) av.x-=0.001;
					if(av.y>0) av.y-=0.001;
					else if(av.y<0.0) av.y+=0.001; // Umm...?
					if(cy.axis==YAXIS) tempnext=get_vector(cy.x+av.x, next.y, cy.z+av.y);
					else if(cy.axis==XAXIS) tempnext=get_vector(next.x, cy.y+av.y, cy.z+av.x);
					if(cy.contains(tempnext)) rotmove=true;
					if(rotmove) terrain=jla + "steps/dirt";
					if(!move) clipboard_copy_text("Debug: " + str(cy.getCenter()) + ", axis " + cy.axis + ", radius " + cy.radius + ". Next is " + str(next) + ". ");
				}// Cylinders.
			}// Don't move.
			else {
				move=true;
				if(i==9) {
					a.set("desc", "A small island in this underground lake.");
					terrain=jla + "steps/dirt";
					continue; // Umm.
				}// Island, so easy.
				Sphere@ s=cast<Sphere>(map[i]);
				if(@s!=null) {
					// Does "is not" work in BGT?
					vector c=s.getCenter();
					if(next.z<c.z) {
						terrain=sounds + "steps/swim";
						if(me.z>=c.z) playsound(jla + "FallWater" + random(1, 4) + ".wav", me.x, me.y, me.z);
						if(player) a.set("desc", "Adrift in the dark, cold, tainted water in the depths of a cave.");
					}// Under water.
					else if(me.z<=c.z and next.z>c.z) {
						playsound(jla + "FallWater" + random(1, 4) + ".wav", me.x, me.y, me.z); // Splash for unsubmerging... Hmm.
						a.set("desc", "Above a subterranian pool of water, lapping from the pool of an unseen ocean.");
					}// This... but... wtf?
					else if(player or (player and next.z>=c.z)) a.set("desc", "Above a subterranian pool of water, lapping from the pool of an unseen ocean.");
					continue; // ????
				}// Sphere.
				Cylinder@ cy=cast<Cylinder>(map[i]);
				if(@cy!=null) {
					if(cy.axis==ZAXIS and next.z<=cy.z) {
						next.z=cy.z;
						terrain=jla + "steps/dirt"; // No puddles? Hmm.
						//terrain=steps + "water"; // Actually, they all end in water.
					}// Vertical.
					else if(cy.axis==ZAXIS and me.y>295) terrain=sounds + "steps/swim";
					else if(round(newLine3D(cy.getBase(), cy.getTop()).getDistance(next), 2)==round(cy.radius, 2)) terrain=jla + "steps/dirt"; // THIS FUNCTION IS SO INEFFICIENT!!!
					// GAH, this is so confusing!
					if(player) {
						if(cy.axis==XAXIS) a.set("desc", "In a damp. stony tunnel, running east and west.");
						else if(cy.axis==YAXIS) a.set("desc", "In a north/south tunnel, deep in the Earth.");
						else if(me.y>295) a.set("desc", "More than a trickle of water pours down on you from above.");
						else a.set("desc", "In a vertical shaft, bathed in darkness.");
						if(key_down(KEY_R)) {
							playsound((cy.z<me.z) ? "aviewer/sounds/red.wav" : "aviewer/sounds/blue.wav", cy.x, cy.y, cy.z, false);
							wait(100); // NOOO!
							vector top=cy.getTop();
							playsound((top.z<me.z) ? "aviewer/sounds/red.wav" : "aviewer/sounds/blue.wav", top.x, top.y, top.z, false);
						}// Detect exits.
					}// Descriptions.
					//else clipboard_copy_text("Not the player. Last listener position: " + pool.last_listener_x + ", " + pool.last_listener_y + ", " + pool.last_listener_z + ". Me: " + str(me) + ". ");
					continue;
				}// Cylinder.
				CappedConic@ cc=cast<CappedConic>(map[i]);
				if(@cc!=null) {
					// I have no idea how to determine if you're on the bottom. Maybe like this?
					if(round(cc.getDistance(next), 2)==round(cc.getRadius(next), 2)) {
						terrain=steps + "water";
						// Catch the case where they're stone instead?
						if(me.x>215) terrain=jla + "steps/dirt"; // Hmm.
					}// On the edge, or close enough, since these are probably wet.
					if(me.z<-23) terrain=sounds + "steps/swim";
					if(player) {
						if(key_down(KEY_R)) {
							playsound((cc.start.z<me.z) ? "aviewer/sounds/red.wav" : "aviewer/sounds/blue.wav", cc.start.x, cc.start.y, cc.start.z, false);
							wait(100); // -_-
							playsound((cc.end.z<me.z) ? "aviewer/sounds/red.wav" : "aviewer/sounds/blue.wav", cc.end.x, cc.end.y, cc.end.z, false);
						}// Radar.
						a.set("desc", "In a slanting tunnel, the streaks from water flowing down the bottom in contrast with the dryness of the ceiling.");
						if(me.x<130 or (me.z<-15 and me.x>275) or (me.y>306) or me.y<245) a.set("desc", "Swimming down the tunnel to oblivion.");
						else if(me.x<200 and me.y>290) a.set("desc", "In a narrow tunnel cut by a downpour of freshwater.");
						//else if(me.x<160) a.set("desc", "(Is that light coming from up ahead? It feels like there might be something to the " + getDir(get_angle(me, get_vector(getd("swordx"), getd("swordy"), getd("swordz")))) + "...)");
					}// Descriptions.
				}

			}// Terrain check.
		}// Inside.

	}// Map loop.
	
	if(inside<0) {
		if(nearest<0) nearest=0; // BLAH!
		playsound(steps + "stone/bump.ogg", next.x, next.y, next.z, false);
		return map[nearest].getCenter();
	}
	
	if(player and absolute(me.x-220)<=6 and me.y>280 and me.z>-9) a.set("desc", "(On the dark side of a small opening, blocked by a large boulder.)");
	if(rotmove and !move) {
		move=true;
		next=tempnext;
	}// Curves.
	
	if(move) {
		if(terrain!="sky" and (round(next.x, 0)!=round(me.x, 0) or round(next.y, 0)!=round(me.y, 0) or round(next.z, 0)!=round(me.z, 0))) playsound(terrain + "/run" + random(1, 6) + ".wav", next.x, next.y, next.z, false); // Falling?
		if(player) {
			if(terrain=="sky" and flight.playing==false) flight.play_looped();
			else if(flight.playing and terrain!="sky") {
				flight.stop();
				playsound(terrain + "/run" + random(1, 6) + ".wav", false);
			}// Landing. Umm.
		}// Flight sounds.
		return next;
	}
	else if(terrain != sounds + "steps/swim") playsound(steps + "dirt/bump.ogg", next.x, next.y, next.z, false);// Umm.
	
	return me;
}// tunnel move, mark 3.

vector desertmove(vector me, vector v, double dt, bool falling=false) {
	
	vector next=me+(v*dt);
	
	bool move=(next.z>=0.0);
	
	string terrain=(me.z<=0.0) ? (steps + "dirt") : "sky";
	bool player=(floor(me.x)==pool.last_listener_x and floor(me.y)<=pool.last_listener_y and floor(absolute(me.z))==absolute(pool.last_listener_z)); // If you're in a pit, or above a pit, enemies can cheat and be you anyway.
	vector rotmove(next.x, next.y, math_max(next.z, math_min(0.0, me.z))); // DANGER!
	int inside=-1;
	if(player and flight.playing) a.set("desc", "Above a dry, rock-strone lanscape, though there are hints of trees to the west, and many things could be hiding amid the cliffs and dunes scattered about.");
	
	for(uint i=0; i<map.length(); i++) {
		if(map[i].contains(next)) {
			inside=i;
			Sphere@ s=cast<Sphere>(map[i]);
			if(@s!=null) {
				move=true;
				rotmove=next;
				if(next.z<=0.0 and dist3d2(next, s.getCenter())>=round(s.radius*s.radius - 4, 2)) terrain=sounds + "steps/gravel";
				else terrain="sky";
				if(player) a.set("desc", "In a dry, dusty pit, in the middle of a dry, dusty landscape.");
				continue;
			}// sphere
			
			Box2@ b=cast<Box2>(map[i]);
			if(@b!=null) {
				// Basically, are you walking up a slope?
				float top=b.getTop(next.x, next.y);
				float otop=b.getTop(me.x, me.y);
				if((absolute(top-otop)<=0.1 and absolute(me.z-otop)<=0.2) or (b.contains(me)==false and (absolute(next.z-top)<=0.15 or absolute(top-b.z)<=0.2))) {
					terrain=steps + "stone";
					if(player) a.set("desc", (b.slope>=0) ? ("On a rocky slope, rising to the " + dirname(b.slope) + ".") : "Atop a boxy rock formation.");
					next.z=top;
					move=true;
				}// On Slope.
				else move=false;
				continue;
			}// Boxes.
			
			// Cylinders?
			Cylinder@ cy=cast<Cylinder>(map[i]);
			if(@cy!=null) {
				if(cy.axis==ZAXIS) {
					if(me.z>=cy.z+cy.height and next.z<cy.z+cy.height) {
						next.z=cy.z+cy.height;
						terrain=steps + "leaves";
						if(falling) playsound(sounds2 + "bodyfall_treeAB_0" + random(1, 3) + ".wav", next.x, next.y, next.z);
						move=true; // Umm?
						if(player) a.set("desc", "In a tree at the edge of a vast expanse of rocks and sand.");
						if(player and flight.playing) flight.stop(); //?
						
						continue;
					}// Landing.
					else playsound((cy.radius>1) ? "downloads/65340_Foliage_impact_medium_foliage_hit_5.wav" : (sounds + "env/hedgebump.ogg"), next.x, next.y, next.z, false);
				}// Trees.
				else if(next.z>=cy.z) {
					//double d2=distance2(get_vector((cy.axis==XAXIS) ? cy.z : cy.x, (cy.axis==YAXIS) ? cy.z : cy.y), get_vector((cy.axis==XAXIS) ? next.z : next.z, (cy.axis==YAXIS) ? next.z : next.y));
					rotmove=get_vector(next.x, next.y, absolute(cy.radius*sine(arc_cosine( ((cy.axis==XAXIS) ? (next.y-cy.y) : (next.x-cy.x))/cy.radius)))+cy.z); // Umm... should've gone with the Pythagorean theorem, ne?
					terrain=steps + "sand"; // Are you sure?
					if(player) a.set("desc", "Amid sand dunes, which seem to stretch as far as the eye can see to the southeast.");
				}// walking atop cylinders.
				//else playsound(steps + "dirt/bump.ogg", next.x, next.y, next.z, false);
			}// Cylinders.
			
			move=false;
		}// Probably the answer is no, but let's be careful.
		else if(map[i].contains(me) and !map[i].contains(next)) {
			inside=i;
			Sphere@ s=cast<Sphere>(map[i]);
			if(@s!=null and next.z<s.z) {
				move=true; // Hmm.
				double d=distance2(me, s.getCenter());
				rotmove=get_vector(next.x, next.y, s.z-square_root(s.radius*s.radius - d));
				terrain=sounds + "steps/gravel";
				next=rotmove;
			}// Walking on the bottom.
		}// Mostly just spheres.
		else if(map[i].contains(me)) {
			inside=i;
			Cylinder@ cy=(cast<Cylinder>(map[i]));
			if(@cy!=null and cy.axis==ZAXIS and round(me.z, 0)==round(cy.z+cy.height, 0)) terrain="leaves"; //?
		}// Wasteful. 4 calls to contains?
		//else if(me.z==next.z and me.z==map[i].getCenter().z+(map[i].getBounds().depth/2) and @(cast<Cylinder>(map[i]))!=null) terrain=steps + "leaves"; // ... That seems... dumb. Really, dumb.
		
	}// Map.
	
	if(inside<0 and me.z<0) {
		next.z=0.0;
		me.z=0.0;
		playsound(steps + "dirt/slide.wav", me.x, me.y, me.z);
		move=true;
	}// Underground bug.
	if(!move and me.z>0.0 and next.z<=0.0 and terrain=="sky") {
		next.z=0.0;
		move=true;
	}// landing.
	
	if(!move and rotmove!=next) {
		next=rotmove;
		move=true;
	}// Rotation things. Mostly walking on the insides of spheres.
	
	if(!move) {
		me=me-(v*dt); // Umm.
		//if(me.z>=0.0) playsound(steps + "stone/bump.ogg", next.x, next.y, next.z, false);
		return me;
	}// no move.
	
	//if(terrain!="sky" and (round(me.length(), 0) != round(next.length(), 0))) {
	if(terrain!="sky" and (round(me.x, 0) != round(next.x, 0) or round(me.y, 0)!=round(next.y, 0) or round(me.z, 0) != round(next.z, 0))) {
		// That... ur... gets around the diagonal problem, I guess. But it's slow.
		// 11:03 PM 10/4/2015: Changed because for some reason the obvious sensible method just straight-up didn't work.
		//clipboard_copy_text(terrain + ", " + str(next));
		playsound((falling) ? (terrain + "/fall" + random(1, 4) + ".wav") : (terrain + "/run" + random(1, 6) + ".wav"), next.x, next.y, next.z, false);
	}// Steps / falls.
	//else clipboard_copy_text(terrain + str(next));
	
	if(player) {
		if(terrain=="sky" and flight.playing==false) flight.play_looped();
		else if(terrain!="sky" and flight.playing) {
			flight.stop();
			if(falling) playsound(terrain + "/fall1.wav", false);
			else playsound(terrain + "/run" + random(1, 6) + ".wav", false); // Ahem.
			if(terrain==steps + "dirt") a.set("desc", "You are in the middle of a vast stretch of dust and rocks, with numerous hiding places in the shadows of countless rocky outcroppings and pits.");
		}// Land.
	}// Player stuff.
	return next;
}// Desert move. Desert, because pits, I guess.


// Since I screwed up the coordinate system, these boxes are rotated so that the xy face is the bottom, rather than xz.
class Box2 : Box {
	Box2() {}
	Box2(double xx, double yy, double zz, double w, double h, double d) {
		this.x=xx;
		this.y=yy;
		this.z=zz;
		this.width=w;
		this.height=h;
		this.depth=d;
		this.slope=-1;
	}
	
	double getTop(double xx, double zz) {
		if((xx<this.x)||(xx>this.x+this.width)||(zz<this.y)||(zz>this.y+this.height)) return MIN_VALUE;
		if((slope<0)||(slope>=32)) return this.z+this.depth;
		
		double ret=this.z+this.depth;
		
		if(this.slope==east) ret = (this.depth*((xx-this.x)/this.width))+this.z;
		else if(this.slope==west) ret = (-this.depth*((xx-this.x)/this.width))+(this.z+this.depth);
		else if(this.slope==north) ret = (this.depth*((zz-this.y)/this.height))+this.z;
		else if(this.slope==south) ret = (-this.depth*((zz-this.y)/this.height))+(this.z+this.depth);
		// Intermediates and inversions are not important enough to bother with right now?
		return round(ret, 3);
	}// Get top
	
	// Returns 0 if the boxes collide, but b is not atop this,
	// 1 if b is resting atop this,
	// and -1 if b does not collide with this.
	int atop(Box@ b) {
		// This checks to see if the collision qualifies as b resting atop this.
		if(!this.collide(b)) return -1;
		if(b.z<this.z) return 0;
		
		// Now. For it to be atop, there must be one line of intersection, and it must have a constant y value of whatever getTop is at that point.
		// The line must be along either the x or the y axis, but that kinda goes without saying.
		// Well, actually, there is one other case:
		
		if(this.slope<0) return (b.z==this.z+this.depth) ? 1 : 0;
		
		// 5:13 AM 5/3/2012: I'm getting sick of bugs with slopes, so I'm doing this drastic thing:
		b.z=round(b.z, 3); // Oh nos precision~!
		// In other cases, we pretty much need to check every possibility. Boo.
		
		int ret=0;
		vector p(this.x+this.width, this.y+this.height, this.z+this.depth);
		vector q(b.x+b.width, b.y+b.height, b.z+b.depth);
		// switch (~( (~slope)|(up|down) ) ) {
		switch (this.slope) {
		case east : {
			if(this.x+this.width<b.x+b.width) ret = (b.z==this.z+this.depth) ? 1 : 0;
			else ret = (b.z==getTop(b.x+b.width, this.y)) ? 1 : 0;
		}; break;
		case west : {
			if(this.x>b.x) ret = (b.z==this.z+this.depth) ? 1 : 0;
			else ret = (b.z==getTop(b.x, this.y)) ? 1 : 0;
		}; break;
		case north : {
			if(this.y+this.height<b.y+b.height) ret = (b.z==this.z+this.depth) ? 1 : 0;
			else ret = (b.z==getTop(this.x, b.y+b.height)) ? 1 : 0;
		}; break;
		case south : {
			if(this.y>b.y) ret = (b.z==this.z+this.depth) ? 1 : 0;
			else ret = (b.z==getTop(this.x, b.y)) ? 1 : 0;
		}; break;
		default : {
			// Default.
			if(b.z==this.z+this.depth) ret=1;
		}
		}// Slope switch.
		
		return ret;
	}// On Top.
	
	// Update collision and junk.
	// Contains already ignores getTop, though. -_-.
}// Box2.
Box2@ newBox2(double x, double y, double z, double w, double h, double d, int slope=-1) {
	Box2 ret(x, y, z, w, h, d);
	ret.slope=slope;
	return ret;
}


string dirname(int dir) {
	return (dir==east) ? "east" : (dir==west) ? "west" : (dir==south) ? "south" : (dir==north) ? "north" : "unknown direction";
}

void swordset(vector sword) {
	a.set("swordx", sword.x);
	a.set("swordy", sword.y);
	a.set("swordz", sword.z);
	a.set("swordslot", pool.play_3d("downloads/39540_Sound_DesignAngelMagicPixie_Dust_MoveTinkly_8.wav", pool.last_listener_x, pool.last_listener_y, pool.last_listener_z, sword.x, sword.y, sword.z, true));
}

// The radar in stage 1 is annoyingly primative. Let's make a new one:
void radar(double dt) {
	double counter=getd("rc");
	int index=geti("ri");
	int stage=geti("stage");
	if(index<0) index=0;
	counter-=dt;
	if(counter<=0.0) {
		vector me(pool.last_listener_x, pool.last_listener_y, pool.last_listener_z);
		
		if(stage==0) {
			// Point toward islands and trees?
			// I'm a little worried that we'll want it to point toward where you need to go--abandoned island, clearing, seacave. Hm.
			counter=0.14;
			a.set("rc", counter);
			a.set("ri", index);
			return;
		}// Stage 0 is kinda weird.
		bool cont=true;
		
		for(int i=index; i<map.length(); i++) {
			index=i;
			if(map[i].contains(me) or dist3d2(me, map[i].getCenter())<=225) {
				string toplay="aviewer/sounds/blue.wav";
				string below="aviewer/sounds/red.wav";
				vector pose=map[i].getCenter();
				Sphere@ s=cast<Sphere>(map[i]);
				if(@s!=null) {
					if(stage==1) {
						// Find intersecting tunnels.
					}
					else {
						toplay="aviewer/sounds/white.wav";
						below="aviewer/sounds/black.wav";
						double theta=get_angle(pose, me);
						double phi=get_angle(get_vector(pose.x, pose.z), get_vector(me.x, me.z)); // Does that work?
						if(s.contains(me)) pose=me; // Maybe having it point out isn't a bad idea, though?
						else pose=s.getCenter()+(s.radius*get_vector(cosine(theta), sine(theta), sine(phi)));
						//clipboard_copy_text(toplay + str(pose));
					}// Hmm.
					cont=false;
				}// Spheres are weird.
				Box2@ b=cast<Box2>(map[i]);
				if(cont and @b!=null and b.slope>=0) {
					toplay="aviewer/sounds/yellow.wav";
					below="downloads/14776_Triangle_02_Restrained_06.wav";
					if(me.x<b.x) pose.x=b.x;
					else if(me.x>=b.x+b.width) pose.x=b.x+b.width;
					else pose.x=me.x;
					if(me.y<b.y) pose.y=b.y;
					else if(me.y>=b.y+b.height) pose.y=b.y+b.height;
					else pose.y=me.y;
					pose.z=b.getTop(pose.x, pose.y);
					if(me.z<b.z) pose.z=b.z;
					else if(me.z<pose.z) pose.z=me.z;
					// But, is there a way to indicate the height of the slope?
					cont=false;
				}// Sloped box.
				Cylinder@ cy=cast<Cylinder>(map[i]);
				if(cont and @cy!=null and stage==1) {
					pose=cy.getTop();
					playsound((cy.z<me.z) ? below : toplay, cy.x, cy.y, cy.z, false);
					wait(10);
				}// Tunnels.
				else if(@cy!=null) {
					if(cy.contains(me)) pose=me;
					else {
						// We need an angle.
						double theta=get_angle(get_vector((cy.axis==XAXIS) ? cy.z : cy.x, (cy.axis==YAXIS) ? cy.z : cy.y), get_vector((cy.axis==XAXIS) ? me.z : me.x, (cy.axis==YAXIS) ? me.z : me.y));
						if(cy.axis==XAXIS) {
							if(me.x<cy.x) pose.x=cy.x;
							else if(me.x>cy.x+cy.height) pose.x=cy.x+cy.height;
							else pose.x=me.x;
							if(absolute(me.y-cy.y)<=cy.radius) pose.y=me.y;
							else pose.y=cy.y+cy.radius*sine(theta);
							if(absolute(me.z-cy.z)<=cy.radius) pose.z=me.z;
							else pose.z=cy.z+cy.radius*cosine(theta);
						}// AAARRRGGGHHH!
						else if(cy.axis==YAXIS) {
							if(me.y<cy.y) pose.y=cy.y;
							else if(me.y>cy.y+cy.height) pose.y=cy.y+cy.height;
							else pose.y=me.y;
							if(absolute(me.x-cy.x)<=cy.radius) pose.x=me.x;
							else pose.x=cy.x+cy.radius*cosine(theta);
							if(absolute(me.z-cy.z)<=cy.radius) pose.z=me.z;
							else pose.z=cy.z+cy.radius*sine(theta);
						}// Y.
						else if(cy.axis==ZAXIS) {
							if(me.z<cy.z) pose.z=cy.z;
							else if(me.z>cy.z+cy.height) pose.z=cy.z+cy.height;
							else pose.z=me.z;
							if(absolute(me.y-cy.y)<=cy.radius) pose.y=me.y;
							else pose.y=cy.y+cy.radius*sine(theta);
							if(absolute(me.x-cy.x)<=cy.radius) pose.x=me.x;
							else pose.x=cy.x+cy.radius*cosine(theta);
						}// ZZAXIS.
					}// Ugh.
					cont=false;
				}// Get closest point to player.
				
				// Conics are hard!
				CappedConic@ c=cast<CappedConic>(map[i]);
				if(cont and @c!=null and stage==1) {
					pose=c.start;
					playsound((c.end.z<me.z) ? below : toplay, c.end.x, c.end.y, c.end.z);
					wait(10); // GRR.
					cont=false;
				}// Tunnels.
				
				if(cont) {
					Box@ b2=map[i].getBounds();
					if(me.x<b.x) pose.x=b.x;
					else if(me.x>b.x+b.width) pose.x=b.x+b.width;
					else pose.x=me.x;
					if(me.y<b.y) pose.y=b.y;
					else if(me.y>=b.y+b.height) pose.y=b.y+b.height;
					else pose.y=me.y;
					if(me.z<b.z) pose.z=b.z;
					else if(me.z>b.z+b.depth) pose.z=b.z+b.depth;
					else pose.z=me.z;
					cont=false;
				}// Default.
				
				playsound((pose.z<me.z) ? below : toplay, pose.x, pose.y, pose.z, false);
				index++;
				if(index>=map.length()) index=0;
				break;
			}// Found.
			index++;
			if(index>=map.length()) index=0;
		}// Loop.
		counter=0.14; //?
	}// Tick.
	a.set("rc", counter);
	a.set("ri", index);
}// radar.

void setPose(int i, vector p) {
	if(i<0) {
		a.set("x", p.x);
		a.set("y", p.y);
		a.set("z", p.z);
		return;
	}// player.
	a.set("x" + i, p.x);
	a.set("y" + i, p.y);
	a.set("z" + i, p.z);
}
vector getPose(int i) {
	if(i<0) return get_vector(getd("x"), getd("y"), getd("z"));
	return get_vector(getd("x" + i), getd("y" + i), getd("z" + i));
}

// Repeat the above for velocities.
