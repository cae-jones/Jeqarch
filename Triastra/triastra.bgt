					if(move and me.z>tunnels[i].z) pool.play_3d(jla + "FallWater" + random(1, 4) + ".wav", pool.last_listener_x, pool.last_listener_y, pool.last_listener_z, me.x, me.y, me.z, false);
				}// Swimming.
			}// We are inside!
			clipboard_copy_text(clipboard_read_text() + "\r\n" + i + "-" + t + ": d=" + d + ", nd=" + nd + ", nearest=" + nearest + ", inside=" + inside);
		}// Cunnels loop.
		
		if(inside<0) {
			pool.play_3d(steps + "stone/bump.ogg", pool.last_listener_x, pool.last_listener_y, pool.last_listener_z, me.x, me.y, me.z, false);
			clipboard_copy_text(clipboard_read_text() + "\r\nNot inside anything. Nearest = " + nearest + ", at " + tunnels[nearest].x + ", " + tunnels[nearest].y + ", " + tunnels[nearest].z + ". Moving from " + me.x + ", " + me.y + ", " + me.z + ".");
			if(tunnels[nearest].y<=0) {alert("ERROR", "You bounced into oblivion, somehow. dt=" + dt + ", v=(" + v.x + ", " + v.y + ", " + v.z + "), destination was " + next.x + ", " + next.y + ", " + next.z + ". I have no idea how to catch the teleportation in action. T.T"); exit();}
			return tunnels[nearest];
		}// You are in the middle of solid earth.
		else if(!move) {
			// Move to the nearest point on inside. This is kinda obnoxious.
			if(inside%4==2) {
				if(next.z<tunnels[inside].z-10) {
					next.z=tunnels[inside].z-10;
					move=true;
					playsound( (steps + "water/run" + random(1, 6) + ".wav"), next.x, next.y, next.z, false); // Jeqocon2: was random(1, 9), there are 6
				}// Landing.
				else {
					playsound(steps + "dirt/bump.ogg", next.x, next.y, next.z, false);
					move=false; // How to prevent rapid bumping?
					me-=v*(dt*2.0); // Buys us two frames, at least.
				}// Bumping the walls.
			}// vertical tunnels.
			else if(inside%4==3) {
				
				move=false; // That all?
				if(next.z>tunnels[inside].z) {
					playsound(steps + "dirt/bump.ogg", next.x, next.y, next.z, false);
					me-=v*(dt*3); // You know, it occurs to me that this could bounce one into weird places.
				}//Bumping the ceiling. 
			}// Spherical pools.
			else {
				if(next.z>tunnels[inside].z) {
					playsound(steps + "dirt/bump.ogg", next.x, next.y, next.z, false);
					me-=v*(3.0*dt);
					if(me.y<200 or me.x<100 or me.z>0) alert("OOPS!", "This is not supposed to happen! " + str(me+(v*(3*dt))) + ", currently " + str(me) + ", v=" + str(v) + ", and v*3*dt = " + str(v*(3*dt)) + ". ");
					move=false;
				}// This part is easy.
				else if((inside%4==0 and absolute(next.x-tunnels[inside].x)>10) or (inside%4==1 and absolute(next.y-tunnels[inside].y)>10)) {
					playsound(steps + "stone/bump.ogg", next.x, next.y, next.z, false);
					me-=v*(3*dt);
				}// Tunnel ends.
				else {
					vector c((inside%4==0) ? tunnels[inside].x : tunnels[inside].y, tunnels[inside].z);
					vector targ((inside%4==0) ? next.x : next.y, next.z);
					double theta=get_angle(c, targ);
					targ.x=5.0*cosine(theta);
					targ.y=5.0*sine(theta);
					next.z=targ.y;
					if(inside%4==0) next.x=targ.x;
					else next.y=targ.x;
					move=true;
					terrain=steps + "stone";
				}// This part is annoying.
			}// Horizontal tunnels.
		}// This could nullify movement entirely, or it might not.
		
		// Oh, make sure the player is flying.
		if(me.x==pool.last_listener_x and me.y==pool.last_listener_y and me.z==pool.last_listener_z) {
			if(terrain=="sky" and flight.playing==false) flight.play_looped();
			else if(flight.playing and terrain!="sky") {
				flight.stop();
				playsound(terrain + "/run" + random(1, 6) + ".wav", false); // Hmm. Landing sounds, though?
			}// stop flying.
		}// At the player's position, which is not the same as being the player, but accomplishes the same thing.
		if(move) {
			
			// Are we walking? Probably not.
			if(nd>24) {
				if(inside%4==2 and next.z<=tunnels[inside].z-10) terrain=steps + "water";
				else if(inside%4<2 and (nd>24.8)) {
					vector axis((inside%4==0) ? tunnels[inside].x : tunnels[inside].y, tunnels[inside].z);
					vector temp((inside%4==0) ? next.x : next.y, next.z);
					if(round(distance2(axis, temp), 2)==25.00) terrain=steps + "stone";
				}// Tunnel walking.
			}// No point in checking if we're closer than that, right?
			
			// We want to know if we've moved one step. However, that could get... weird.
			if(terrain!="sky" and (round(me.x, 0)!=round(next.x, 0) or round(me.y, 0)!=round(next.y, 0) or round(me.z, 0)!=round(next.z, 0))) playsound(terrain + "/run" + random(1, 6) + ".wav", next.x, next.y, next.z, false);
			return next;
		}// Moving.
		
		return me;
}// Moving in the tunnels of stage 1.
*/

// This does not include changes in velocity due to terrain, swimming, or flying.
vector keyV() {
	vector v(getd("vx"), getd("vy"), getd("vz"));
	double dx=v.x, dy=v.y, dz=v.z; // Oopse. I meant to use a vector.
	
	if(string_contains("fallstun", gets("act"), 1)%4==0) {
		// GRAVITY!
		return v;
	}// Stunned or falling.
	
	bool changeFace=true;
	if(key_down(KEY_LEFT) or key_down(KEY_A)) dx=-1.0;
	else if(key_down(KEY_RIGHT) or key_down(KEY_D)) dx=1.0;
	if(key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)) {
		changeFace=false;
		dx*=1.5;
		if(key_down(KEY_W) or key_down(KEY_UP)) dz+=3.0;
		else if(key_down(KEY_DOWN) or key_down(KEY_S)) dz=-3.0;
	}// shift.
	else if(key_down(KEY_W) or key_down(KEY_UP)) dy=1.0;
	else if(key_down(KEY_DOWN) or key_down(KEY_S)) dy=-1.0;
	
	dx*=4.0;
	dy*=4.0;
	/*if(a.exists("act") and string_contains("fallstun", gets("act"), 1)%4==0) {
		dx=v.x*dt;
		dy=v.y*dt;
		dz=v.z;
		// Gravity? *Sigh*
		changeFace=false;
	}// Stunned or falling.
	*/
	//dz*=dt;
	
	// Rotate for targets.
	// 5:10 PM 9/27/2015: But what about things like running water, etc, that affect absolute velocity? -_-
	if(geti("targ")>=0) {
		// I don't like this. I don't like this at all. 
		int targ=geti("targ");
		// If the target doesn't exist, you shouldn't be locked on to it? ... But what about... loot and things? Do defeated enemies drop things?
		if(getd("hp" + targ)>0.0) {
			vector you(getd("x" + targ), getd("y" + targ), getd("z" + targ));
			vector me(getd("x"), getd("y"), getd("z"));
			// So, we want to rotate (dx, dy, dz) to point at you. Or, rather, so that it's y axis points at you.
			// Though, honestly, I'd prefer not to mess with left/right, but whatever.
			// So, dx is perpendicular to theta... what's theta, anyway?
			double theta=get_angle(me, you);
			// Umm... dz? *Sigh*.
			// I now need to rotate (dy, dz), don't I? DY is currently all your forward/backward velocity, but it's parallel to the ground.
			// Luckily, it's as simple as ... umm... I think it works like this?
			// Actually, we need.. *sigh* this:
			double phi=get_angle(get_vector(0,0,0), get_vector(square_root(distance2(me, you)), you.z-me.z));
			dz+=dy*sine(phi); // Presumably, any changes to dz are absolute and additive.
			dy*=cosine(phi); // I hope.
			
			vector rv=rotate(get_vector(dx, dy, dz), get_vector(0,0,0), theta-(PI/2.0)); // I... hope...? Might need to tweak the offset?
			dx=rv.x;
			dy=rv.y;
			
			// That was an abomination. Matrix transformations are probably much faster, and I really wish I could teach myself to do them.
		}
	}// Targeting.
	else if(changeFace) {
		if(dx>0) a.set("face", (dy>0) ? "NE" : (dy<0) ? "SE" : "E");
		else if(dx<0) a.set("face", (dy>0.0) ? "NW" : (dy<0.0) ? "SW" : "W");
		else if(dy<0.0) a.set("face", "S");
		else if(dy>0.0) a.set("face", "N");
	}// Change Face.
	
	/*if(terrain=="sky") {
		dx*=1.5;
		dy*=1.5;
	}
	else if(string_contains(terrain, "swim", 1)>=0) {
		dx*=0.6;
		dy*=0.6;
		dz*=0.6;
	}// swimming.
	*/
	
	
		//clipboard_copy_text("DX:" + dx + ", DY:" + dy + "DZ:" + dz);
	
	
	return get_vector(dx, dy, dz);
}// KeyV.

double dist3d2(vector v1, vector v2) {
	vector v=v2-v1;
	return v.x*v.x + v.y*v.y + v.z*v.z;
}// Leaving out parentheses always makes me nervous.

int playsound(string fn, double x, double y, double z, bool looping=false) {
	log_sound(fn);
	return pool.play_3d(fn, pool.last_listener_x, pool.last_listener_y, pool.last_listener_z, x, y, z, looping);
}// Playsound 3d.

string str(vector v) {
	return "(" + v.x + ", " + v.y + ", " + v.z + ")";
}


