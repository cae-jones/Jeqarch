Shape3D@[] map;
dictionary voices;

void set_voices(string v0, string v1="", string v2="", string v3="", string v4="", string v5="", string v6="") {
	string[] v={v0, v1, v2, v3, v4, v5, v6};
	dynamic_menu vm;
	pool.pause_all();
	for(uint i=0; i<v.length(); i++) {
		if(v[i]!="") {
			vm.add_item_tts((v[i]=="Ramiel") ? "Player" : v[i], v[i]);
			custom_voice@ cv;
			custom_voice temp;
			@cv=temp;
			cv.load_config("tri_" + v[i] + ".cfg");
			cv.config_path="tri_" + v[i] + ".cfg";
			voices.set(v[i], @cv);
		}// Gah!
	}// loop.
	vm.add_item_tts("OK", "OK");
	vm.wrap=false;
	vm.enable_home_and_end=true;
	vm.allow_escape=true;
	vm.set_callback(main_callback, "");
	playsound(jla + "menu/submenu.wav", false);
	bgm.volume=bgm.volume-4;
	wait(300);
	int n=1;
	while(n>0 and n<vm.get_item_count()) {
		n=vm.run("Set character voices:", true);
		if(n<=0) break;
		string id=vm.get_item_name(n);
		if(id=="OK") break;
		else {
			custom_voice@ cv;
			custom_voice temp;
			@cv=temp;
			if(voices.exists(id)) voices.get(id, @cv); // Question: do we need the @ sign?
			string fn="tri_" + id + ".cfg";
			cv.load_config(fn);
			cv.config_path=fn;
			cv.options_menu();
			voices.set(id, cv);
		}
	}// loop.
	
	playsound(jla + "menu/activate.wav", false);
	wait(500);
	bgm.volume=bgm.volume+4;
	pool.resume_all();
}// Set voices.
