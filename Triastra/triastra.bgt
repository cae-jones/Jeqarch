int playsound(string fn, bool looping=false) {
	log_sound(fn);
	return pool.play_stationary(fn, looping);
}
int playsound(string fn, double lx, double ly, double sx, double sy, bool looping, bool persistent=false) {
	log_sound(fn);
	return pool.play_2d(fn, lx, ly, sx, sy, looping, persistent);
}

void fadeout(double time=1.0) {
	double delay=time*20.0; // Still feels wrong.
	while(bgm.volume>-50) {
		bgm.volume=bgm.volume-1;
		wait(delay);
	}
}

double get_angle(vector o, vector p) {
	// Return the angle of p, where o represents the origin.
	// I don't think there's any better way to do this than atan. I'm doing this every frame in the intro. Aaaaaargh.
	double dx=p.x-o.x;
	double dy=p.y-o.y;
	// Ignore z.
	if(dx==0.0) return (dy>0.0) ? PI/2 : -PI/2;
	double ret =arc_tangent(dy/dx);
	if(dx<0) ret+=PI;
	if(ret>PI) ret-=2.0*PI;
	return ret;
}// get angle.


void move(vector me, vector v, string terrain, double dt, bool groundzero=true) {
	
	groundzero=false; // too annoying.
	double dx=v.x, dy=v.y, dz=v.z; // Oopse. I meant to use a vector.
	dt*=0.001; // Umm.
	
	bool changeFace=true;
	if(key_down(KEY_LEFT) or key_down(KEY_A)) dx=-1.0;
	else if(key_down(KEY_RIGHT) or key_down(KEY_D)) dx=1.0;
	if(key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)) {
		changeFace=false;
		dx*=1.5;
		if(dx!=0.0 and terrain!="sky" and (/*groundzero and*/ me.z<1.0)) {
			playsound(sounds2 + "hawk_wingstretch_0" + random(1, 4) + ".wav", false);
			dz=2.0;
		}// Quick hops left/right. I assume key pressed would handle it, but just in case...
		if(key_down(KEY_W) or key_down(KEY_UP)) dz+=3.0;
		else if(key_down(KEY_DOWN) or key_down(KEY_S)) dz=-3.0;
	}// shift.
	else if(key_down(KEY_W) or key_down(KEY_UP)) dy=1.0;
	else if(key_down(KEY_DOWN) or key_down(KEY_S)) dy=-1.0;
	
	dx*=dt*4.0;
	dy*=dt*4.0;
	if(a.exists("act") and string_contains("fallstun", gets("act"), 1)%4==0) {
		dx=v.x*dt;
		dy=v.y*dt;
		dz=v.z;
		// Gravity? *Sigh*
		changeFace=false;
	}// Stunned or falling.
	dz*=dt;
	
	// Rotate for targets.
	// 5:10 PM 9/27/2015: But what about things like running water, etc, that affect absolute velocity? -_-
	if(geti("targ")>=0) {
		// I don't like this. I don't like this at all. 
		int targ=geti("targ");
		// If the target doesn't exist, you shouldn't be locked on to it? ... But what about... loot and things? Do defeated enemies drop things?
		if(getd("hp" + targ)>0.0) {
			vector you(getd("x" + targ), getd("y" + targ), getd("z" + targ));
			// So, we want to rotate (dx, dy, dz) to point at you. Or, rather, so that it's y axis points at you.
			// Though, honestly, I'd prefer not to mess with left/right, but whatever.
			// So, dx is perpendicular to theta... what's theta, anyway?
			double theta=get_angle(me, you);
			// Umm... dz? *Sigh*.
			// I now need to rotate (dy, dz), don't I? DY is currently all your forward/backward velocity, but it's parallel to the ground.
			// Luckily, it's as simple as ... umm... I think it works like this?
			// Actually, we need.. *sigh* this:
			double phi=get_angle(get_vector(0,0,0), get_vector(square_root(distance2(me, you)), you.z-me.z));
			dz+=dy*sine(phi); // Presumably, any changes to dz are absolute and additive.
			dy*=cosine(phi); // I hope.
			
			vector rv=rotate(get_vector(dx, dy, dz), get_vector(0,0,0), theta-(PI/2.0)); // I... hope...? Might need to tweak the offset?
			dx=rv.x;
			dy=rv.y;
			
			// That was an abomination. Matrix transformations are probably much faster, and I really wish I could teach myself to do them.
		}
	}// Targeting.
	else if(changeFace) {
		if(dx>0) a.set("face", (dy>0) ? "NE" : (dy<0) ? "SE" : "E");
		else if(dx<0) a.set("face", (dy>0.0) ? "NW" : (dy<0.0) ? "SW" : "W");
		else if(dy<0.0) a.set("face", "S");
		else if(dy>0.0) a.set("face", "N");
	}// Change Face.
	
	if(terrain=="sky") {
		dx*=1.5;
		dy*=1.5;
	}
	else if(string_contains(terrain, "swim", 1)>=0) {
		dx*=0.6;
		dy*=0.6;
		dz*=0.6;
	}// swimming.
	
	if(groundzero and dz<0 and me.z<=0) dz=0.0; // Maybe change it to accept a ground value instead of a boolean?
		//clipboard_copy_text("DX:" + dx + ", DY:" + dy + "DZ:" + dz);
	
	if(dx!=0 or dy!=0 or dz!=0) {
		// I hate doing it this way, but:
		
		bool doplay=(terrain!="sky" and (round(me.x+dx, 0)!=round(me.x, 0) or round(me.y+dy, 0)!=round(me.y, 0) or round(me.z+dz, 0)!=round(me.z, 0)));
		me.x+=dx;
		me.y+=dy;
		me.z+=dz;
		if(doplay) {
			if(a.exists("act") and gets("act")=="fall" and (string_contains(terrain, "swim", 1)<0 or me.z>-1.0)) playsound(terrain + "/fall" + random(1, 4) + ".wav", false);
			else playsound(terrain + "/run" + random(1, 6) + ".wav", false);
		}// Wait what?
		// Rolling? Sliding? Other?
		if(groundzero and me.z<=0.0 and me.z-dz>0.0) playsound(sounds2 + "hawk_landing_01.wav", false); // Is that right?
		//}// sounds.
		
		a.set("x", me.x);
		a.set("y", me.y);
		a.set("z", me.z);
	}// moving.
}// movement.

// Returns the square of the distance, because there is no reason to take the square root most of the time.
double distance2(vector v1, vector v2) {
	return (((v1.x-v2.x)*(v1.x-v2.x))+((v1.y-v2.y)*(v1.y-v2.y)));
}

bool confirm(string tosay) {
	dynamic_menu conf;
	conf.allow_escape=true; // Hmm.
	conf.enable_home_and_end=true;
	conf.wrap=false;
	conf.add_item_tts("Yes");
	conf.add_item_tts("No");
	conf.set_callback(main_callback, "confirm");
	return (conf.run(tosay, true)==1);
}// Confirm.

void playBGM(int stage=-1, int gloc=-1) {
	if(stage<0) stage=geti("stage");
	if(gloc<0) gloc=geti("gloc");
	if(stage==0) {
		loop((gloc<3) ? 7 : (gloc==4) ? 1 : 20);
		bgm.volume=bgm.volume-4;
	}
	else if(stage==1) {
		playsong("241946__dredile__dark-ambience-lonely-caverns.ogg");
		bgm.volume=bgm.volume-4; // Umm. Are we just... going to do this everywhere? I feel like we need to balance the quieter Varazuvi tracks, and we won't need to do this so much.
	}
}

const string[] skills={
"Basic Combo. press spacebar, or g, 3 times in a row to perform a simple combo.",
"Heal. Hold Z, and press up or W, to heal allies, and weaken nearby enemies. Divides all your power among all targets.",
"Shield. Hold Z and down, or Z and S, to guard against most attacks. Rapidly depletes power.",
"Flame of Hope: hold Z, and press left, left, right, attack, to cast angellic fire at your enemies.",
"Smite from On High: In the air, hold up, and attack, to perform a diving attack.",
"Outer Darkness: hold Z, and press down, up, down, attack, to temporarily blind all enemies."
};
const string[] sdescs={
"This is the sword I used in Heaven. I must have dropped it when I fell.",
"The Waters of Mara remain pure, even with the touch of the blood of Yam thick here.",
"The shield of Cassiel cannot have fallen here... why can't I understand...?",
"They sought to imprison Death, but neglected to implement Mercy.",
"I can\'t afford to miss the mark!",
"If there is no Hope in the darkness, then is there Hope at all?"
};

bool noskip() {
	return (key_up(KEY_RETURN) and key_up(KEY_A) and key_up(KEY_SPACE) and key_up(KEY_ESCAPE));
}
void keywait() {
	keys_pressed();
	while(true) {
		system_keys();
		if(keys_pressed().length()>0) return;
		wait(5);
	}// Loop.
}

void script(bool dim, string s0, string s1="", string s2="", string s3="", string s4="", string s5="", string s6="", string s7="", string s8="", string s9="", string s10="", string s11="", string s12="", string s13="", string s14="", string s15="") {
	// Weirdest thing to watch out for: starting scripts with the A key down. Space or Enter, too, but especially A.
	string[] lines={s0, s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12, s13, s14, s15};
	keys_pressed();
	//playsound(jla + "menu/submenu.wav", false); // Umm?
	if(dim) bgm.volume=bgm.volume-4;
	uint l=0;
	bool cv=(gets("cv")=="on");
	if(cv and string_contains(s0, ":", 1)>0 and voices.exists(string_left(s0, string_contains(s0, ":", 1)))) {
		custom_voice@ vv;
		custom_voice temp;
		@vv=temp;
		voices.get(string_left(s0, string_contains(s0, ":", 1)), @vv);
		
		vv.speak(string_right(s0, s0.length()-string_contains(s0, ":", 1)));
	}// Custom voice.
	else voice.speak(s0);
	while(l<16 and lines[l]!="") {
		system_keys();
		int[] keys=keys_pressed(); // This right here is why we have event based systems.
		bool found=false; // GRR!
		for(uint i=0; i<keys.length(); i++) {
			found=((dirs.find(keys[i])>=0 or keys[i]==KEY_RETURN or keys[i]==KEY_H or keys[i]==KEY_G) and keys[i]!=KEY_A);
			if(keys[i]==KEY_RETURN or keys[i]==KEY_H or keys[i]==KEY_G) l++; // No confirmation sound?
			if(found) i+=100;
		}// Keys.
			if(found and l<16) {
				string[] parts=string_split(lines[l], ":", true);
				if(cv and voices.exists(parts[0])) {
					custom_voice@ vv;
					custom_voice temp;
					@vv=temp;
					// AGH! THIS CAN'T BE PORTED TO PYTHON!
					voices.get(parts[0], @vv);
					vv.load_config(vv.config_path);
					vv.speak_interrupt(string_right(lines[l], lines[l].length()-parts[0].length()));
				}// Custom.
				else voice.speak_interrupt(lines[l]);
			}// Speak.
		else if(!noskip() and !key_down(KEY_RETURN) and !key_down(KEY_SPACE)) break;
		wait(5);
	}// Loop.
	if(dim) bgm.volume=bgm.volume+4;
}

// Oh, jees, this is stupid. The lack of a map, I mean. Are we going to actually draw one, or am I going to have to gut the step function and make a universal movement function? The latter is better, but the former is less of a nuissance.

void fight(double dt) {
	
	dt*=0.001;
	// We need to watch out for what allies are doing when not fighting. I like the idea of a party of up to three, and incentives for you to choose party members diversely, but I'm kinda lost beyond that.
	
	vector me(getd("x"), getd("y"), getd("z")); // Ugh, and now we need to keep track of party members _and_ the player, even though they aren't in the same format.
	
	string act=gets("act");
	double counter=getd("counter");
	int targ=geti("targ");
	
	if(counter>0.0) {
		counter-=dt;
		if(counter<=0.0) {
			counter=0.0;
			vector aim(0, 1, 0);
			string face=gets("face");
			if(targ>=0) {
				// So, I want the unit vector pointing from the player to the target.
				aim=get_vector(getd("x" + targ), getd("y" + targ), getd("z" + targ))-me;
				double length=aim.length();
				if(length!=0) aim/=length; // That's how you normalize, right?
			}// Aiming is annoying.
			else aim=unit_vector(face);
			if(string_right(act, 1)=="A" or string_right(act, 2)=="A)") {
				// I have no idea how to handle the dive move.
				int skills=geti("skills");
				if(((skills&8)==8) and string_right(act, 7)=="Z(LLRA)" and getd("e")>=7000) {
					addProjectile(sounds2 + "ignite_0" + random(1, 3) + ".wav", -1, me, 1.0, aim*7, sounds2 + "bellow" + random(1, 4) + "v.wav", random(25, 50), 1.0, 0);
					a.set("e", getd("e")-7000);
				}// Fireball. I guess.
				else if(((skills&32)==32) and string_right(act, 7)=="Z(DUDA)" and getd("e")>=7000 and getd("blind")<=0.0) {
					playsound("downloads/31106_Production_Element_Imaging_Accent_Stab_Dark_Hit_Reverb_04.wav", false);
					a.set("blind", random(5, 12)); // Too short? Too long?
					a.set("e", getd("e")-7000);
					// I have no idea what to do with enemy targets, though. Just go through and set all of them to random, then let events sort them out?
					for(uint i=2; i<10; i++) if(a.exists("targ" + i)) a.set("targ" + i, random(2, 9)); // Will Python let me put everything on one line like that?
				}// Blinding.
				else if(string_right(act, 3)=="AAA") {
					// You can actually perform this combo without your angel sword, but it's stronger and better at guard-breaking with it.
					// (Todo: find ways to encourage more exploration.)
					// Also, environmental interaction. What if you do this to a tree?
					for(uint i=2; i<10; i++) {
						if(a.exists("x" + i)==false) continue;
						vector you(getd("x" + i), getd("y" + i), getd("z" + i));
						if((you-me).length()<=1.5 and absolute(get_angle(me, you)-get_angle(zero, aim))<=PI/4 ) {
							// 3D collision detection with angles all over the place are annoying! Phi! Phi! To get phi, I have to turn (x, y) into a plane, which means more square roots! 
							// (Blocking.)
							pool.play_3d("magiarm6.ogg", me.x, me.y, me.z, you.x, you.y, you.z, false);
							hurt(i, 3+(skills&1)); // Hey, maybe we should multiply (skills&1) by stage? It'd be kinda like leveling up.
						}// Hit.
					}// Enemy loop.
					
					a.set("act", "");
					a.set("counter", -0.5); // Imagining Kingdom Hearts, thinking it might want to be longer.
					
					// Environmental interaction.
					if(geti("stage")==1 and geti("gloc")>=2 and absolute(me.x-220)<=6 and me.y>280 and me.z>-9) {
						playsound(sounds2 + "sq_rockramp_01a.wav", false);
						fadeout();
						a.set("z", 0);
						a.set("stage", 2);
						int gloc=geti("gloc");
						a.set("gloc", (gloc==2) ? 0 : (gloc+2));
						playsound(sounds2 + "hawk_wingstretch_0" + random(1, 4) + ".wav", false);
						wait(500);
						fade_all();
						scapeme(gloc==2);
					}// Breaking the boulders on Ben Yam's hideout.
					else if(geti("stage")==2 and me.z<-7 and me.z>-20 and absolute(me.x-358)<=3 and absolute(me.y-460)<=5) playsound(sounds2 + "bellow" + random(1, 4) + "v.wav", 356, 460, -13);
				}// Combo-ender.
				else {
					a.set("counter", -0.4); // ?
					// The aim thing again.
					for(uint i=2; i<10; i++) {
						if(!a.exists("x" + i) or getd("hp" + i)<=0.0) continue;
						vector you(getd("x" + i), getd("y" + i), getd("z" + i));
						if((you-me).length()<=1.5 and absolute(get_angle(me, you)-get_angle(zero, aim))<=PI/3) {
							// Vertical, and blocking.
							// Also armor and stuff.
							pool.play_3d("magiarm5.ogg", me.x, me.y, me.z, you.x, you.y, you.z, false);
							hurt(i, 2);
							// Stun?
						}// Hit.
					}// Loop.
					
					// Environmental interaction:
					if(geti("stage")==1 and geti("gloc")>=2 and absolute(me.x-220)<=6 and me.y>280 and me.z>-9) playsound("downloads/150838__toxicwafflezz__bullet-impact-2.wav", false);
				}// Basic hit.
			}// Attacking
			else {
				a.set("counter", 0.0);
				// I want to do more with this.
			}// Umm. I dunno.
			counter=getd("counter"); // You goofed.
		}// From Above.
	}// DESCENDING! AGAIN? NOOOOOO!
	else if(counter<0.0) {
		counter+=dt;
		if(counter>=0.0) {
			counter=0.0;
			a.set("act", ""); // Destruction?
		}// From below.
	}// Ascending.
	
	for(uint i=0; i<10; i++) {
		if(a.exists("hp" + i)==false) continue;
		double hp=getd("hp" + i);
		double e=getd("e" + i);
		vector you(getd("x" + i), getd("y" + i), getd("z" + i)); // So much easier with brackets! Come on, Angelscript!
		if(i<2) {
			
			continue; // because I don't like overdoing the indentation. Might need to move this, though. Aaarrrggghhh!
		}// party.
		
		// Targeting player, or party members? Whichever is closest, I guess.
		
		// AI:
		if(gets("name" + i)=="Bath Kothar") {
			// If the target is in range, try to knock them back, or retreat.
			// If this is any time other than the first fight in the game, she can dodge to the side.
			// If there is distance, "gather energy", which is to say, reset / charge weapons.
			// If enemy is too high, high jump and smash them down.
			// (High jump uses up lots of energy.)
			// If she has enough power for a special, get in position to use it.
			// If the enemy has been stunned by a special, or is just standing there, combo them.
			// But I don't want her to have an easy time of the combo without the Sonic Boom as a stunner. Hmm.
			// (Also, can she upgrade her weapons, gain new skills, etc?)
			// (Oh, and if she's swinging a club, does that block swords?)
		}// Bath Kothar.
		
		// Yeah, this right here? This is where it becomes clear that I'm doing it wrong:
		a.set("hp" + i, hp);
		a.set("e" + i, e);
		a.set("x" + i, you.x);
		a.set("y" + i, you.y);
		a.set("z" + i, you.z);
	}// Loop.
	
	a.set("counter", counter);
	
}// Fighting.

// Cross fading music for random encounters? I can do it, but it requires two bgm objects. Should I?
//sound battle;

dictionary uvs;

vector unit_vector(string face) {
	if(uvs.exists(face)) {
		vector ret;
		uvs.get(face, ret);
		return ret;
	}
	return get_vector(0, 1, 0);
}


// I had to make projectiles anyway:
class Projectile {
	string hitsound="magiarm" + random(1, 6) + ".ogg"; // Can you do that?
	double damage=0.0, stun=0.0;
	int8 flags=0; // 1=obeys gravity, 2=has momentum.
	vector v(0,0,0);
	int creator=-1; // Though it mostly just focuses on teams?
	int slot=-1;
	double r=1.0, r2=1.0; // They are always spheres. Grumble grumble distance 3d.
	vector pose(0,0,0);
	// I think that's it.
	Projectile() {}
	
	bool update(double dt) {
		// returns true if it is dead.
		
		if(pool.sound_is_playing(this.slot)) {
			pool.update_sound_3d(this.slot, this.pose.x, this.pose.y, this.pose.z);
			return true;
		}
		else {
			pool.destroy_sound(this.slot);
			return false;
	}
	}
}// Projectile.
Projectile@[] projectiles;
Projectile@ addProjectile(string startSound, int creator, vector center, float radius, vector velocity, string hitsound="magiarm3.ogg", double damage=0.0, double stun=0.0, int flags=0) {
	Projectile ret;
	// Question: do we give the sound range, or do we play from the center?
	ret.slot=pool.play_3d(startSound, getd("x"), getd("y"), getd("z"), center.x, center.y, center.z, false, true);
	ret.r=radius;
	ret.r2=radius*radius;
	ret.pose=center;
	ret.damage=damage;
	ret.hitsound=hitsound;
	ret.stun=stun;
	ret.flags=flags;
	ret.v=velocity;
	ret.creator=creator;
	projectiles.insert_last(ret);
	return ret;
}

vector zero(0,0,0);

void hurt(int i, double damage, double stun=0.0, string targetState="stun") {
	
	if(i>=0 and a.exists("hp" + i)==false) return;
	double hp=getd((i<0) ? "hp" : ("hp" + i));
	string name=gets((i<0) ? "name" : ("name" + i));
	
	hp-=damage;
	if(hp<=0.0 and hp+damage>0.0) {

	}// KO.
	else if(hp>0.0 and random(0, 5)>2) {
		if(name=="Bath Kothar") pool.play_3d(sounds + "kiais/linda" + ((random(0, 5)>3) ? "2" : (random(0, 5)>2) ? "22" : "23") + ".ogg", getd("x"), getd("y"), getd("z"), getd("x" + i), getd("y" + i), getd("z" + i), false);
	}// Alive.
	
	if(i<0) a.set("hp", hp);
	else a.set("hp" + i, hp);
}// Hurt.

vector getV(int targ) {
	if(targ<0) {
		return get_vector(getd("vx"), getd("Vy"), getd("vz"));
	}
	else return get_vector(getd("vx" + targ), getd("vy" + targ), getd("vz" + targ)); // GAAAAH!
}

string getDir(double theta) {
							string direction="southeast";
							if(absolute(theta)<pi/8) direction="east";
							else if(theta>0 and theta<3*pi/8) direction="northeast";
							else if(theta>0 and theta<5*pi/8) direction="north";
							else if(theta>0 and theta<=7*pi/8) direction="northwest";
							else if(theta>0 and theta<9*pi/8) direction="west";
							else if((theta>pi and theta<3*pi/2) or (theta>-pi and theta<-5*pi/8)) direction="southwest";
							else if((theta>0 and theta<=13*pi/8) or (theta<-3*pi/8 and theta>=-5*pi/8)) direction="south";
							return direction;
}

bool clearDead() {
	uint alive=0;
	for(uint i=2; i<=9; i++) {
		if(gets("name" + i)!="") {
			if(getd("hp" + i)>0.0) alive++;
			else a.set("name" + i, "");
		}// Still present.
	}
	return alive==0; // Umm.
}// Remove dead enemies.


