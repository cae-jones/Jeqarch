 }// down.
 else {

 }// I have no idea what this is, but it's gotta be awesome!

 // Guard is chillin'.
 g.setAction(tick, 0);
}// Guards attack?
else {
  int bestFace=0;
 string room=gloc.descs[g.getX()][g.getY()];
 // We check for possible targets.
 // If there are multiple candidates, we use these rules:
 // - If one is closer than the other, the closest takes priority.
 // - If two are at the same distance, and we're already facing one, continue facing that one.
 Steve@ closest=null;
 if(myroom==room) {
 if((me.getX()==g.getX())||(me.getY()==g.getY())) {
 @closest=me;
 if(me.getX()<g.getX()) bestFace=left;
 else if(me.getX()>g.getX()) bestFace=right;
 else if(me.getY()<g.getY()) bestFace=up;
 else bestFace=down;

 }// The player instance is a possible target.
}// Look at the player.
 for(uint j=0; j<instances.length(); j++) {
  if((instances[j].getAction(tick)<0)||(instances[j].getX(tick)<0)||(instances[j].getY(tick)<0)||(instances[j].getX(tick)>=gloc.values.length())||(instances[j].getY(tick)>=gloc.values[0].length())) continue;

 if((gloc.descs[instances[j].getX(tick)][instances[j].getY(tick)]==room)&&((instances[j].getX(tick)==g.getX(tick))||(instances[j].getY(tick)==g.getY(tick)))) {
 if(@closest!=null) {
 // Who's closer between these two instances?
 int mydist=absolute(instances[j].getX(tick)-g.getX(tick))+absolute(instances[j].getY(tick)-g.getY(tick));
 int cdist=absolute(closest.getX(tick)-g.getX(tick))+absolute(closest.getY(tick)-g.getY(tick));
 if(mydist<cdist) {
 @closest=instances[j];
 if(instances[j].getX(tick)<g.getX(tick)) bestFace=left;
 else if(instances[j].getX(tick)>g.getX(tick)) bestFace=right;
 else if(instances[j].getY(tick)<g.getY(tick)) bestFace=up;
 else bestFace=down;
}// This one is closer.
 else if(mydist==cdist) {
 if(act!=bestFace) {
@closest=instances[j];
 if(instances[j].getX(tick)<g.getX(tick)) bestFace=left;
 else if(instances[j].getX(tick)>g.getX(tick)) bestFace=right;
 else if(instances[j].getY(tick)<g.getY(tick)) bestFace=up;
 else bestFace=down;
}
 // Otherwise, they're already facing someone, and ignore this instance.
}// Choose between the two if they're equidistant.
}
 else {@closest=instances[j];
 if(instances[j].getX(tick)<g.getX(tick)) bestFace=left;
 else if(instances[j].getX(tick)>g.getX(tick)) bestFace=right;
 else if(instances[j].getY(tick)<g.getY(tick)) bestFace=up;
 else bestFace=down;

 }// Meh.
 }// Possible target.
}// Look at other instances of you.
 if((act!=bestFace)&&(bestFace>0)) {
 if(g.desc=="armed guard") {
 g.setAction(tick, bestFace|attack);
  addMessage("The " + g.desc + " at " + getCoords(g.getX(), g.getY()) + " is preparing to shoot, " + ((bestFace==up) ? "up" : (bestFace==down) ? "down" : (bestFace==left) ? "left" : "right" ) + "! Anyone on a line " + ((bestFace==up) ? "above" : (bestFace==down) ? "below" : (bestFace==left) ? "to the left of" : "to the right of") + " him on the next tick will die!");
  playsound("sound/" + g.desc + "/face" + random(1, 4) + ".wav", g.getX(tick), g.getY(tick));
 playsound("sound/loadgun.wav", g.getX(tick), g.getY(tick));
}
 else {
 addMessage("the " + g.desc + " at " + getCoords(g.getX(tick), g.getY(tick)) + " has turned to face " + ((@closest==@me) ? " you " : " a previous instance of you "));
 g.setAction(tick, bestFace);
 playsound("sound/" + g.desc + "/face" + random(1, 4) + ".wav", g.getX(tick), g.getY(tick));
}// Default for non-armed guards.
}// Face the target.
}// Guards aren't attacking, so they can pick targets.
 }// Guards.


 if(gloc.descs[me.getX()][me.getY()]!=myroom) {
 myroom=gloc.descs[me.getX()][me.getY()];
 int v=gloc.values[me.getX()][me.getY()];
 if(v==openDoor) addMessage("This is an open doorway. ");
 else if(v==closedDoor) {
 sound snd; snd.load("sound/crushed.wav"); snd.play_wait(); snd.close();
 pool.play_1d("sound/gameover.wav", 0, 0, false);
voice.speak_interrupt_wait("You have been smashed by one of the building\'s large steel doors.  In time, they will be able to clean you up, but some poor janitor is going to have a rough day.  Game over!");
 return;
}// Crushed.
 else if(v==computer) {
 // which computer are we looking at?
 bool success=false;
 switch (mission) {
 case 1 : {
 if(me.getY()>4) {
 if((plot&1)==0) {success=true; plot|=1; string tosay="You have hacked the security computer, and now know the password to the main doors."; addMessage(tosay); voice.speak_interrupt(tosay);}
 else voice.speak_interrupt("You already know the password to the main doors.");
 }// Server room.
 else {
 if((plot&2)==0) {
 success=false;
 voice.speak_interrupt("You need a supervisor\'s key-card to access this computer.");
}
 else {
 success=true;
 string tosay="Using the supervisor\'s key card, you have deleted the lab\'s data from studying you.";
 addMessage(tosay); voice.speak_interrupt(tosay);
 plot|=4;
}
 }// Backup server.
 }; break;
case 2 : {
 // Elevator control.
  success=true;
 string tosay="The supervisor\'s key card works on this computer too.  The Docking room doors have opened.";
 addMessage(tosay); voice.speak_interrupt(tosay);
 gloc.values[1][8]=openDoor; gloc.values[2][8]=openDoor; plot=10;
 }; break;
 }// Missionswitch for computers.
 if(success) playsound("sound/access.wav", me.getX(), me.getY());
 }// Computers.
 else {
 if((myroom=="the lab")&&((tick<spotted)||(spotted<0))) {spotted=tick;
 addMessage("Guards have noticed you and will lock down the room within moments!  If you can, kill them before any are able to pull the alarm.");
 // Play some sounds.
}// Spotted.
 else if((mission==0)&&(me.getX()<4)&&(tick>1)) {
 string tosay="A voice booms from an intercom. \"Experiment successful. If you\'ll please step to the left...\"";
 addMessage(tosay); voice.speak_interrupt(tosay);
}
 else if((mission==2)&&(myroom=="Elevator")) {
 string tosay = "Your thumb presses the button marked surface.  The elevator doors slowly close, and you feel yourself moving up toward the surface.  Congradulations on a job well done! ";
 if(lastMissionCompleted<2) lastMissionCompleted=2;
 voice.speak_interrupt(tosay);
 while((!key_pressed(KEY_RETURN))&&(!key_pressed(KEY_SPACE))&&(!key_pressed(KEY_ESCAPE))) {systemCommands(); wait(5);}
 return;
}// Completing mission 2.
 else if((mission==1)&&(me.getY()==0)) {
 if((plot&4)==0) {
 voice.speak_interrupt("Before leaving, you need to destroy any information these men have learned about you.");
}
 else {
 voice.speak_interrupt("From the rest of the world\'s perspective, it has been only moments since you first opened your eyes in your cell.  The Vault door slowly closes behind you, as you casually walk away from the muffled screams.  Simultaneously, within the vault, several men are being attacked, and the back up data is being deleted from the computers.  For a brief moment, you wonder if they have any idea what has just been set loose upon the world.");
 while((!key_pressed(KEY_RETURN))&&(!key_pressed(KEY_SPACE))&&(!key_pressed(KEY_ESCAPE))) {systemCommands(); wait(5);}
 voice.speak_interrupt_wait("You have escaped the vault! Congratulations on a job well done!"); return;
}
 }// Exit.
}// Room.
}// Changing rooms.
 pool.update_listener_2d(me.getX(tick), me.getY(tick));
}// Ticking.

 wait(5);
 }// Loop.
}// Play game.

 EchoD@[] echoes;

 void moveCam(int tx, int ty) {
 camX=tx; camY=ty;
 if(@gloc!=null) {
 if(camX<0) camX=0;
 if(camY<0) camY=0;
 if(camX>=gloc.values.length()) camX=gloc.values.length()-1;
 if(camY>=gloc.values[camX].length()) camY=gloc.values[camX].length()-1;
}
 // Check for guards.
 string tosay= "" + gloc.descs[camX][camY];
 if(gloc.values[camX][camY]==stepplate) tosay += ". Standing here holds a door open.";
 else if(gloc.values[camX][camY]==closedDoor) tosay += ". This door is closed.";
 else if(gloc.values[camX][camY]==openDoor) tosay += ". This door is open.";

 for(uint i=0; i<gloc.guards.length(); i++) {
 if((gloc.guards[i].getX(tick)==camX)&&(gloc.guards[i].getY(tick)==camY)) {
 int act=gloc.guards[i].getAction(tick);
 switch (act) {
 case -1 : tosay = "dead " + gloc.guards[i].desc; break;
 case left : tosay="" + gloc.guards[i].desc + " facing left"; break;
 case right : tosay="" + gloc.guards[i].desc + " facing right"; break;
 case up : tosay="" + gloc.guards[i].desc + " facing up"; break;
 case down : tosay="" + gloc.guards[i].desc + " facing down"; break;
 default : {
 tosay=gloc.guards[i].desc;
 // Get attacking, patrolling, etc.
}
}// Guards.
}// Guard found.
}
 // Check for other instances of the player.
 for(uint i=0; i<instances.length(); i++) {
 Steve@ inst=instances[i];
 if((inst.getX(tick)==camX)&&(inst.getY(tick)==camY)&&(inst.getAction(tick)>=0)) {
 tosay="another you, ";
 int act=inst.getAction(tick);
 switch(act) {
 case up : tosay += " preparing to walk up"; break;
 case down : tosay += " preparing to walk down"; break;
 case left : tosay += " preparing to walk left"; break;
 case right : tosay += " preparing to walk right"; break;
 case standing : tosay += " standing still"; break;
 case 7 : tosay += " preparing to jump through time"; break;
 default : {
 if((act&attack)!=0) {
 tosay += " attacking ";
 act&=7;
 switch (act) {
 case up : tosay += "up"; break;
 case left : tosay += "left"; break;
 case down : tosay += "down"; break;
 case right : tosay += "right"; break;
 default : tosay += "in an unknown direction";
}// Another actswitch? For shame!
}// Attacking.
}
}// Actswitch for instances.
}// Other instance found.
}
 // Finally, check for the player.
 if((me.getX()==camX)&&(me.getY()==camY)) tosay="you are currently here.";
 voice.speak("" + getCoords(camX, camY) + ", " + tosay);

}// Move camera.

 void playsound(string toplay, int x, int y) {

 pool.play_2d(toplay, me.getX(), me.getY(), x, y, false);
 // Determine if we need to echo.

 // Echoes will go in four directions, and be positioned based on distance from walls or closed doors.
/*
 if((x<0)||(y<0)||(x>=gloc.values.length())||(y>=gloc.values[0].length())) return;
 int v=gloc.values[x][y];
 if(v>0) return; // I think?

 int u=0; int l=0; int r=0; int d=0; // Distance in each direction. Must be non-zero for an echo to be added.

 for(int yy=y-1; (yy>=0)&&(gloc.values[x][yy]<1); yy--) {
 u=y-yy;
 }
 for(int yy=y+1; (yy<gloc.values[x].length())&&(gloc.values[x][yy]<1); yy++) {
 d=yy-y;
 }
 for(int xx=x-1; (xx>=0)&&(gloc.values[xx][y]<1); xx--) {
 l=x-xx;
}
 for(int xx=x+1; (xx<gloc.values.length())&&(gloc.values[xx][y]<1); xx++) {
 r=xx-x;
}

 if(l!=0) {
 l=absolute(l);
 EchoD echo(toplay, x-l, y, -7, 0.075);
 echoes.insert_last(echo);
}// Left.
 if(r!=0) {
 r=absolute(r);
 EchoD echo(toplay, x+r, y, -7, 0.15);
 echoes.insert_last(echo);
}// Right.
 if(u!=0) {
 u=absolute(u);
 EchoD echo(toplay, x, y-u, -7, 0.225, 106);
 echoes.insert_last(echo);
}// Up.
 if(d!=0) {
 d=absolute(d);
 EchoD echo(toplay, x, y+d, -7, 0.3, 94);
 echoes.insert_last(echo);
}// Down.
*/
 }// Playsound.

 bool stepInstance(Steve@ inst) {
 int act=inst.getAction(tick);
 int x=inst.getX(tick); int y=inst.getY(tick);
 // Let's ... catch these things that mean we're not really here:
 if((act<0)||(x<0)||(y<0)||(x>=gloc.values.length())||(y>=gloc.values[0].length())) return true;
 if( (act&attack)!=0) {
 // There are two ways to do this, but only one is prepared at the moment.
 int tx=inst.getX(tick);
 int ty=inst.getY(tick);
 int a=(act&7);
 if(a==left) tx--;
 if(a==right) tx++;
 if(a==up) ty--;
 if(a==down) ty++;
 inst.moveTo(tx, ty, tick+1);
for(uint i=0; i<gloc.guards.length(); i++) {
 if((gloc.guards[i].getX(tick)==tx)&&(gloc.guards[i].getY(tick)==ty)&&(gloc.guards[i].getAction(tick)>=0)) {
 gloc.guards[i].setAction(tick, -1);
playsound("sound/" + gloc.guards[i].desc + "/killed" + random(1, 3) + ".wav", tx, ty); 
 if((gloc.guards[i].desc=="lab supervisor")&&((plot&2)==0)) {
 plot|=2; voice.speak_interrupt("You have taken the supervisor\'s keycard, which gives you access to the backup server.");
}// Keycard.
// Message.
 addMessage( "" + ((@inst==@me) ? "You" : "A previous instance of you") + " has killed the " + gloc.guards[i].desc + " at " + getCoords(gloc.guards[i].getX(tick), gloc.guards[i].getY(tick)) + ". ");
}// Kill.
 }// Guards.

}// Attacking.
 else if(act==left) inst.moveTo(inst.getX()-1, inst.getY(), tick+1);
 else if(act==right) inst.moveTo(inst.getX()+1, inst.getY(), tick+1);
 else if(act==up) inst.moveTo(inst.getX(tick), inst.getY(tick)-1, tick+1);
 else if(act==down) inst.moveTo(inst.getX(tick), inst.getY(tick)+1, tick+1);
 else if(act==standing) inst.moveTo(x, y, tick+1);

if((x!=inst.getX(tick+1))||(y!=inst.getY(tick+1))) {
playsound("sound/step" + random(1, 5) + ".wav", inst.getX(), inst.getY());
 // Check for stepplates.
 if(gloc.values[x][y]==stepplate) {
handleDoor(x, y, false);
 }// Close door.

}// Moved.

 // Do checks for collisions.
 if((inst.getX(tick+1)>=0)&&(inst.getY(tick+1)>=0)&&(inst.getX(tick+1)<gloc.values.length())&&(inst.getY(tick+1)<gloc.values[0].length())&&(gloc.values[inst.getX(tick+1)][inst.getY(tick+1)]==stepplate)) {
 handleDoor(inst.getX(tick+1), inst.getY(tick+1), true);
 }// Opening a door.

 if((@inst!=@me)&&(inst.getX()==me.getX())&&(inst.getY()==me.getY())) {
 pool.play_1d("sound/gameover.wav", 0, 0, false);
 voice.speak_interrupt_wait("You have bumped into a previous instance of yourself. Even this small change has disrupted the timeline. Game over!");
 return false;

 }// Game over.

 return true;
}// Step instance.

 // we need to keep track of time-sensitive variables for missions.
 int spotted; // The tick when the guards see you in mission 1.
 int ammo=0; // Ammo for guns that you find.
 string myroom="";
 void addMessage(string msg) {messages.insert_last(msg);}

 void handleDoor(int x, int y, bool open) {
 bool playit=true;
 int px=-1; int py=-1;
 switch (mission) {
 case 0 : {
 px=2; py=5; playit=true;
}; break;
 case 1 : {
  if((x<=10)&&(y==9)) {
 px=11; py=9; playit=true;
}// Door at l 10.
 else {px=12; py=3;}
}; break;
 case 2 : {
 // doors in mission 2
  if((x==9)&&(y==13)) {px=10; py=11;}
 else if((x>=11)&&(y>=10)) {
 px=2; py=3;
 gloc.values[1][3]= (open) ? openDoor : closedDoor;
}// Secondary door.
 else if((x>=11)&&(y<9)) {px=9; py=7;} // Computer room door.
 else {px=4; py=6;
 gloc.values[4][5]=(open) ? openDoor : closedDoor;
}
}; break;
}// Doors.
 if(playit) {
 if((open)&&(gloc.values[px][py]==openDoor)) playit=false;
 else if((!open)&&(gloc.values[px][py]==closedDoor)) playit=false;
}// Make sure the door in question isn't already at the desired value.
 if(playit) {
 if(open) gloc.values[px][py]=openDoor; else gloc.values[px][py]=closedDoor;
 playsound("sound/" + ((open)? "open" : "close" ) + ".wav", px, py);
 addMessage("The door at " + getCoords(px, py) + " has just " + ((open) ? " opened" : " closed" ) + ". ");
}
}// Door.
void cutscene(string[] lines, string ending) {
 int lx=lines.length()-1;
 voice.speak_interrupt("Arrow for story, or enter to start game.");
 if(key_pressed(KEY_RETURN)) {wait(300);}
 if(key_pressed(KEY_RETURN)) alert("Hey!", "Are you holding the enter key?");
 while(!key_pressed(KEY_RETURN)) {
systemCommands();
 bool speakme=true;
 if((key_pressed(KEY_LEFT))||(key_pressed(KEY_UP))) lx--;
 else if((key_pressed(KEY_DOWN))||(key_pressed(KEY_RIGHT))) lx++;
 else speakme=false;
 if(lx<0) lx=lines.length()-1;
 else if(lx>=lines.length()) lx=0;
 if(speakme) voice.speak_interrupt(lines[lx]);
wait(5);}// Lines.
 voice.speak_interrupt(ending);
}// Cutscenes.
 void save_exit() {
 string txt="" + tickSpeed + "\n" + lastMissionCompleted + "";
 file fout; fout.open("progress.ini", "w"); fout.write(txt); fout.close();
 exit();
}
