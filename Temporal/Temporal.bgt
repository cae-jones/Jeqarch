 return;
}// Shot.
 for(uint j=0; j<instances.length(); j++) {
 if((instances[j].getX(tick+1)==x)&&(instances[j].getY(tick+1)==y)) {
 sound snd; snd.load("sound/crushed.wav"); snd.play_wait();
 playsound("sound/gameover.wav", me.getX(), me.getY());
 voice.speak_interrupt_wait("A previous instance of you has been shot by the " + g.desc + " at " + getCoords(g.getX(), g.getY()) + "! Game over!");
 return;
}// Shot.

}// Instances.
 for(uint j=0; j<gloc.guards.length(); j++) {
 Guard@ enemy=gloc.guards[j];
 if((enemy.getX()==x)&&(enemy.getY()==y)) {
 playsound("sound/" + enemy.desc + "/killed" + random(1, 3) + ".wav", enemy.getX(), enemy.getY());
 enemy.setAction(tick, -1);
 tosay="shot and killed the " + enemy.desc + " at " + getCoords(enemy.getX(), enemy.getY());
 x=-1;
}// Shot.

 }// Other guards.

}// Look for people.
}// Left.

}// Left.
 else if(a==right) {
 int x=g.getX(); int y=g.getY();
for(x=g.getX()+1; x<gloc.values.length(); x++) {
 if(gloc.values[x][y]==wall) {tosay="shot a bullet into the wall at " + getCoords(x, g.getY()); x=34;}
