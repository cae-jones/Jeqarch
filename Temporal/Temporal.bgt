 string saveSteve(Steve@ me) {
 string txt="[instance]\n";
 string poses="";
 for(uint i=0; i<me.pose.length(); i++) {poses = poses + "" + me.pose[i] + ", ";}
 string actions="";
 for(uint i=0; i<me.whatidid.length(); i++) {actions += "" + me.whatidid[i] + ", ";}
 txt = txt + "\n[pose]\n" + poses + "\n[actions]\n" + actions + "\n[next]\n;\n";
return txt;
}// Save steve.
 string saveGuard(Guard@ me) {
 string txt="[guard]\n" + me.desc + "\n";
 string poses="";
 for(uint i=0; i<me.pose.length(); i++) {poses = poses + "" + me.pose[i] + ", ";}
 string actions="";
 for(uint i=0; i<me.whatidid.length(); i++) {actions += "" + me.whatidid[i] + ", ";}
 txt = txt + "\n[pose]\n" + poses + "\n[actions]\n" + actions + "\n[next]\n;\n";
 return txt;
 }// save guard.

 void saveGame() {
 voice.speak_interrupt("Enter save file name and press enter. Press escape to cancel.");
 string inp=input_box("Save File Name", "Enter save file name and press enter, or press escape to cancel.");
 if(inp=="") {voice.speak_interrupt("Canceled."); return;}
 string txt="[plot]\n" + plot + "\n[mission]\n" + mission + "\n[tick]\n" + tick + "\n[highest]\n" + highestTick + "\n[speed]\n" + tickSpeed + "\n[me]\n" + saveSteve(me) + "\n";
 for(uint i=0; i<instances.length(); i++) {txt += "\n" + saveSteve(instances[i]);}
 for(uint i=0; i<gloc.guards.length(); i++) {txt += "\n" + saveGuard(gloc.guards[i]);}
 file fout; fout.open(inp, "w");
 fout.write(txt);
 fout.close();
 }

 bool loadGame() {
 voice.speak_interrupt("Enter the file name and press enter, or press escape to cancel.");
 string inp=input_box("Save File Name", "Enter the name of the file to load from and press enter, or press escape to cancel.");
 if(inp=="") {voice.speak_interrupt("Canceled"); return false;}

 file fin; fin.open(inp, "r");
 string txt=fin.read(0);
 fin.close();
 string[] lines=string_split(txt, "\n", true);
 if(lines.length()<10) {voice.speak_interrupt("Invalid file"); return false;}
 @me=null;
 instances.resize(0);


 for(uint i=0; i<lines.length(); i++) {
 if(lines[i]=="[mission]") {mission=string_to_number(lines[i+1]); @gloc=loadMap(mission); gloc.guards.resize(0);}
 else if(lines[i]=="[plot]") plot=string_to_number(lines[i+1]);
 else if(lines[i]=="[speed]") tickSpeed=string_to_number(lines[i+1]);
 else if(lines[i]=="[tick]") tick=string_to_number(lines[i+1]);
 else if(lines[i]=="[highest]") highestTick=string_to_number(lines[i+1]);
 else if(lines[i]=="[ammo]") ammo=string_to_number(lines[i+1]);
 else if(lines[i]=="[spotted]") spotted=string_to_number(lines[i+1]);
 else if(lines[i]=="[instance]") {
 Steve s;
 string[] words=string_split(lines[i+2], ", ", true); // Is that safe?
// clipboard_copy_text(lines[i+2]); // Debug.
 string[] words2=string_split(lines[i+4], ", ", true);
 for(uint j=0; j<words.length(); j++) {
 if(j<s.pose.length()) s.pose[j]=string_to_number(words[j]);
 else s.pose.insert_last(string_to_number(words[j]));
}
 for(uint j=0; j<words2.length(); j++) {
 if(j<s.whatidid.length()) s.whatidid[j]=string_to_number(words2[j]);
 else s.whatidid.insert_last(string_to_number(words2[j]));
}
 if(@me==null) @me=s; else instances.insert_last(s);
 i+=4;
 }// Instances.
 else if(lines[i]=="[guard]") {
 Guard s(lines[i+1]);
 string[] words=string_split(lines[i+3], ", ", true); // Is that safe?
 string[] words2=string_split(lines[i+5], ", ", true);
 for(uint j=0; j<words.length(); j++) s.pose.insert_last(string_to_number(words[j]));
 for(uint j=0; j<words2.length(); j++) s.whatidid.insert_last(string_to_number(words2[j]));
 gloc.guards.insert_last(s);
 i+=6;

 }// Guard.
}// Loop.
 loc=game;
 voice.speak_interrupt("Loaded");
 return true;

}

bool radar_on=false;
 timer timerRadar; int radarCount;
 void updateRadar() {
 if(timerRadar.elapsed>=250) {
timerRadar.restart(); timerRadar.resume();
 radarCount++;

}// Radar go.
}// Update radar.