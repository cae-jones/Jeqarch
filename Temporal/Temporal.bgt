for(x=g.getX()-1; x>=0; x--) {
 if(gloc.values[x][y]==wall) {tosay="shot a bullet into the wall at " + getCoords(x, g.getY()); x=-1;}
 else if(gloc.values[x][y]==closedDoor) {tosay="shot a bullet into the closed door at " + getCoords(x, g.getY()); x=-1;}
 else {
 if((me.getX()==x)&&(me.getY()==y)) {
