 int act=map.guards[i].getAction(tick);
 if((map.guards[i].getX(tick)!=tx)||(map.guards[i].getY(tick)!=ty)) continue;
 if(act<=0) tickme=true;
 else {
 // Keep in mind that guards might be attacking, so we only need to check the bottom 3 bits of act.
 bool blocked=false;
 int a=(act&7);
 if((dx>0)&&( a==left)) blocked=true;
 else if((dx<0)&&(a==right)) blocked=true;
 else if((dy<0)&&(a==down)) blocked=true;
 else if((dy>0)&&(a==up)) blocked=true;

if(blocked) {tickme=false; playsound("sound/blocked" + random(1, 3) + ".wav", tx, ty); playsound("sound/" + map.guards[i].desc + "/block" + random(1, 5) + ".wav", tx, ty);
 voice.speak_interrupt("You cannot attack people who are facing you.");
 }// blocked.
 else {
 tickme=true;
 playsound("sound/" + map.guards[i].desc + "/killed" + random(1, 3) + ".wav", tx, ty);
 if(dx<0) action=attack|left;
 else if(dx>0) action=attack|right;
 else if(dy<0) action=attack|up;
 else if(dy>0) action=attack|down;

 }// Attack successful?
}// The guards might be facing you.
}// Guards.

 if((tickme)&&(action==0)) {
// playsound("sound/step" + random(1, 5) + ".wav", me.getX(), me.getY());

 if(dx>0) action=right;
 else if(dx<0) action=left;
 else if(dy<0) action=up;
 else if(dy>0) action=down;

}// Ticked, no enemies.
 if((tickme)&&(action!=0)) {
 me.setAction(tick, action);

}
else clipboard_copy_text("No action set. Tickme is " + tickme + ", action is " + action + ", tx is " + tx + ", and ty is " + ty + ". ");
}
}}// Switch for map value.

 }// Movement.

 // Tick.
 if(tickme) {
 messages.resize(0);
 if(tickSpeed>0) {
 pool.play_1d("sound/tick" + (tick%2) + ".wav", me.getX(), me.getX(), false);
