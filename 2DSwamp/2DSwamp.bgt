#include "geom.bgt" // Jeqocon2: local copies of c:\bgIncludes
#include "custom_voice.bgt"
#include "FiniteStateMachine.bgt"

string random(string[] str) {
if(str.is_empty()) return "";
 if(str.length()==1) return str[0];
return str[random(0, str.length()-1)];
}

// Zombie types. Or at least, the basic zombie types.
string[] zomnames={"Canine", "Normal", "Giant", "Stalker", "Reaper", "Lamprey", "Matriarch", "Tyrant"}; // The Dire is not included in this list.

// Object types:
const int solid=1, platform=2, breakable=4, amb=8, lute=9, misc=10, trap=11, safezone=12, deathtrap=13;
class Object {
int slot;
string filename;
string name;
int type;
vector v;
Rectangle@ bounds;
string terrain;
Object() {init();}
Object(Rectangle @ b) {init(); @bounds=b;}
Object(string n, Rectangle@ b) {init(); name=n; @bounds=b;}
Object(string n, int t, Rectangle@ b) {init(); name=n; type=t; @bounds=b;}
void init() {
slot=-1;
filename="";
name="";
type=0;
v.x=0; v.y=0; v.z=0;
@bounds=newRectangle(0, 0, 1, 1);
}
Object@ clone() {
Rectangle@ b=null; if(@bounds!=null) @b=newRectangle(bounds.x, bounds.y, bounds.width, bounds.height);
Object@ ret=newObject(name, type, b);
ret.filename=filename;
ret.v.x=v.x; ret.v.y=v.y; ret.v.z=v.z;
ret.terrain=terrain;
return ret;
}
}// Object.
Object@ newObject(string n, int t, Rectangle@ b) {Object ret(n, t, b); return ret;}
Object@ newObject(string n, Rectangle@ r) {Object ret(n, r); return ret;}


class Zombie : FSM {
int slot;
Rectangle@ bounds;
 vector v;
int awareness; //How sensitive the zombie is to your presence. This is the maximum distance where it will notice you, or the loudest sound, or something.
Rectangle@ target;
double speed; // Normal. Doubles when it chases you.
double health;
string name; // Doubles as the directory path. zombies\name\*.wav
double aspeed; // how long they take to recover from an attack. Randomly between aspeed and aspeed/10
double exp;
Object@ atop;
int fallchance; // How likely this zombie is to walk off the edge of its platform.
double strength;
Zombie() {init(random(zomnames));}
Zombie(string n) {init(n);}
Zombie(string n, double x, double y) {init(n); bounds.x=x; bounds.y=y;}
void init(string n) {
counter=0.0; state=0;
name=n;
@bounds=newRectangle(0,0,1,2);
slot=-1;
v.x=0; v.y=0;
awareness=1;
@target=null;
speed=1.0;
health=50;
aspeed=3.0;
exp=1;
@atop=null; fallchance=0;
strength=15;
if(n.is_empty()) return;
name=string_to_upper_case(n[0]) + string_right(n, n.length()-1);
n=string_to_lower_case(n);
if(n=="canine") {
 bounds.height=1;
bounds.width=1.25;
health=60;
speed=4;
awareness=5;
fallchance=50; // Those are out of 100.
strength=10;
}
else if(n=="normal") {
health=100;
awareness=2;
speed=1;
aspeed=4;
fallchance=10;
exp=2;
}// Normal.
else if(n=="giant") {
bounds.width=1.5;
bounds.height=2.5;
health=150;
speed=0.1*random(7, 13);
strength=25;
aspeed=4;
fallchance=25;
exp=4;
}//Giant
else if(n=="tyrant") {
health=500;
speed=0.1*random(7,20);
strength=40;
bounds.width=0.01*random(90,150);
bounds.height=0.01*random(190,300);
awareness=4;
fallchance=100; // This is because it chases you, not because it dives headlong into pits. Tyrants that fall into pits should respawn.
exp=10;
}
else if(n=="stalker") {
health=100;
speed=2;
strength=random(10, 20);
aspeed=2;
bounds.width=0.5;
bounds.height=1.5;
awareness=4;
fallchance=5;
exp=3;
}
else if(n=="matriarch") {
health=300;
exp=8;
strength=random(25, 40);
awareness=4;
fallchance=50;
}
else if(n=="reaper") {
exp=4;
speed=2;
strength=random(10, 30);
bounds.width=0.75;
fallchance=5;
awareness=3;
}// Reaper
else if(n=="lamprey") {
exp=2;
speed=1.5;
bounds.height=1.5;
strength+=random(-5, 10);
awareness=1;
fallchance=0;
health=150;
exp++;
}// Lamprey.
else if(n=="dire") {
health=400;
speed=4;
awareness=5;
strength=40;
aspeed=2.5;
bounds.width=2;
bounds.height=1.5;
fallchance=100; // They will chase you. And respawn in pits.
exp=15;
}// Dires.
else if(name=="Amorphous") {
speed=2.5; 
aspeed=2.5;
bounds.width=2;
bounds.height=1.5;
fallchance=100; // They will chase you. And respawn in pits.
exp=15;
strength=30;
 health=700;
}// Amorphous
else if(string_left(n, 6) == "raider") {
speed=2.5; aspeed=3.0;
 int weapon=random(2, weaponNames.length()-1);
 weapon=(weapon<<4)|(random(0, weaponNames[weapon].length()-1));
 strength=weapon;
 health=1000;
bounds.width=1.0; bounds.height=2.0;
exp=25;
fallchance=-1; // Better idea.
fallchance=100; // Umm.
awareness=5;
}// Raiders.
 else if(n=="hulk") {
 strength=60;
 health=1500;
 speed=2.5;
 fallchance=75;
 bounds.width=2; bounds.height=4;
 aspeed=3;
awareness=3;
exp=30;
}// Hulks.
else if(n=="tentacle") {
// I actually want these to ignore gravity and slide along walls.
fallchance=75;
health=100;
strength=25; // Much?
speed=3.5;
awareness=3;
bounds.width=2.0;
bounds.height=0.75; // Ouch. Can the machete hit that? It kinda needs to, because it is the best weapon for these in real life, right? ... Right?
aspeed=4.0; // It drags you more than damages you.
exp=7; // Hopefully.
}// Tentacles.
else if(n=="behemoth") {
strength=100; // Shut up; you have armor by now.
speed=1.0; // Hmm.
bounds.width=2.0;
bounds.height=4.0;
fallchance=100; //?
awareness=5; //???
aspeed=2.5; //???
exp=35;
health=2000;
// Maybe the Behemoth should be resistant to bullets? Actually, the Axe, Hammer, Chainsaw, Flamethrower, Vulcan and explosives are the only weapons that make sense against it.
}// Behemoth.

v.x=speed;
//exp=5; // 9:42 PM 1/11/2015: was that set this entire time? That's... why?
}// init.

bool setState(int s) {
if (counter!=0.0) return false;
counter=aspeed/random(1, 20);
return true;
}
void always(double dt) {
double dx=v.x*dt;
double dy=v.y*dt;
Rectangle@ b=newRectangle(bounds.x+dx, bounds.y+dy, bounds.width, bounds.height);

if(@atop==null) {
if(@map==null) {
if(b.y<=0.0) b.y=0.0;
}
else {
if(b.y<map.bounds.y) {
if(fallchance>=50) {b.y=map.bounds.y+map.bounds.height;
 // Teleport the zombie to either the platform that the player's on, or if that isn't possible, very close to the player's position.
 v.y=0.0;
 if(@(me.atop)!=null) {@atop=me.atop; b.y=atop.bounds.y+atop.bounds.height; if((b.x>=atop.bounds.x+atop.bounds.width)||(b.x+b.width<=atop.bounds.x)) b.x=random(atop.bounds.x, atop.bounds.x+atop.bounds.width);}
 else {b.x=me.bounds.x+random(-3, 3); b.y=me.bounds.y+random(-3, 3);}
} // One of the stronger zombies will not die in a pit.
else health=0.0;
}// fall off the bottom of the map.
else {
for(uint i=0; i<map.objects.length(); i++) {
Object@ o=map.objects[i];
if((o.type<8)&&(o.bounds.collide(b))) {
if(((o.type==solid)||(o.type==platform))&&(@atop==null)&&(round(b.y, 1)>=round(o.bounds.y+o.bounds.height, 1))) {@atop=o; playsound("sounds/steps/" + o.terrain + "/run" + random(1, 9) + ".wav", b, false);}
else if(o.type==solid) {v.x*=-1; playsound(getBump(o.terrain), b);}
}// Collided with something that might be solid.
}// Loop.
}// Look for stuff to collide with.
}// Map.
}// Collision detection.
else {
if(!b.collide(atop.bounds)) {
if((random(0, 100)<fallchance)||(@target==null)) {
v.x*=-1; v.y=0.0; @b=bounds;
}// No fall.
else @atop=null;
}// Edge?
}
if((round(b.x, 0)!=round(bounds.x, 0))&&(@atop!=null)) playsound("sounds/steps/" + atop.terrain + "/run" + random(1, 9) + ".wav", b);
bounds.x=b.x; bounds.y=b.y;
if((@atop==null)||(!bounds.collide(atop.bounds))) v.y-=9.8*dt;

if((absolute(me.bounds.x-bounds.x)<=awareness)&&(absolute(me.bounds.y-bounds.y)<=3*awareness/2)) {
if((bounds.x<me.bounds.x)&&(v.x<=0.0)) v.x=speed*random(1, 2);
else if((bounds.x>me.bounds.x+me.bounds.width)&&(v.x>=0.0)) v.x=-speed*random(1, 2);
if(slot<0) slot=playsound("sounds/zombies/" + name + "/growl" + random(1, 7) + ".wav", bounds, true);
@target=me.bounds;
}// Aware.
}// DT.


void clearSlot() {if(slot>=0) 
{bool success=pool.destroy_sound(slot);
//if(!success) alert("Trouble", "Cannot destroy sound! Trying again, with a loop...");
//int tries=0;
//while((!success)&&(tries<1000)) {
//success=pool.destroy_sound(slot);
//tries++;
//}
//if(tries>0) alert("Results", "Took " + tries + " tries. " + ((tries>=1000) ? "Gave up." : "Successful."));
}
 slot=-1;
}
void play(string fn) {clearSlot(); slot=playsound(fn, bounds, true);}
}// Zombie.

sound_pool pool(300);
Map@ map;
Char me;
int playsound(string fn, Rectangle@ b, bool persistent=false) {
vector c=camera;
return pool.play_extended_2d(fn, c.x, c.y, b.x, b.y, 0, b.width, 0, b.height, false, 0,
0, 0, 100, persistent);
}
int play_looped(string fn, Rectangle@ b, bool persistent=false) {
vector c=camera;
return pool.play_extended_2d(fn, c.x, c.y, b.x, b.y, 0, b.width, 0, b.height, true, 0,
0, 0, 100, persistent);
}

class Map {
Rectangle@ bounds;
Object@[] objects;
string bgm;
Zombie@[] zombies;
string name;
Map() {init();}
vector startpoint;
Map(Rectangle@ b) {init(); @bounds=b;}
Map(double w, double h) {init(); @bounds=newRectangle(0, 0, w, h);}
Map(string n, Rectangle@ b) {init(); name=n; @bounds=b;}
Map(string n, double w, double h) {init(); name=n; @bounds=newRectangle(0, 0, w, h);}
Map(string fn) {
if(!load(fn)) init();
}// Load.
void init() {@bounds=newRectangle(0, 0, 100,100); bgm="music.mp3";}
Zombie@ addZombie(string n, double x, double y) {Zombie z(n, x, y); zombies.insert_last(z); return z;}
Zombie@ addZombie(string n, Object@ o) {Zombie@ z=addZombie(n, random(o.bounds.x, o.bounds.x+o.bounds.width), o.bounds.y+o.bounds.height); @(z.atop)=o; return z;}
Object@ add(Object@ o) {objects.insert_last(o); return o;}
Zombie@ add(Zombie@ z) {zombies.insert_last(z); return z;}
bool load(string fn) {
if(!file_exists(fn)) return false;
objects.resize(0); zombies.resize(0); // GAAAAAAH!
file fin; fin.open(fn, "r");
 string txt=fin.read(0); fin.close();
string[] lines=string_split(txt, "\n", true);
@bounds=newRectangle(0,0,100,100);
for(uint i=0; i<lines.length(); i++) {
string[] words=string_split(lines[i], " ", true);
if(words[0]=="bgm") bgm=words[1];
if(words[0]=="width") bounds.width=string_to_number(words[1]);
if(words[0]=="height") bounds.height=string_to_number(words[1]);
if(words[0]=="x") bounds.x=string_to_number(words[1]);
if(words[0]=="y") bounds.y=string_to_number(words[1]);
if(words[0]=="zombie") {
double x=string_to_number(words[1]);
double y=string_to_number(words[2]);
 addZombie(words[3], x, y);
}
if(words[0]=="start") {double x=string_to_number(words[1]); double y=string_to_number(words[2]); vector v(x, y); if(startpoints.length()<=stage) startpoints.resize(stage+1); startpoints[stage]=v; me.bounds.x=x; me.bounds.y=y;}
if(words[0]=="obj") {
Object o;
o.filename=words[1];
o.name=string_replace(words[2], "_", " ", true);
o.type=string_to_number(words[3]);
o.v.x=string_to_number(words[4]);
o.v.y=string_to_number(words[5]);
o.bounds.x=string_to_number(words[6]);
o.bounds.y=string_to_number(words[7]);
o.bounds.width=string_to_number(words[8]);
clipboard_copy_text("Line " + i + ", " + o.name);
o.bounds.height=string_to_number(words[9]);
o.terrain=words[10];
add(o);
}// Object.
}// loop.
// Attach zombies to platforms.
 for(uint i=0; i<zombies.length(); i++) {
for(uint j=0; j<objects.length(); j++) {
Object@ o=objects[j];
if((o.type>=8)||( ((o.type)&3)==0)) continue;
Zombie@ z=zombies[i];
if((z.bounds.collide(o.bounds))&&(round(z.bounds.y, 1)==round(o.bounds.y+o.bounds.height, 1))) @(z.atop)=o;
}// Ugh!
}// loop.
return true;
}// Load.
void save(string fn) {
string txt="x " + bounds.x + "\ny " + bounds.y + "\nwidth " + bounds.width + "\nheight " + bounds.height + "\nbgm " + bgm + "\nstart " + startpoint.x + " " + startpoint.y;
for(uint i=0; i<objects.length(); i++) {
Object@ o=objects[i];
txt += "\nobj "
 + o.filename + " "
 + string_replace(o.name, " ", "_", true) + " "
 + o.type + " "
+ o.v.x + " "
 + o.v.y + " "
 + o.bounds.x + " "
 + o.bounds.y + " "
 + o.bounds.width + " "
 + o.bounds.height + " "
 + o.terrain;
}// objects.
for(uint i=0; i<zombies.length(); i++) txt += "\nzombie " + zombies[i].bounds.x + " " + zombies[i].bounds.y + " " + zombies[i].name;

file fout; fout.open(fn, "w"); fout.write(txt); fout.close();
}// save map.
}
