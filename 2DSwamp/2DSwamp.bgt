void story_check() {

switch (stage) {
case 4 : {
if(crates>=4) {
pool.play_stationary("sounds/weapons/Scorpion/Fire.wav", false);
wait(2000);
pool.play_stationary("sounds/player/receive.wav", false);
 voice.speak_interrupt("Someone\'s firing at us! You\'ll have to find them and take them out before we can launch!");
wait(3000);
 Object@ o=null; for(uint i=0; i<map.objects.length(); i++) {if(string_contains(map.objects[i].name, "usiness", 1)>0) {@o=map.objects[i]; i=map.objects.length(); }}
 map.addZombie("Hulk", o);
map.add(newObject("Exit", platform, newRectangle(98, o.bounds.y+o.bounds.height+1, 3, 2)));
 map.objects[map.objects.length()-1].v.x=-3;
map.objects[map.objects.length()-1].filename="sounds/weapons/Scorpion/FireM.wav";
map.objects[map.objects.length()-1].slot=play_looped("sounds/weapons/Scorpion/FireM.wav", map.objects[map.objects.length()-1].bounds, true);
 movers.insert_last(map.objects[map.objects.length()-1]);
}
}; break;
case 5 : {
 map.addZombie("Tyrant", map.objects[random(0, 3)]);
 map.addZombie("Tyrant", map.objects[random(0, 3)]);
 map.addZombie("Tyrant", map.objects[random(0, 4)]);
 map.addZombie("Tyrant", map.objects[random(0, 4)]);
if(crates>3) {
pool.play_stationary("sounds/Ambience/WallBreak.wav", false);
wait(2000);
 pool.play_stationary("sounds/player/receive.wav", false);
 voice.speak_interrupt_wait("Too many zombies! We can\'t bring you this way! We\'ll try and make an exit back where we came in!");
Object@ ex=newObject("Exit", platform, newRectangle(0, 0, 4, 1));
ex.filename="sounds/Weapons/Vulcan/Fire.wav";
 map.add(ex);
ex.slot=play_looped(ex.filename, ex.bounds, true);
}
}; break;
case 9 : {
// Add more of the boss-class enemies, heal the player, subtract crates.
crates--;
me.health=100.0;
string[] bosses={"Matriarch", "Dire", "Tyrant", "Raider", "Behemoth", "Hulk", "Tentacle"};
for(uint i=0; i<bosses.length(); i++) {
Object@ o;
do {
@o=map.objects[random(0, map.objects.length()-1)];
} while(o.type>3);
map.addZombie(bosses[i], o);
}// 10 zombies? OUCH!
}; break;
case 10 : {
if(((me.attachments)&16)==16) {crates+=stage; me.attachments^=16;}
}; break;
}// stageswitch in story check.
}
sound weaponSound; // For the combustion weapons and firing sounds with tails.

bool load_game(string filename) {
if(!file_exists(filename)) {alert("File not found", "Could not find the " + filename + " file."); return false;}
file fin; fin.open(filename, "rb");
string txt=string_decrypt(fin.read(0), "kelly the rabbit");
fin.close();
string[] lines=string_split(txt, "\n", true);
uint l=0;
for(uint wc=0; wc<weaponNames.length(); wc++) {
for(uint w=0; w<weaponNames[wc].length(); w++) {
if(l>=lines.length()) {alert("Error", "Invalid save file."); return false;}
me.weapons[wc][w]=string_to_number(lines[l]);
l++;
me.ammos[wc][w]=string_to_number(lines[l]);
l++; if(l>=lines.length()) {alert("Error", "Invalid save file."); return false;}
}}
me.medkits=string_to_number(lines[l]); l++; if(l>=lines.length()) {alert("Error", "Invalid save file."); return false;}
level=string_to_number(lines[l]); l++; if(l>=lines.length()) {alert("Error", "Invalid save file."); return false;}
exp=string_to_number(lines[l]); l++; if(l>=lines.length()) {alert("Error", "Invalid save file."); return false;}
stage=string_to_number(lines[l]); l++; if(l>=lines.length()) {alert("Error", "Invalid save file."); return false;}
me.ammo9mm=string_to_number(lines[l]); l++; if(l>=lines.length()) {alert("Error", "Invalid save file."); return false;}
me.ammo30cal=string_to_number(lines[l]); l++; if(l>=lines.length()) {alert("Error", "Invalid save file."); return false;}
me.ammo56=string_to_number(lines[l]); l++; if(l>=lines.length()) {alert("Error", "Invalid save file."); return false;}
me.ammo762=string_to_number(lines[l]); l++; if(l>=lines.length()) {alert("Error", "Invalid save file."); return false;}
me.arrows=string_to_number(lines[l]); l++; if(l>=lines.length()) {alert("Error", "Invalid save file."); return false;}
me.armor=string_to_number(lines[l]); l++; if(l>=lines.length()) {alert("Error", "Invalid save file."); return false;}
me.grenades=string_to_number(lines[l]); l++; if(l>=lines.length()) {alert("Error", "Invalid save file."); return false;}
me.knives=string_to_number(lines[l]); l++; if(l>=lines.length()) {alert("Error", "Invalid save file."); return false;}
me.gas=string_to_number(lines[l]); l++; if(l>=lines.length()) {alert("Error", "Invalid save file."); return false;}
rep=string_to_number(lines[l]);

return true;
}
void save_game(string filename) {
if(file_exists(filename)) {if(question("Confirm file replace", "The file " + filename + " already exists. Are you sure you want to overwrite it?")!=1) return;}

string txt="";
for(uint wc=0; wc<weaponNames.length(); wc++) {
for(uint w=0; w<weaponNames[wc].length(); w++) {
txt += me.weapons[wc][w] + "\n" + me.ammos[wc][w] + "\n";
}}
txt += me.medkits + "\n"
 + level + "\n"
 + exp + "\n"
 + stage + "\n"
+ me.ammo9mm + "\n"
+ me.ammo30cal + "\n"
 + me.ammo56 + "\n"
 + me.ammo762 + "\n"
 + me.arrows + "\n"
 + me.armor + "\n"
 + me.grenades + "\n"
 + me.knives + "\n"
 + me.gas + "\n"
 + rep + "\n";

file fout;
fout.open(filename, "wb");
fout.write(string_encrypt(txt, "kelly the rabbit"));
fout.close();
voice.speak_interrupt("Game saved successfully.");
}

