 class Point2D {
 double x; double y;
 Point2D(double xx, double yy) {x=xx; y=yy;}
 double getX() {return x;}
 double getY() {return y;}
 }


/*
   BitChar made to accompany BitRoom.
   A BitChar should facilitate position relative to a BitRoom,
   Tile size and velocity.
   Velocity is represented in terms of time between steps from tile to tile;
*/

 class BitChar {

 double vx; 
double vy;
 int x; int y;
  double counter;
  int width; int height;
 double speed;

 BitChar() {width=1; height=1; init();}
 BitChar(int w, int h) {width=w; height=h; init();}
 void init() {
 vx=0.0; vy=0.0; x=0; y=0; speed=0.5; counter=0.0;
 } 
 void setSpeed(double s) {speed=s;}
 void setVX(double v) {vx=v;}
 void setVY(double v) {vy=v;}
 void setX(int i) {x=i;}
 void setY(int i) {y=i;}
 void setPose(int tx, int ty) {setX(tx); setY(ty);}
// void setPose(Point2D p) {setPose((int)(p.getX()), (int)(p.getY()));}
 void setCounter(double c) {counter=c;}
 void step(double dt) {
 if(counter>0.0) {counter-=dt;
 if(counter<=0.0) {
 counter=0.0;
if(vx>0.0) x++; else if(vx<0.0) x--;
 if(vy>0.0) y++; else if(vy<0.0) y--;
}
}//Descending
 else if(counter<0.0) {counter+=dt;
 if(counter>=0.0) {counter=0.0;
//...
}
}//ascending.
}
}




 class TyleMap : BitRoom {

   double gravity; //Gravity's confusing.
   string defaultLand; string defaultStep;  string defaultBump; string defaultFall;
   string walls;  string platforms; // "platforms" are objects that are passable from all directions other than from above; the sort of thing one can jump to from below and stand on.
 TyleChar@[] team1;
 TyleChar@[] team2;
 TyleChar@[] statics;
 TyleChar@[] items;
 TyleChar@[] projectiles; //Meh.
 dictionary steps; dictionary landings; dictionary bumps; dictionary falls;

   string ids;
   TyleMap@ north; TyleMap@ south;
 TyleMap@ east; 
TyleMap@ west;
   string bgm;
   bool loop;

   TyleMap(string[] str) {
 super(0, 0, 0); //We're overriding most of this; will this suffice in the meantime?
 init();
 uint types=0;
 uint h=str.length();
//We need to define properties before making the BitRoom.
 uint w=0;
 string recognized=" ";
for(uint i=0; i<str.length(); i++) {
// if(str[i]==null) continue;
 if(str[i].length()>w+1) w=str[i].length()-1; //Hmm.
for(uint c=0; c<str[i].length(); c++) if(string_contains(recognized, "" + str[i][c], 1)<0) {
 string n="" + str[i][c];
 if((n==" ")||(n==",")||(n=="0")) continue;
recognized = recognized + n; types++;} 
}

//Now we can make the BitRoom:
if(types<recognized.length()) types=recognized.length();
width=w; height=h; typeNum=types; ids=recognized;
// map=new int[typeNum][height];
 map.resize(typeNum);
 for(uint i=0; i<map.length(); i++) {map[i].resize(height);
 for(int y=0; y<height; y++) map[i][y]=0;
 }

for(uint y=0; y<h; y++)
for(uint x=0; x<=w; x++) {
 if(str[y].length()<=x) {x=w; continue;}
  string n="" + str[y][x];
 if((n==" ")||(n==",")||(n=="0")) continue;
 else set(x, y, string_contains(recognized, n, 1));
}
}// There must be a better word for insane...

 void init() {
slopes=""; water="~";
 gravity=0.25; //Gravity's confusing.

    walls="|-"; platforms="=";

 ids=" ";
  @north=null; @south=null; @east=null; @west=null;
 bgm="";
loop=false;
 }
