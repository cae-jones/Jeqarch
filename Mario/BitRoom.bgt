/*
 An instance of BitRoom can represent a map (or board) of equal-size objects in terms of [x, y].
  The goal of this class is to provide a minimalist approach to representing a tyled space;
  rather than a string-map (where each space is represented by a char),
  or an object-oriented map (where each object is an instance of an Object class of some kind),
  each object in a BitRoom is represented by a single bit,
   where an integer represents each horizontal row.
  The limitation of this method is that it restricts the diversity of objects in the room;
  typically, a BitRoom is only more efficient than a CharRoom when
  the number of types is less than sqrt(width * height).
*/

 class BitRoom {
 int[][] map;
 int width;
 int height;
 int typeNum;

 BitRoom(int w, int h, int t) {
 width=w;
 height=h;
 typeNum=t;
 if(width>32) alert("Illegal Argument Exception!", "Width must be between 0 and 32.");

// map=new int[typeNum][height];
 map.resize(typeNum);
 for(int i=0; i<typeNum; i++) {map[typeNum].resize(height);
 for(int y=0; y<height; i++) map[i][y]=0;
}// Initialize!
}

//Returns the typeIndex for the given coordinates.
//If nothing is found at [x, y], return -1.
//If multiple objects exist at [x, y], which is returned?
 int get(int x, int y) {
 if((x<0)||(x>width)||(y<0)||(y>=height)) return -1; //throw new IndexOutOfBoundsException(" [" + x + ", " + y + "] is out of range [" + width + ", " + height + "].");

for(int i=0; i<typeNum; i++) {
if(((map[i][y]) & (1<<x))!=0) return i;
}

return -1;
}

//Sets [x, y, t] to true.
 void set(int x, int y, int t) {
if((x<0)||(x>width)||(y<0)||(y>=height)||(t<0)||(t>=typeNum)) return; //throw new IndexOutOfBoundsException(" [" + x + ", " + y + ", " + t + "] is out of range [" + width + ", " + height + ", " + typeNum + "]. ");
map[t][y]|=(1<<x);
}
//Drawn from [0, 0] = top left corner. 
/* string tostring() {
string ret="";
for(int y=0; y<height; y++) {
for(int x=0; x<=width; x++) ret +=(char)(get(x, y)+49);
; ; ;
 ret =ret + "\n";
}
return ret; 
}*/

 int getWidth() {return width;}
 int getHeight() {return height;}
 int getTypeNum() {return typeNum;}

//Clears the given space of all types.
 void clear (int x, int y) {
 if((x<0)||(x>width)||(y<0)||(y>=height)) return; //throw new IndexOutOfBoundsException("[0, 0] to [" + width + ", " + height + "]: [" + x + ", " + y + "].");
 int c=~(1<<x); //And this with each entry to clear only the specified x.
for(int t=0; t<typeNum; t++) map[t][y]&=c;
 //My confidence in this method is a bit lacking.
}//Clear

}


//Converts a string Array to a BitRoom.

/*  static*/ BitRoom@ getFromStringArray(string[] str) {
//BitRoom ret=null;
uint types=0;
uint h=str.length();
//We need to define properties before making the BitRoom.
uint w=0;
 string recognized=" ";
for(uint i=0; i<str.length(); i++) {
// if(str[i]==null) continue;
 if(str[i].length()>w+1) w=str[i].length()-1; //Hmm.
for(uint c=0; c<str[i].length(); c++) {
if(string_contains(recognized, "" + str[i][c], 1)<0) {recognized = recognized + str[i][c]; types++;} 
}// C Loop.
}

//Now we can make the BitRoom:
 BitRoom ret(w, h, types);
for(uint y=0; y<h; y++)
for(uint x=0; x<=w; x++) {
 if(str[y].length()<=x) {x=w; continue;}
 string n="" + str[y][x];
 if(n==" ") continue;
 else ret.set(x, y, string_contains(recognized, n, 1)-1);
}
 return @ret;
}

