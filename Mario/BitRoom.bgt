 if(index>=0) team2.remove_at(index);
 }// Team2.
 return me;
}// Remove.
//   Object remove(Object me) {return remove(me, (isEnemy(me))?2:1);}
 TyleChar@ remove(TyleChar@ me) {
 int tea=1;
 if(isEnemy(me)) tea=2;
 return remove(me, tea);
 }

