int c=get(x, y);
if(c<0) return " ";
 uint c2=0+c;
 if(c2>=ids.length()) return "-";
 return "" + ids[c];
}
   void setC(int x, int y, string t) {
 if(string_contains(ids, t, 1)>=0) {clear(x, y); set(x, y, string_contains(ids, t, 1));}
else {

typeNum++;

// try {

 int[][] m;//=new int[typeNum][height];
 m.resize(typeNum); for(uint i=0; i<m.length(); i++) m[i].resize(height);

 for(int i=0; i<typeNum-1; i++) for(int cy=0; cy<height; cy++) m[i][cy]=map[i][cy];;;
 for(int cy=0; cy<height; cy++) m[typeNum-1][cy]=0;

 ids=ids + t;
 map=m;
 clear(x, y);

  set(x, y, ids.length()-1);


// } catch (Exception iobe) {iobe.printStackTrace();}
}//Add another type.
}

