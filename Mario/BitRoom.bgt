   TyleChar@ remove (TyleChar@ me, int tea) {
 if(@me==null) return me;
// ArrayList team=(tea==1)?team1:team2;
// if(team==null) return me; //?????????
//  if(team.indexOf(me)>=0) team.remove(team.indexOf(me));
  if(tea==1) {
 int index=array_contains(team1, me);
 if(index>=0) team1.remove_at(index);
 }// Team1.
 else {
