 void extendStage(TyleMap@ ret) {
 if(@ret==null) return;
// ret.defaultBump= ("mario/smb3_bump.wav");
 ret.defaultBump=bumpblock; // O.O I dumb. 12:14 PM 1/1/2011
  ret.defaultLand="mario/tone.wav"; // Remove this later.
 ret.defaultStep="mario/step.wav";
 ret.walls="-|PpBbCM23^vV<>Tt456789S";
// ret.bumps=new HashMap();
// ret.bumps.put(new Character('M'), bumpblock);
 ret.bumps.set("M", bumpblock);
// ret.bumps.put(new Character('S'), bumpblock);
 ret.bumps.set("S", bumpblock);
// ret.bumps.put(new Character('C'), bumpblock);
 ret.bumps.set("C", bumpblock);
// ret.bumps.put(new Character('b'), bumpblock);
 ret.bumps.set("b", bumpblock);

 TyleMap@ next=ret.east;
 while(@next!=null) {
 next.bgm=ret.bgm;
 next.defaultStep=ret.defaultStep; next.defaultLand=ret.defaultLand; next.defaultBump=ret.defaultBump;
 next.defaultFall=ret.defaultFall;
 next.gravity=ret.gravity; // For water, mostly.
 next.walls=ret.walls; next.bumps=ret.bumps; @next=next.east;
}

