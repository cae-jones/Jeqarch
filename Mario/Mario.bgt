 addEastwest(ret.east, newTyleMap(diag3));
extendStage(ret);
 @(me.gloc)=ret;
 me.x=1; me.y=1;
 addEastwest(ret.east.east, ret.east); // That sounds like death.

 }// Advancing from room 4.
 // 25, 8 goes to the water level?
 else if((me.x==25)&&(me.y==8)) {
 @nexit=me.gloc.east;
if(@exitPoint!=null) {
 exitPoint.x=19; exitPoint.y=7;
}
 string[] diag= {
