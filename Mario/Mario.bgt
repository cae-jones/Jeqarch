 if((enemy.x<0)||(enemy.x>=me.gloc.getWidth())||((me.gloc.getC(enemy.x, enemy.y)!=" ")&&(me.gloc.getC(enemy.x, enemy.y)!="~"))) enemy.hp=-1.0;
 }// Moving...

 }// Bullets.
 else if(enemy.name=="Hammerhead Brother") {
 // I could give them boomarang hammers, but that's complicated.
 // How about they can move, and whatever is below them is vulnerable? Oh, jees, in that case it's hard to escape them.
 // Well, ok, they aren't attacking _all_ the time.
