 @(me.gloc)=newTyleMap( diag);
 me.x=1; me.y=0; me.gloc.bgm= ("mario/underworld.wav"); extendStage(me.gloc); //???


 }; break;
 case 14 : {
 // warpzone in 4-2.
 @nexit=null;
 if(@(me.gloc.west)==null) {
