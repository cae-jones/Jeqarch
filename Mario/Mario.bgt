 if((me.x==perana)&&(starpower<=0.0)) {
 if((me.y<me.gloc.getHeight()-1)&&(me.gloc.getC(me.x, me.y+1)=="p")) hitEnemy(me, newTyleChar("Perana Plant"), me.x);
