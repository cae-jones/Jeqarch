   void keyPressed() {

 if(key_pressed(KEY_PRIOR)) {BGMVolume+=5; if(BGMVolume>0) BGMVolume=0; bgm.volume=BGMVolume;}
 else if(key_pressed(KEY_NEXT)) {BGMVolume-=5; if(BGMVolume<-100) BGMVolume=-100; bgm.volume=BGMVolume;}
// if((k>=KEY_F1)&&(k<=KEY_F12)) {
 if(key_pressed(KEY_F1)) {

 // Needs to reveal the position of the character and all enemies.
 TyleChar@ me=mario;

 string tosay="";
 
 tosay=me.name + " is at " + me.x + ", " + me.y + ". ";
 if(me.vx!=0.0) tosay += "" + me.name + " is moving. ";
 if((perana>=0)&&(perana<30)) tosay += " There is a perana plant in column " + perana + ". ";
 if((@(me.gloc)!=null)&&(me.gloc.team2.length()>0)) for(uint i=0; i<me.gloc.team2.length(); i++) {
 TyleChar enemy=me.gloc.team2[i];
 tosay=tosay + " There is a " + enemy.name + " at " + enemy.x + ", " + enemy.y + ". ";
 }
 QuadTalker.speak(tosay);
 while((QuadTalker.speaking)&&((!key_down(KEY_LCONTROL))&&(!key_down(KEY_RCONTROL)))) {wait(5);}
 if(QuadTalker.speaking) QuadTalker.stop();
// } catch (Exception malfunction) {}

 }// F1.
// else if(key_pressed(KEY_F2)) QuadTalker.speak("" + mario.counter);
 else if(key_pressed(KEY_F5)) {// Set loc to soundtest.
 if(loc==soundTest) loc=title; else loc=soundTest;
 }// Sound Test.
// else if((k==KEY_F11)&&(key1.isKeyPressed(KeyC.C))) try {stage=Integer.parseInt(JOptionPane.showInputDialog("Enter Stage (1-32):")); mario.gloc=setStage();} catch (Exception badanerie) {QuadTalker.speak("Invalid input.");} // Level skip, debug. Remove from final version!
 else if(key_pressed(KEY_F2)) {
 string tosave="";
 tosave = tosave + stage + "\n";
 tosave = tosave + p1lives + "\n";
 tosave = tosave + p2lives + "\n";
 tosave=tosave + p1coins + "\n";
 tosave = tosave + p2coins + "\n";
 tosave = tosave + mario.hp + "\n";
 tosave=tosave + mario.mp + "\n";
 if(hard_mode) tosave = tosave + "1\n";
 file saveFile;
 saveFile.open("asmb.dat", "w");
 saveFile.write(tosave);
 saveFile.close();
 QuadTalker.speak("Saved. ");
 }// save game.
 else if(key_pressed(KEY_F3)) {
 file saveFile;
 if(saveFile.open("asmb.dat", "r")) {
 string tosave=saveFile.read(0);
 string[] lines=string_split(tosave, "\n", false);
 stage=string_to_number(lines[0]);
 p1lives=string_to_number(lines[1]);
 p2lives=string_to_number(lines[2]);
 p1coins=string_to_number(lines[3]);
 p2coins=string_to_number(lines[4]);
 mario.hp=string_to_number(lines[5]);
 mario.mp=string_to_number(lines[6]);
 if(lines.length()>7) hard_mode=(lines[7]=="1");
 if(bgm.playing) bgm.stop();
 QuadTalker.speak("Loaded.");
 loc=nextStage; counter=0.0;
 checkpoint.x=1; checkpoint.y=5;
 } else QuadTalker.speak("File not found.");
 }// Load Game.
 else if(key_pressed(KEY_F6)) {
 int room=0;
 TyleMap@ g;
 @g=mario.gloc;
 TyleMap @next;
 while((@g!=null)&&(room<100)) {room++; @next=g.west;
 if(@next==@g) break;
 else @g=next;
}
 QuadTalker.speak_wait("In room " + room + ".");
 if((@(mario.gloc.west)==null)&&(@(mario.gloc.east)==null)) QuadTalker.speak(" This is a hidden room.");
 if(mario.gloc.bgm=="mario/starman.wav") QuadTalker.speak(" In the clouds.");
 }// Room check.
 else if(key_pressed(KEY_F7)) QuadTalker.speak_wait("Mario has " + p1coins + " points, and " + p1lives + " lives. ");
 else if(key_pressed(KEY_F8)) QuadTalker.speak_wait("The accessible camera is at " + camX + ", " + camY + ". ");
 else if(key_pressed(KEY_F11)) stage=string_to_number(input_box("Level select", "Enter level"));
 else if(key_pressed(KEY_F4)) {
 exit();
 QuadTalker.speak("Are you sure you want to quit? Press enter to quit, or escape to return to the game.");
 while ((!key_pressed(KEY_RETURN))&&(!key_pressed(KEY_ESCAPE))) { wait(5);}
 if(key_down(KEY_RETURN)) {QuadTalker.speak_wait("Thanks for playing."); exit();}
 }// Exit.
