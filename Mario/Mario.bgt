 else if(me.x<=22) stage=29;
 else stage=25;
}
 else stage=17;
 @(me.gloc)=setStage();
 me.x=1; me.y=5;

 
 QuadTalker.speak_wait("Warped to world " + ((stage/4)+1) + ". ");
 }; break;
 case 17 : {
 @nexit=me.gloc.east.east; exitPoint.x=1; exitPoint.y=0; //???
