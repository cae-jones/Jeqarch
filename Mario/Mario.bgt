 void climb(TyleChar@ me) {
 if(stage/4==3) {
 string[] diag={
 "                             -",
 "    $$$  $$$                w-",
 "              --------------w-",
 "    ---   ----    -          -",
 "  $$$$$ $$$$      -          -",
 "  $$$$$ $$$$      -          -",
 "  ----- ----      -          -",
 "                  -          -",
 "    $$$$$$        -          -",
 "   -- --   --  $$ - P  P  P  -",
 "                  - p  p  p  -",
 "    - $$$  $$$ $$ - p  p  p  -",
 "------------------------------"
 };
 TyleMap@ ret;
 @ret=newTyleMap(diag);
 ret.bgm="mario/overworld.wav";
 extendStage(ret);
 @(me.gloc)=ret; me.x=1; me.y=ret.getHeight()-2;
 }// Stage 4 warp zone.
 else {
 TyleMap@ next=me.gloc;
 while(@next.east!=null) @next=next.east;
 string[] diag= {
 "                              ",
 "   $$$$$$$$$$$$               ",
 "   $$$$$$$$$$$$               ",
 "     c    c   c  c            ",
 ">>>                           ",
 "                          $$$ ",
 "                              ",
 "------------------------------"
 };

 @(me.gloc)=newTyleMap(diag );
 extendStage(me.gloc);
 @(me.gloc.east)=next; me.gloc.bgm= ("mario/starman.wav");
 me.y=me.gloc.getHeight()-3; me.x=1;
 }// Default.
 }// Climbing. Usually into the clouds, but not exclusively.



string[] display_text;
 timer refresh_timer;

 void set_display_text(TyleMap@ g) {
 if(@g==null) return;
 string text=g.toString();
 text=string_replace(text, "S", "b", true);
 text=string_replace(text, "2", " ", true);
 // I'm sure I'm forgetting something crucialicious.
 display_text=string_split(text, "\n", true); 
 }// Set display text.

 void setOutput(int dispY) {
 int chl=0; chl+=display_text.length();
 if((dispY<0)||(dispY>=chl)) return;

 string ret=display_text[dispY];
 if(camY==dispY)  ret[camX]="x";
 if(mario.y==dispY) {ret[mario.x]="("; if(mario.face!="e") ret[mario.x]=")";}
 if(@(mario.gloc)!=null) {
 for(uint i=0; i<mario.gloc.team2.length(); i++) {
 TyleChar@ enemy; @enemy=mario.gloc.team2[i];
 if((@enemy!=null)&&(enemy.hp>0.0)&&(enemy.y==dispY)&&(enemy.x>=0)&&(enemy.x<30)) {
 string id=enemy.name[0];
 if((enemy.name=="star")||(enemy.name=="Star")) id="*";
 else if((enemy.name=="Mushroom")||(enemy.name=="mushroom")) id="+";
 else if((enemy.name=="Flower")||(enemy.name=="flower")) id="[";
 else if(enemy.name=="1up") id="!";
 else if((enemy.name=="Goomba")||(enemy.name=="goomba")||(enemy.name=="Kuribo")||(enemy.name=="kuribo")) id="o";
 else if((enemy.name=="paratroopa")||(enemy.name=="Paratroopa")) id="O";
 else if((enemy.name=="snail")||(enemy.name=="Snail")) id="=";
 else if(enemy.name=="Bowser") {id="R";
 int count=100*counter;

 // Bowser breathes fire periodicly. Every two or three seconds?
 int fbx=enemy.x;
 if(enemy.face=="e") fbx+=(count/100)%10;
 else fbx-=(count/100)%25;
 if((fbx>=0)&&(fbx<30)) ret[fbx]="{";

 }// Bowser.
 ret[enemy.x]=id;
 }// How do we represent enemies, Hmm?
 else if((@enemy!=null)&&(enemy.name=="Bowser")) {
 if(absolute(enemy.y-dispY)<=1) {
 int fishx=enemy.x;
 for(int j=fishx; (j<fishx+3)&&(j<30); j++) {ret[j]="r";}
}// Oy.
}// Bowser.
 }// Enemies.
 }// Non-null gloc.

 // Show fireballs.
 if((firex>=0.0)&&(firey==dispY)&&(firex<30.0)) {uint fx=0; fx+=firex; if(fx<ret.length()) ret[fx]="\"";}
 if((fire2>=0.0)&&(firey2==dispY)&&(fire2<30.0)) {uint fx=0; fx+=fire2; if(fx<ret.length()) ret[fx]="\"";}

 // Let's add platform information, since otherwise this is as tedious as having the accessible camera without cues.
 if(dispY<chl-1) {for(uint xx=0; xx<ret.length(); xx++) {
 if(((ret[xx]==" ")||(ret[xx]=="~"))&&(display_text[dispY+1][xx]!=" ")&&(display_text[dispY+1][xx]!="~")&&(display_text[dispY+1][xx]!="$")&&(display_text[dispY+1][xx]!="w")) {
 if(ret[xx]=="~") ret[xx]="#"; else ret[xx]="-";
 for(int yy=dispY-1; (yy>=0)&&(dispY-yy<=5); yy--) {
 if((yy<0)||(yy>=chl)||(xx<0)||(xx>29)) continue;
 uint x2=xx; if(x2>=display_text[yy].length()) continue;
 if((display_text[yy][xx]!=" ")&&(display_text[yy][xx]!="~")&&(display_text[yy][xx]!="$")&&(display_text[yy][xx]!="w")) {
 if(dispY-yy<=2) ret[xx]="x"; else ret[xx]="u";
 yy=0;
 }// Platform found.
 }// Look for platforms.
}
 else if(ret[xx]=="-") ret[xx]="7"; // So as not to be confused with below.
 else  if((ret[xx]==" ")||(ret[xx]=="~")) for(int yy=dispY-1; (yy>=0)&&(dispY-yy<=5); yy--) {
 if((yy<0)||(yy>=chl)||(xx<0)||(xx>29)) continue;
 uint x2=xx; if(x2>=display_text[yy].length()) continue;
 if((display_text[yy][xx]!=" ")&&(display_text[yy][xx]!="~")&&(display_text[yy][xx]!="$")&&(display_text[yy][xx]!="w")) {
 if(dispY-yy<=2) ret[xx]="c"; else ret[xx]="a";
 yy=0;
 }// Platform found.
 }// Look for platforms.

}
 int chx=0; chx+=ret.length();
 if((perana>=0)&&(perana<30)&&(perana<chx)&&((ret[perana]=="-")||(ret[perana]=="u")||(ret[perana]=="x"))&&(display_text[dispY+1][perana]=="p")) ret[perana]=":";
}// Platform check.
 show_game_window(ret);

 }// Set Output.
