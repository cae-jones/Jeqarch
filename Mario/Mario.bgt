 if(me.y>=me.gloc.getHeight()-1) me.y=me.gloc.getHeight()-3;

 // 11:53 PM 8/30/2011: It's possible to wind up stuck inside walls here, so let's put in a failsafe for that.
 
 string cn=me.gloc.getC(me.x, me.y);
 while((cn!=" ")&&(cn!="~")&&(cn!="$")&&(cn!="W")&&(cn!="w")&&(cn!="F")&&(cn!="f")) {
 if(me.y>0) me.y--; else me.y=me.gloc.getHeight()-2;
cn=me.gloc.getC(me.x, me.y);
}
 

