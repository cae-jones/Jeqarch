 if(enemy.counter<=0.0) {
 // Adjust Vy/Vx.
 if(enemy.x>me.x) enemy.face="w";
 else if(enemy.x<me.x) enemy.face="e";
 if(absolute(me.x-enemy.x)>1) {enemy.counter=0.3; enemy.vx=0.3; sb.play_2d("mario/kick.wav", camera.x, camera.y, enemy.x, enemy.y, false);}
 if(me.y<enemy.y) {sb.play_2d("mario/bowser_jump.wav", camera.x, camera.y, enemy.x, enemy.y, false); enemy.counter=0.5; enemy.y=Math_max(me.y-1, 1); enemy.state="a";}
 if(enemy.counter==0.0) {enemy.state="b"; enemy.counter=1.0; sb.play_2d("mario/smb3_shuffle.wav", camera.x, camera.y, enemy.x, enemy.y, false);}
 }// AI.
 else {
 if(enemy.state=="b") {
 if((starpower<=0.0)&&(absolute(me.x-enemy.x)<3)&&(me.y>=enemy.y)) hitEnemy(me, enemy, stereoX);
 else enemy.counter*=math_random(); //alert("Hammers thrown!", "Distances between Mario and the Hammerhead Brother throwing: " + absolute(me.x-enemy.x) + ", " + (me.y-enemy.y) + ". Starpower is " + starpower + ". ");
 int count=enemy.counter*10;
 if(count%3==0) sb.play_1d("mario/smb3_shuffle.wav", camera.x, enemy.x, false);
 }// Attacking
 }// Just keep doin' what you're doin'.

 if((stomped)||((enemy.x==firex)&&(absolute(enemy.y-firey)<2))||((enemy.x==fire2)&&(absolute(enemy.y-firey2)<2))) {enemy.state="wait"; enemy.hp=-1.0; sb.play_1d("mario/smb3_kick.wav", camera.x, enemy.x, false);
 addPoints(800);
}

 if(hit) hitEnemy(me, enemy, stereoX);
 }// HHBros.
 if(enemy.y>=gloc.getHeight()) enemy.hp=-1.0;
 if((enemy.hp<=0.0)&&((@(enemy.lastHit)==null)||(enemy.hitTimer>1.0))) {
 if(enemy.y>=gloc.getHeight()) {

 }// No points from people who fall to their deaths.
