 me.gloc.bgm="mario/underwater.ogg"; extendStage(me.gloc);
 }; break;
 case 32 : {
 // Crazy mazy in 8-4.

 // Room 2: 13, 4. Well, that's where the pipe is. Mario would be at 13, 3.
