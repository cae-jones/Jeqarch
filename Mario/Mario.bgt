 if(output_to_window) show_game_window("GAME OVER");
 stage=1+(4*((stage-1)/4));
 checkpoint.x=1; checkpoint.y=5; checkgloc=0;
 wait(5000);
 if( (player&1)==0) p2lives=5; else p1lives=5;
 }
 }
 }; break;
 }//Locswitch in step.

