 // 15, 7, (to room 2)
 if((me.x==15)&&(me.y==7)) {@(me.gloc)=me.gloc.west.west; me.x=1; me.y=5;}
 // 27, 7 (advance)
 else if((me.x==27)&&(me.y==7)) {
 // That second pipe in the horizontal platform room goes here: 
