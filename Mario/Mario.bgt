 string bumpblock="mario/bumpblock.wav"; // Saved so that size can be caught.
 TyleMap@ gloc, nexit;
 Point2D exitPoint(2, 7);
 double starpower=0.0;
 double[] timeLimits (32);

 void init(int tt, double dd) {t=tt; speed=dd;

 // Create Mario and Luigi.
 mario.name="Mario"; mario.hitcries.insert_last("mario/pipe.wav");
 luigi.name="Luigi"; luigi.hitcries.insert_last(mario.hitcries[0]);
 mario.height=1; luigi.height=1;
 mario.mp=0; luigi.mp=0;
 mario.migrates=true; luigi.migrates=true;
// HashMap list=mario.movelist;
 // Oh, the horror...
 // Walking.
 TTechnique teq=newTechnique(0.25);

 teq.dvx=0.25;
 mario.movelist.set("f", teq);
 mario.movelist.set("air_f", teq);
 // Turning:
 teq=newTechnique(0.05);
 teq.rotate=4;
 teq.addStartSound("mario/stop.wav");
 mario.movelist.set("b", teq);
 mario.movelist.set("air_b", teq);
 // Jump.
 teq=newTechnique(0.7);
 teq.dvy=-0.1; //???
 teq.addStartSound(jump);
 teq.weightless=true;
 mario.movelist.set("a", teq);

 // Jump forward.
 teq=newTechnique(0.3);
 teq.dvx=0.2; teq.dvy=-0.1;
 teq.addStartSound(jump); // This isn't easy to fix, methinks.
// list.put(new Integer(TyleChar.forward|TyleChar.A), teq);
// list.put("air_" + (TyleChar.forward|TyleChar.A), teq);
 mario.movelist.set("fa", teq);
 mario.movelist.set("af", teq);
 mario.movelist.set("air_af", teq);

 // Back-jump.
 teq=newTechnique(0.3);
 teq.dvx=-0.2; teq.dvy=-0.1;
 teq.addStartSound(jump); // This isn't easy to fix, methinks.
// list.put(new Integer(TyleChar.back|TyleChar.A), teq);
// list.put("air_" + (TyleChar.back|TyleChar.A), teq);
 mario.movelist.set("ba", teq);
 mario.movelist.set("ab", teq);
 mario.movelist.set("air_ba", teq);
 mario.movelist.set("air_ab", teq);

 // Fireball.
 teq=newTechnique(0.1);
 teq.addStartSound("mario/fireball.wav");
 teq.mp=1.0;
 teq.addHitArea(1, 0, 0, 1, 1); teq.damage=1.0; teq.stun=0.5;
// list.put(new Integer(TyleChar.B), teq);
// list.put("air_" + TyleChar.B, teq);
 mario.movelist.set("x", teq);
 mario.movelist.set("air_x", teq);

 // Running Fireball.
 teq=newTechnique(0.1);
 teq.addStartSound("mario/fireball.wav");
 teq.mp=1.0;
 teq.addHitArea(1, 0, 0, 1, 1); teq.damage=1.0; teq.stun=0.5;
 teq.dvx=0.2;
// list.put(new Integer(TyleChar.B|TyleChar.forward), teq);
// list.put("air_" + (TyleChar.forward|TyleChar.B), teq);
 mario.movelist.set("fx", teq);
 mario.movelist.set("air_fx", teq);

 // Jumping Fireball.
 teq=newTechnique(0.25);
 teq.addStartSound("mario/fireball.wav");
 teq.mp=1.0;
 teq.addHitArea(1, 0, 0, 1, 1); teq.damage=1.0; teq.stun=0.5;
 teq.dvy=-0.1;
// list.put(new Integer(TyleChar.B|TyleChar.A), teq);
 mario.movelist.set("ax", teq);
 mario.movelist.set("air_ax", teq);

 // Jump-Forward-Fireball
 teq=newTechnique(0.25);
 teq.addStartSound("mario/fireball.wav");
 teq.mp=1.0;
 teq.addHitArea(1, 0, 0, 1, 1); teq.damage=1.0; teq.stun=0.5;
 teq.dvx=0.25; teq.dvy=-0.1;
// list.put(new Integer(TyleChar.B|TyleChar.forward|TyleChar.A), teq);
 mario.movelist.set("afx", teq);
 mario.movelist.set("fax", teq);
 mario.movelist.set("air_afx", teq);
 mario.movelist.set("air_afx", teq);

 luigi.movelist=mario.movelist;

 stage=1;
 @(mario.gloc)=setStage();
 @(luigi.gloc)=mario.gloc;

// try {
// QuadTalker.setVoice(QuadTalker.buildVoiceList().get(0));
// } catch (Exception voiceError) {System.err.println("Unable to initialize sapi text-to-speech.");}
 }//Constructor.


