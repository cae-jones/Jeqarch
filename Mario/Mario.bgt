 TyleChar getFireball() {
 TyleChar ret("Fireball");
 ret.hp=9999999;
 string[] flames={"mario/flame.wav"};
 // Needs to rise, then fall.
// HashMap list=ret.movelist;
 ret.agility=0.5; // Yes/no/maybe?
 TTechnique@ teq; @teq=null;
 for(int i=1; i<11; i++) {
 @teq=newTechnique(0.15);
 teq.startSounds=flames;
 teq.weightless=true;
 teq.dvy=0.2;
 teq.recovery=teq.duration;
 teq.endState="" + (i+1);
 ret.movelist.set("" + i, teq);
 ret.movelist.set("air_" + i, teq);

 // On the way down...
 @teq=newTechnique(0.25); teq.startSounds=flames;
 teq.recovery=teq.duration; teq.endState="" + (i+11);
 ret.movelist.set("" + (i+10), teq);
 ret.movelist.set("air_" + (i+10), teq);
 }// Fireballs go up...
 if(@teq!=null) teq.endState="wait"; teq.recovery=1.0;
 ret.counter=2.0*math_random(); // No telling when it'll pop up...
 return ret;
 }// Fireballs.
 TyleChar Bowser() {
 TyleChar ret=newTyleChar("Bowser");
 ret.hp=stage;
// HashMap list=ret.movelist;
 ret.width=3; ret.height=4; 

 // I'll Allow his horizontal movement to be controlled by something other than techniques.
 // Jumping, on the other hand:
 TTechnique teq=newTechnique(0.5);
 teq.recovery=0.25;
 teq.weightless=true;
 teq.dvy=-0.2;
 teq.addStartSound("mario/bowser_jump.wav");
// list.put(new Integer(TyleChar.B), teq);
 ret.movelist.set("x", teq);

 // Firebreath.
 teq=newTechnique(5.0); // Only use at long range?
 teq.addStartSound("mario/flame.wav");
 HitArea ha=teq.addHitArea(15, 0, 1023, 1, 1);
 ha.x1=1; ha.xrange1=1; ha.y1=0; ha.yrange1=1; ha.z1=ha.z;
 teq.damage=1.0;
 teq.addHitsound("mario/pipe.wav");
// list.put(new Integer(TyleChar.A), teq);
// list.put("air_" + TyleChar.A, teq);
 ret.movelist.set("a", teq);
 ret.movelist.set("air_a", teq);

 return ret;
 }// Bowser.
 void hammerhead(int x, int y, TyleMap@ g)
 {
 TyleChar@ ret;
 @ret=newTyleChar("Hammerhead Brother");
 ret.x=x; ret.y=y; @(ret.gloc)=g;
 ret.gloc.add(ret, 2);
 ret.face="w";
 ret.counter=math_random();
 ret.state="b";
 }// Hammerhead brother.

 int curcoins=0; // For inside a stage.

 void setStageComplete(TyleChar@ me) {
 int fireworks=(10.0*counter);
 if(counter<300.0) addPoints(10*(300-counter));
 string tosay="Score for this level: " + curcoins + ". Time: " + floor(counter) + ". Total score: " + p1coins + ". ";
 curcoins=0;
 stage++; counter=0.0; loc=nextStage; checkgloc=0; checkpoint.x=1; checkpoint.y=6;
// key1.release(key1.l); key1.release(key1.r); key2.release(key2.l); key2.release(key2.r);
 string toplay="mario/flag.wav"; if(stage%4==1) toplay="mario/bossfall.wav";
 sb.play_1d(toplay, 0, 0, false);
 wait(2000);
 if(stage%4==1) playsong("mario/bd.wav"); else playsong("mario/win.wav");
  wait(1500);
 if(stage%4==1) {
 if(stage<32) {
 if(output_to_window) show_game_window("Sorry, Mario, but our princess is in another castle.");
QuadTalker.speak_wait("Sorry, Mario, but our princess is in another castle.");
}
 else {
QuadTalker.speak_wait("You\'ve found Princess Toadstool!");
}
 }// Castle.
  else {
 if(output_to_window) show_game_window(tosay);
 fireworks%=10;
 if((fireworks==1)||(fireworks==3)||(fireworks==6)) {
 while(fireworks>0) {fireworks--;
sb.play_1d("mario/smb3_thwomp.wav", random(-4, 4), 0, false); wait(500);}
 }// Fireworks
 }// Fireworks.
 if(output_to_window) show_game_window(tosay);
 QuadTalker.speak_wait(tosay);
 wait(2000);
 }// Meep.
 void setGameComplete() {
 stage=1; loc=title; playsong("mario/ending.wav"); wait(12050);
 hard_mode=true;
// QuadTalker.speak_wait("Congratulations! You\'ve completed the game! Thanks for playing!");
 string tosay="Thank you, Mario! Your quest is over. We present you a new quest.";
 if(output_to_window) show_game_window(tosay);
 QuadTalker.speak_wait(tosay);
 level_select();
 p1coins=0;
 }// Game Complete.
 void level_select() {
 wait(2500);
 sound snd;
 snd.load("mario/underwater.ogg");
 snd.pitch=75;
 snd.play_looped();
 snd.volume=BGMVolume;
 if(output_to_window) show_game_window("Use the directions to select a world.");
 QuadTalker.speak("Use the directions to select a world.");
 int mx=1;
 int sel=-1;
 while((!key_down(KEY_F4))&&(sel<1)) {
 if((key_pressed(KEY_LCONTROL))||(key_pressed(KEY_RCONTROL))) {if(QuadTalker.speaking) QuadTalker.stop();}
 bool speak=true;
 if((key_pressed(KEY_RIGHT))||(key_pressed(KEY_DOWN))||(key_pressed(KEY_S))||(key_pressed(KEY_Z))) mx++;
 else if((key_pressed(KEY_UP))||(key_pressed(KEY_LEFT))||(key_pressed(KEY_A))||(key_pressed(KEY_W))) mx--;
 else if((key_pressed(KEY_SPACE))||(key_pressed(KEY_RETURN))||(key_pressed(KEY_F))||(key_pressed(KEY_G))||(key_pressed(KEY_H))||(key_pressed(KEY_NUMPAD1))||(key_pressed(KEY_NUMPAD2))||(key_pressed(KEY_NUMPAD3))) sel=mx;
 else speak=false;

 if(mx<1) mx=8;
 if(mx>8) mx=1;
 if(speak) {
 sb.play_1d("mario/tone.wav", 0, 0, false);
 QuadTalker.speak_interrupt("World " + mx + ". ");
 if(output_to_window) show_game_window("--o  World " + mx + " ");
 }
 wait(5);
 }// Level select.
 
 // Fade out music.
 while(QuadTalker.speaking) {wait(50);}
 sb.play_2d("mario/coin.wav", 0, 0, 0, 4, false);
 while(snd.volume>-50) {snd.volume=snd.volume-1; wait(10);}
 snd.stop();
 stage= (sel-1)*4; stage++;
 loc=nextStage;
 counter=0.0;
 }// Heh. Heh heh. Hehehehe.

