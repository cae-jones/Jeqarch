 int indexOf(string[] arr, string val) {
 for(uint i=0; i<arr.length(); i++) {if(arr[i]==val) return i;}
 return -1;
 }
 double math_random() {
 return 0.01*random(0, 100);
 }
 double Math_max(double a, double b) {
 if(a>b) return a; return b;}
 double Math_min(double a, double b) {if(a<b) return a; return b;}

 TTechnique newTechnique(double dur) {TTechnique ret(dur); /*alert("Ret.duration", "duration = " + ret.duration + ". Parameter was " + dur + ".");*/ return ret;}
 TyleMap@ newTyleMap(string[] diag) {
 TyleMap  ret(diag);
 return ret;
 }
 TyleChar@ newTyleChar(string n) {TyleChar ret(n); return ret;}


