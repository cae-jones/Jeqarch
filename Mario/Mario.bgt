};
TyleMap@ ret;
 @ret=newTyleMap(diag);
 ret.bgm="mario/underwater.ogg"; extendStage(ret);
 addEastwest(ret, ret);
 TyleChar@ enemy;
 for(uint i=0; i<10; i++) {
  @enemy=newTyleChar("paratroopa"); @(enemy.gloc)=ret; ret.add(enemy, 2);
enemy.x=random(1, ret.getWidth()-1); enemy.y=random(1, ret.getHeight()-2);
 enemy.counter=math_random(); enemy.vx=math_random();
  @enemy=newTyleChar("snail"); @(enemy.gloc)=ret; ret.add(enemy, 2);
enemy.x=random(1, ret.getWidth()-1); enemy.y=random(1, ret.getHeight()-2);
 enemy.counter=math_random(); enemy.vx=math_random();
 @enemy=getFireball(); ret.add(enemy, 2);
enemy.x=random(1, ret.getWidth()-1); enemy.y=random(1, ret.getHeight()-2);
 enemy.counter=math_random(); enemy.vx=math_random();


 }// Add enemies. Lots of enemies.
 @(me.gloc)=ret; me.x=1; me.y=0;

 }// Water level.
 // 6, 8 (advance)
 else if((me.x==6)&&(me.y==8)) {

