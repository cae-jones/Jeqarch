    void main () {

 show_game_window("Super Mario Brothers, the audio edition!");
 init(50, 0.001);
 sb.pan_step=3;
 sb.volume_step=3;
 if(screen_reader_is_running(JAWS)) install_keyhook();
QuadTalker.speak("Super Mario Brothers! Press enter to play, F5 to learn game sounds, and F1 while playing to learn Mario\'s position.");
 while(!key_pressed(KEY_ESCAPE)) {
 keyPressed();
 step(speed*t);
 keyReleased();
 wait(t);
 if((key_down(KEY_LMENU))&&(key_down(KEY_F4))) exit();
 }// Loop in main.

}//Main?

 void setBonus(TyleChar@ me, int s) {
 switch (s) {
 case 1 :
 case 21 :
 case 25 : {
if(s<10)  @nexit=me.gloc.east.east.east;
 else if(s>10) @nexit=me.gloc.east;
  if(s>23) @nexit=me.gloc.east.east;
//  exitPoint=new Point(7, 6); // Maybe.
 exitPoint.x=7; exitPoint.y=6;
 if(s>23) {exitPoint.x=17; exitPoint.y=5;}
 string[] diag=   {
