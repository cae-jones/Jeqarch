 if((me.x>=20)&&(me.y<=enemy.y)&&(count%100<5)&&( (count/100)%3==1)&&(enemy.vy>=0.0)) {enemy.vy=-0.5; enemy.y--; sb.play_2d("mario/bowser_jump.wav", camera.x, camera.y, enemy.x, enemy.y, false);}

 if((absolute(me.y-enemy.y)<=1)&&(enemy.x-me.x>=0)&&(enemy.x-me.x<=3))
 { hitEnemy(me, enemy, stereoX);}

 if((absolute(me.x-enemy.x)<=5)&&( (( floor(firex) == enemy.x)&& (absolute(enemy.y-firey)<=2))||((enemy.x==floor(fire2))&&(absolute(enemy.y-firey2)<2)))) { enemy.hp--;
  firex=-1.0; fire2=-1.0;
