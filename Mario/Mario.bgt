 if((fire2>=gloc.getWidth())||(fire2<=0.0)||(gloc.getC(floor(fire2), firey2)!=" ")) {sb.play_1d("mario/smb3_bump.wav", 0, 0, false); fire2=-1.0;}
 }// Fireball2.
