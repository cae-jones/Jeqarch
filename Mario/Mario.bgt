"-               p",
"-               p",
"-      $$$$     p",
"-     $$$$$$    p",
"-     $$$$$$    p",
"-      $$$$     p",
"-   --------  ppp",
"-   --------  Ppp",
"-----------------"
 };
 @(me.gloc)=newTyleMap(diag); extendStage(me.gloc);
 me.gloc.bgm= ("mario/underworld.wav");
 }; break;
 case 2 :
 case 29 : {
 // There are multiple possibilities, actually.
 // One is that we're going into the actual hidden room:
 if(@(me.gloc.east)!=null) {
 @nexit=me.gloc.east; exitPoint.x=2; exitPoint.y=8; me.x=1; me.y=1;
