 };
 @(me.gloc)=newTyleMap( diag); extendStage(me.gloc); me.gloc.bgm=nexit.bgm;
 }// Hidden Room.
 else {
 // Warp Zone.
 if(me.x>=me.gloc.getWidth()-3) stage=5;
 else if(me.x>=me.gloc.getWidth()-7) stage=9;
 else stage=13;
 @(me.gloc)=setStage(); @nexit=null; me.x=1; if(@(me.gloc)!=null) me.y=me.gloc.getHeight()-3;
 QuadTalker.speak_wait("Warped to world " + ((stage/4)+1) + ". ");
 }// Warp Zone.
 }; break;
 case 9 : {
 @nexit=me.gloc.east.east; exitPoint.x=2; exitPoint.y=6;

