 void addCoin() {
 int coins=p1coins; //((player&1)==0)?p2coins:p1coins;
// coins++;
 coins+=200;
 curcoins+=200;
// if(coins%100==0) {
 if((coins/200)%100==0) {
// try {sb.stop("mario/coin.wav");} catch (Exception nostop) {}
sb.play_1d("mario/1up.wav", 0, 0, false);
 if((player&1)==0) p2lives++; else p1lives++;
 }// 1up.
 if((player&1)==0) p2coins=coins; else p1coins=coins;
 p1coins=coins;
 }//Add coin.
 void addPoints(int pts) {
 int coins=p1coins; //((player&1)==0)?p2coins:p1coins;
// coins++;
 coins+=pts;
 curcoins+=pts;
// if(coins%100==0) {
 if(((coins/200)%100==0)||(coins%20000<pts)) {
// try {sb.stop("mario/coin.wav");} catch (Exception nostop) {}
sb.play_1d("mario/1up.wav", 0, 0, false);
 if((player&1)==0) p2lives++; else p1lives++;
 }// 1up.
 if((player&1)==0) p2coins=coins; else p1coins=coins;
 p1coins=coins;

 }// Add Points.
 void hitEnemy(TyleChar@ me, TyleChar@ enemy, float stereoX) {
 int sx=100.0*stereoX;
 if(enemy.hp<=0.0) return; // Dead enemies can't hurt you.
 if(starpower>0.0) {enemy.hp=-1.0; sb.play_1d("mario/kick.wav", camera.x, enemy.x, false);}
 else if(@(me.lastHit)==null) {me.hp-=1.0; me.mp=0.0;
 if(me.hp>0.0) {sb.play_1d("mario/pipe.wav", 0, 0, false); @(me.lastHit)=newTechnique(0.1); me.hitTimer=0.0;}
 else {
 loc=dying; counter=0.0; playsong("mario/death.ogg"); if((player&1)==0) p2lives--; else p1lives--;
 }//Death.
 }//Hitting Mario/Luigi.

 }//Meh.
   void step(double dt) {
 if(loc!=paused) counter+=dt;
 switch (loc) {
 case game : {

 TyleChar@ me=mario; //((player&1)==0)?luigi:mario;
 int x=me.x; int y=me.y; string face=me.face;
 me.step(dt);
 camera.x=me.x; camera.y=me.y;
 if(@(me.gloc)==null) {@(me.gloc)=setStage(); if(@(me.gloc) /*still*/ ==null) setGameComplete();
 else if(me.y>=me.gloc.getHeight()) me.y=me.gloc.getHeight()-2;
}// setstage.
// try {
//Iterator it=me.sounds.iterator();
 /*float stereoX=(2.0f*( ((float)(me.x))/((float)(me.gloc.getWidth()))))-1.0f;
 if(stereoX<-1.0f) stereoX=-1.0f; else if(stereoX>1.0f) stereoX=1.0f;*/
// Point2D audioPosition=camera.getAudioPosition(me.x, me.y);
// float stereoX=(float)(audioPosition.getX());
// while(it.hasNext()) {
 while(me.sounds.length()>0) {
 string f=me.sounds[0]; me.sounds.remove_at(0);
 if(f==jump) {
 // Catch water.
 if(me.hp>1.0) f=("mario/jumpbig.wav");
 if(me.gloc.getC(me.x, me.y)=="~") f=("mario/stomp.wav"); // Swimming. :-/
 }// Jump stuff
 else if((f!="")&&(string_contains(f, "fire", 1)>=0)) {
 if(firex>=0.0) {
 if(fire2>=0.0) {f=("null.wav");}
 else {fire2=(me.x); firey2=me.y; fdir2=1.0; if(me.face=="w") fdir2=-1.0; }//(me.face=="w")?-1.0:1.0;}
 }//Second fireball.
 else {firex=(me.x); firey=me.y; fdir=1.0; if(me.face=="w") fdir=-1.0; }//(me.face=="w")?-1.0:1.0;}
 }// Fireball.
 else if(f==bumpblock) {
// try {
 string c=me.gloc.getC(me.x, me.y-1);
 if(c=="b") {
 if(me.hp<2.0) f=("mario/smb3_bump.wav");
 else {me.gloc.setC(me.x, me.y-1, " "); addPoints(50);}
}
 else if(c=="C") {

  sb.play_1d("mario/coin.wav", camera.x, me.x, false);
 addCoin();
 f=("mario/smb3_bump.wav");
 me.gloc.setC(me.x, me.y-1, 'B');
 }
 else if((c=="f")||(c=="F")) setStageComplete(me);
 else if(c=="M") {
 f=("mario/smb3_bump.wav");
 sb.play_1d( ("mario/grow.wav"), camera.x, me.x, false);
 TyleChar mushroom=newTyleChar("flower");
if(me.hp<2.0) mushroom.name="mushroom"; //:"flower");
 mushroom.height=1; mushroom.x=me.x; mushroom.y=me.y-2;
 TTechnique teq=newTechnique(1.0);
 teq.addStartSound("mario/" + mushroom.name + ".wav");
// mushroom.movelist.put(new Integer(TyleChar.A), teq);
 mushroom.movelist.set("a", teq);
 me.gloc.add(mushroom, 2);
 me.gloc.setC(me.x, me.y-1, "B");
 @(mushroom.gloc)=me.gloc; mushroom.x=me.x; mushroom.y=me.y-2;
 }
 else if(c=="S") {
 f=("mario/smb3_bump.wav");
 sb.play_1d(("mario/grow.wav"), camera.x, me.x, false);
 TyleChar mushroom=newTyleChar("star");
 mushroom.height=1; mushroom.x=me.x; mushroom.y=me.y-2;
 TTechnique teq=newTechnique(1.0);
 teq.addStartSound("mario/" + mushroom.name + ".wav");
// mushroom.movelist.put(new Integer(TyleChar.A), teq);
 mushroom.movelist.set("a", teq);
 me.gloc.add(mushroom, 2);
 me.gloc.setC(me.x, me.y-1, "B");
 @(mushroom.gloc)=me.gloc; mushroom.x=me.x; mushroom.y=me.y-2;
 }
 else if(c=="2")  {
  f= ("mario/smb3_bump.wav");
 sb.play_1d( ("mario/grow.wav"), camera.x, me.x, false);
 TyleChar mushroom=newTyleChar("1up");
 mushroom.height=1; mushroom.x=me.x; mushroom.y=me.y-2;
 TTechnique teq=newTechnique(1.0);
 teq.addStartSound("mario/" + mushroom.name + ".wav");
// mushroom.movelist.put(new Integer(TyleChar.A), teq);
 mushroom.movelist.set("a", teq);
 me.gloc.add(mushroom, 2);
 me.gloc.setC(me.x, me.y-1, "B");
 @(mushroom.gloc)=me.gloc; mushroom.x=me.x; mushroom.y=me.y-2;
 }
 else if((c=="4")||(c=="5")||(c=="6")||(c=="7")||(c=="8")||(c=="9")) {
 f= ("mario/smb3_bump.wav");
 sb.play_1d("mario/coin.wav", camera.x, me.x, false);
 addCoin();
 string coins="" + (string_to_number(c)-1);
// int coins=(int)(me.gloc.getC(me.x, me.y-1));
// coins--;
 if(coins=="3") me.gloc.setC(me.x, me.y-1, "B"); else me.gloc.setC(me.x, me.y-1, coins);
 
 }
 else if(c=="V") {
 f= ("mario/grow.wav");
 sb.play_1d("mario/grow.wav", camera.x, me.x, false);
 climb(@me);
 wait(1000);
 } //; break; // Vine, not falling platform.
 else {
f= ("mario/smb3_bump.wav");
// System.out.print(me.gloc.getC(me.x+1, me.y)); // Horizontal pipes aren't working.
// try {
if(me.gloc.getC(me.x+1, me.y)=="P") {
 if(@nexit==null) {
 if(stage==16) {
 string[] diag={
 "                           ---",
 "                           -FF",
 "                              ",
 "                              ",
 "                              ",
 "       --          -BBBBBBBBB-",
 "     - --         --          ",
 "  -  - -C        --           ",
 " --  - -        --            ",
 "---    -----   --             "
};
 @nexit=newTyleMap(diag);
 nexit.bgm="mario/castle.wav";
 exitPoint.x=0; exitPoint.y=nexit.getHeight()-2;
 TyleChar@ enemy;
 @enemy=Bowser();
 @(enemy.gloc)=nexit;
 nexit.add(enemy, 2);
 enemy.x=26; enemy.y=4;
 for(int i=0; i<5; i++) {
 @enemy=getFireball();
 nexit.add(enemy, 2);
 enemy.x=5*(i+1); enemy.y=i+1;
 }// Fireballs.
 extendStage(nexit);
 } // 4-4 maze.
else {
 string[] diag= {
 "               F ",
 "            -  F ",
 "           --  F ",
 "          ---  F ",
 "         ----  F ",
 "        -----  F ",
 "       ------  F ",
 "      -------  F ",
 "     --------  F ",
 " pp ---------  F ",
 " PP----------  B ",
 "-----------------"
  };
 @nexit=newTyleMap( diag); nexit.bgm= ("mario/overworld.wav");
extendStage(nexit);
 }// Normal.
 }// Define nexit.
 if(@nexit!=null) @(me.gloc)=nexit; @nexit=null;
 if(@exitPoint!=null) {me.x=exitPoint.x; me.y=exitPoint.y;} else {me.x=2; me.y=me.gloc.getHeight()-3;}
 f= ("mario/pipe.wav"); camera.x=me.x; camera.y=me.y;
 }//} catch (Exception brokenPipe) {QuadTalker.speak("That pipe is clogged.");}
 }
//else f= ("mario/smb3_bump.wav"); // Why was this commented out?
// }// Switch for bumping bricks.
// } catch (Exception error) {f= ("mario/smb3_bump.wav");}
 }//Bumpblock.
 if(@gloc==null) {;}
 else if((gloc.getC(me.x, me.y)=="f")||(me.gloc.getC(me.x, me.y)=="F")) {setStageComplete(me); return;}
 sb.play_1d(f, camera.x, me.x, false);
}

 me.sounds.resize(0);
if(@(me.gloc)==null) {@(me.gloc)=setStage(); return;}
 if(output_to_window) {
 // Refresh every five seconds or so.
 if(refresh_timer.elapsed>5000) {refresh_timer.pause(); set_display_text(me.gloc);
refresh_timer.restart(); refresh_timer.resume();}
if((key_down(KEY_H))||(key_down(KEY_NUMPAD3))) setOutput(camY); else setOutput(me.y);
}
  if(me.gloc.getC(me.x, me.y)=="w") QuadTalker.speak_interrupt("Welcome to the Warp Zone!");
 else if(me.gloc.getC(me.x, me.y)=="$") {
 addCoin(); sb.play_1d("mario/coin.wav", camera.x, me.x, false);
 me.gloc.clear(me.x, me.y);
 }// Coin.

 int stereoX;
 // Check for things that make noise or move. Particularly, floating platforms.
 if(counter-floor(counter)<dt)  {for(int xx=Math_max(0, me.x-5); xx<=Math_min(me.x+5, gloc.getWidth()); xx++) {for(int yy=0; yy<me.gloc.getHeight(); yy++) {
 string cn=gloc.getC(xx, yy);
 if(cn==">") {
 // So, we need to find the edge of this moving platform and move it.
 // Also, does it turn around?
 // There is a slight issue with the range of this; the platform can only move within 5 spaces of Mario. So if it goes to the edge of that range, it needs to turn around automatically.
 stereoX=xx;
 int x2=xx+1;
 while((x2<=gloc.getWidth())&&(gloc.getC(x2, yy)==cn)) x2++;
 string become=">"; if(xx>=me.x+4) become="<";
 while(x2>xx) {
 if(gloc.getC(x2, yy)==" ") {gloc.setC(x2, yy, become); gloc.clear(x2-1, yy);}
 else { gloc.setC(x2-1, yy, "<");}
 x2--;
 }// O.O.


// float volumeY=4.0f-absolute(4.0f*(float)(yy-me.y));
