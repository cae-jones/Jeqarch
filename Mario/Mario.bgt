 void doAccess() {
// try {
 TyleChar@ me=mario; //((player&1)==0)?luigi:mario;
// switch (k) {
 bool play=true;
 if((key_pressed(KEY_UP))||(key_pressed(KEY_W))) {camY--; if(camY<0) {camY=0; sb.play_1d("mario/smb3_bump.wav", 0, 0, false);}}//; break;
 else if((key_pressed(KEY_DOWN))||(key_pressed(KEY_Z))) {camY++; if(camY>=me.gloc.getHeight()) {camY=me.gloc.getHeight()-1; 
 int dn=3;
 // Determine whether or not this indicates a bottomless pit.
 // We do this by checking every space between mario.y and camY.
 for(int i=me.y+1; i<=camY; i++) {
 string cn=me.gloc.getC(camX, i);
 if((cn!=" ")&&(cn!="$")&&(cn!="~")&&(cn!="W")&&(cn!="w")) {dn=2; if(i-me.y<=2) dn=1; i=camY;}
 }// Pit check loop.
sb.play_1d("drop" + dn + ".wav", 0, 0, false);}}
 else if((key_pressed(KEY_LEFT))||(key_pressed(KEY_A))) {camX--; if(camX<0) {camX=0; sb.play_1d("mario/smb3_bump.wav", 0, 0, false);}}
 else if((key_pressed(KEY_RIGHT))||(key_pressed(KEY_S))) {camX++; if(camX>me.gloc.getWidth()) {camX=me.gloc.getWidth(); sb.play_1d("mario/hit.wav", 0, 0, false);}}
 else if((key_pressed(KEY_G))||(key_pressed(KEY_NUMPAD2))) {camX=me.x; camY=me.y;
 if(output_to_window) set_display_text(me.gloc);
}
 else if(key_pressed(KEY_V)) {
 // Note, this is relative to Mario, not the camera's y position.
 bool safe=false;
 for(int i=0; i<me.gloc.getHeight(); i++) {
 string cn=me.gloc.getC(camX, i);
 if((cn!=" ")&&(cn!="$")&&(cn!="~")) {
 if(i>me.y) {safe=true;
 if(i-me.y<=2) sb.play_1d("drop1.wav", 0, 0, false);
 else sb.play_1d("drop2.wav", 0, 0, false);
 wait(250);
 // check to see if there are more directly beneath this space, so as to avoid being too repetitive?

 for(int i2=i+1; i2<me.gloc.getHeight(); i2++) {
 cn=me.gloc.getC(camX, i2);
 if((cn==" ")||(cn=="$")||(cn=="~")) i2=me.gloc.getHeight();
 else i=i2; // I think that works.
 }// Stack loop.
 }// Platform below.
 else {
 // We want to make sure of how big this stack is, and whether or not the bottom of it is at or below Mario's height.
 int stackHeight=1;
 for(int i2=i+1; i2<me.gloc.getHeight(); i2++) {
 cn=me.gloc.getC(camX, i2);
 if((cn==" ")||(cn=="$")||(cn=="~")) i2=me.gloc.getHeight();
 else {i=i2; stackHeight++;}
 }// Stack loop.
 if(stackHeight>3) stackHeight=3;
 if(i>=me.y) {safe=(i>me.y); sb.play_1d("low.wav", 0, 0, false);}
 else sb.play_2d("platform" + stackHeight + ".wav", 0, camera.y, 0, i, false);
 wait(250);
 }// Platform above or wall ahead.
 }// Something solid.
 }// Platform check.

 if(!safe) sb.play_1d("drop3.wav", 0, 0, false);

 }// Do platform check directly above and below the camera's position.
 else if(key_pressed(KEY_SLASH)) {

 }// Describe verbally what's going on with the camera.
 else if((!key_pressed(KEY_F))&&(!key_pressed(KEY_NUMPAD1))) play=false;
// }//KeySwitch in doAccess.
 if(!play) return;
 string toplay="mario/smb3_bump.wav";
/* float stereoX=((float)camX)/((float)(me.gloc.getWidth()));
 stereoX*=2.0f; stereoX-=1.0f;
 if(stereoX<-1.0f) stereoX=-1.0f; else if(stereoX>1.0f) stereoX=1.0f;*/
// float stereoX=(float)(camera.getAudioPosition(camX, camY).getX());

// switch (me.gloc.getC(camX, camY)) {
 string c=me.gloc.getC(camX, camY);
 if(c==" ") toplay="mario/tone.wav";
 else if(c=="b") toplay="mario/brick.wav";
 else if((c=="p")||(c=="P")) toplay="mario/pipeFound.wav";
 else if((c=="C")||(c=="4")||(c=="5")||(c=="6")||(c=="7")||(c=="8")||(c=="9"))  sb.play_1d("mario/coin.wav", 0, 0, false);
 else if((c=="S")||(c=="M")||(c=="2")||(c=="3")||(c=="V")) toplay="mario/grow.wav";
 else if(c=="1") toplay="mario/1up.wav";
 else if(c=="$") toplay="mario/coin.wav";
 else if(c=="~") toplay="mario/stomp.wav";
 else if((c=="f")||(c=="F")) toplay="mario/flag.wav";
// }// Charswitch in doAccess.
 sb.play_1d(toplay, 0, 0, false);
 if(me.gloc.team2.length()>0)  for(uint i=0; i<me.gloc.team2.length(); i++) {
 TyleChar@ enemy=me.gloc.team2[i];
 if((enemy.x==camX)&&(enemy.y==camY)) {
 QuadTalker.speak(enemy.name);
 }//Play Enemy sounds.
 }// Enemies.
 if((perana==camX)&&(camY<me.gloc.getHeight()-1)&&(c==" ")&&(me.gloc.getC(camX, camY+1)=="p")) QuadTalker.speak("Perana Plant");
 if(output_to_window) setOutput(camY);
// } catch (Exception failure) {sb.play("mario/hit.wav");}
 }//Accessible camera. Sorta.
 int getBGMVolume() {return BGMVolume;}
 void playsong(string str) {
// playsong( (str));
