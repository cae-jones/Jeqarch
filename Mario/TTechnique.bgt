 // Returns a specified HitArea.
 
 HitArea@ getHitArea(uint i) {
 HitArea@ ret;
 if((i<0)||(i>=hitAreas.length()))  @ret=null;
 else @ret=hitAreas[i];
 return ret;
 }// GetHitArea.
 HitArea@ addHitArea(int x, int y, int z, int xrange, int yrange) {
 HitArea ret;
 ret.x=x; ret.y=y; ret.z=z;
 ret.xrange=xrange; ret.yrange=yrange;
// if(hitAreas==null) hitAreas=new ArrayList();
 hitAreas.insert_last(ret);
 return ret;
 }//Add Hit Area.
 HitArea@ addHitArea(int x, int y, int z, int xrange, int yrange, string l) {
 HitArea@ ret=addHitArea(x, y, z, xrange, yrange);
 ret.limb=l;
 return ret;
 }//Add Hit Area with limbs.
 HitArea getLastHitArea() {
// if(hitAreas==null) return null;
 return hitAreas[hitAreas.length()-1];
 }//GetLastHitArea.

 int rotate; // For face-changes. 1 = 45 degrees.


 // 8:46 AM 5/25/2010.
 void addBlocksound(string str) {addBlockSound(str);}
