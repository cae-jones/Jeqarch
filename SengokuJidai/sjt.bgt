// Multiplayer functions and properties.
 Account@ uac;
Account@[] players;
 network host;
uint server_id=0;  // This is used to store the ID of the remote peer that will be our server.
 // We need to include a list of potential server addresses, since there's no telling which might be available.
//string danip=

 string[] ips={
"softbound.zapto.org",
"5.135.62.217",
"24.226.110.195",
// Add more servers here
 /// Default to a local server if necessary.
 "127.0.0.1"};


 bool connect_to_server() {

if(host.setup_client(3, 1)==false)
{
voice.speak_wait("Unable to connect.");
 return false;
}

 for(uint ip=0; ip<ips.length(); ip++) {
string address=ips[ip]; //danip; //input_box("Address", "Please enter the host name or address to connect to.");

 timer connectionTimer;
voice.speak_interrupt("Connecting, please wait.");
host.connect(address, 10000);
network_event event;

// In this loop, we just wait for either a connect or disconnect event as this is always the first thing that we'll get.

while(true)
{
event=host.request();
if(event.type==event_connect)
{
voice.speak_interrupt("Connected successfully to server " + ip + ".");
server_id=event.peer_id;
 ip=ips.length();
break;
}
if(event.type==event_disconnect)
{
 voice.speak_interrupt("Unable to connect.");
 return false;
//exit();
}
 if(key_pressed(KEY_ESCAPE)) //if(key_down(KEY_LMENU) and key_pressed(KEY_F4))
{
host.destroy();
voice.speak_interrupt_wait("Cancelled");
return false; //exit();
}

 if(connectionTimer.elapsed>10000) {
 if(ip==ips.length()-1) {
 voice.speak_interrupt_wait("Unable to connect.");
 return false;
 }// Failure.
 if(!confirm("Unable to connect to server " + ip + " after 10 seconds. Choose yes to keep trying, or no to try a different server.")) {

 disconnect_everyone();
break;
 }
 connectionTimer.restart(); connectionTimer.resume();
 }// Unable to connect.
wait(5);
}
}// Loop.
 return true;
}

void disconnect_everyone()
{

/*
This is the exact same function as the one found in the server, as it works equally well for both.

This function first gets a list of all connected peers and disconnects them. Then it waits until it has received the same number of disconnect notifications as it sent out disconnect requests, and then returns. This may take some time, however, so we set up a timeout after which we return anyway.

Note that we are not processing messages in this event loop. You will obviously want to do this if you have other connections to manage at the same time.
*/

timer timeout;
uint[] peer_list=host.get_peer_list();
int expected_disconnects=peer_list.length();
for(uint i=0;i < peer_list.length();i++)
{
host.disconnect_peer(peer_list[i]);
}
network_event event;
while(expected_disconnects>0)
{
event=host.request();
if(event.type==event_disconnect)
{
expected_disconnects-=1;
}
if(timeout.elapsed>=1000)
{
break;
}
wait(5);
}
}

void loadMultiplayerMap() {
 loadGame(-1, "multiB"); // Hmm?
}

 int braille=0;
 string getBraille(Map@ gloc, int x, int y) {
 if(@gloc==null) return "";
 if((x<-order_range)||(x>=50+order_range)||(y<0)||(y>=50)) return "";
 string ret="";
 // Let's find the characters and items in range outside the loop, since doing 100 iterations 2*order_range times is just silly.
 Char@[] chars;
 for(int xx=x-order_range; xx<=x+order_range; xx++) {
 if((xx<0)||(xx>49)) continue;
 switch (gloc.map[xx][y]) {
 case clear : ret += "-"; break;
 case castle_wall : ret += "="; break;
 case castle_room : ret += "\'"; break;
 case courtyard : ret += ","; break;
 case garden : ret += "g"; break;
 case tree : ret += "t"; break;
 case hole : ret += "o"; break;
 case boulder : ret += "B"; break;
 case water : ret += "w"; break;
 case deepWater : ret += "W"; break;
 case house : ret += "H"; break;
 case horse : ret += "E"; break;
 case boat : ret += "A"; break;
 case fire : ret += "F"; break;
 case broken_wall : ret += "0"; break;
 case campsite : ret += "C"; break;
}// Switch.
}// Loop.
 for(uint i=0; i<gloc.chars.length(); i++) {
 if((gloc.chars[i].y==y)&&(absolute(gloc.chars[i].x-x)<=order_range)) {
 int zero=x-order_range;
 if(zero<0) zero=0;
  int index=gloc.chars[i].x-zero;
 while(index>=ret.length()) ret += "-";
 switch (gloc.chars[i].rank) {
 case SHOGUN : ret[index]="%"; break;
 case DAIMYOU : ret[index]="D"; break;
 case SAMURAI : ret[index]="S"; break;
 case RONAN : ret[index]="R"; break;
 default : {
 if((gloc.chars[i].rank==SHINOBI)&&(@(gloc.chars[i].shogun)==@(myArmy[0]))) ret[index]="N";
else  if(gloc.chars[i].male) ret[index]="M"; else ret[index]="W"; // Don't get confused with water...
 }// Civilians.
}// Switch for rank.
}// Put them in here.
}// Chars loop.

 return ret;
}// Braille.
 timer burntimer; // To prevent the burning lag. 9:03 AM 1/2/2012
 Point@ newPoint(int x, int y) {Point ret(x, y); return ret;} // 1:33 PM 6/24/2012. Got tired of having to do backflips for points.
timer killtimer; int[] killtimes; int[] othertimes; int[] enemykills;
 timer brailletmr;
 int[] causes; Char@[] dead;
// Cause of death is getting annoying.
 const int starvation=1, battle=2, drowning=3, burning=4;

 void addDeath(Char@ who, int cause=0) {
 for(uint i=0; i<dead.length(); i++) {if(@(dead[i])==@who) return;}
 dead.insert_last(who);
 if(cause<=0) {
 if(who.food<=0) cause=starvation;
 if((who.x>=0)&&(who.x<50)&&(who.y>=0)&&(who.y<50)&&(@(who.gloc)!=null)) {
 int cn=who.gloc.map[who.x][who.y];
 if(cn==fire) cause=burning;
 else if(cn==deepWater) cause=drowning;
 else if(cn==boulder) cause=battle; //?
}
}
causes.insert_last(cause);
}// GAH!


 void fullDisplay(Char@ me, bool iflash, string msg="") {
 if((@me==null)||(@me.gloc==null)) {show_game_window(msg); return;}
 int x=me.x-order_range;
 int y=me.y-order_range;
 if(x<0) x=0;
if(y<0) y=0;
string[] disp(4*(order_range+1)); // Is that enough?

 int i=0;
 for(y=y; ((y<=me.y+order_range)&&(y<50)); y++) {
 while(i+1>=disp.length()) disp.insert_last("                    ");
 for(x=x; ((x<=me.x+order_range)&&(x<50)); x++) {
 if((x<0)||(y<0)||(x>=50)||(y>=50)) continue;
 int c=me.gloc.map[x][y];
while(disp[i].length()<2*(x+1)) {disp[i]+= "  ";}
while(disp[i+1].length()<2*(x+1)) {disp[i+1]+= "  ";}
 string cn=" ";
 switch (c) {
 case clear : cn= "-"; break;
 case castle_wall : cn= "="; break;
 case castle_room : cn= "\'"; break;
 case courtyard : cn= ","; break;
 case garden : cn= "g"; break;
 case tree : cn= "t"; break;
 case hole : cn= "o"; break;
 case boulder : cn= "B"; break;
 case water : cn= "w"; break;
 case deepWater : cn= "W"; break;
 case house : cn= "H"; break;
 case horse : cn= "E"; break;
 case boat : cn= "A"; break;
 case fire : cn= "F"; break;
 case broken_wall : cn= "0"; break;
 case campsite : cn= "C"; break;
}// switch for the map.

 disp[i][2*x]=cn;
 disp[i][(2*x)+1]=cn;
 disp[i+1][2*x]=cn;
 disp[i+1][(2*x)+1]=cn;

}// X Loop.
i+=2;
 }// Y Loop.

if(iflash) for(i=0; i<me.gloc.items.length(); i++) {
 if((absolute(me.gloc.itemPositions[i].x-me.x)<=order_range)&&(absolute(me.gloc.itemPositions[i].y-me.y)<=order_range)) {
 x=me.gloc.itemPositions[i].x-me.x;
 y=me.gloc.itemPositions[i].y-me.y;
 y*=2; x*=2;
 if((y<0)||(x<0)||(y>=disp.length()-1)||(x>=disp[y].length()-1)) continue; // should not happen, but catch it anyway.
 string cn="i";
 disp[y][x]=cn; disp[y][x+1]=cn;
 disp[y+1][x]=cn; disp[y+1][x+1]=cn;
}// Put it in.
}// Items.
 for(i=0; i<me.gloc.chars.length(); i++) {
 x=me.gloc.chars[i].x-me.x; y=me.gloc.chars[i].y-me.y;
 y*=2; x*=2;
 if((y<0)||(x<0)||(y>=disp.length()-1)||(x>=disp[y].length()-1)) continue; // should not happen, but catch it anyway.
 string cn="?";
 string wn=disp[y+1][x];
 string an=disp[y][x+1];
 switch (me.gloc.chars[i].rank) {
 case SHOGUN : cn="%"; break;
 case DAIMYOU : cn="D"; break;
 case SAMURAI : cn="S"; break;
 case RONAN : cn="R"; break;
 default : {
 if((me.gloc.chars[i].rank==SHINOBI)&&(@(me.gloc.chars[i].shogun)==@(myArmy[0]))) cn="N";
else  if(me.gloc.chars[i].male) cn="M"; else cn="W"; // Don't get confused with water...
 }// Civilians.
}// Switch for rank.

 switch (me.gloc.chars[i].state) {
 case preparing : {
 // Depends on the direction.
 if(me.gloc.chars[i].face=="n") an="^";
 else if(me.gloc.chars[i].face=="s") an="v";
 else if(me.gloc.chars[i].face=="e") an=">";
 else if(me.gloc.chars[i].face=="w") an="<";
 else if((me.gloc.chars[i].face=="ne")||(me.gloc.chars[i].face=="sw")) an="/";
 else an="\\";
}; break;
 case attacking : an="*"; break;
 case recovering : an="_"; break;
 case sepuku : an="x"; break;
}// State.

if((me.gloc.chars[i].weapon>=0)&&(me.gloc.chars[i].weapon<me.gloc.chars[i].weapons.length())) wn=me.gloc.chars[i].weapons[me.gloc.chars[i].weapon][0];
 disp[y][x+1]=an;
 disp[y+1][x]=wn; disp[y+1][x+1]=cn;

}// Chars.

 string txt=msg + "\n";
 for(i=0; i<disp.length(); i++) {txt += disp[i] + "\n";}
 show_game_window(txt);
}// Display.


// 6:29 AM 8/22/2013: Campaigns.
dictionary user_vars;
const int LOCATION=0, VAR=1, KILL=2, OFFER=3, PICKUP=4, USE=5, IMPACT=6, ALLY_LOC=7, ENEMY_LOC=8, ARMY_SIZE=9;
// Conditionals:
const uint8 EQUAL=0, GREATER=1, LESS=2, GREATER_EQUAL=3, LESS_EQUAL=4, NOT_EQUAL=5;

class Condition {
string var1, var2;
int operand=-1;
int op=0;
Condition() {}
bool eval() {
if(var1.is_empty()) return false;
int val1=0;
int val2=operand;
int res;
if(user_vars.exists(var1)) user_vars.get(var1, res);
val1=res;
if((!var2.is_empty())&&(user_vars.exists(var2))) user_vars.get(var2, val2);
bool ret=false;
switch (op) {
case EQUAL : ret=(val1==val2); break;
case GREATER : ret=(val1>val2); break;
case GREATER_EQUAL : ret=(val1>=val2); break;
case LESS : ret=(val1<val2); break;
case LESS_EQUAL : ret=(val1<=val2); break;
case NOT_EQUAL : ret=(val1!=val2); break;
}
return ret;
}// Evaluate.
}// conditional.

class Event {
int type;
int[] params;
string[] commands;
int lifetime=1;
Condition@ whileand=null;
Event() {type=-1;}
}// Events.