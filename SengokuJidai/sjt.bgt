 voice.speak_interrupt("Got yasai");
 if((random(0, 10)==4)||(me.gloc.weather=="snow")) {me.gloc.map[me.x][me.y]=clear; voice.speak("This section of land is now barren, and cannot be harvested from until fresh vegetables have time to grow.");}
 }// Harvesting food.
