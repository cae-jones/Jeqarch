 pool.play_2d("voice/" + commands[menuX] + toplay + ".wav", me.x, me.y, me.x, me.y, false);
 me.orders=commands[menuX]; // I guess.
 voice.speak("" + obeys + " people obey your orders.");
 }// The rest require that the hierarchy isn't confused.

 if((me.orders=="steal")&&(me.rank==SHINOBI)) {
