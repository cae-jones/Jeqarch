 else if((me.weapon<me.weapons.length())&&(me.weapons[me.weapon]=="kusurigami")&&(me.charged*10.0>=random(0, 11))&&(!special)) {enemy.sounds.insert_last("sfx/selected.wav"); enemy.sounds.insert_last("sfx/icebreak" + random(0, 5) + ".ogg"); enemy.hasShield=false; hit2=false;}
 else if((me.weapon<me.weapons.length())&&(special)&&((me.weapons[me.weapon]=="yumi")||(me.weapons[me.weapon]=="rocket-bow"))&&(random(0, 5)>2)) {hit2=true; me.counter*=1.2;}
