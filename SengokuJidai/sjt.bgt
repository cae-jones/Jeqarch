 if(p.x<25) p.x+=8; else p.x-=8;
 if(p.y<25) p.y+=8; else p.y-=8;
 }// Go around the obstacle.
 }// If you run into a castle or house, move elsewhere.

 for(uint xx=p.x; xx<p.x+10; xx++) {for(uint yy=p.y; yy<p.y+10; yy++) {
 if((xx<0)||(xx>49)||(yy<0)||(yy>49)) continue;
 me.gloc.map[xx][yy]=deepWater;
 }}// Loops.
 if(p.x<me.x) {
 p.x+=3; if(p.x>me.x) p.x=me.x;
}
 else if(p.x>me.x) {p.x-=3; if(p.x<me.x) p.x=me.x;}
 if(p.y<me.y) {p.y+=3; if(p.y>me.y) p.y=me.y;}
 else if(p.y>me.y) {p.y-=3; if(p.y<me.y) p.y=me.y;}
 }// Dig a canal.
 me.gloc.map[me.x][me.y]=boat; me.riding=true;
 switch (border) {
