 else if((me.weapons[w]=="kanabo")&&(distance<=4)) {options.insert_last(w); if(attacker.hasShield) {options.insert_last(w); options.insert_last(w); double cheat=random(0, difficulty*2); me.charged=0.1*cheat;}}
