 // Hitting boulders with a strong attack can cause them to fall on people.
 else if((cur==boulder)&&(cur!=broken_wall)&&(me.weapon<me.weapons.length())&&(me.weapons[me.weapon]=="kanabo")&&(me.charged>0.5)&&(random(1, 7)>4)) {
 // Try to push the boulder in the direction that one faces.
 Point targetPoint(p.x, p.y);
 if(me.face=="n") targetPoint.y=targetPoint.y-1;
 else if(me.face=="ne") {targetPoint.y-=1; targetPoint.x+=1;}
 else if(me.face=="e") targetPoint.x+=1;
 else if(me.face=="se") {targetPoint.x+=1; targetPoint.y+=1;}
 else if(me.face=="s") targetPoint.y+=1;
 else if(me.face=="sw") {targetPoint.x--; targetPoint.y++;}
 else if(me.face=="w") targetPoint.x--;
 else {targetPoint.x--; targetPoint.y--;}
 if((targetPoint.x>=0)&&(targetPoint.x<50)&&(targetPoint.y>=0)&&(targetPoint.y<50)) {
 int tarty=me.gloc.map[targetPoint.x][targetPoint.y];

 // Boulders can move into clear spaces, gardens, holes, or fire.
 if((tarty==garden)||(tarty==clear)||(tarty==hole)||(tarty==fire)||(tarty==campsite)||(tarty==water)||(tarty==deepWater)) {
 if((tarty==water)||(tarty==deepWater)) {
 me.gloc.map[p.x][p.y]=clear;
 if(tarty==water) me.gloc.map[targetPoint.x][targetPoint.y]=clear; // Deep Water is not filled, but there's still a splash.
