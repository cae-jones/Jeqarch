 else if(face=="w") {here.x=path.x-cont; here.y=path.y;}
 else if(face=="n") {here.x=path.x; here.y=path.y-cont;}
 else {here.x=path.x; here.y=path.y+cont;}

 if((here.x<=p[pindex].x)||(here.x>=p[pindex].x+9)||(here.y<=p[pindex].y)||(here.y>=p[pindex].y+9)) {
 if((here.x>=0)&&(here.x<50)&&(here.y>=0)&&(here.y<50)) {if(map[i][j].type=="ocean") map[i][j].map[here.x][here.y]=boat; else map[i][j].map[here.x][here.y]=horse;
 openSpaces.insert_last(here);
}
// alert("Out of bounds", "Path in the castle has gone out of bounds. Currently, length is " + size + ". This section of path is supposed to be " + next + " long. This error occurred on space " + cont + ".");
 if(cont>0) {next=cont-1;}
 else {
 next=1;
 }// We keep running up on problems here, so lets move path back so that we know it's in bounds.
 if(path.x<=p[index].x) {path.x++; face="e";}
 else if(path.x>=p[index].x+9) {path.x--; face="w";}
 if(path.y<=p[index].y) {path.y++; face="s";}
 else if(path.y>=p[index].y+9) {path.y--; face="n";}
 else face=faces[random(0, faces.length()-1)];
 // Change direction.
 
 continue;} // Yes?

