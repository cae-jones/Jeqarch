 if(@(me.destination)==null) {Point p(xx, yy); @(me.destination)=p;}
 else if((absolute(me.x-xx)<absolute(me.destination.x-me.x))&&(absolute(me.y-yy)<absolute(me.y-me.destination.y))) {me.destination.x=xx; me.destination.y=yy;}
}
 }}
