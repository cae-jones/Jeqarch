 }// North and northeast.
 if(me.y<49) {
 if((me.x>=0)&&(me.y>=0)&&(me.x<50)&&(me.gloc.map[me.x][me.y+1]!=castle_wall)) paths.insert_last("s");
 if((me.x<49)&&(me.y<49)&&(me.x>=0)&&(me.y>=0)&&(me.gloc.map[me.x+1][me.y+1]!=castle_wall)) paths.insert_last("se");
 }// South and southeast.
 if((me.x<49)&&(me.y>=0)&&(me.x>=0)&&(me.y<50)&&(me.gloc.map[me.x+1][me.y]!=castle_wall)) paths.insert_last("e");
 string opp; opposite_directions.get(me.face, opp);
 string nf;
 if(paths.length()<1) {
 // There is one option... smash it with a kanabo.
 for(uint ww=0; ww<me.weapons.length(); ww++) {
 if(me.weapons[ww]=="kanabo") {me.weapon=ww; me.sounds.insert_last("sfx/SMASH.wav"); me.setState(attacking); me.charged=0.5+(0.1*random(1, 11)); ww=9001;}
 }// Yeah.
 }// You're just plain stuck. 
 else {
 int tries=0;
 do {nf=paths[random(0, paths.length()-1)]; tries++;
 } while((nf==me.face)||(nf==opp)&&(tries<15));
 me.face=nf;
}// There are paths.
 }// Can't climb it, so find a way around.
 }// Trying to navigate castles is annoying.
 }// Check that space.
 // And boats as well.
 // Horses too, but boats are considerably more important in terms of avoiding drowning.

 if(!me.setState(walking)) {

 if(me.riding) {
 // 12:55 PM 8/25/2012: AI is still not dismounting, so move it up here.
 Point@ p=newPoint(me.x, me.y);
 if(me.face=="e") p.x=p.x+1;
 else if(me.face=="ne") @p=newPoint(me.x+1, me.y-1);
 else if(me.face=="n") p.y=p.y-1;
 else if(me.face=="nw") @p=newPoint(me.x-1, me.y-1);
 else if(me.face=="w") p.x=p.x-1;
 else if(me.face=="sw") @p=newPoint(me.x-1, me.y+1);
 else if(me.face=="s") p.y=p.y+1;
 else @p=newPoint(me.x+1, me.y+1);
 int cn=clear;
 if((p.x>=0)&&(p.x<50)&&(p.y>=0)&&(p.y<50)) cn=me.gloc.map[p.x][p.y];
 int cur=((me.x>=0)&&(me.y>=0)&&(me.x<50)&&(me.y<50)) ? me.gloc.map[me.x][me.y] : clear;
 if(me.riding) {
 if((cur==boat)&&(cn!=deepWater)) me.riding=false;
 else if((cur==horse)&&(cn!=clear)&&(cn!=garden)&&(cn!=water)) {
 // I'd recommend looking for alternative paths for horses, but... so... meh.
 me.riding=false;
 }// Horses.

 if((!me.riding)&&(me.x>=0)&&(me.x<50)&&(me.y>=0)&&(me.y<50)) switch(me.gloc.map[me.x][me.y]) {
 case tree :
 case garden : me.sounds.insert_last("sfx/hardleafland.wav"); break;
 case water : 
 case deepWater : me.sounds.insert_last("sfx/rock_water_01.wav"); break;
 case boulder :
 case courtyard : me.sounds.insert_last("sfx/concreteland" + random(1, 2) + ".wav"); break;
 case castle_wall :
 case castle_room :
 case house :
 case broken_wall : me.sounds.insert_last("sfx/landWood" + random(1, 2) + ".wav"); break;
 case hole :
 case fire : me.sounds.insert_last("sfx/rockstep1.wav"); break;
 default : {
 string toplay="dirtland3.wav";
 if(me.gloc.type=="planes") toplay="grassland" + random(1, 2) + ".wav";
 else if(me.gloc.type=="ocean") toplay="pikkonland2.wav";
 if(me.gloc.weather=="snow") toplay="snowland" + random(1, 2) + ".wav";
 me.sounds.insert_last("sfx/" + toplay);
 }
 }// Landsound.
 }// Riding.

 }// Dismount when appropriate, or try to dodge obstacles, maybe.

 if(me.face.length()>1) {
 me.face=me.face[random(0, 1)]; me.setState(walking);
 }// If going diagonally doesn't work, try going straight.
 else {
 if((me.face=="w")||(me.face=="e")) {string pref="ns"; me.face=pref[random(0, 1)] + me.face;}
 else {string suf="ew"; me.face=me.face + suf[random(0, 1)];}
 me.setState(walking);
 }// Else, do the opposite?
 if((me.state!=walking)&&(me.state!=recovering)) {

 }// The simple solution failed, now we have to look for a path.
 }// Walking around obstacles.
 }// Try to travel.
 }// Not there yet.
 }// Pathing.
 if((me.state==walking)&&(me.x>=0)&&(me.y>=0)&&(me.x<50)&&(me.y<50)) {
 // 8:10 PM 6/27/2012. AI needs to be smarter with horses and boats.
 Point@ p=newPoint(me.x, me.y);
 if(me.face=="e") p.x=p.x+1;
 else if(me.face=="ne") @p=newPoint(me.x+1, me.y-1);
 else if(me.face=="n") p.y=p.y-1;
 else if(me.face=="nw") @p=newPoint(me.x-1, me.y-1);
 else if(me.face=="w") p.x=p.x-1;
 else if(me.face=="sw") @p=newPoint(me.x-1, me.y+1);
 else if(me.face=="s") p.y=p.y+1;
 else @p=newPoint(me.x+1, me.y+1);
 int cn=clear;
 if((p.x>=0)&&(p.x<50)&&(p.y>=0)&&(p.y<50)) cn=me.gloc.map[p.x][p.y];
 int cur=me.gloc.map[me.x][me.y];
 if(me.riding) {
 if((cur==boat)&&(cn!=deepWater)) me.riding=false;
 else if((cur==horse)&&(cn!=clear)&&(cn!=garden)&&(cn!=water)) {
 // I'd recommend looking for alternative paths for horses, but... so... meh.
 me.riding=false;
 }// Horses.
 }// Riding.
 else {
 if((cn==deepWater)&&(cur==boat)) me.riding=true;
 else if((cur==horse)&&((cn==clear)||(cn==garden)||(cn==water))&&(random(0, 5)>2)) me.riding=true;
 }// On foot.
}// Walking.
 }// AI.
} // Roughly every 0.1 seconds. More like 0.105.

 if((me.x>=0)&&(me.y<50)&&(me.x<50)&&(me.y>=0)) {
 if(me.gloc.map[me.x][me.y]==fire) {me.hp-=dt; if(burntimer.elapsed>=200) {me.sounds.insert_last("sfx/hitonarmor.wav"); burntimer.restart(); burntimer.resume();}}
 else if(me.gloc.map[me.x][me.y]==house) {
 if(me.fatigue>0.0) me.fatigue-=dt*2.0; 
 // Hmm, reproduction?
 }// In a house.
 else if(me.gloc.map[me.x][me.y]==deepWater) {me.fatigue+=dt;
 if(me.gloc.weather=="storm") me.fatigue+=dt; // Storms are worse.
 if(me.fatigue>50) me.hp-=random(0, 10)*0.1*dt; if(me.hp<=0.0) {
 EchoD echo("sfx/acid.ogg", me.x, me.y, 0, 0, random(90, 150)); echoes.insert_last(echo);
 }}// Swimming
 }// Some more space-specific things.

 }// Step Char.

