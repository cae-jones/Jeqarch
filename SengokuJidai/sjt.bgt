 else if(@(me.shogun)!=null) @newLeader=me.shogun;
 else if(@(me.daimyou)!=null) @newLeader=me.daimyou;
 else @newLeader=null;
 string nl=""; if(@newLeader==null) nl="noone"; else nl=newLeader.rankString() + " " + newLeader.name;
// alert("Power Transfer", "Anyone who wishes to live will now follow " + nl + ". ");
 for(uint u=0; u<enemy.gloc.chars.length(); u++) {
 bool freed=false;
 if((enemy.rank==DAIMYOU)&&(@(enemy.gloc.chars[u].daimyou)==@enemy)) {@(enemy.gloc.chars[u].daimyou)=null; freed=true;}
 else if((enemy.rank==SHOGUN)&&(@(enemy.gloc.chars[u].shogun)==@enemy)) {@(enemy.gloc.chars[u].shogun)=null; freed=true;}
 if(freed) {
 // There are two options, three for samurai.
// alert("Underling found", "Found an underling of " + enemy.rankString() + " " + enemy.name + ": " + enemy.gloc.chars[u].rankString() + " " + enemy.gloc.chars[u].name + ". ");
 int choice=random(0, 10);
 if((enemy.gloc.chars[u].rank==SAMURAI)||(enemy.gloc.chars[u].rank==DAIMYOU)) {if(choice<6) enemy.gloc.chars[u].state=sepuku; enemy.gloc.chars[u].counter=random(1, 10)*0.1;}
 else { if(choice<4) {enemy.gloc.chars[u].state=sepuku; enemy.gloc.chars[u].counter=random(1, 10)*0.1;}}
// alert("Decision", "" + enemy.gloc.chars[u].rankString() + " " + enemy.gloc.chars[u].name + " is " + enemy.gloc.chars[u].state + ". ");
 if(enemy.gloc.chars[u].state!=sepuku) {
 if(@newLeader==null) {@(enemy.gloc.chars[u].shogun)=null; @(enemy.gloc.chars[u].daimyou)=null;}
 else if(newLeader.rank==SHOGUN) @(enemy.gloc.chars[u].shogun)=newLeader;
 else {@(enemy.gloc.chars[u].daimyou)=newLeader; if(@(newLeader.shogun)!=null) @(enemy.gloc.chars[u].shogun)=newLeader.shogun;}
for(uint kk=0; kk<myArmy.length(); kk++) {
 if((@(enemy.gloc.chars[u].shogun)==@(myArmy[kk]))||(@(enemy.gloc.chars[u].daimyou)==@(myArmy[kk]))) {myArmy.insert_last(enemy.gloc.chars[u]); kk=myArmy.length();}
 }
 }// They probably join you, but not always.
 }// What to do without a leader...
 }// Loop.
 }// Underlings.
}
 else {string toplay ="voice/hit_"; if(enemy.male) toplay += "m"; else toplay += "f"; enemy.sounds.insert_last(toplay + random(0, 4) + ".wav");}
 }
 }// Not blocked.
 hit=true;
 }// Hit2.
 }// Otherwise, it's not in range.
 }// Loop for finding and hitting characters.
 // You want to be able to hit nearby spaces as well.
 if(!hit) for(int jar=0; jar<=range; jar++) {
 // Figure out what space we're talking about.
 Point p(me.x, me.y);
 if(me.face=="n") p.y-=jar;
 else if(me.face=="ne") {p.y-=jar; p.x+=jar;}
 else if(me.face=="e") {p.x+=jar;}
 else if(me.face=="se") {p.x+=jar; p.y+=jar;}
 else if(me.face=="s") p.y+=jar;
 else if(me.face=="sw") {p.x-=jar; p.y+=jar;}
 else if(me.face=="w") p.x-=jar;
 else {p.x-=jar; p.y-=jar;}
 if((p.x<0)||(p.y<0)||(p.x>49)||(p.y>49)) continue;
 if(me.gloc.map[p.x][p.y]==clear) continue;
 int cur=me.gloc.map[p.x][p.y];

 // Hitting trees with blades can result in items falling out.
 if(cur==tree) {
 int item=random(0, 10);
 if(item==4) me.gloc.addItem("arrow", p);
 else if((item==2)&&(me.gloc.weather!="snow")) me.gloc.addItem("kudamono", p);
 EchoD echo("sfx/treekick1.wav", p.x, p.y, 0, 0.1, random(90, 102)); echoes.insert_last(echo);
 if((me.weapon>=0)&&(me.weapon<me.weapons.length())&&(me.weapons[me.weapon]=="woodaxe")) {
 EchoD echo("sfx/build_long_01.wav", p.x, p.y, 0, 0.1, random(90, 102)); echoes.insert_last(echo);
if(@me!=@(myArmy[ychar])) me.gloc.map[p.x][p.y]=(random(0, 5)<=2) ? house : castle_wall;
 else if((key_down(KEY_LSHIFT))||(key_down(KEY_RSHIFT))) {
for(uint xx2=me.x-2; xx2<=me.x+2; xx2++) {
for(int yy2=me.y-2; yy2<=me.y+2; yy2++) {
if((xx2<0)||(yy2<0)||(xx2>=50)||(yy2>=50)) continue;
 switch (me.gloc.map[xx2][yy2]) {
 case broken_wall :
 case boulder :
 case tree : me.gloc.map[xx2][yy2]=castle_wall; break;
case deepWater : me.gloc.map[xx2][yy2]=boat; break;
 case garden : {me.gloc.map[xx2][yy2]=horse; me.getItem("yasai");
for(uint jj=0; jj<myArmy.length(); jj++) {myArmy[jj].inv.insert_last("yasai"); myArmy[jj].inv.insert_last("yasai"); myArmy[jj].inv.insert_last("yasai");}
}; break;
 case fire : me.gloc.map[xx2][yy2]=campsite; break;
 case hole : me.gloc.map[xx2][yy2]=courtyard; break;
}// Ugh.
}}
me.gloc.map[p.x][p.y]=castle_wall;
me.fatigue+=10; me.food-=10; // Careful with the castles, yo.
}// Castles.
else me.gloc.map[p.x][p.y]=house;
 }// Axe.
 }// Trees.
 // Hitting boats with weapons can sink the boat.
 else if(cur==boat) {
 if((me.weapon<me.weapons.length())&&(random(0, 10)==4)&&(me.charged>0.5)&&((me.weapons[me.weapon]=="rocket-bow")||(me.weapons[me.weapon]=="kanabo")||(me.weapons[me.weapon]=="naginata")||(me.weapons[me.weapon]=="kunai")))
{ EchoD echo("sfx/icebreak" + random(0, 5) + ".ogg", p.x, p.y, 0, 0.1, random(90, 105));
 EchoD echo2("sfx/acid.ogg", p.x, p.y, 0, 0.5, random(95, 105));
