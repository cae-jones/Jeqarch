 enemy.weapons.remove_at(enemy.weapon);
 enemy.sounds.insert_last("sfx/metalkick1.wav");

 }// Disarm.
}// Index out of bounds I disagree!
 }// Something special.
 string[] hitsounds={
 "sfx/roughit.wav",
 "sfx/squish1.ogg", "sfx/squish2.ogg",
 "sfx/splat.wav", "sfx/splat01.ogg", "sfx/splatter1.ogg"
 };
 enemy.sounds.insert_last(hitsounds[random(0, hitsounds.length()-1)]);
 }// Default.
 // Anyway:
 enemy.hp-=dmg;
 if(enemy.hp<=0.0) {string toplay="voice/die_"; if(enemy.male) toplay += "m"; else toplay += "f"; enemy.sounds.insert_last(toplay + ".wav");
 // 8:43 PM 6/26/2012: add to the appropriate kills list.
 if(@(me.shogun)==@(myArmy[0])) enemykills.insert_last(killtimer.elapsed);
 else if(@(enemy.shogun)==@(myArmy[0])) othertimes.insert_last(killtimer.elapsed);
 if(@(enemy.shogun)==@(myArmy[0])) addDeath(enemy, battle);
 // If a daimyou or Shogun just died, then look for their underlings.
 if((enemy.rank==SHOGUN)||(enemy.rank==DAIMYOU)) {
 if((enemy.name=="Nobutomo")&&(mode==campaigne)) {missions[0]=2;
  sound vic; vic.load("sfx/selected.wav"); vic.pitch=200;
 vic.play_wait();
 string[] story={
 "You and Nobumitsu\'s forces are able to depose Nobutomo, putting you in charge of the governing of the provence.",
