// 4. "Pirates have captured the children of important samurai in your army. You must rescue them quickly, not only to keep them alive, but so that news does not spread; your parents may well feel dishonored enough to commit suicide if it seems their line has failed!",
 case 4 : {

 // Find an ocean district. If there is not one, use the player's district.
 int dx=-1; int dy=-1;
 for(int xx=0; xx<map.length(); xx++) {for(int yy=0; yy<map[xx].length(); yy++) {
 if((map[xx][yy].type=="ocean")||((@(map[xx][yy])==@(me.gloc))&&(dx<0))) {dx=xx; dy=yy;}
}}// Loop.

 // Find a spot in the selected district farthest from the player's location
 Point@[] possibles={
 newPoint(0, 0), newPoint(0, 30), newPoint(30, 0), newPoint(30, 30)
};
 Point@ p=newPoint(me.x, me.y);
 for(uint i=0; i<possibles.length(); i++) {
 if((absolute(possibles[i].x-me.x)>absolute(p.x-me.x))&&(absolute(possibles[i].y-me.y)>absolute(p.x-me.x))) @p=possibles[i];
 }// Find a point.

 // Fill the area with deep water
 for(uint xx=p.x; xx<p.x+20; xx++) {for(uint yy=p.y; yy<p.y+20; yy++) {

 if((xx<0)||(xx>map[dx][dy].map.length())||(yy<0)||(yy>=map[dx][dy].map[xx].length())) continue;
 map[dx][dy].map[xx][yy]=deepWater;
 // Put boats at the corners
 if(((xx==p.x)||(xx==p.x+19))&&((yy==p.y)||(yy==p.y+19))) map[dx][dy].map[xx][yy]=boat;
 // Build the pirate ship.
 if((xx>=p.x+5)&&(xx<p.x+15)&&(yy>=p.y+6)&&(yy<p.y+15)) {
 map[dx][dy].map[xx][yy]=castle_room;
 // Including a closed box containing the captives.
 if(
((xx==p.x+8)&&(yy>=p.y+8)&&(yy<=p.y+12))||
 ((yy==p.y+8)&&(xx>=p.x+8)&&(xx<=p.x+12))||
 ((xx==p.x+12)&&(yy>=p.y+8)&&(yy<=p.y+12))||
 ((yy==p.y+12)&&(xx>=p.x+8)&&(xx<=p.x+12))
 ) map[dx][dy].map[xx][yy]=castle_wall;
}// Ship.
}}// Loop.

 for(uint i=0; i<random(4, 7); i++) {
 // Put in our captive samurai. Take away their weapons.
 Char@ pris=newChar(SAMURAI);
 pris.weapons.resize(0);
 pris.food=150; // So they don't starve too quickly.
 @(pris.gloc)=map[dx][dy];
 pris.x=random(p.x+9, p.x+11); pris.y=random(p.y+9, p.y+11);
 // Give them tomes as well? Or put tomes in the room with them.
 map[dx][dy].add(pris);
 @(pris.shogun)=myArmy[0];
 myArmy.insert_last(pris);
}// Prisoners.
 map[dx][dy].addItem(tomes[random(0, tomes.length()-1)], newPoint(p.x+10, p.y+10));
 clipboard_copy_text("Your scouts believe the pirate ship has anchor at " + (p.x+10) + ", " + (p.y+10) + ", in district " + coords[dx] + " " + dy + ". ");
 // Create the pirate captain. He is a civilian, mind. He's just here to keep the rest of the pirates under control.
 Char@ captain=newChar(CIVIL);
 captain.getItem("katana"); captain.getItem("arcbus");
 @(captain.gloc)=map[dx][dy]; map[dx][dy].add(captain); 
 captain.x=random(p.x+5, p.x+15); captain.y=random(p.y+6, p.y+15);
 // Give the captain a tome.
 captain.getItem(tomes[random(0, tomes.length()-1)]);
 captain.base=newPoint(captain.x, captain.y);
 captain.orders="wait";
 captain.food=200;
 captain.hp=20;

 // Add the pirates, which will just be civilians with katanas and arcbuses.
 for(uint i=0; i<10; i++) {
 Char@ pirate=newChar(CIVIL);
 pirate.getItem("katana"); pirate.getItem("arcbus");
 @(pirate.gloc)=map[dx][dy]; map[dx][dy].add(pirate); 
 pirate.x=random(p.x+5, p.x+15); pirate.y=random(p.y+6, p.y+15);
 @(pirate.shogun)=captain;
 pirate.base.x=captain.base.x; pirate.base.y=captain.base.y;
 pirate.orders="'wait";
 pirate.food=200;
 }// Pirates.

 }; break;
 case 5 : {

 // Select a location for the shinobi camp.
 Point@[] possibles;
for(int i=0; i<50; i+=10) {
 for(int j=0; j<50; j+=10) {
 if((me.gloc.map[i][j]!=castle_wall)&&(me.gloc.map[i][j]!=castle_room)&&(me.gloc.map[i][j]!=courtyard)&&(me.gloc.map[i][j]!=broken_wall)&&(me.gloc.map[i][j]!=house)&&(me.gloc.map[i][j]!=horse)) {Point p(i, j); possibles.insert_last(p);}
}}// Loop.
 Point@ p=possibles[random(0, possibles.length()-1)];

 // Build a small campsite with a fire in the center of the area, and surround it with water to prevent the fire from spreading to houses or trees.
 for(int xx=p.x; xx<p.x+10; xx++) {for(int yy=p.y; yy<p.y+10; yy++) {
 if((xx>=p.x+4)&&(xx<=p.x+6)&&(yy>=p.y+4)&&(yy<=p.y+6)) {
 me.gloc.map[xx][yy]=campsite;
 if((xx==p.x+5)&&(yy==p.y+5)) me.gloc.map[xx][yy]=fire;
 }// Center of the village.
 else if((xx>=p.x+3)&&(xx<=p.x+7)&&(yy>=p.y+3)&&(yy<=p.y+7)) me.gloc.map[xx][yy]=water;
 else if(((me.gloc.map[xx][yy]==clear)||(me.gloc.map[xx][yy]==boulder)||(me.gloc.map[xx][yy]==tree))&&(random(0, 10)>5)){
  me.gloc.map[xx][yy]=(random(0, 5)>2) ? house : garden;
 }// Open space, be random.
}} // Build the ninja village.

 // Now, add the shinobi, and make one of them the leader to prevent just absorbing them.
 Char@ leader=newChar(SHINOBI);
 leader.inv.insert_last(tomes[random(0, tomes.length()-1)]);
 me.gloc.add(leader); @(leader.gloc)=me.gloc;
 leader.x=p.x+random(4, 6); leader.y=p.y+random(4, 6);
 if((leader.x==p.x+5)&&(leader.y==p.y+5)) leader.y=p.y+4;

 for(uint i=0; i<15; i++) {
 Char@ ninja=newChar(SHINOBI);
 @(ninja.gloc)=me.gloc; @(ninja.shogun)=leader;
 me.gloc.add(ninja);
 do {
 ninja.x=p.x+random(0, 9); ninja.y=p.y+random(0, 9);
 } while((ninja.x==p.x+5)&&(ninja.y==p.y+5));
 if(random(0, 5)==4) ninja.getItem("kusurigami");
 }// Big army of ninjas.

}; break;
// 6. "An enemy daimyou has hired a spy, disguised as a member of your army! Your scouts have managed to copy the sigil of the daimyou\'s lanterns, so that when you find the spy, you can give them the lantern to force them to reveal themselves."
 case 6 : {
