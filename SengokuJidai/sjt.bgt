 if((p.x<50)&&(p.y<50)&&(p.x>=0)&&(p.y>=0)) {me.gloc.map[p.x][p.y]=horse; me.gloc.map[me.x][me.y]=water; me.state=recovering; me.counter=0.25;}
 }// water.
 else if((p.x<50)&&(p.y<50)&&(p.x>=0)&&(p.y>=0)) {me.gloc.map[p.x][p.y]=horse;me.gloc.map[me.x][me.y]=clear;}
}// Horse
 else {me.sounds.insert_last("sfx/waterwake2.ogg"); if((p.x>=0)&&(p.y>=0)&&(p.x<50)&&(p.y<50)) {me.gloc.map[me.x][me.y]=next; me.gloc.map[p.x][p.y]=boat;}
 // Boats should carry other people.
 if(random(0, 5)>3) {
 for(uint i=0; i<me.gloc.chars.length(); i++) {
