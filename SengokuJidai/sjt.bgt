 else if(me.rank==SHINOBI) {
  if((me.gloc.map[me.x][me.y]==hole)||((me.gloc.map[me.x][me.y]==water)||(me.gloc.map[me.x][me.y]==deepWater))) { talk=false;
 // You cannot hide in water if it's snowing, or holes in an earthquake.
 if((me.gloc.map[me.x][me.y]==hole)&&(me.gloc.weather=="earthquake")) voice.speak_interrupt("You can\'t hide in a hole during an earthquake!");
 else if(((me.gloc.map[me.x][me.y]==water)||(me.gloc.map[me.x][me.y]==deepWater))&&(me.gloc.weather=="snow")) voice.speak_interrupt("That\'s a good way to freeze to death.");
 else {me.hiding=true; voice.speak_interrupt("Hidden.");}
