 }// Safe.

 x=i; y=random(45, 48);
 // An army to destroy, composed of samurai and shinobi.
 if((me.gloc.map[x][y]!=castle_wall)&&(me.gloc.map[x][y]!=castle_room)&&(me.gloc.map[x][y]!=broken_wall)&&(me.gloc.map[x][y]!=courtyard)) {

 if(me.gloc.map[x][y]==deepWater) me.gloc.map[x][y]=boat;


