 me.inv.remove_at(ix);
 ispeak=false; paid++; voice.speak_interrupt("Traded " + paid + " of " + price + " items.");
}// sold.
 else ispeak=false;
 if(ix<0) ix=me.inv.length()-1; else if(ix>=me.inv.length()) ix=0;
 if(ispeak) {voice.speak_interrupt(me.inv[ix]); pool.play_stationary("sfx/select.wav", false);}
 wait(5);
 }// Manual loop.

 }// Manual.
 else {
 for(uint i=0; i<price; i++) me.inv.remove_at(random(0, me.inv.length()-1));
 }// Automatic.

 if(parts.length()<2) {
 if((parts[0]=="sushi")||(parts[0]=="yasai")) {for(uint i=0; i<price; i++) me.getItem(parts[0]);}
 else me.getItem("" + price + parts[0]);
 }// Herm.
 else if(parts[0]=="food distribution") {
 // Find everyone in your army that needs food.
