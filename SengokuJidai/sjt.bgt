 else {p.x--; p.y--;}
 if((p.x>=0)&&(p.y>=0)&&(p.x<50)&&(p.y<50)&&((me.gloc.map[p.x][p.y]==castle_wall)||(me.gloc.map[p.x][p.y]==broken_wall))) { talk=false;
 me.climbing=true;
