 else if(key_pressed(KEY_D)) {
 if(confirm("Are you sure you want to drop the " + me.inv[menuX] + "? ")) {me.gloc.items.insert_last(me.inv[menuX]); me.inv.remove_at(menuX); Point p(me.x, me.y); me.gloc.itemPositions.insert_last(p); pool.play_2d("sfx/metalkick1.wav", me.x, me.y, me.x, me.y, false);}
 }// Drop item.
 else if((key_pressed(KEY_G))||(key_pressed(KEY_A))||(key_pressed(KEY_E))) {
 int type=0;
