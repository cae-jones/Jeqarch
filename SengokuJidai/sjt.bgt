 echoes.insert_last(echo);
 }
 else if(me.state==walking) {
 me.fatigue+=0.25; // Walking is more tiring than fighting at one per step.
 bool move=true;
 Point p(me.x, me.y);
 if(@(me.gloc)!=null) {
 // figure out which direction we're going.

 string face=me.face;
 Map@ gloc; @gloc=me.gloc;
 if(face=="n") p.y--;
 else if(face=="ne") {p.x++; p.y--;}
 else if(face=="e") p.x++;
 else if(face=="se") {p.x++; p.y++;}
 else if(face=="s") p.y++;
 else if(face=="sw") {p.y++; p.x--;}
 else if(face=="w") p.x--;
 else {p.x--; p.y--;} 
 int cur=clear; int next=clear;
 int chx=0; chx+=me.x; int chy=0; chy+=me.y;
 if((me.x<0)||(me.y<0)||(chx>=gloc.width)||(chy>=gloc.height)) {cur=cur;}
 else cur=gloc.map[me.x][me.y];
 chx=0; chx+=p.x; chy=0; chy+=p.y;
 if((p.x>=0)&&(chx<gloc.width)&&(p.y>=0)&&(chy<gloc.height)) next=gloc.map[p.x][p.y];
 string toplay="sfx/";
 int state=me.state; // So I don't have to remove everything.
 if(gloc.weather=="snow") toplay += "snowstep1.wav";
 else if(gloc.type=="planes") toplay += "grasssteps4.wav";
 else if(gloc.type=="ocean") toplay += "pikkonsteps2.wav";
 else toplay += "dirtstep1.wav";
 if(me.riding) {
 if((cur!=boat)&&(cur!=horse)) {
 if(cur==deepWater) {
 // Doo a sweep of the spaces surrounding the character to prevent falling.
 // I have an omenous feeling, though, that this isn't always going to work.
  for(int xx=me.x-1; xx<me.x+2; xx++) {for(int yy=me.y-1; yy<me.y+2; yy++) {
 if((xx<0)||(xx>49)||(yy<0)||(yy>49)) continue;
 else if(me.gloc.map[xx][yy]==boat) {me.x=xx; me.y=yy; xx=50; yy=50;}
}}// Loop.
 }// To make it possible to have multiple people riding in one boat.
 else {
 toplay="sfx/";
 if(cur==clear) {
 if(gloc.weather=="snow") toplay += "snowland" + random(1, 2) + ".wav";
 else if(gloc.type=="planes") toplay+="grassland2.wav";
 else if(gloc.type=="ocean") toplay += "pikkonland2.wav";
 else toplay += "dirtland3.wav";
 }
 else {
 if(cur==tree) toplay += "hardleafland.wav";
 else if(next==hole) {toplay += "whoosh1.wav"; state=recovering; counter=0.2+(0.01*me.fatigue); me.sounds.insert_last(toplay); toplay="voice/hit_"; if(me.male) toplay += "m"; else toplay += "f"; me.sounds.insert_last(toplay + ".wav");}
 // And so on and so forth.
 }
 me.sounds.insert_last(toplay);
 state=standing; counter=0.0;;
 me.riding=false;
 }// Not falling out of a boat.
 }// You can only ride horses or boats.
 else {
// counter=0.15;
 if((cur==horse)&&(next!=clear)&&(next!=garden)&&(next!=water)) {counter=0.0; me.sounds.insert_last("sfx/collide4-brickwall.ogg"); state=standing;}
 else if((cur==boat)&&(next!=deepWater)&&(next!=water)) {counter=0.0; me.sounds.insert_last("sfx/collide4-brickwall.ogg"); state=standing;}
 else if(cur==horse) {
me.sounds.insert_last("gallop.wav"); 
 if(next==water) {
