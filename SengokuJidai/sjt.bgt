 if((absolute(me.x-me.gloc.chars[i].x)<=1)&&(absolute(me.y-me.gloc.chars[i].y)<=1)&&(me.gloc.chars[i].x>=0)&&(me.gloc.chars[i].x<50)&&(me.gloc.chars[i].y>=0)&&(me.gloc.chars[i].y<50)&&(me.gloc.map[me.gloc.chars[i].x][me.gloc.chars[i].y]==deepWater)) {me.gloc.chars[i].x=me.x; me.gloc.chars[i].y=me.y; me.gloc.chars[i].riding=true;}
 }// Loop.
