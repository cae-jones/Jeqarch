wait(5);
 }// Looking around.
 }// You're looking instead of interacting.
 else {
 // Pick up items if any are in reach.
 bool talk=(me.food>random(25, 50));
 if(@(me.gloc)!=null) {
 for(uint i=0; i<me.gloc.itemPositions.length(); i++)
  if((absolute(me.gloc.itemPositions[i].x-me.x)<=1)&&(absolute(me.gloc.itemPositions[i].y-me.y)<=1)) {
 voice.speak("Got " + me.gloc.items[i] + ". "); talk=false;
me.getItem(me.gloc.items[i]); me.gloc.items.remove_at(i); me.gloc.itemPositions.remove_at(i);}

 // Good thing to do if there aren't items is to check what you're standing on and see what you can do with it.
 // Horses and boats can be ridden.
 if((me.gloc.map[me.x][me.y]==horse)||(me.gloc.map[me.x][me.y]==boat)) {talk=false; if(me.riding) voice.speak("Dismounted"); else voice.speak("riding " + mapstring(me.gloc.map[me.x][me.y]) + ". "); me.riding=!(me.riding);}
 // Shinobi can hide in trees, holes and water.
 if(me.hiding) {me.hiding=false; voice.speak_interrupt("You are no longer hidden.");}
 else if(me.gloc.map[me.x][me.y]==tree) {
 // Options:
 // You can get food,
 // You can harvest branches to make arrows, shuriken or staves,
 // Or a shinobi can hide in the tree.
 if(confirm("Do you want to try and make something from the branches of the tree?")) { talk=false;
 if(me.gloc.weather=="snow") voice.speak_interrupt("The branches are too covered in snow and ice to be of any use.");
 else if((me.gloc.weather=="windy")&&(random(0, 5)<3)) voice.speak_interrupt("The wind has blown the branches away.");
 else if((me.gloc.weather=="earthquake")&&((me.rank!=SHINOBI)||(random(0, 6)!=2))) voice.speak_interrupt("You can\'t craft anything with the ground shaking like this!");
 else if(random(0, 10)>6) voice.speak_interrupt("You can\'t find any usable branches right now. Wait for new ones to grow.");
 else {
 string[] options={"arrows", "jo staff", "bo staff", "Naginata, requires a short blade to attach."};
 if(me.rank==SHINOBI) {options.insert_last("shuriken"); options.insert_last("poisonous darts");}
 voice.speak_interrupt("What do you want to make? Use enter or space bar to make a selection, or escape to cancel.");
 bool cont=true;
 menuX=0;
 while(cont) {
 bool speakme=false;
 if((key_pressed(KEY_LCONTROL))||(key_pressed(KEY_RCONTROL))) voice.stop();
 else if(key_pressed(KEY_ESCAPE)) {pool.play_1d("sfx/select.wav", me.x, me.x, false); cont=false;}
 else if(key_pressed(KEY_UP)) {menuX--; if(menuX<0) menuX=options.length()-1; speakme=true;}
 else if(key_pressed(KEY_DOWN)) {speakme=true; menuX++; uint chx=0; chx+=menuX; if(chx>=options.length()) menuX=0;}
 else if((key_pressed(KEY_RETURN))||(key_pressed(KEY_SPACE))) {
 if(confirm("Are you sure you want to make " + options[menuX] + "?")) {
 cont=false;
  switch (menuX) {
 case 0 : {// arrows.
 int arrows=random(1, 5); me.arrows+=arrows;
 voice.speak_interrupt("You are able to make " + arrows + " arrows.");
 }; break;
 case 1 : {
 me.getItem("jo"); voice.speak_interrupt("Jo successfully created.");
 }; break;
 case 2 : {me.getItem("bo"); voice.speak_interrupt("Bo created.");}; break;
 case 3 : { //naginata.
 // The wakazushi has ceremonial relevance, so search for a tanto first.
 int index=-1;
 bool useInv=false;
 for(uint i=0; i<me.inv.length(); i++) {
 if(me.inv[i]=="tanto") index=i;
 else if((index<0)&&(me.inv[i]=="wakazushi")) index=i;
 }
 if(!useInv) for(uint i=0; i<me.weapons.length(); i++) {
 if(me.weapons[i]=="tanto") index=i;
 else if((index<0)&&(me.weapons[i]=="wakazushi")) index=i;
 }// Searching weapons.

 if(index<0) {voice.speak_interrupt("You don\'t have a blade to complete the naginata."); cont=true;}
 else {
 if(useInv) me.inv.remove_at(index);
 else me.weapons.remove_at(index);
 me.getItem("naginata");
 }// Build the naginata, and remove the blade that is sacrificed.
 }; break;
 case 4 : {
 if( (me.ninjaAmmo&0xF0)<0x80) me.ninjaAmmo|=0x80; else me.ninjaAmmo|=0x70;
 }; break;
 case 5 : {
 me.ninjaAmmo|=0x700;
 }; break;
 default : voice.speak_interrupt("What? I\'m confused. You want to make " + options[menuX] + ", right? That\'s in a strange place, so tell the programmer about it!");
 }// That's a bad idea.
 }
 }// Enter and space.
 else {int index=-1; index=number_pressed(); if(index>=0) {uint chx=0; chx+= index; if(chx<options.length()) menuX=index; speakme=true;}}
 if(speakme) {
 pool.play_1d("sfx/select.wav", me.x, me.x, false);
 voice.speak_interrupt(options[menuX]);
 }// Speak.
 }// Another one of these...
 }// Success!
 }// Crafting.
 else {
 voice.speak_interrupt("To get fruit or birds to eat, attack the tree when no human targets are in range.");
 if(me.rank==SHINOBI) {voice.stop();
