if(v.face=="w") found=true;
 else if((me.y<v.y)&&(v.face=="nw")) found=true;
 else if((me.y>v.y)&&(v.face=="sw")) found=true;
}// west.
else if((me.y<v.y)&&(v.face=="n")) found=true;
 else if((me.y>v.y)&&(v.face=="s")) found=true;
 else if(random(0, 10)==4) found=true;
 if((found)&&(@(v.target)==null)) {
 @(v.target)=me;
sound snd; snd.load("sfx/beacon.wav");
 snd.pitch=50;
snd.play();
while(snd.pitch<=400) {snd.pitch=snd.pitch+1; wait(1);}
voice.speak_interrupt("You are spotted!");
}// Found.
else {
me.state=recovering; me.counter=1.0;
if(!v.inv.is_empty()) {int index=random(0, v.inv.length()-1); me.getItem(v.inv[index]); voice.speak_wait("Stole " + v.inv[index] + ". "); v.inv.remove_at(index);}
 else if(v.arrows>0) {int a=random(0, v.arrows); v.arrows-=a; me.arrows+=a; voice.speak_wait("Stole " + a + " arrows.");}
 else if(v.weapons.length()>1) {int index=random(0, v.weapons.length()-1); me.getItem(v.weapons[index]); voice.speak_wait("stole " + v.weapons[index] + ". "); v.weapons.remove_at(index);}
i+=random(0, 2);
}// steal some stuff.

}// Chars loop.
 }// Try to steal stuff.
 if(me.orders=="scout") {
 string[] quests={
"A powerful shogun is surrounding your district with a large army, including many mounted warriors!",
