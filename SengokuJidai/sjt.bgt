// 1. "A nearby district faces famine. There are skilled workers there that have been selling their crafts to the local ruler for food. If you can feed the people and get them on your side, you can overthrow that ruler and claim what he has hoarded for yourself.",
 case 1 : {
 // Step 1. Pick a district.
 int dx=random(0, map.length()-1);
 int dy=random(0, map[dx].length()-1);

 // Step 2. Remove all of the gardens.
 for(uint xx=0; xx<map[dx][dy].map.length(); xx++) {
 for(uint yy=0; yy<map[dx][dy].map[xx].length(); yy++) {
 if(map[dx][dy].map[xx][yy]==garden) map[dx][dy].map[xx][yy]=clear;
 else if((map[dx][dy].map[xx][yy]==water)&&(random(0, 6)==4)) map[dx][dy].map[xx][yy]=hole;
}}

 // Step 3. Build a new castle.
 Point@[] possibles;
for(int i=0; i<50; i+=10) {
 for(int j=0; j<50; j+=10) {
 if((map[dx][dy].map[i][j]!=castle_wall)&&(map[dx][dy].map[i][j]!=castle_room)&&(map[dx][dy].map[i][j]!=courtyard)&&(map[dx][dy].map[i][j]!=broken_wall)&&(map[dx][dy].map[i][j]!=house)&&(map[dx][dy].map[i][j]!=horse)) {Point p(i, j); possibles.insert_last(p);}
}}// Loop.
 Point@ p=possibles[random(0, possibles.length()-1)];

 for(uint xx=p.x; xx<p.x+10; xx++) {for(uint yy=0; yy<p.y+10; yy++) {
 map[dx][dy].map[xx][yy]=castle_wall;
 if((xx>p.x+1)&&(xx<p.x+9)&&(xx-p.x%2==0)) map[dx][dy].map[xx][yy]=castle_room;
}}// Loop.

 // I want the castle to be in a spiral-type design.
 // 5 8
 map[dx][dy].map[p.x+5][p.y+8]=courtyard;
 // 7 8
 map[dx][dy].map[p.x+7][p.y+8]=courtyard;
 // 5 4
 map[dx][dy].map[p.x+5][p.y+4]=courtyard;
 map[dx][dy].map[p.x+2][p.y+9]=horse;
 // 4 3
 map[dx][dy].map[p.x+4][p.y+3]=castle_wall;
 // 6 3
 map[dx][dy].map[p.x+6][p.y+3]=castle_wall;
 // 6 7
 map[dx][dy].map[p.x+6][p.y+7]=castle_wall;

 // Debug:
 clipboard_copy_text("Your scouts think the corrupt leader\'s castle is in district " + coords[dx] + " " + dy + ", with a corner at " + p.x + ", " + p.y + ". ");

 // Fill said castle with food.
 for(uint i=0; i<10; i++) {
 Point ip(random(p.x, p.x+9), random(p.y, p.y+9));
map[dx][dy].addItem( ((random(0, 7)>5) ? "kudamono" : (random(0, 5)==2) ? "sushi" : "yasai"), ip);
}// Food.

 // Create the corrupt leader.
 Char@ leader=newChar(SHOGUN); // He really should be the daimyou, but it's easier with a shogun.
 map[dx][dy].add(leader); @(leader.gloc)=map[dx][dy];
 leader.x=p.x+6; leader.y=p.y+6;
 leader.orders="wait"; Point b(p.x+6, p.y+6); leader.base.x=b.x; leader.base.y=b.y;
 leader.food=200.0;
 // Give him a tome.
 leader.getItem(tomes[random(0, tomes.length()-1)]);
 // Create samurai to guard the castle.
 for(uint i=0; i<7; i++) {
 Char@ sam=newChar(SAMURAI);
 @(sam.gloc)=map[dx][dy]; map[dx][dy].add(sam);
 @(sam.shogun)=leader;
 sam.base.x=b.x; sam.base.y=b.y;
 sam.orders="wait";
 sam.food=200.0;
do { sam.x=random(p.x+2, p.x+8); sam.y=random(p.y+2, p.y+8); } while(map[dx][dy].map[sam.x][sam.y]==castle_wall);
 if((sam.x==p.x+2)||(sam.x==p.x+4)) sam.face="s";
 else if((sam.y==p.y+2)||(sam.y==p.y+4)) sam.face="w";
 else if(sam.x==p.x+8) sam.face="n";
 
 }// 7 samurai.

 // Add civilians to convert to your cause.
 for(uint i=0; i<25; i++) {
 Char@ civ=newChar(CIVIL);
 @(civ.gloc)=map[dx][dy]; map[dx][dy].add(civ);
 civ.x=random(0, 49); civ.y=random(0, 49);
 if(random(0, 10)==6) civ.getItem(tomes[random(0, tomes.length()-1)]);
}

}; break;
