 void step() {

 // Generally, this only matters in game.

 double dt=0.005;
 dt=realtimer.elapsed*0.001; realtimer.restart(); realtimer.resume();
 switch (speed) {
 case 0 : dt*=0.5; break; //dt=0.002; break;
 case 1 : dt=dt; break; //dt=0.005; break;
 case 2 : dt*=2.0; break; //dt=0.01; break;
 default : dt*=3.0; break; //dt=0.02; break;
//  default : dt=0.03;
 }// Speed.
 if(loc==game) {
 if(ychar>=myArmy.length()) ychar=0;
 if(myArmy.length()==0) {
 playsong("music/gameover.wav");
 tbi=-1;
 while(bgm.playing) {
 if((key_pressed(KEY_RETURN))||(key_pressed(KEY_SPACE))) fadeOut();
 wait(5);
 }
 setLoc(MAIN);
}
 // Iterate through the army and determine what districts need to be stepped.
 Char@ me;
 @me=myArmy[ychar];

 Map@[] r;
 r.insert_last(me.gloc);
 for(uint i=0; i<myArmy.length(); i++) {
 bool add=true;
 for(uint j=0; j<r.length(); j++) {if(@(r[j])==@(myArmy[i].gloc)) add=false;}
 if(add) r.insert_last(myArmy[i].gloc);
 }// Meh.
 Point p(me.x, me.y); // Listener position.

 for(uint i=0; i<r.length(); i++) {
 if(@(r[i])==null) continue;
 if(@(r[i])==@(me.gloc)) {p.x=me.x; p.y=me.y;}
 else {p.x=9001; p.y=9001;}
 for(uint j=0; j<r[i].chars.length(); j++) {
 if(@(r[i].chars[j])==null) continue;
 stepChar(r[i].chars[j], dt, p);
if(r[i].chars[j].hp<=0.0) {
 // Stop the breathing sound, s'il vous plait.
 if(r[i].chars[j].fatigue_sound>=0) pool.destroy_sound(r[i].chars[j].fatigue_sound);
 r[i].chars[j].fatigue_sound=-1;
 // All items belonging to this character are dropped.
Point px(r[i].chars[j].x, r[i].chars[j].y); 
 for(uint k=0; k<r[i].chars[j].inv.length(); k++) {
r[i].items.insert_last(r[i].chars[j].inv[k]); r[i].itemPositions.insert_last(px);}
 for(uint k=0; k<r[i].chars[j].weapons.length(); k++) {
r[i].items.insert_last(r[i].chars[j].weapons[k]); r[i].itemPositions.insert_last(px);
}
 // That includes shields.
 if(r[i].chars[j].hasShield) {r[i].items.insert_last("shield"); r[i].itemPositions.insert_last(px);}
 // And arrows
/* for(int k=0; k<r[i].chars[j].arrows; k++) {r[i].items.insert_last("arrow"); r[i].itemPositions.insert_last(px);}*/
 if(r[i].chars[j].arrows>0) r[i].addItem("" + (r[i].chars[j].arrows) + "arrows", px);
 // And Ninja Ammo.

 // I'm sure there's more to do...

 // Check to see if this one is in myArmy.
 bool inarmy=false;
 if(@(r[i].chars[j])!=@(myArmy[ychar])) {
 for(uint k=1; k<myArmy.length(); k++) {if(@(myArmy[k])==@(r[i].chars[j])) {myArmy.remove_at(k); k=9001; inarmy=true;}}
 }// Don't remove the player character.
 if(inarmy) {killtimes.insert_last(killtimer.elapsed);
 addDeath(r[i].chars[j]);
}
 r[i].chars.remove_at(j); j--;
 }// Dead one.
 else {
 if((r[i].chars[j].x<0)||(r[i].chars[j].x>=r[i].width)||(r[i].chars[j].y<0)||(r[i].chars[j].y>=r[i].height)) {
 int tx=0; int ty=0;
 for(uint xx=0; xx<map.length(); xx++) {
 for(uint yy=0; yy<map[xx].length(); yy++) {
 if(@(r[i])==@(map[xx][yy])) {tx=xx; ty=yy;}
 }}
 if(r[i].chars[j].x<0) tx--;
 else if(r[i].chars[j].x>=r[i].width) tx++;
 else if(r[i].chars[j].y<0) ty--;
 else ty++;
 uint chx=0; uint chy=0; chx+=tx; chy+=ty;
 if(tx<0) r[i].chars[j].x=0;
 else if(chx>=map.length()) r[i].chars[j].x=49;
 else if(ty<0) r[i].chars[j].y=0;
 else if(chy>=map[tx].length()) r[i].chars[j].y=49;
 else {

 @(r[i].chars[j].gloc)=map[tx][ty];
 if(r[i].chars[j].x<0) r[i].chars[j].x=r[i].chars[j].gloc.width-1;
 else if(r[i].chars[j].x>49) r[i].chars[j].x=0;
 else if(r[i].chars[j].y<0) r[i].chars[j].y=49;
 else if(r[i].chars[j].y>49) r[i].chars[j].y=0;
 r[i].chars[j].gloc.add(r[i].chars[j]);
 r[i].chars.remove_at(j); j--;
 }// Map to go to.
 }// Out of bounds, change gloc.
 }// Alive.
 }// Loop for chars.
 }// Loop for maps.

 // Stuff on the map where the player character is.
 if(@(me.gloc)==null) @(me.gloc)=map[0][0]; // 10:41 PM 12/29/2011. Multiplayer was being difficult.
 int trees=0; // Count the trees...
 int gardens=0; // And gardens.
 Point@[] firepoints; // So that giant fires don't flood the ambience.
 for(int xx=me.x-(order_range); xx<=me.x+order_range; xx++) {
 for(int yy=me.y-(order_range); yy<=me.y+order_range; yy++) {
 if((xx<0)||(xx>=50)||(yy<0)||(yy>=50)) continue;
 int cur=me.gloc.map[xx][yy];

 if(cur==fire) {
 if(((me.gloc.weather=="storm")||(me.gloc.weather=="rain")||(me.gloc.weather=="snow"))&&(random(0, 75)>=50)) {me.gloc.map[xx][yy]=clear; me.gloc.destroyEnvSound(pool, xx, yy);}
 else {

 int nears=0;
 for(uint i=0; i<firepoints.length(); i++) {
 if((absolute(firepoints[i].x-xx)<2)&&(absolute(firepoints[i].y-yy)<2)) nears++;
 }// Loop.

 if(nears<7) {  
 firepoints.insert_last(newPoint(xx, yy));

me.gloc.playEnvSound(pool, ((nears==0) ? "sfx/fire_large.wav" : "sfx/bp_fire_0" + nears + ".wav"), me.x, me.y, xx, yy, true);
}// If there are too many fires here, don't play sounds.
}
 // Check to see if you're inside a castle, and set it on fire.
 if(AICounter%20==0) {
 for(int x2=xx-1; x2<=xx+1; x2++) { for(int y2=yy-1; y2<=yy+1; y2++) {
 if((x2<0)||(x2>49)||(y2<0)||(y2>49)) continue;
 if((me.gloc.map[x2][y2]==castle_wall)||(me.gloc.map[x2][y2]==castle_room)||(me.gloc.map[x2][y2]==tree)||(me.gloc.map[x2][y2]==garden)||(me.gloc.map[x2][y2]==house)) me.gloc.map[x2][y2]=fire;
}} } // Burning things.

} // Fire.
 else if(cur==tree) {
// if(tmr.elapsed%4000<=5) pool.play_2d("sfx/undertree.ogg", me.x, me.y, xx, yy, false);

 // There are way too many trees and gardens, so let's tighten the range a bit.
 if((absolute(xx-me.x)<5)&&(absolute(yy-me.y)<5))
 { trees++;
 if((me.gloc.weather=="snow")||(me.gloc.weather=="rain")||(me.gloc.weather=="storm")) me.gloc.destroyEnvSound(pool, xx, yy);
else  if(trees<15) me.gloc.playEnvSound(pool, "sfx/underTree.ogg", me.x, me.y, xx, yy, true);
 }// Trees.
 }// Trees.
 else if(cur==garden) {
 gardens++;
 // if((absolute(xx-me.x)<5)&&(absolute(yy-me.y)<5))
// me.gloc.playEnvSound(pool, "sfx/buzz1.wav", me.x, me.y, xx, yy, true);
 }
 else if(cur==horse) {if(tmr.elapsed%5000<5) pool.play_2d("sfx/horse.wav", me.x, me.y, xx, yy, false);
 // Horses should echo, but I'm not really sure how echoes will work.
 }// Horse.
 else if((cur==castle_room)||(cur==courtyard)) {
 if(tmr.elapsed%2000<=5) {
 // Determine if this is on a path that the character is on.
 if((xx==me.x)||(yy==me.y)) {if(me.gloc.map[me.x][me.y]==cur) continue;}
 else if((absolute(me.x-xx)>1)||(absolute(me.y-yy)>1)) continue; // Only make sounds if it's a turn from the current path. :).
 pool.play_2d("sfx/doorAjar" + random(1, 3) + ".ogg", me.x, me.y, xx, yy, false);

 }// Sound.
 }// Courtyard or room.
 else if((me.gloc.weather=="earthquake")&&(absolute(me.x-xx)<=1)&&(absolute(me.y-yy)<=1)) {
 if(((cur==house)||(cur==castle_wall)||(cur==boulder)||(cur==hole))&&(random(0, 100)==4)&&(AICounter%3==0)) {
 me.gloc.map[xx][yy]=broken_wall;
  for(uint i=0; i<6; i++) {
 EchoD ech("sfx/icebreak" + random(0, 5) + ".ogg", xx, yy, 0, random(1, 15)*0.1);
 EchoD ech2("sfx/manyRocks.ogg", xx, yy, random(-10, 0), random(1, 15)*0.1);
 echoes.insert_last(ech); echoes.insert_last(ech2);
}// Sound.
 me.hp-=random(0, 30)*0.15;
 pool.play_2d("sfx/hitmk.wav", me.x, me.y, me.x, me.y, false);
 }// Earthquake damage.
 }// Earthquakes can cause trouble.
 }}// Loop for current map.
// if((trees>10)||(gardens>10)) alert("So many plants!", "There are " + trees + " trees, and " + gardens + " gardens within sight.");

 // Echoes.
 for(uint i=0; i<echoes.length(); i++) {
 echoes[i].delay-=dt;
 if(echoes[i].delay<=0.0) {
 pool.play_extended_2d(echoes[i].filename, me.x, me.y, echoes[i].x, echoes[i].y, 0, 0, 0, 0, false, 0.0, 0, echoes[i].decay, echoes[i].pitchBend);
 echoes.remove_at(i); i--;
}// Play and remove echo.
}

 // I'm not sure if this is a good idea, considering how many maps might be going at once, but I'm hoping that the out of range nature of the off-screen maps makes this safe:
 if(@(me.gloc)!=@(r[0])) {
pool.destroy_all(); // To kill env sounds, mostly.
 me.fatigue_sound=-1; // Should reset it for other characters as well, but there are so many loops already...
 tbi=-1;
 playamb("sfx/" + me.gloc.weather + ".wav"); // Otherwise the same weather sound will keep playing when you change locations.
 r[0].weather=""; // I don't think that's a very good idea, but it's silly to leave an area and come back to find earthquakes or storms still in progress.

 // 9:03 PM 6/26/2012: Look for boats in oceans. Canals are not affected by this.
 if(me.gloc.type=="ocean") {
 for(uint xx=0; xx<me.gloc.map.length(); xx++) {
 for(uint yy=0; yy<me.gloc.map[xx].length(); yy++) {
 if(me.gloc.map[xx][yy]==boat) me.gloc.playEnvSound(pool, "sfx/beach_01.wav", me.x, me.y, xx, yy, false);
}}// X-Y loops.
 }// Boats.
 }
 else pool.update_listener_2d(me.x, me.y);
 if(braille%4==2) {
 int time=brailletmr.elapsed;
 if(time>=250) {show_game_window(getBraille(me.gloc, me.x, me.y) + "  " + getBraille(me.gloc, me.x, me.y-1) + "  " + getBraille(me.gloc, me.x, me.y+1)); brailletmr.restart(); brailletmr.resume();}
 }// Update display.
 else if(braille%4==3) {
 if(brailletmr.elapsed>=200) {fullDisplay(me, ((AICounter/4)%2)==0); brailletmr.restart(); brailletmr.resume();}
}
 // Weather.
 if(tmr.elapsed>60000) {tmr.restart(); // I... don't know. :-/
 string[] weathers={
 "", "", "windy", "rain", "snow", "earthquake", "storm", "windy", "rain", "",
 "", "", "windy", "rain", "snow", "", "storm", "windy", "rain", ""
 };
 if(me.gloc.weather=="rain") {
 uint gardens=0;
 for(uint xx=0; xx<50; xx++) for(uint yy=0; yy<50; yy++) {
 if(gardens>100) {xx=50; yy=50; continue;}
 if((me.gloc.map[xx][yy]==clear)&&(random(0, 50)==2)) {me.gloc.map[xx][yy]=garden; gardens++;}

 }// Look for clear ground.
 }// Rain rejuvinates gardens.
 else if(me.gloc.weather=="earthquake") {

 }// Earthquakes can cause tsunamis, damage houses or castles, Etc.
 me.gloc.weather=weathers[random(0, weathers.length()-1)];
 playamb("sfx/" + me.gloc.weather + ".wav"); // ... No. 
 
 }// Weather.
 else if((me.gloc.weather=="storm")&&(tmr.elapsed%1000<=7)) {

 int lx=random(0, 49); int ly=random(0, 49);
// alert("Lightning strike!", "Lightning has struck at " + lx + ", " + ly + ". ");
 pool.play_2d("sfx/lightning" + random(1, 3) + ".wav", me.x, me.y, lx, ly, false);
 if(me.gloc.map[lx][ly]==tree) {
 pool.play_2d("sfx/blowup.wav", me.x, me.y, lx, ly, false);
 me.gloc.map[lx][ly]=fire;
 // Anyone near the tree will be hit.
 for(uint ix=0; ix<me.gloc.chars.length(); ix++) {
 if((absolute(me.gloc.chars[ix].x-lx)<3)&&(absolute(me.gloc.chars[ix].x-ly)<3)) {
 me.gloc.chars[ix].hp-=random(1, 5);
 // Hitcries.

 }// Hit with shrapnel.
 }
 }// Lightning can destroy trees.
 else if(me.gloc.map[lx][ly]==garden) me.gloc.map[lx][ly]=fire;
 else if((me.gloc.map[lx][ly]!=house)&&(me.gloc.map[lx][ly]!=castle_room)&&(me.gloc.map[lx][ly]!=castle_wall)&&(me.gloc.map[lx][ly]!=broken_wall)&&(me.gloc.map[lx][ly]!=courtyard)&&(me.gloc.map[lx][ly]!=campsite)) {
 for(uint ix=0; ix<me.gloc.chars.length(); ix++) {
 if((absolute(me.gloc.chars[ix].x-lx)<=1)&&(absolute(me.gloc.chars[ix].y-ly)<=1)) me.gloc.chars[ix].hp-=random(3, 12);
 }}// People can be struck by lightning.
 }// Lightning.
 // Music?
 if((bgm.active)&&(!bgm.playing)) bgm.play();
 if((amb.active)&&(!amb.playing)) amb.play();

 AICounter++;
 if(AICounter>=50) AICounter=0;

 if(mode==online) {
 if(onlineCounter.elapsed>=1000) {
 // We'll handle state changes when the states are set, but we need to handle position, hp, etc here.
 uac.mychar=ychar;
 int xx=0; int yy=0; // Which district are we in?
 if(map.length()==0) alert("ERROR!", "Map is empty!");
 for(uint x2=0; x2<map.length(); x2++) {
 if(map[x2].length()==0) alert("Error!", "Collumn " + x2 + " is empty!");
for(uint y2=0; y2<map[x2].length(); y2++) {
if(@(me.gloc)==@(map[x2][y2])) {xx=x2; yy=y2; x2=10; y2=10; break;} }
}
 string info="info, " + uac.id + ", " + ychar + ", " + me.x + ", " + me.y + ", " + me.hp + ", " + me.fatigue + ", " + me.arrows + ", " + me.ninjaAmmo + ", " + xx + ", " + yy + ", " + me.weapon + ", " + ( (me.weapon<me.weapons.length()) ? me.weapons[me.weapon] : "woodaxe" );
 host.send_unreliable(server_id, info, 0);

 onlineCounter.restart(); onlineCounter.resume();
 }// Update for online.
 network_event event;
 // No telling how many messages we'll get when.
 event=host.request();
 if(event.type!=event_none) {


 if(event.type==event_receive) {
 string msg=event.message;
 string head=string_left(msg, 4);

 if(head=="info") {
string[] vals=string_split(msg, ", ", true);
int pid=string_to_number(vals[1]);
 Account@ peer; @peer=null;
 for(uint i=0; i<players.length(); i++) {if(players[i].id==pid) {@peer=players[i]; i=players.length();}}
 if(@peer!=null) {
 peer.mychar=string_to_number(vals[2]);
 if((peer.mychar<peer.army.length())&&(@(peer.army[peer.mychar])!=null)) {
 Char@ you; @you=peer.army[peer.mychar];
 you.x=string_to_number(vals[3]); you.y=string_to_number(vals[4]);

 you.hp=string_to_number(vals[5]);
 you.fatigue=string_to_number(vals[6]);
  you.arrows=string_to_number(vals[7]);
 you.ninjaAmmo=string_to_number(vals[8]);
 int xx=string_to_number(vals[9]); int yy=string_to_number(vals[10]);
 if((xx>=0)&&(xx<map.length())&&(yy>=0)&&(yy<map[xx].length())) {
 if(@(you.gloc)!=@(map[xx][yy])) {
  // Set gloc.
 if(@(you.gloc)!=null) {
 for(uint j=0; j<you.gloc.chars.length(); j++) {
 if(@(you.gloc.chars[j])==@you) you.gloc.chars.remove_at(j);
 }// Loop for removal.
 }// Remove.
 @(you.gloc)=map[xx][yy];
 // See if we need adding. Or... just add us anyway.
 map[xx][yy].chars.insert_last(you);
 }// No need to set it otherwise.
 }// District.
 you.weapon=string_to_number(vals[11]);
 if(you.weapon>=you.weapons.length()) {
 you.weapons.resize(you.weapon+1);
}
 you.weapons[you.weapon]=vals[12];
}// mychar set correctly.
}// Non-null peer.
 else {
//voice.speak("Error. Received info for a player that was not found. " + vals[1] + ". ");
 // Try to load them
 host.send_reliable(server_id, "load, " + vals[1], 2);
 network_event le;
 while(true) {
 le=host.request();
 if((le.type==event_receive)&&(le.channel==2)) {
 if(le.message=="not found") {
 voice.speak_interrupt("Tried to load " + vals[1] + " from server, but that account was not found.");
 }
 else {
 Account ac2; ac2.loadString(le.message, map); players.insert_last(ac2); ac2.id=string_to_number(vals[1]);
 }
 break;
 }// Found, maybe.
 wait(5);
 }// Loop for loading the bloody thing.

}// Not found.
 }// Decode info.

 else if((head=="join")||(head=="save")||(head=="load")) {
 // We need to isolate the account id before we can load? Or... not.
 Account ac; ac.loadString(msg, map); players.insert_last(ac);
 }// Adding player.
 else if(head=="quit") {
 string[] words=string_split(msg, ", ", true);
 int pid=string_to_number(words[1]);
 for(uint i=0; i<players.length(); i++) {
 if(players[i].id==pid) {
 // We want to be sure that all of the characters go away first. I'd like to put some echoes there for sake of not being confusing.
 Char@ you; if(players[i].army.length()>players[i].mychar) @you=players[i].army[players[i].mychar]; else @you=null;

if(@you!=null) pool.play_2d("sfx/DIRTFALL.wav", me.x, me.y, you.x, you.y, false);

 // Do we really want to go through a loop? No. Instead, let's do this:
 for(uint j=0; j<players[i].army.length(); j++) {
 players[i].army[j].inv.resize(0); players[i].army[j].weapons.resize(0); players[i].army[j].hp=-1;
 }// Kill them.
 players.remove_at(i); i=players.length();
 }// Found.
 }// Remove.

 }// Remove player.

 // state-setting
 else if(head=="stat") {
 string[] vals=string_split(msg, ", ", true);
 int pid=string_to_number(vals[1]);
 for(uint i=0; i<players.length(); i++) {if(players[i].id==pid) {
 if(players[i].mychar<players[i].army.length()) players[i].army[players[i].mychar].setState(string_to_number(vals[2]));
 }//Found.
}// Loop.
 }// change state.
 else if(head=="orde") {
 // orders
 string[] vals=string_split(msg, ", ", true);
 int pid=string_to_number(vals[1]);
 for(uint i=0; i<players.length(); i++) {if(players[i].id==pid) {
 if(players[i].mychar<players[i].army.length()) {
 players[i].army[players[i].mychar].orders=vals[2];
 if(@(me.gloc)==@(players[i].army[players[i].mychar].gloc)) pool.play_2d("voices/" + vals[2] + "_" + ( (players[i].army[players[i].mychar].male) ? "m.wav" : "f.wav" ), me.x, me.y, players[i].army[players[i].mychar].x, players[i].army[players[i].mychar].y, false);
 // And everyone in earshot, but eh.
 }
 }//Found.
}// Loop for finding player.

}// Giving orders.
else if(head=="offe") {
string[] words=string_split(msg, ", ", true);
if(words.length()>3) {
if(uac.id==string_to_number(words[2])) {
realtimer.pause(); pool.pause_all();
if(amb.playing) amb.pause();
if(confirm("Shogun " + words[3] + " has requested an alliance with you. Do you accept?")) {
host.send_reliable(server_id, "ally, " + words[1] + ", " + words[2] + ", " + myArmy[0].name, 0);
 int pid=string_to_number(words[1]);
 if(myArmy[0].rank==SHOGUN) myArmy[0].rank=DAIMYOU;
for(uint pp=0; pp<players.length(); pp++) {
if(players[pp].id==pid) {
for(uint pa=0; pa<players[pp].army.length(); pa++) {
if((players[pp].army[pa].rank==SHOGUN)||(players[pp].army[pa].name==words[3])) {
 for(uint ma=0; ma<myArmy.length(); ma++) {
@(myArmy[ma].shogun)=players[pp].army[pa];
if(@(myArmy[ma].daimyou)==null) @(myArmy[ma].daimyou)=myArmy[0];
}// Too many loops!
pa=players[pp].army.length();
}// Found, do the submitting.
// Avoid Friendly Fire.
}// Gah!
}// Found.
}// Find the player.
}// Yes.
 if((amb.active)&&(!amb.playing)) amb.play();
pool.resume_all();
 realtimer.resume();
}// You're the intended recipiant.
}
else {
// Bad message. Kick the hacker.
clipboard_copy_text("If you\'re reading this, you received a malformed message from the Sengoku Jidai server, which means someone probably hacked us. Please report at forum.audiogames.net! First 32 chars of Message is: " + string_left(msg, 32));
}
}// Offers.
 else if(head=="ally") {
string[] words=string_split(msg, ", ", true);
if(words.length()>3) {
if(uac.id==string_to_number(words[1])) {
 pool.play_2d("sfx/selected.wav", 0, 0, 0, -order_range, false);
voice.speak("" + words[3] + " has joined you!");
int pid=string_to_number(words[2]);
for(uint pp=0; pp<players.length(); pp++) {
if(players[pp].id==pid) {
for(uint pa=0; pa<players[pp].army.length(); pa++) {
 Char@ them=players[pp].army[pa];
 if(them.rank==SHOGUN) them.rank=DAIMYOU;
 if(@(them.daimyou)!=null) @(them.daimyou)=them.shogun;
 @(them.shogun)=myArmy[0];
}// Player's army.
}// Right player.
}// Players.
}}
else {
// Bad message. Kick the hacker.
clipboard_copy_text("If you\'re reading this, you received a malformed message from the Sengoku Jidai server, which means someone probably hacked us. Please report at forum.audiogames.net! First 32 chars of Message is: " + string_left(msg, 32));
}
}// Alliance confirmed.
 else if(event.channel==1) {
 uac.inbox.insert_last(msg); pool.play_2d("sfx/takeBalance.ogg", me.x, me.y, me.x, me.y, false);
 if(view_all_chat) voice.speak(msg);
if(chatx>=uac.inbox.length()-2)  chatx=uac.inbox.length()-1;
 }// chat.

} // event_receive.
 else {
 if(event.type==event_disconnect) voice.speak("Connection interrupted.");
}// We might have a problem.

 }// Event received.
}// Online mode.
 }// Game.
 }// Step
 timer onlineCounter;
 bool view_all_chat=true;
 int chatx=0;
 void stepChar(Char@ me, double dt, Point@ cam) {
 if(ychar>=-1+1+myArmy.length()) ychar=0;
 if(@(me.gloc)==@(myArmy[ychar].gloc)) for(uint i=0; i<me.sounds.length(); i++) {pool.play_2d(me.sounds[i], cam.x, cam.y, me.x, me.y, false);
// alert("Playing sound", "Playing " + me.sounds[i] + ". Camera is at " + cam.x + ", " + cam.y + ", and the source is " + me.x + ", " + me.y + ". ");
 
 if((@(me.gloc)!=null)&&(me.x>=0)&&(me.x<50)&&(me.y>=0)&&(me.y<50)&&(me.gloc.type=="mountains")&&(me.gloc.map[me.x][me.y]!=courtyard)&&(me.gloc.map[me.x][me.y]!=castle_room)) {
 EchoD echo(me.sounds[i], 25, 25, -12, 0.3);
// echoes.insert_last(echo);
 }// Add Echo.

 // Now, echoes for upcoming walls and boulders.

 // Actually, I think I only want echoes for when you're passing a passageway.
 // Unfortunately this needs to happen even when you're passing a castle from the outside, so we need to do a check at all times.
 // Also, it's in four directions and goes outward. -_-.

 if((me.face!="n")&&(me.face!="s")) {
 // Check to the north:
 for(int yy=me.y-1; (yy>=me.y-5)&&(yy>=0); yy--) {
 if((yy<0)||(yy>49)||(me.x<0)||(me.x>49)) continue;

 if(me.gloc.map[me.x][yy]==boulder) {
 yy=-1; continue;
 }// Obstructed.
 else if(me.gloc.map[me.x][yy]==castle_wall) {
 yy=-1; continue;
 }// Hit a wall, stop.
 else if(((me.gloc.map[me.x][yy]==courtyard)||(me.gloc.map[me.x][yy]==castle_room))&&(me.face!="n")) {
 double len=1;
 int y2=0; y2+=yy;
 while((yy>=0)&&((me.gloc.map[me.x][yy]==courtyard)||(me.gloc.map[me.x][yy]==castle_room))) {yy--; len++;}
 // We know the length of this passageway. Now what?
 EchoD echo(me.sounds[i], me.x, y2, -18, (0.05*len), 100+pool.behind_pitch_decrease+len);
 echoes.insert_last(echo);
 }// Passageway found.
 }// North loop.
 // South.
 if(me.face!="s") for(int yy=me.y+1; (yy<50)&&(yy<=me.y+5); yy++) {
 if((me.x<0)||(me.x>49)||(yy<0)||(yy>49)) continue;
 if(me.gloc.map[me.x][yy]==boulder) {
 yy=50; continue;
 }// Obstructed.
 else if(me.gloc.map[me.x][yy]==castle_wall) {
 yy=50; continue;
 }// Hit a wall, stop.
