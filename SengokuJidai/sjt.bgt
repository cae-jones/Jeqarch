 faces="nesw";
 if(face=="e") {face="w"; path.x--;}
 else if(face=="w") {face="e"; path.x++;}
 else if(face=="n") {face="s"; path.y++;}
 else {face="n"; path.y--;} // We must start out going the opposite direction.
 int tries=0;
 while(size<length) { tries++;
 if(tries>=100) {
 alert("Castle Problem", "We\'re having trouble getting a castle to build correctly. The paths inside the castle need to be a total of " + length + " spaces. After 100 turns, the path is only " + size + " spaces long."); size+=10;
