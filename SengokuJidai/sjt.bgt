 else if((me.gloc.map[me.x][me.y]==tree)&&(random(0, 10)==2)&&(me.gloc.weather!="snow")&&(me.gloc.weather!="storm")) {me.getItem("kudamono");}
 else if((me.gloc.map[me.x][me.y]==water)||(me.gloc.map[me.x][me.y]==deepWater)||(me.gloc.map[absolute(me.x-1)][me.y]==water)||(me.gloc.map[me.x][me.y]==boat)) {
