 if((key_pressed(KEY_LEFT))||(key_pressed(KEY_UP))) mmx--;
 else if((key_pressed(KEY_RIGHT))||(key_pressed(KEY_DOWN))) mmx++;
 else speak3=false;
 if(mmx<0) mmx=missions.length(); else if(mmx>missions.length()) mmx=0;
 if(speak3) {
 pool.play_1d("sfx/select.wav", 0, 0, false);
if(mmx>=missions.length()) voice.speak_interrupt("Return to previous menu.");
 else voice.speak_interrupt(missionDescs[mmx]);
 }// Speak.
 wait(5);
