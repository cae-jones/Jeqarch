 else if((key_pressed(KEY_LEFT))||(key_pressed(KEY_UP))) mx--;
 else if((key_pressed(KEY_RIGHT))||(key_pressed(KEY_DOWN))) mx++;
 else if(key_pressed(KEY_EQUALS)) ips.insert_at(0, input_box("Add IP Address", "Enter an alternate server address:"));
 else if((key_pressed(KEY_RETURN))||(key_pressed(KEY_SPACE))) {
cont=false; speak2=false;
 quest="no quest";
 switch (mx) {
