 case 3 : @p=newPoint(39, 10*(me.y%10)); break;
 }// And meh.
 if(p.x<0) p.x=0; if(p.x>49) p.x=39;
 if(p.y<0) p.y=0; if(p.y>49) p.y=39;
 me.gloc.map[p.x][p.y]=boat;
