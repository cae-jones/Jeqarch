 if( (maru&1)==1) map[i][j].map[here.x][here.y]=castle_room; else map[i][j].map[here.x][here.y]=courtyard;
 openSpaces.insert_last(here);
 }// Path-building.
 size+=next;

 if(face=="e") path.x+=next-1;
 else if(face=="w") path.x-=next-1;
 else if(face=="n") path.y-=next-1;
 else path.y+=next-1;
