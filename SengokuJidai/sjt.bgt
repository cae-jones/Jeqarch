 Char@ newChar(int r) { Char ret(r); return ret;}

 string mapstring(int cn) {
 string ret="";
 switch (cn) {
 case garden : ret="garden"; break;
 case boat : ret="boat"; break;
 case horse : ret="horse"; break;
 case deepWater : ret = "deep" + "wa" + "ter"; break;
 case water : ret = "wat" + "er"; break;
 case fire : ret = "fi" + "re"; break;
 case hole : ret = "ho" + "le"; break;
 case boulder : ret="bould" + "er"; break;
 case house : ret = "hou" + "se"; break;
 case tree : ret = "tr" + "ee"; break;
 case castle_wall : ret = "castle " + "wall"; break;
 case broken_wall : ret = "broken " + "wall"; break;
 case castle_room : ret="castle " + "room"; break;
 case courtyard : ret = "court" + "yard"; break;
 case campsite : ret = "camp" + "site"; break;
 default : ret = "" + cn;
 }
 return ret;
 }

