 else type=2;
 bool found=false;
 for(uint i=0; i<me.gloc.chars.length(); i++) {
 if(@(me.gloc.chars[i])==@me) continue;
 if((absolute(me.x-me.gloc.chars[i].x)>3)||(absolute(me.y-me.gloc.chars[i].y)>3)) continue; // Out of range.

 bool ally =(@(me.gloc.chars[i].shogun)==@(myArmy[0]));

 if((ally)&&( (type&1)==0)) continue;
 else if((!ally)&&(type==1)) continue;
 if((!ally)&&(me.gloc.chars[i].state==attacking)) continue;
 found=true;
 if(confirm("Do you want to give the " + me.inv[menuX] + " to " + me.gloc.chars[i].rankString() + " " + me.gloc.chars[i].name + "?")) {
 if(ally) {
 if(me.inv[menuX]=="ghost lantern") {
 bool spy=false;
 for(uint jj=0; jj<me.gloc.chars[i].weapons.length(); jj++) {if(me.gloc.chars[i].weapons[jj]=="lantern") spy=true; }
 if(!spy) voice.speak_interrupt("" + me.gloc.chars[i].rankString() + " " + me.gloc.chars[i].name + " is not the spy.");
 else {
 sound vic; vic.load("sfx/selected.wav"); vic.pitch=200;
 vic.play_wait();
 voice.speak_interrupt("Aha! You have discovered the traitor in your ranks! " + me.gloc.chars[i].name + " might commit sepuku for " + ((me.gloc.chars[i].male) ? "his" : "her" ) + " failure, but not before a fight to the death!");
 me.gloc.chars[i].hp=20; me.gloc.chars[i].fatigue=0;
 @(me.gloc.chars[i].shogun)=null;
 me.gloc.chars[i].orders="attack"; 
 }// Spy found.
}// Lantern
//}// Ally
 else {
me.gloc.chars[i].getItem(me.inv[menuX]); me.inv.remove_at(menuX);
}// Something normal.
}
 else {
 // First of all, people are less likely to accept things that they already have.
 bool alreadyHas=false;
 for(uint j=0; (j<me.gloc.chars[i].weapons.length())||(j<me.gloc.chars[i].inv.length()); j++) {
 if((j<me.gloc.chars[i].weapons.length())&&(me.inv[menuX]==me.gloc.chars[i].weapons[j])) alreadyHas=true;
 else if((j<me.gloc.chars[i].inv.length())&&(me.gloc.chars[i].inv[j]==me.inv[menuX])) alreadyHas=true;
 if(alreadyHas) j+=9001;
 }

 // Secondly, if they are an opposing shogun or serve an opposing shogun, the best you can hope for is a temporary ceasefire. I mean, to win you have to take out the shogun eventually, but this might convince them not to attack you so you can deal with someone else.
 // (Note that such truces do not prevent the shogun or his soldiers from fighting back if attacked.)

 // A servant of an independent daimyou might relay the gift to the daimyou, but might not.
 if((@(me.gloc.chars[i].daimyou)!=null)||(me.gloc.chars[i].rank==DAIMYOU)) {
 if((me.gloc.chars[i].orders=="attack")||(me.gloc.chars[i].orders=="destroy")) voice.speak_interrupt(me.gloc.chars[i].name + " is not in the mood for negotiating.");
 else {
 int result=random(0, 10);
 bool join=false;
 string daimyou="";
 if(me.gloc.chars[i].rank==DAIMYOU) daimyou=me.gloc.chars[i].name; else daimyou=me.gloc.chars[i].daimyou.name;

 switch (result) {
 case 5 : {join=true; voice.speak_interrupt("Your offer has been accepted.");}; break;
 case 8 :
 case 4 : {
if(me.gloc.chars[i].rank==DAIMYOU) me.gloc.chars[i].orders="attack"; else {me.gloc.chars[i].daimyou.orders="attack"; me.gloc.chars[i].orders="attack";} voice.speak_interrupt("Daimyou " + daimyou + " is insulted by your gift and orders your death!");}; break;
 case 6 : {
 int arrows=random(5, 50);
 if(confirm("Daimyou " + daimyou + " will join you if you can provide " + arrows + " arrows. Will you accept this price?")) {
  int total=0;
 if(me.arrows<arrows) {total+=me.arrows; me.arrows=0;}
 else {me.arrows-=arrows; total=arrows;}

 for(uint j=0; (j<myArmy.length())&&(total<arrows); j++) {
 if(myArmy[j].arrows>arrows-total) {myArmy[j].arrows-=arrows-total; total=arrows;}
 else {total+=myArmy[j].arrows; myArmy[j].arrows=0;}
 }// Looking for additional arrows.
 if(total<arrows) voice.speak_interrupt("You do not have that many arrows in your entire army. Daimyou " + daimyou + " takes what you have, but refuses to join you under such conditions.");
 else join=true;
 me.gloc.chars[i].arrows+=arrows;

 }// Yes.
}; break;

 case 7 : {
 // Request weapons.
 int price=random(5, 15);
 if(confirm("Daimyou " + daimyou + " will join you if you can provide " + price + " new weapons. " + daimyou + " will only accept a weapon if a member of " + daimyou + "\'s forces does not already have it.")) {
 voice.speak_interrupt("Comparing resources. this will probably take a while.");
 int total=0;
 int[] clist; int[] wind;
 int[] rlist;
 // clist stores the indeces of the people who will sacrifice their weapons.
 // wind holds the indeces of the weapons in either inv or weapons. If a value in wind is negative, it refers to myArmy[clist].inv, otherwise, myArmy[clist].weapons.
 // rlist holds the index in me.gloc.chars of the person to receive the weapon.
 Char@ l= (me.gloc.chars[i].rank==DAIMYOU) ? me.gloc.chars[i] : me.gloc.chars[i].daimyou;
 for(uint ii=0; ii<myArmy.length(); ii++) {
 for(uint ik=0; ik<me.gloc.chars.length(); ik++) {
 if((@(me.gloc.chars[ik])!=@l)&&(@(me.gloc.chars[ik].daimyou)!=@l)) continue;
 for(uint j=0; j<myArmy[ii].inv.length(); j++) {
 if(weaponDescriptions.exists(myArmy[ii].inv[j])) {
 bool found=false;
 for(uint w=0; w<me.gloc.chars[ik].weapons.length(); w++) {
 if(me.gloc.chars[ik].weapons[w]==myArmy[ii].inv[j]) {found=true; w+=10;}
}// Does this person have it?
 if(!found) {clist.insert_last(ii); rlist.insert_last(ik); wind.insert_last(-(j+1)); total++;}
}// Ahoy?
}// Start with inv, since we don't want to give up what we're using to fight.
 for(uint j=0; j<myArmy[ii].weapons.length(); j++) {
 bool found=false;
 for(uint w=0; w<me.gloc.chars[ik].weapons.length(); w++) {
 if(me.gloc.chars[ik].weapons[w]==myArmy[ii].weapons[j]) {found=true; w+=10;}
}// Does this person have it?
 if(!found) {clist.insert_last(ii); rlist.insert_last(ik); wind.insert_last(j); total++;}

}// Weapons.
}// Look for someone to receive.
 }// Loop.
 if(total<price) {voice.speak_interrupt("You cannot find enough resources to meet " + daimyou + "\'s request.");
 if(random(1, 10)==4) {
if(me.gloc.chars[i].rank==DAIMYOU) me.gloc.chars[i].orders="attack"; else {me.gloc.chars[i].daimyou.orders="attack"; me.gloc.chars[i].orders="attack";} voice.speak_interrupt("Daimyou " + daimyou + " has realized that you are weakened, desperate, and will initiate bargains that you can\'t keep, and concludes that this makes now the best time to attack!");
