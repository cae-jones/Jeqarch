// This is dumb. 5:05 AM 8/22/2013
// This orders thing is complicated and annoying. Let's fix it.

// Shogun and Daimyou can order around anyone under them. Everyone else can only order around people of the same rank. Ignore rank selection for them.

// Rank selection: 0=everyone, 3=shinobi, 2=samurai, 1 = daimyou, else = civilians.


for(uint i=0; i<myArmy.length(); i++) {
if((@(myArmy[i].gloc)!=@(me.gloc))||(@(myArmy[i])==@myArmy[ychar])) continue;
if((absolute(myArmy[i].x-me.x)>order_range)||(absolute(myArmy[i].y-me.y)>order_range)) continue;

if((menuY==1)&&(myArmy[i].rank!=DAIMYOU)) continue;
else if((menuY==2)&&(myArmy[i].rank!=SAMURAI)&&(myArmy[i].rank!=RONAN)) continue;
 else if((menuY==3)&&(myArmy[i].rank!=SHINOBI)) continue;
 else if((menuY==4)&&(myArmy[i].rank!=CIVIL)) continue;
 else if((me.rank!=SHOGUN)&&(me.rank!=DAIMYOU)&&(myArmy[i].rank!=me.rank)) continue;
 else if((me.rank==DAIMYOU)&&(@(myArmy[i].daimyou)!=@me)) continue;
 else if((me.rank!=SHOGUN)&&(me.rank!=DAIMYOU)&&(@(myArmy[i].daimyou)!=@(me.daimyou))) continue;
obeys++; myArmy[i].orders=commands[menuX];
// THERE! THAT'S IT! GAH!

 if(commands[menuX]=="return") @(me.gloc.chars[i].destination)=@(me.gloc.chars[i].base);
 else if(commands[menuX]=="scout") {
 // Move this character to another district.
@(me.gloc.chars[i].gloc)=map[random(0, map.length()-1)][random(0, map[0].length()-1)];
 string[] quests={
"A powerful shogun is surrounding your district with a large army, including many mounted warriors!",
"A nearby district faces famine. There are skilled workers there that have been selling their crafts to the local ruler for food. If you can feed the people and get them on your side, you can overthrow that ruler and claim what he has hoarded for yourself.",
"There is a daimyou nearby whose heir is looking for marriage. This daimyou\'s clan holds some guarded secrets, so it would be good to claim this marriage for your clan. Find Heian-style paper fans, and wave them in the house of the heir to make your proposal.",
 "A rival clan has been secretly conducting trade with foreigners, and has amassed a large supply of weapons in a large castle in a nearby district. You must take this castle and its resources for your clan!",
"Pirates have captured the children of important samurai in your army. You must rescue them quickly, not only to keep them alive, but so that news does not spread; your parents may well feel dishonored enough to commit suicide if it seems their line has failed!",
"An enemy daimyou has hired a shinobi clan to train more shinobi for them. If you can find the camps of this clan, you can confiscate their weapons and writings.",
"An enemy daimyou has hired a spy, disguised as a member of your army! Your scouts have managed to copy the sigil of the daimyou\'s lanterns, so that when you find the spy, you can give them the lantern to force them to reveal themselves."
};
 quest=quests[random(0, quests.length()-1)];
 voice.speak_interrupt("Your scouts have sent a message back to you. Press q to hear what it is.");
}// Scouting.
 }// Yeah.
