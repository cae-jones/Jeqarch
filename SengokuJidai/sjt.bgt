// Be less likely to leave houses, especially if the weather is bad or if someone is nearby.
 bool domove=true;
 if((me.x>=0)&&(me.x<50)&&(me.y>=0)&&(me.y<0)&&(me.gloc.map[me.x][me.y]==house)) {

 if((me.gloc.weather=="rain")||(me.gloc.weather=="storm")||(me.gloc.weather=="snow")) domove=false;

 if((me.fatigue>random(30, 50))&&(me.food>random(40, 80))) domove=false;
// else if((me.gloc.weather=="rain")||(me.gloc.weather=="storm")||(me.gloc.weather=="snow")) domove=false;
 else {
 // Check allies first.
 uint peoplehere=0;
 uint opshere=0; // o.o.
 for(uint i=0; i<allies.length(); i++) {
 if((absolute(allies[i].x-me.x)<=1)&&(absolute(allies[i].y-me.y)<=1)) {peoplehere++; if(allies[i].male!=me.male) opshere++;}
 }// Allies.
 if(peoplehere>0) domove=false; //?
 if(domove) for(uint i=0; i<enemies.length(); i++) {
 if((absolute(enemies[i].x-me.x)<=1)&&(absolute(enemies[i].y-me.y)<=1)) {peoplehere++; if(enemies[i].male!=me.male) opshere++;}
 }// Check enemies as a last resort.
 if(peoplehere>0) {domove=false;
 if((peoplehere<=8)&&(opshere>0)&&(me.fatigue<random(10, 35))&&(me.food>=40)&&(random(0, 12)==8)) {
 Char@ partner; @partner=null;
 for(uint i=0; i<allies.length(); i++) {
 if((absolute(allies[i].x-me.x)<=1)&&(absolute(allies[i].y-me.y)<=1)&&(allies[i].male!=me.male)&&(allies[i].fatigue<random(25, 40))&&(allies[i].food>=40)&&(random(0, 10)>=7)) {
 if(@(allies[i])==@(myArmy[ychar])) {
 if(confirm("" + me.rankString() + " " + me.name + " is quite interested in " + myArmy[ychar].rankString() + " " + myArmy[ychar].name + ". Do you return the sentiment?")) @partner=myArmy[ychar];
 else {domove=true; me.orders="food";} // So we don't get spammed with it.
}
 else @partner=allies[i];
 }// Maybe.
}// Ask allies.
 if(@partner==null) for(uint i=0; i<enemies.length(); i++) {
 if((absolute(enemies[i].x-me.x)<=1)&&(absolute(enemies[i].y-me.y)<=1)&&(enemies[i].fatigue<random(25, 40))&&(enemies[i].food>=35)&&(random(0, 10)>=8)&&(@(me.shogun)==@(enemies[i].shogun))) {
 if(@(enemies[i])==@(myArmy[ychar])) {
 if(confirm("" + me.rankString() + " " + me.name + " is quite interested in " + myArmy[ychar].rankString() + " " + myArmy[ychar].name + ". Do you return the sentiment?")) @partner=myArmy[ychar];
 else {domove=true; me.orders="food";} // So we don't get spammed with it.
}
 else @partner=enemies[i];
 }// Hm.
 }// Ask enemies.

 if(@partner!=null) {
 me.fatigue+=random(50, 100);
 partner.fatigue+=random(50, 100);
 me.food-=random(15, 50);
 partner.food-=random(15, 50);
 me.state=recovering; me.counter=random(1, 10);
 partner.state=recovering; partner.counter=random(1, 10);
 Char@ mother; Char@ father;
 if(me.male) @father=me; else @mother=me;
 if(partner.male) @father=partner; else @mother=partner;
 if(@father==null) {
 if(me.male) @father=me; else @father=partner;
 }// What?
 if(@mother==null) {
 if(!(me.male)) @mother=me; else @mother=partner;
}// Make sure there are no nulls.
 int children=random(1, 3);
for(uint ch=0; ch<children; ch++) {
 Char@ child;
 @child=newChar(father.rank);
 mother.gloc.add(child); @(child.gloc)=@(mother.gloc);
 child.x=mother.x; child.y=mother.y;
 child.state=recovering; child.counter=random(1, 30);
 @(child.shogun)=mother.shogun;
 @(child.daimyou)=mother.daimyou;
 if(@(child.shogun)==null) @(child.shogun)=father.shogun;
 if(@(child.daimyou)==null) @(child.daimyou)=father.daimyou;
 child.getItem("kudamono"); // Because milk.

 if(@(child.shogun)==@(myArmy[0])) {
 sound snd; snd.load("voice/die_f.wav"); snd.pitch=200; snd.pan=random(-10, 10); snd.volume=random(-10, 0);
 snd.play();
 wait(500);
 string gen="girl"; if(child.male) gen="boy";
 voice.speak_interrupt_wait("" + mother.rankString() + " " + mother.name + " has given birth to a " + gen + ", " + child.name + ", who will grow up to become a " + child.rankString() + ".");
 myArmy.insert_last(child);
 }// Joins your army.
 else if(@(child.gloc)==@(myArmy[ychar].gloc)) pool.play_extended_2d("voices/die_f.wav", myArmy[ychar].x, myArmy[ychar].y, child.x, child.y, 0, 0, 0, 0, false, 0, 0, 0, 200);
 child.sounds.insert_last("sfx/splatter1.ogg");
} }// Reproduction.
 }// H..m...
}// Check for... stuff... to do... while people are in houses...
 }// Find someone to hang out with.
 }// Look for reasons not to move from a house. 
 if(domove) {
 // Look for possible destinations nearby, which include... basically anything that isn't a clear space or deep water.
 string weather=me.gloc.weather;
 for(int mxx=-order_range; mxx<=order_range; mxx++) {for(int myy=-order_range; myy<=order_range; myy++) {
 if((mxx+me.x<0)||(mxx+me.x>=50)||(myy+me.y<0)||(myy+me.y>=50)) continue;
 int cn=me.gloc.map[mxx+me.x][myy+me.y];
 bool gothere=false;
 // Also, check for people to talk to.
 // If the weather is bad, priority goes to finding houses, or castles if this character is aligned.
 if((cn==house)&&((me.fatigue>random(10, 35))||(random(0, 8)==2)||(weather=="rain")||(weather=="storm")||(weather=="snow"))) gothere=true;
 else if((cn==garden)&&(random(0, 5)==2)) gothere=true;
 else if((cn==water)||(cn==boat)) {
 // Only go to water if you have a net.
 for(uint mii=0; mii<me.inv.length(); mii++) {if(me.inv[mii]=="net") gothere=true;}
 }// Go fishin'.
else if((cn==tree)&&(random(0, 10)==2)) gothere=true;

 if(gothere) {
 Point ppp(me.x+mxx, me.y+myy);
 @(me.destination)=ppp;
 mxx=order_range+1; myy=order_range+1;
}// Destination found.
}}// Looking for a destination.

}// Meep?
}// Wandering around.
 // If in range of people to talk to, and there's nothing better to do, try to talk to them.
 // Be careful that you don't interrupt someone who is already speaking.
 if(((me.state==standing)||(round(me.counter, 2)==0))&&(talkTimer.elapsed>500)) {
talkTimer.restart(); talkTimer.resume();
 for(uint i=0; i<me.gloc.chars.length(); i++) {
 if(@(me.gloc.chars[i])==@me) continue;
 if((absolute(me.gloc.chars[i].x-me.x)<=order_range)&&(absolute(me.gloc.chars[i].y-me.y)<=order_range)) {
 if(((me.face=="e")&&(me.gloc.chars[i].x>=me.x)&&(absolute(me.gloc.chars[i].y-me.y)<2))||
 ((me.face=="ne")&&(me.gloc.chars[i].x>=me.x)&&(me.gloc.chars[i].y<=me.y))||
 ((me.face=="n")&&(me.gloc.chars[i].y<=me.y)&&(absolute(me.gloc.chars[i].x-me.x)<2))||
 ((me.face=="w")&&(me.gloc.chars[i].x<=me.x)&&(absolute(me.gloc.chars[i].y-me.y)<2))||
 ((me.face=="nw")&&(me.gloc.chars[i].x<=me.x)&&(me.gloc.chars[i].y<=me.y))||
 ((me.face=="sw")&&(me.gloc.chars[i].x<=me.x)&&(me.gloc.chars[i].y>=me.y))||
 ((me.face=="s")&&(me.gloc.chars[i].y>=me.y)&&(absolute(me.gloc.chars[i].x-me.x)<2))||
 ((me.face=="se")&&(me.gloc.chars[i].x>=me.x)&&(me.gloc.chars[i].y>=me.y))
) {
me.setState(greeting);

 // Have the target react accordingly.
 i=me.gloc.chars.length();
 }

}// In range.
 }// Do we talk to someone?

}// Look for talkings.

 }// Civilians or Shinobi in disguise will wander around and maybe try to talk to people.
 }// Most common, so put it at the top.
 else if(me.orders=="follow") {
 if((@(me.daimyou)!=null)&&((absolute(me.x-me.daimyou.x)>3)||(absolute(me.y-me.daimyou.y)>3))) {
 // Catch district switching.
 Point p(me.daimyou.x+random(-3, 3), me.daimyou.y+random(-3, 3));
 if(@(me.gloc)!=@(me.daimyou.gloc)) {
 Point meg(0, 0);
 Point leg(0, 0);
 for(uint ax=0; ax<map.length(); ax++) {for(uint ay=0; ay<map[ax].length(); ay++) {
 if(@(map[ax][ay])==@(me.gloc)) {meg.x=ax; meg.y=ay;}
 else if(@(map[ax][ay])==@(me.daimyou.gloc)) {leg.x=ax; leg.y=ay;}
 }}// Loop.
 if(leg.x<meg.x) p.x=-2;
 else if(leg.x>meg.x) p.x=51;
 if(leg.y<meg.y) p.y=-2;
 else if(leg.y>meg.y) p.y=51;
 }// Find where the daimyou is, and make your way there.
 @(me.destination)=p;
 }
 else if((@(me.shogun)!=null)&&((absolute(me.x-me.shogun.x)>3)||(absolute(me.y-me.shogun.y)>3))) {
 Point p(me.shogun.x+random(-3, 3), me.shogun.y+random(-3, 3));

 if(@(me.gloc)!=@(me.shogun.gloc)) {
 Point meg(0, 0);
 Point leg(0, 0);
 for(uint ax=0; ax<map.length(); ax++) {for(uint ay=0; ay<map[ax].length(); ay++) {
 if(@(map[ax][ay])==@(me.gloc)) {meg.x=ax; meg.y=ay;}
 else if(@(map[ax][ay])==@(me.shogun.gloc)) {leg.x=ax; leg.y=ay;}
 }}// Loop.
 if(leg.x<meg.x) p.x=-2;
 else if(leg.x>meg.x) p.x=51;
 if(leg.y<meg.y) p.y=-2;
 else if(leg.y>meg.y) p.y=51;
 }// Find where the shogun is, and make your way there.
 @(me.destination)=p;
 }// Following a shogun.
 }// Follow the leader...
 else if(me.orders=="destroy") {
 // Oy, this is complicated.
 // First of all, we need to find an acceptable target. Priority goes to enemy castles.
 // However, even once we've found a castle to destroy, we need to be sure it isn't our own.
 // Unfortunately, we also need to be sure it isn't under the control of an ally.
 // That is not a quick task, so we want to do it as rarely as possible.

 // So, first, let's see if we need to. The easiest way to do that is to see if we have a candidate destination set, or if we are already in range of a suitable target.

 /*
 bool search=false;
 if(@(me.destination)==null) {

 }// No destination, are we in range of something to break?
 else {
 if((me.destination.x<0)||(me.destination.y>49)||(me.destination.y<0)||(me.destination.y>49)) search=true;
 else if((@(me.base)!=null)&&( (me.base.x)%10==me.destination.x%10)&&(me.base.y%10==me.destination.y%10)) search=true; // Do not destroy your own base! Even though destroying your own campsite doesn't seem like a bad move, sometimes.
 else {
 int cur=me.gloc.map[me.destination.x][me.destination.y];
 if((cur==campsite)||(cur==castle_wall)||(cur==broken_wall)||(cur==courtyard)||(cur==castle_room)) {

 }// Yes, but make sure it isn't close to our base.
 else if(cur==house) {

 }// Houses are acceptable targets _if_ you can find villagers nearby that serve an enemy leader. I'm not sure I want to run this check as often as I would need to, though.
 else search=true;
 }// Is it a viable structure for destruction?
 }// Is this destination a suitable target?
*/

 if(@(me.destination)!=null) {
 // We really need to make sure we aren't looking at a poor choice of target. But anyway...
 if((me.destination.x<0)||(me.destination.x>49)||(me.destination.y<0)||(me.destination.y>49)) {@(me.destination)=null;}
 else if(me.gloc.map[me.destination.x][me.destination.y]==fire) @(me.destination)=null; // Already destroyed.
 else if((@(me.base)!=null)&&(me.destination.x%10==me.base.x%10)&&(me.destination.y%10==me.base.y%10)) @(me.destination)=null;
 else {
 // If you're in the same 10x10 region as the destination, and you're not a shinobi, and you have a kanabo, start smashing things.
 // Assuming of course that your target is vulnerable to kanabo strikes.
 if((absolute(me.x-me.destination.x)<10)&&(absolute(me.y-me.destination.y)<10)) {
 if(me.rank==SHINOBI) {
 // First, hide or climb if possible.
 if((me.x>=0)&&(me.x<50)&&(me.y>=0)&&(me.y<50)) {
 int cur=me.gloc.map[me.x][me.y];
 if((cur==tree)||(cur==hole)||(cur==water)||(cur==deepWater)||(cur==garden)||(cur==house)) me.hiding=true;
 }// On the map.

 // Now, if you're close enough to set things on fire, set things on fire.
 if((absolute(me.x-me.destination.x)<2)&&(absolute(me.y-me.destination.y)<2)) {
 me.gloc.map[me.destination.x][me.destination.y]=fire;
 me.sounds.insert_last("sfx/bp_ignite_01.wav");
 me.orders="return";
 @(me.destination)=null;
 }// Might expand that if it's too difficult.
 }// Shinobi approach this in their own way that differs entirely from everyone else.
 else {
 // If you have a kanabo, it's your weapon of choice. Unless you're in the middle of a fight already.
 if((me.state!=attacking)&&(me.state!=preparing)) {
 for(uint ww=0; ww<me.weapons.length(); ww++) {
 if(me.weapons[ww]=="kanabo") me.weapon=ww;
}
 }// Find a kanabo and equip it.

 // Now, see if there is a breakable wall anywhere near in range.
 // Or... umm... don't. Heh.
 if((random(0, 5)>3)&&(me.state!=walking)) {me.setState(preparing); me.charged=random(difficulty, 10)*0.1;} // Hulk smash?
 }// The less sneaky method of destruction.
 }// Close enough to start caring.
 }// Viable target. Maybe.

 }

 }// Destroy things.
 else if(me.orders=="food") {
 // Look for the closest food sources.
 int[] sources={garden, tree};
 int foods=0;
 for(uint it=0; it<me.inv.length(); it++) {
if((sources.length()<=3)&&(me.inv[it]=="net")) {
//it=9999;
 sources.insert_last(water); sources.insert_last(deepWater); sources.insert_last(boat);
}// net
 else if((me.inv[it]=="yasai")||(me.inv[it]=="sushi")||(me.inv[it]=="kudamono")) foods++;
}// loop.

 for(int xx=me.x-10; xx<me.x+10; xx++) {
 if((xx<0)||(xx>49)) continue;
 for(int yy=me.y-10; yy<me.y+10; yy++) {
 if((yy<0)||(yy>49)) continue;
 if((@(me.destination)==null)||((absolute(me.destination.x-me.x)>=absolute(xx-me.x))&&(absolute(me.destination.y-me.y)>=absolute(me.y-yy)))) {
 for(uint ix=0; ix<sources.length(); ix++) {if(me.gloc.map[xx][yy]==sources[ix]) {Point p(xx, yy); @(me.destination)=p;}}
 }// Go for the closest.
 }// Y loop.
 }// x loop?

 // Except you should return to base and distribute the food to allies when you have enough.
 if(foods>=random(3, 10)) {
 me.orders="none";
 if((@(me.shogun)==@(myArmy[0]))&&(@(me.gloc)==@(myArmy[ychar].gloc))) pool.play_extended_2d("sfx/beacon.wav", myArmy[ychar].x, myArmy[ychar].y, me.x, me.y, 0, 0, 0, 0, false, 0, 0, 0, 250);
 if((@(me.base)!=null)&&((random(0, 7)==me.rank)||((me.rank==SAMURAI)&&(random(0, 5)<3))||((me.rank==SHINOBI)&&(random(0, 5)>3)) )) @(me.destination)=me.base;

 }// Plenty of food.
 }// Looking for food.
//} // 1:31 PM 8/31/2012. I think this was here because the loop for a net was not closed properly. No wonder there was so much lag!
 else if(me.orders=="steal") {
 for(uint en=0; en<enemies.length(); en++) {
 // Check to see if we're close enough...
 if((absolute(me.x-enemies[en].x)<2)&&(absolute(me.y-enemies[en].y)<2)) {
 // Make sure they're not facing us.
 bool can=false;
 if((me.hiding)||(me.climbing)) can=true;
 else if((me.x<enemies[en].x)&&(string_contains(enemies[en].face, "w", 1)<0)) can=true;
 else if((me.x>enemies[en].x)&&(string_contains(enemies[en].face, "e", 1)<0)) can=true;
 else if((me.y<enemies[en].y)&&(string_contains(enemies[en].face, "n", 1)<0)) can=true;
 else if(string_contains(enemies[en].face, "s", 1)<0) can=true;

 if((can)&&(me.state!=preparing)&&(me.state!=attacking)) {
 // Success depends on your rank.
 int stealth=random(0, 10);
 if(((me.rank==SHINOBI)&&(stealth>0))||((me.rank==CIVIL)&&(stealth>4))||(stealth>7)) {
 if(enemies[en].arrows>me.arrows) { int tosteal=random(0, enemies[en].arrows); me.arrows+=tosteal; enemies[en].arrows-=tosteal;}
 else if(enemies[en].inv.length()>0) {
 int tosteal=random(0, enemies[en].inv.length()-1);
 me.inv.insert_last(enemies[en].inv[tosteal]); enemies[en].inv.remove_at(tosteal);
 }
 else if(enemies[en].weapons.length()>0) {
 int tosteal=random(0, enemies[en].weapons.length()-1);
 me.getItem(enemies[en].weapons[tosteal]); enemies[en].weapons.remove_at(tosteal); // Gasp!
 }// Steal weapons.
 else {@(me.target)=null; @(me.destination)=me.base;}
 if(@(me.destination)!=(@me.base)) {me.state=recovering; me.counter=0.3;}
 }// Success.
 else {
 @(enemies[en].target)=me;
 sound alarm; alarm.load("sfx/beacon.wav");
 alarm.play();
 while((alarm.playing)&&(alarm.pitch<300)) {alarm.pitch=alarm.pitch+15; wait(5);}
 }// Failure.
 }// Steal something.
 }
 }// Enemies loop.
 }
 else if((me.orders=="camp")||(me.orders=="house")||(me.orders=="castle")||(me.orders=="boat")) {
 // Well, in either case, we need to find trees, right?
 if(@(me.destination)==null) {
 bool found=false;
 bool castling=(me.orders=="castle");
  int xx=me.x; int yy=me.y;
 if((me.gloc.map[me.x][me.y]==tree)||((castling)&&(me.gloc.map[me.x][me.y]==boulder))) found=true;
 else if(me.x>0) {
 if(me.gloc.map[me.x-1][me.y]==tree) {found=true; xx=me.x-1;}
  else if((castling)&&(me.gloc.map[me.x-1][me.y]==boulder)) {found=true; xx=me.x-1;}
 else if((me.y>0)&&((me.gloc.map[me.x-1][me.y-1]==tree)||((castling)&&(me.gloc.map[me.x-1][me.y-1]==boulder)))) {found=true; xx=me.x-1; yy=me.y-1;}
 else if((me.y<49)&&((me.gloc.map[me.x-1][me.y+1]==tree)||((castling)&&(me.gloc.map[me.x-1][me.y+1]==boulder)))) {found=true; xx=me.x-1; yy=me.y+1;}
}// West.
 if((!found)&&(me.x<49)) {
 if((me.gloc.map[me.x+1][me.y]==tree)||((castling)&&(me.gloc.map[me.x+1][me.y]==boulder))) {found=true; xx=me.x+1; yy=me.y;}
  else if((me.y>0)&&((me.gloc.map[me.x+1][me.y-1]==tree)||((castling)&&(me.gloc.map[me.x+1][me.y-1]==boulder)))) { found=true; xx=me.x+1; yy=me.y-1;}
 else if((me.y<49)&&((me.gloc.map[me.x+1][me.y+1]==tree)||((castling)&&(me.gloc.map[me.x+1][me.y+1]==boulder)))) {found=true; xx=me.x+1; yy=me.y+1;}
 }// east.
 if((!found)&&(me.y>0)&&((me.gloc.map[me.x][me.y-1]==tree)||((castling)&&(me.gloc.map[me.x][me.y-1]==boulder)))) {found=true; yy=me.y-1;}
 else if((!found)&&(me.y<49)&&((me.gloc.map[me.x][me.y+1]==tree)||((castling)&&(me.gloc.map[me.x][me.y+1]==boulder)))) {found=true; yy=me.y+1;}

 if(found) {
 if(me.orders=="house") {
 me.gloc.map[xx][yy]=house; me.fatigue+=50+random(0, 50); me.state=recovering; me.counter=random(1, 10);
 string xstring="" + xx; if(xx<26) xstring=coords[xx];
 if(@(me.gloc)==@(myArmy[ychar].gloc)) pool.play_2d("sfx/build_long_01.wav", myArmy[ychar].x, myArmy[ychar].y, xx, yy, false);
 if(@(me.shogun)==@(myArmy[0])) voice.speak(me.rankString() + " " + me.name + " has built a house at " + xstring + ", " + yy + ". ");
 me.orders="none";
}// house
 else if(me.orders=="boat") {
 bool speak=(@(me.shogun)==@(myArmy[0])); if(!speak) speak=(@me==@(myArmy[0]));
 me.gloc.map[xx][yy]=clear;  me.fatigue+=50+random(0, 50); me.state=recovering; me.counter=random(1, 10);
 if(@(me.gloc)==@(myArmy[ychar].gloc)) pool.play_2d("sfx/build_long_01.wav", myArmy[ychar].x, myArmy[ychar].y, xx, yy, false);
 if((me.fatigue>80)&&(random(0, 10)<me.counter)) me.orders="none";
 // find ocean regions and add boats there.
 for(uint x2=0; x2<map.length(); x2++) {for(uint y2=0; y2<map[x2].length(); y2++) {
 int boats=0;
 if(@(me.gloc)==@(map[x2][y2])) {
 int bx=me.x; int by=me.y;
  if(x2>0) {
 if(map[x2-1][y2].type=="ocean") {
 boats++;
 if(map[x2-1][y2].map[49][me.y]==deepWater) {map[x2-1][y2].map[49][me.y]=boat; bx=49; by=me.y;
if(speak) voice.speak("A new boat has been built, and waits at " + bx + ", " + by + " in district " + coords[x2-1] + " " + y2 + ". ");
 }// Easy spot.
 else {
 for(int y3=0; y3<49; y3++) {
 if(map[x2-1][y2].map[49][y3]==deepWater) {map[x2-1][y2].map[49][y3]=boat;
 if(speak) voice.speak("A new boat has been built, and waits at 49, " + y3 + " in district " + coords[x2-1] + " " + y2 + ". "); boats++; y3=50;
}} }// Track down a spot on the coast.
 }// Add boat.

 }// West.
 uint chl=0; chl+=map.length();
  if(x2<chl) {
 if((x2+1<chl)&&(map[x2+1][y2].type=="ocean")) {
 boats++;
 if(map[x2+1][y2].map[0][me.y]==deepWater) {map[x2+1][y2].map[0][me.y]=boat; bx=0; by=me.y;
if(speak) voice.speak("A new boat has been built, and waits at A, " + by + " in district " + (((x2>0)&&(x2<coords.length())) ? coords[x2-1] : ("" + x2) ) + " " + y2 + ". ");
 }// Easy spot.
 else {
 for(int y3=0; y3<49; y3++) {
 if((x2+1>map.length())||(y2>=map[x2+1].length())||(y3>49)||(y3<0)) continue;
 if(map[x2+1][y2].map[0][y3]==deepWater) {map[x2+1][y2].map[0][y3]=boat;
 if(speak) voice.speak("A new boat has been built, and waits at A, " + y3 + " in district " + (((x2>0)&&(x2<coords.length())) ? coords[x2-1] : ("" + x2) ) + " " + y2 + ". "); boats++; y3=50;
}} }// Track down a spot on the coast.
 }// Add boat.

 }// East.

  if(y2>0) {
 if(map[x2][y2-1].type=="ocean") {
 boats++;
 if(map[x2][y2-1].map[me.x][49]==deepWater) {map[x2][y2-1].map[me.x][49]=boat; by=49; bx=me.x;
if(speak) voice.speak("A new boat has been built, and waits at " + ((bx<coords.length()) ? coords[bx] : ("" + bx) ) + ", " + by + " in district " + coords[x2] + " " + (y2-1) + ". ");
 }// Easy spot.
 else {
 for(int y3=0; y3<49; y3++) {
 if(map[x2][y2-1].map[y3][49]==deepWater) {map[x2][y2-1].map[y3][49]=boat;
 if(speak) voice.speak("A new boat has been built, and waits at " + y3 + ", 49, in district " + coords[x2] + " " + (y2-1) + ". "); boats++; y3=50;
}} }// Track down a spot on the coast.
 }// Add boat.

 }// North.
 chl=0; chl+=map[x2].length();

  if(y2<chl) {
 if((y2<chl-1)&&(map[x2][y2+1].type=="ocean")) {
 boats++;
 if(map[x2][y2+1].map[me.x][0]==deepWater) {map[x2][y2+1].map[me.x][0]=boat; by=0; bx=me.x;
if(speak) voice.speak("A new boat has been built, and waits at " + bx + ", " + by + " in district " + coords[x2] + " " + (y2+1) + ". ");
 }// Easy spot.
 else {
 for(int y3=0; y3<49; y3++) {
 if(map[x2][y2+1].map[y3][0]==deepWater) {map[x2][y2+1].map[y3][0]=boat;
 if(speak) voice.speak("A new boat has been built, and waits at " + y3 + ", 49, in district " + coords[x2] + " " + (y2+1) + ". "); boats++; y3=50;
}} }// Track down a spot on the coast.
 }// Add boat.

 }// South.

 }// Found.
 }}// Ocean search.
 }// More complicated. Boats.
 else if(castling) {
 if(me.state!=9999) {
 // Ok.
 // First, the position of the base is important.
 // So, if you want to direct the construction, change the location of the base as construction is occurring.
 // Anyway, we need to focus on walls, and then paths. Or something.

 // Ick, ok.
 // When we find building materials,
 // We convert that space into a room.
 me.gloc.map[me.x][me.y]=castle_room;
 // At least two of the surrounding spaces become walls, if possible.
 int wallsbuilt=0; // Must be less than 7, otherwise we're trapped.
 for(int cax=me.x-1; cax<=me.x+1; cax++) {for(int cay=me.y-1; cay<=me.y+1; cay++) {
 if((cax<0)||(cax>49)||(cay<0)||(cay>49)||(me.gloc.map[cax][cay]==tree)||(me.gloc.map[cax][cay]==boulder)) continue;
 bool saveit=false;
 switch(me.gloc.map[cax][cay]) {
 case water : 
 case garden : saveit=true; break;
 case hole :
 case broken_wall : {me.gloc.map[cax][cay]=courtyard; saveit=true;}; break;
 }// Check for things to get special treatment.
 if(saveit) continue;

 // If there are people inside the target space, they become rooms; otherwise, they become walls.
 for(uint ii=0; ii<allies.length(); ii++) {
 if((allies[ii].x==cax)&&(allies[ii].y==cay)) {saveit=true; me.gloc.map[cax][cay]=castle_room;}
 }
 if(((cax==me.x)&&(cay==me.y))||(wallsbuilt>6)) me.gloc.map[cax][cay]=castle_room;
 else {me.gloc.map[cax][cay]=castle_wall; wallsbuilt++;}
}}// Loop for castle building.
 me.sounds.insert_last("sfx/pipeblock" + random(1, 2) + ".ogg");
 me.sounds.insert_last("sfx/build_long_01.wav");
 me.fatigue+=random(10, 30);
 me.food-=random(5, 15);
 me.state=recovering; me.counter=random(5, 20);
 if(@(me.shogun)==@(myArmy[0])) {string xstring="" + me.x; if(me.x<26) xstring=coords[me.x]; voice.speak(me.rankString() + " " + me.name + " has built " + wallsbuilt + " new walls for a castle around " + xstring + ", " + me.y + ". ");}
}// Just to avoid doing it too quickly
