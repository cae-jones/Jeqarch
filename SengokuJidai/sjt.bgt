 void cutscene(string[] lines) {
 voice.speak_interrupt("Press down arrow for story.");
 int mx=lines.length()-1;
 bool cont=true;
 wait(250);

 while(cont) {
 if((key_down(KEY_LCONTROL))||(key_down(KEY_RCONTROL))) voice.stop();
 if((key_down(KEY_LMENU))&&(key_down(KEY_F4))) exit();
 if(key_pressed(KEY_DOWN)) {
mx++;
 if(mx>=lines.length()) mx=0;
 voice.speak_interrupt(lines[mx]);
 }
 else if(key_pressed(KEY_ESCAPE)) cont=false;
 

wait(5);
}// Loop
}// Cutscene.
 void debug_map(Map@ gloc) {
 int mx=0; int my=0;
 Point@ mark=newPoint(0, 0);
 voice.speak_interrupt("Debugging map. Press enter to increment the value of a tyle, or backspace to decrement it. Press escape when done.");

 while(!key_pressed(KEY_ESCAPE)) {
 if((key_down(KEY_LCONTROL))||(key_down(KEY_RCONTROL))) {voice.stop();
 if(key_pressed(KEY_S)) {
 saveGame(input_box("Save as", "Enter map name and press enter"));
 }// Save map... as something special.
 else if(key_pressed(KEY_L)) {
 string inp=input_box("Load map", "Enter map to load");
 if(inp!="") loadGame(-1, inp);
 @gloc=map[0][0];
 }
 else if(key_pressed(KEY_C)) {
 mx=string_to_number(input_box("Coordinates", "Enter x"));
 my=string_to_number(input_box("Coordinates", "Enter y"));
 }// Move to specified coordinates.
 else if(key_pressed(KEY_D)) {
 int dx=string_to_number(input_box("Coordinates", "Enter x"));
 int dy=string_to_number(input_box("Coordinates", "Enter y"));
 if((dx>=0)&&(dx<map.length())&&(dy>=0)&&(dy<map[dx].length())) @gloc=map[dx][dy];
 }// District switch.
 else if(key_pressed(KEY_HOME)) my=0;
 else if(key_pressed(KEY_END)) my=49;
}

 bool speakme=true;
 if(key_pressed(KEY_LEFT)) mx--;
 else if(key_pressed(KEY_RIGHT)) mx++;
 else if(key_pressed(KEY_UP)) my--;
 else if(key_pressed(KEY_DOWN)) my++;
 else if(key_pressed(KEY_HOME)) mx=0;
 else if(key_pressed(KEY_END)) mx=49;
 else if(key_pressed(KEY_RETURN)) gloc.map[mx][my]++;
 else if(key_pressed(KEY_BACK)) gloc.map[mx][my]--;
 else if(key_pressed(KEY_EQUALS)) {voice.speak_interrupt("Enter region type. Valid values are mountain, ocean, or planes."); gloc.type=input_box("Enter region type", "Enter type:");}
 else if(key_pressed(KEY_C)) voice.speak_interrupt_wait("Selecting " + mx + ", " + my + ".");
 else if(key_pressed(KEY_M)) {
 if((key_down(KEY_LSHIFT))||(key_down(KEY_RSHIFT))) {mx=mark.x; my=mark.y; speakme=true;}
 else @mark=newPoint(mx, my);
 }// Mark.
 else {

speakme=false;
 int targ=-1;
 int num=number_pressed();
 if(key_pressed(KEY_A)) num=10;
 else if(key_pressed(KEY_B)) num=11;
 else if(key_pressed(KEY_C)) num=12;
 else if(key_pressed(KEY_D)) num=13;
 else if(key_pressed(KEY_E)) num=14;
 else if(key_pressed(KEY_F)) num=15;
 else if(key_pressed(KEY_G)) num=16;
 else if(key_pressed(KEY_H)) num=17;
 else if(key_pressed(KEY_I)) { string itm=input_box("Add item", "Enter item name and press enter to add, or escape to cancel."); if(itm=="") voice.speak_interrupt("Canceled"); else gloc.addItem(itm, newPoint(mx, my));}
 else speakme=false;
 if(num>=0) {
 int x1=mx; int x2=mark.x; int y1=my; int y2=mark.y;
 if(x2<x1) {x1=x2; x2=mx;}
 if(y2<y1) {y1=y2; y2=my;}
 for(uint xx=x1; xx<=x2; xx++) {
 for(uint yy=y1; yy<=y2; yy++) {
 gloc.map[xx][yy]=num;
 
 }}// Meh.

 }// Box.
}// Meh.
 if(mx<0) mx=0; else if(mx>=gloc.map.length()) mx--;
 if(my<0) my=0; else if(my>=gloc.map[mx].length()) my--;
 if(speakme) {voice.speak_interrupt(mapstring(gloc.map[mx][my]));
 string toplay="sfx/grassland1.wav";
 switch (gloc.map[mx][my]) {
 case clear : toplay=(gloc.type=="planes") ? "sfx/grassland1.wav" : (gloc.type=="ocean") ? "sfx/pikkonland.wav" : "sfx/dirtland3.wav"; break;
 case boat : toplay="sfx/woodstep1.wav"; break;
 case horse : toplay="sfx/horse.wav"; break;
 case house : toplay="sfx/landWood1.wav"; break;
  case broken_wall : toplay="sfx/icebreak" + random(0, 5) + ".ogg"; break;
 case castle_wall : toplay="sfx/collide2-wall.wav"; break;
 case courtyard : toplay="sfx/concreteland1.wav"; break;
 case castle_room : toplay="sfx/squeakystep1.ogg"; break;
 case water : toplay="sfx/waterwalk1.wav"; break;
 case deepWater : toplay="sfx/watertwirl1.wav"; break;
 case tree : toplay="sfx/hardleafland.wav"; break;
 case garden : toplay="sfx/harvest_01.wav"; break;
 case hole : toplay="sfx/rockstep1.wav"; break;
 case boulder : toplay="sfx/collide3-brickWall.ogg"; break;
 default : toplay = "sfx/armpunch" + random(1, 2) + ".wav";
 }// Switch for sounds.
 pool.play_2d(toplay, mx, my, mx, my, false);
}// Speakme.
 wait(5);
 }// Map editor loop.

 }// Debug the map.
 void debug_chars(Map@ gloc) {
 voice.speak_interrupt("Debugging characters. Press tab to select characters. Press escape when done.");
 int qui=0;
 while(!key_pressed(KEY_ESCAPE)) {
 if((key_down(KEY_LCONTROL))||(key_down(KEY_RCONTROL))) voice.stop();

 if(key_pressed(KEY_TAB)) {
 if((key_down(KEY_LSHIFT))||(key_down(KEY_RSHIFT))) qui--; else qui++;
 if(qui<0) qui=gloc.chars.length()-1;
 else if(qui>=gloc.chars.length()) qui=0;
 string tosay="" + gloc.chars[qui].rankString() + " " + gloc.chars[qui].name + ", ";
 if((@(gloc.chars[qui].shogun)==@(myArmy[0]))||(@(gloc.chars[qui].daimyou)==@(myArmy[0]))) tosay += "is part of your army.";
 else if((@(gloc.chars[qui].daimyou)==null)&&(@(gloc.chars[qui].shogun)==null)) tosay += " independent.";
 voice.speak_interrupt(tosay);
 }// Tab.
 else if(key_pressed(KEY_LEFT)) {gloc.chars[qui].x--; if(gloc.chars[qui].x<0) gloc.chars[qui].x=0; voice.speak_interrupt(" " + ( (gloc.chars[qui].x<coords.length() ) ? coords[gloc.chars[qui].x] : ("" + gloc.chars[qui].x) ) + ", " + gloc.chars[qui].y + ", " + mapstring(gloc.map[gloc.chars[qui].x][gloc.chars[qui].y]) + ". ");}
 else if(key_pressed(KEY_RIGHT)) {gloc.chars[qui].x++; if(gloc.chars[qui].x>49) gloc.chars[qui].x=49; voice.speak_interrupt(" " + ( (gloc.chars[qui].x<coords.length() ) ? coords[gloc.chars[qui].x] : ("" + gloc.chars[qui].x) ) + ", " + gloc.chars[qui].y + ", " + mapstring(gloc.map[gloc.chars[qui].x][gloc.chars[qui].y]) + ". ");}
 else if(key_pressed(KEY_UP)) {gloc.chars[qui].y--; if(gloc.chars[qui].y<0) gloc.chars[qui].y=0; voice.speak_interrupt(" " + ( (gloc.chars[qui].x<coords.length() ) ? coords[gloc.chars[qui].x] : ("" + gloc.chars[qui].x) ) + ", " + gloc.chars[qui].y + ", " + mapstring(gloc.map[gloc.chars[qui].x][gloc.chars[qui].y]) + ". ");}
 else if(key_pressed(KEY_DOWN)) {gloc.chars[qui].y++; if(gloc.chars[qui].y>49) gloc.chars[qui].y=49; voice.speak_interrupt(" " + ( (gloc.chars[qui].x<coords.length() ) ? coords[gloc.chars[qui].x] : ("" + gloc.chars[qui].x) ) + ", " + gloc.chars[qui].y + ", " + mapstring(gloc.map[gloc.chars[qui].x][gloc.chars[qui].y]) + ". ");}
 else if(key_pressed(KEY_N)) gloc.chars[qui].name=input_box("Character name:", "Enter the desired name and press enter.");
 else if(key_pressed(KEY_R)) {gloc.chars[qui].riding=!(gloc.chars[qui].riding); voice.speak_interrupt( (gloc.chars[qui].riding) ? "Riding" : " not riding ");}
 else if(key_pressed(KEY_K)) {
 if((key_down(KEY_LSHIFT))||(key_down(KEY_RSHIFT))) {gloc.chars[qui].counter=string_to_number(input_box("Counter", "Enter counter."));}
 else if(key_down(KEY_LCONTROL)) gloc.chars[qui].state++;
 else if(key_down(KEY_RCONTROL)) gloc.chars[qui].state--;
 voice.speak_interrupt(gloc.chars[qui].stateString() + ", counter " + gloc.chars[qui].counter);
}// W. T. F!
 else if(key_pressed(KEY_A)) gloc.chars[qui].arrows=string_to_number(input_box("Arrows", "Enter the number of arrows to give " + gloc.chars[qui].name + ", who already has " + gloc.chars[qui].arrows + ". "));
 else if(key_pressed(KEY_O)) gloc.chars[qui].orders=input_box("Orders", "Enter " + gloc.chars[qui].name + "\'s orders, which are currently " + gloc.chars[qui].orders + ". ");
 else if(key_pressed(KEY_RETURN)) {gloc.chars[qui].rank++; if(gloc.chars[qui].rank>6) gloc.chars[qui].rank=0; voice.speak_interrupt(gloc.chars[qui].rankString());}
 else if(key_pressed(KEY_M)) {gloc.chars[qui].male=!gloc.chars[qui].male; voice.speak_interrupt( (gloc.chars[qui].male) ? "Male" : "female" ); }
 else if(key_pressed(KEY_S)) {
 Char@ me; @me=gloc.chars[qui];
 if((key_down(KEY_LSHIFT))||(key_down(KEY_RSHIFT))) {
 gloc.chars[qui].hasArmor=!gloc.chars[qui].hasArmor;
 }// Armor.
 else if((key_down(KEY_LCONTROL))||(key_down(KEY_RCONTROL))) {
 double dx=1.0;
 if(key_down(KEY_LCONTROL)) dx=-1.0;
 gloc.chars[qui].hp+=dx;
}// Health.
 else {
  gloc.chars[qui].hasShield=!gloc.chars[qui].hasShield;
 }// Shield.
   string tosay=me.rankString() + " " + me.name + " ";
 if(me.hasShield) tosay += "has a shield, and ";
 if(me.hasArmor) tosay +="has armor, and ";
 if(me.hp<=0.0) tosay += " is dead.";
 else if(me.hp<=2.0) tosay += " is about to die.";
 else if(me.hp<=5.0) tosay += " is seriously injured.";
 else if(me.hp<=7.5) tosay += " is wounded.";
 else if(me.hp<10.0) tosay += " is in good health.";
 else tosay += " is in perfect health.";
 voice.speak_interrupt(tosay);
}// Shields and armor.
 else if((key_pressed(KEY_W))||(key_pressed(KEY_I))) {
 bool arms=key_down(KEY_W);
 string[] list= (arms) ? gloc.chars[qui].weapons : gloc.chars[qui].inv;
 voice.speak_interrupt("Editing " + ((arms) ? "weapons" : "inventory" ) + ". Press backspace to remove, plus to add, and delete to clear. Press enter when done.");
 int wx=0;
 while(!key_pressed(KEY_RETURN)) {
 if((key_down(KEY_LCONTROL))||(key_down(KEY_RCONTROL))) voice.stop();
 bool speak=true;
 if((key_pressed(KEY_LEFT))||(key_pressed(KEY_UP))) wx--;
 else if((key_pressed(KEY_DOWN))||(key_pressed(KEY_RIGHT))) wx++;
 else if(key_pressed(KEY_BACK)) {list.remove_at(wx); voice.speak_wait("Removed.");}
 else if(key_pressed(KEY_EQUALS)) list.insert_last(input_box("Add item", "Enter item to add:"));
 else if(key_pressed(KEY_SPACE)) {gloc.chars[qui].weapon=wx;
 speak=false;
 if(wx<gloc.chars[qui].weapons.length()) voice.speak_interrupt("weapon set to " + gloc.chars[qui].weapons[wx] + ".");
 else voice.speak_interrupt("Disarmed.");
}// Weapon.
 else speak=false;
 if(wx<0) wx=list.length()-1; else if(wx>=list.length()) wx=0;
 if(speak) voice.speak_interrupt(((wx>=list.length())||(list.length()==0)) ? "No items" : list[wx]);
wait(5);}
 voice.speak_wait("Done.");
 if(arms) gloc.chars[qui].weapons=list; else gloc.chars[qui].inv=list;
 }// Edit weapons.
 else if(key_pressed(KEY_L)) {
 // Make a list of potential leaders
 Char@[] leaders;
 vector[] districts;
 for(uint xx=0; xx<map.length(); xx++) {for(uint yy=0; yy<map[xx].length(); yy++) {
 for(uint i=0; i<map[xx][yy].chars.length(); i++) {
 if((map[xx][yy].chars[i].rank==DAIMYOU)||(map[xx][yy].chars[i].rank==SHOGUN)) {
leaders.insert_last(map[xx][yy].chars[i]);
 vector d(xx, yy);
 districts.insert_last(d);
}// Leader found.
 }// Meeps!
}}// loop.
voice.speak_interrupt("" + leaders.length() + " leaders found. Use arrow keys and enter to select. Press escape when done.");
 int lx=leaders.length()-1;
 while(!key_pressed(KEY_ESCAPE)) {
 if((key_down(KEY_LCONTROL))||(key_down(KEY_RCONTROL))) voice.stop();
 
 bool lspeak=true;
 if((key_pressed(KEY_LEFT))||(key_pressed(KEY_UP))) lx--;
 else if((key_pressed(KEY_DOWN))||(key_pressed(KEY_RIGHT))) lx++;
 else if(key_pressed(KEY_RETURN)) {
 if((key_down(KEY_LSHIFT))||(key_down(KEY_RSHIFT))) {
 if(leaders[lx].rank==DAIMYOU) @(gloc.chars[qui].daimyou)=leaders[lx];
 else @(gloc.chars[qui].shogun)=leaders[lx];
 voice.speak_interrupt(gloc.chars[qui].rankString() + " " + gloc.chars[qui].name + " now follows " + leaders[lx].rankString() + " " + leaders[lx].name + ". ");
}// Set.
 else voice.speak_interrupt("Hold shift, and press enter, to permanently set " + leaders[lx].rankString() + " " + leaders[lx].name + " as " + gloc.chars[qui].rankString() + " " + gloc.chars[qui].name + "\'s leader.");
lspeak=false;
}// Enter.
 else lspeak=false;
 if(lx<0) lx=leaders.length()-1; else if(lx>=leaders.length()) lx=0;
 if(lspeak) {
 if((lx<0)||(lx>=leaders.length())) voice.speak_interrupt("No leader.");
 else voice.speak_interrupt(leaders[lx].rankString() + " " + leaders[lx].name + ", in district " + coords[districts[lx].x] + " " + districts[lx].y + ", at " + leaders[lx].x + ", " + leaders[lx].y + ". ");
}// Speak.
 wait(5);
 }// loop.
  keys_pressed(); voice.speak_interrupt("Done.");
}// Changing leaders.
 else if(key_pressed(KEY_EQUALS)) {
 Char@ who=newChar(CIVIL);
 gloc.chars.insert_last(who);
 @(who.gloc)=gloc;
 who.x=random(0, 49); who.y=random(0, 49);
 voice.speak_interrupt("Added " + who.rankString() + " " + who.name + ". "); 
}// Add character.
 wait(5);
 }// Debug chars loop.
}// Debug characters.


 class EchoD {

 string filename; // the sound to be echoed.
 double x; double y; // The spacial position of the sound to be echoed.
 double decay; // How much quieter the sound should be than the source sound. Note that playing it at a distance will likely cut the volume even further.
 double delay; // How long before the echo plays.
 double pitchBend; // If the echo is pitched compared to the original.
 EchoD() {x=0; y=0; delay=0; decay=0; pitchBend=100;}
 EchoD(string fn) {filename=fn; pitchBend=100;}
 EchoD(string fn, double xx, double yy, double dec, double del) {filename=fn; x=xx; y=yy; decay=dec; delay=del; pitchBend=100;}
 EchoD(string fn, double xx, double yy, double dec, double del, double pb) {filename=fn; x=xx; y=yy; decay=dec; delay=del; pitchBend=pb;}

 EchoD clone() {return this;} //?

 // This version of clone changes the filename, but leaves everything else the same.
 // This is a quick way to use the EchoD object for echoes of individual sounds based on a master EchoD templet.
 EchoD clone(string fn) {
 EchoD ret(fn, x, y, decay, delay, pitchBend);
 return ret;
 }

}// EchoD.

 Map@ newMap(uint w, uint h, string ter) {
