 // Start missions. Load files, stuff like that.
 void startMission(int m) {
 loadGame(m);
mission=m;
 mode=campaigne;
 // Load maps and characters.
 // Give information and instructions.
 switch (m) {
 case 0 : {
 // Nobunaga gets started.
 string[] story={
 "Your father has died unexpectedly. At the funeral, you let your emotions get the better of you, and threw the ceremonial incense at the altar.",
 "Though you are the oldest son of Oda Nobuhide, your behavior has left many of your clansmen supporting your younger brother, Nobuyuki.",
 "Even your trusted mentor and retainer was so shamed by your actions that he committed Sepuku.",
 "Your uncle, Nobutomo, is using the local governor as a puppet to further challenge your authority.",
 "You have just received word that Nobutomo discovered that the governor was secretly your supporter, and has had him killed.",
 "Now is your chance to move. First, though, you will need to form an alliance with your other uncle, Nobumitsu.",
 "Nobumitsu\'s estate is in the southwest of this district. Gain his support so that you can put Nobutomo in his place!",
"Press Escape to enter the game."
};
 cutscene(story);
 quest="Convince Daimyou Nobumitsu to join you.";

 }; break;

 }// Mission switch.

 setLoc(game); 
}// Start Mission.
