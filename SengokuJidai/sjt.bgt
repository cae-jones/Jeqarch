 sh.x=25; sh.y=0; me.gloc.map[sh.x][sh.y]=horse;
 dai1.x=0; dai1.y=25; me.gloc.map[dai1.x][dai1.y]=horse;
 dai2.x=25; dai2.y=48; me.gloc.map[dai2.x][dai2.y]=horse;
 dai3.x=48; dai3.y=25; me.gloc.map[dai3.x][dai3.y]=horse;
