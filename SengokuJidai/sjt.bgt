 if(@(me.destination)!=null) {
 if((absolute(me.x-me.destination.x)<=random(0, 2))&&(absolute(me.y-me.destination.y)<=random(0, 2))) @(me.destination)=null;
 else {
 if((me.state==attacking)||(me.state==preparing)) {
 // You can't travel while attacking, so don't turn away from your opponent.
 }
 else {
 Point p;
 if(me.destination.x>me.x) {
 if(me.destination.y>me.y) {me.face="se"; p.x=me.x+1; p.y=me.y+1;}
 else if(me.destination.y<me.y) {me.face="ne"; p.x=me.x+1; p.y=me.y-1;}
 else {me.face="e"; p.x=me.x+1; p.y=me.y;}
 } // East.
 else if(me.destination.x<me.x) {
 if(me.destination.y<me.y) {me.face="nw"; p.x=me.x-1; p.y=me.y-1;}
 else if(me.destination.y>me.y) {me.face="sw"; p.x=me.x-1; p.y=me.y+1;}
 else {me.face="w"; p.x=me.x-1; p.y=me.y;}
 }// West.
 else if(me.destination.y<me.y) {me.face="n"; p.x=me.x; p.y=me.y-1;}
 else {me.face="s"; p.x=me.x; p.y=me.y+1;}

 // But! AI must take walls, boulders, Etc into consideration.
 if((p.x>=0)&&(p.y>=0)&&(p.x<50)&&(p.y<50)) {
