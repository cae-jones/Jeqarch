 for(uint i=0; i<myArmy.length(); i++) {
 bool hasFood=false;
 for(uint j=0; j<myArmy[i].inv.length(); j++) {if((myArmy[i].inv[j]=="sushi")||(myArmy[i].inv[j]=="yasai")||(myArmy[i].inv[j]=="kudamono"))
 {hasFood=true; j=myArmy[i].inv.length();}
}// Inv.
 if(!hasFood) hungry.insert_last(myArmy[i]);
}// Meh.
 // Find every piece of food in inventory until we're out of people to feed.
 int fed=0;
 for(uint i=0; i<me.inv.length(); i++) {
 if((me.inv[i]=="yasai")||(me.inv[i]=="sushi")||(me.inv[i]=="kudamono")) {
 if(hungry.length()>0) {
 hungry[0].getItem(me.inv[i]); me.inv.remove_at(i); i--; hungry.remove_at(0); fed++;
 } else i=me.inv.length();
 }// Is food.
}// Loop.
 voice.speak_interrupt("" + fed + " pieces of food were distributed.");
 }// distribute food.
 else if(parts[0]=="horse") {
 // Well, we can't just put the horse at our current position. Perhaps pick a location?
 int hx=me.x; int hy=me.y;
