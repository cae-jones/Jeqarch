}// Upgrading Samurai to Daimyou.
 else if((myArmy[mx].rank==CIVIL)||(myArmy[mx].rank==RONAN)) {myArmy[mx].rank=SAMURAI; myArmy[mx].hasArmor=true;}
 upgrades++;
 }// Upgraded.
