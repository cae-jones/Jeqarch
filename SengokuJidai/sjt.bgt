 echoes.insert_last(ech);
 }// Echoes.
 }// Break a wall.
 switch (me.gloc.map[enemy.x][enemy.y]) {
 case water :
 case deepWater : fall="sfx/water2.wav"; break;
 case boulder :
 case courtyard : fall="sfx/concretefall" + random(1, 2) + ".wav"; break;
 case house :
 case broken_wall :
 case castle_room : fall="sfx/woodfall1.ogg"; break;
 }// Switch.
 }// Tiles for throws.
 EchoD ech(fall, enemy.x, enemy.y, 0, 0.5);
 echoes.insert_last(ech);
 enemy.sounds.insert_last("sfx/grab-lift.ogg");
 }; break;
 case DAIMYOU : {
 // Disarm.
 if(enemy.weapon<enemy.weapons.length()) enemy.gloc.addItem(enemy.weapons[enemy.weapon], newPoint(enemy.x+random(-2, 2), enemy.y+random(-2, 2)));
 enemy.weapons.remove_at(enemy.weapon);
 enemy.sounds.insert_last("sfx/metalkick1.wav");
 }; break;
 case SHINOBI : {
 // Steal weapon.
 if(enemy.weapon<enemy.weapons.length()) {me.getItem(enemy.weapons[enemy.weapon]); enemy.weapons.remove_at(enemy.weapon); me.sounds.insert_last("sfx/takeBalance.ogg");}

 }; break;

 }}// Special melee attacks.
 }// Hitting with fists.
 else if((me.weapons[me.weapon]=="kanabo")||(me.weapons[me.weapon]=="kusurigami")) {
 if(random(0, 1)==0) enemy.sounds.insert_last("sfx/HITMK.wav"); else enemy.sounds.insert_last("sfx/hit4.wav");
 if((special)&&(me.weapons[me.weapon]=="kanabo")) {enemy.x+=random(-2, 2); enemy.y+=random(-2, 2); enemy.counter=0.2; enemy.state=walking; string faces="news"; enemy.face=faces[random(0, faces.length()-1)];}
 }// The big ouch weapon.
 else if(me.weapons[me.weapon]=="black-egg") {
 enemy.state=recovering; enemy.counter=1.0+me.charged+(0.01*enemy.fatigue);
 }// Black Egg.
 else {
 if(special) {
 if((me.weapon<me.weapons.length())&&(enemy.weapon<enemy.weapons.length())){
