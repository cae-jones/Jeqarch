 void playsong(string toplay) {
 if(curbgm==toplay) {if(!(bgm.playing)) bgm.play(); bgm.volume=BGMVolume;}
 else {if(bgm.playing) bgm.stop(); bgm.load(toplay); curbgm=toplay; bgm.play(); bgm.volume=BGMVolume;}
 }
 void playamb(string toplay) {
 if(curamb==toplay) {if(!(amb.playing)) amb.play(); amb.volume=BGMVolume;}
 else {if(amb.playing) amb.stop(); amb.load(toplay); curamb=toplay; amb.play(); amb.volume=BGMVolume;}

 }// Same as playsong, but for ambience.
 custom_voice voice;
 void fadeOut() {
 while(
((bgm.playing)&&(bgm.volume>-50))||
 ((amb.playing)&&(amb.volume>-50))
 ) {
 if(bgm.playing) bgm.volume=bgm.volume-1;
 if(amb.playing) amb.volume=amb.volume-1;
 if(bgm.volume<=-50) bgm.stop();
 if(amb.volume<=-50) amb.stop();
 wait(50);
 }
 }
 void fadeIn(string music, string ambience) {
  // This applies to music, but does it work with ambience?
 float tempvol=0.0;
 tempvol+=BGMVolume;
 BGMVolume=-50;
 playsong(music);
 playamb(ambience);
 BGMVolume=tempvol;
 while(
((bgm.playing)&&(bgm.volume<BGMVolume))||((amb.playing)&&(amb.volume<BGMVolume))) {
 if(bgm.playing) bgm.volume=bgm.volume+1;
 if(amb.playing) amb.volume=amb.volume+1;
 wait(50);
 }

 }

 void saveGame(string name="") {
 int num=-1;
 if(name=="") {
 voice.speak_interrupt("Choose file to save, 0-9.");

 while(num<0) {
 num=number_pressed();
 wait(5);
 }
}
 voice.speak_interrupt("Saving, please wait.");
// string txt="[settings]";

 // Put all the data in here.
 string txt="[settings]\n";
 txt += "[difficulty]\n" + difficulty + "\n";
 txt += "[speed]\n" + speed + "\n";
 txt += "[volume]\n" + BGMVolume + "\n";
 if(friendly_fire) txt += "[friendly_fire]\n";
 txt += "[counter]\n" + counter + "\n"; //?
 txt += "[mode]\n" + mode + "\n[mission]\n" + mission + "\n[missions]\n";
 string missiontext=""; for(uint ix=0; ix<missions.length(); ix++) {missiontext += "" + missions[ix]; if(ix<missions.length()-1) missiontext += " ";}
 txt += missiontext + "\n";
 txt += "[ychar]\n" + ychar + "\n";

 // Maps and characters.
// How in the world am I going to pull off these references to people...
 // For instance, how can I save who a given character follows?
 // How do we prevent duplicates of people in your army?

 // Let's worry about the maps first?
 txt += "[voicerate]\n" + 4 + "\n";
 txt += "[map]\n" + map.length() + ", " + map[0].length() + "\n";
 // As for your army, let's just make that a list of references. We can't add it until we know what those are, though.
 txt = txt + "[army]\n";
 // Or better yet, let's just put a flag in the block for each character for that. It should eliminate problems with duplicates.
 string hex="0123456789ABCDEFGHIJKLMNOP"; // So that's not really hex. Just being safe in case I add more terrain types in the future.

 for(uint xx=0; xx<map.length(); xx++) {
 for(uint yy=0; yy<map[xx].length(); yy++) {
 string m="";

 // First, let's define the map.
 m += "[type]\n" + map[xx][yy].type + "\n";
 m+= "[weather]\n" + map[xx][yy].weather + "\n";
 m += "[size]\n" + map[xx][yy].width + ", " + map[xx][yy].height + "\n";
 m += "[map]\n";
 for(int x2=0; x2<map[xx][yy].width; x2++) {
 for(int y2=0; y2<map[xx][yy].height; y2++) {
 m += "" + hex[map[xx][yy].map[x2][y2]];
}
 m += "\n";
}

 for(uint i=0; i<map[xx][yy].items.length(); i++) {
 m += "[item]\n" + map[xx][yy].items[i] + ", " + map[xx][yy].itemPositions[i].x + ", " + map[xx][yy].itemPositions[i].y + "\n";
 }// add Items.

 // And now the head-splody part:
 for(uint i=0; i<map[xx][yy].chars.length(); i++) {
 Char@ me; @me=map[xx][yy].chars[i];
 m += "|\n" + me.name + "\n" + me.male + "\n";
 m+= "[pose]\n" + me.x + ", " + me.y + "\n";
 if(@(me.shogun)==@(myArmy[0])) m += "[army]\n";
 m += "[orders]\n" + me.orders + "\n";
 m += "[state]\n" + me.state + "\n";
 m += "[rank]\n" + me.rank + "\n";
 m += "[weapon]\n" + me.weapon + "\n";
 m += "[inv]\n";
 for(uint j=0; j<me.inv.length(); j++) {m += me.inv[j]; if(j<me.inv.length()-1) m += ", ";}
 m += "\n";
  m += "[counter]\n" + me.counter + "\n[hp]\n" + me.hp + "\n[fatigue]\n" + me.fatigue + "\n";
 if(me.hasShield) m += "[shield]\n"; if(me.hasArmor) m += "[armor]\n";
 m += "[arrows]\n" + me.arrows + "\n";
 m += "[food]\n" + me.food + "\n";
 m += "[ninjaAmmo]\n" + me.ninjaAmmo + "\n";
 m += "[weapons]\n";
 for(uint j=0; j<me.weapons.length(); j++) {m += me.weapons[j]; if(j<me.weapons.length()-1) m += ", ";}
 m += "\n";
 m += "[face]\n" + me.face + "\n";
 if(me.riding) m += "[riding]\n"; if(me.hiding) m += "[hiding]\n"; if(me.climbing) m += "[climbing]\n";

 m += "[charged]\n" + me.charged + "\n";
 if(me.blocked) m += "[blocked]\n";
 if(@(me.destination)!=null) m += "[destination]\n" + me.destination.x + ", " + me.destination.y + "\n";
 if(@(me.base)!=null) m += "[base]\n" + me.base.x + ", " + me.base.y + "\n";
 if(me.sounds.length()>0) {
 m += "[sounds]\n";
 for(uint j=0; j<me.sounds.length(); j++) {m += me.sounds[j]; if(j<me.sounds.length()-1) m += ", ";}
 m += "\n";
 }// Sounds.

 // Save daimyou and shogun for last.
 if(@(me.shogun)!=null) {
 m += "[shogun]\n";
 for(uint x2=0; x2<map.length(); x2++) {
 for(uint y2=0; y2<map[x2].length(); y2++) {
  if(@(me.shogun.gloc)==@(map[x2][y2])) {
 m += "" + x2 + ", " + y2 + ", ";
 for(uint j=0; j<map[x2][y2].chars.length(); j++) {
 if(@(map[x2][y2].chars[j])==@(me.shogun)) {m += "" + j + "\n"; j=map[x2][y2].chars.length();}
 }// Find them.
 }// Found.
 
 }}// Loop.
 }// Gah.

 if(@(me.daimyou)!=null) {
 m += "[daimyou]\n";
 for(uint x2=0; x2<map.length(); x2++) {
 for(uint y2=0; y2<map[x2].length(); y2++) {
  if(@(me.daimyou.gloc)==@(map[x2][y2])) {
 m += "" + x2 + ", " + y2 + ", ";
 for(uint j=0; j<map[x2][y2].chars.length(); j++) {
 if(@(map[x2][y2].chars[j])==@(me.daimyou)) {m += "" + j + "\n"; j=map[x2][y2].chars.length();}
 }// Find them.
 }// Found.
 
 }}// Loop.
 }// Gah.


 // And target...
 if(@(me.target)!=null) {
 m += "[target]\n";
 for(uint x2=0; x2<map.length(); x2++) {
 for(uint y2=0; y2<map[x2].length(); y2++) {
  if(@(me.target.gloc)==@(map[x2][y2])) {
 m += "" + x2 + ", " + y2 + ", ";
 for(uint j=0; j<map[x2][y2].chars.length(); j++) {
 if(@(map[x2][y2].chars[j])==@(me.target)) {m += "" + j + "\n"; j=map[x2][y2].chars.length();}
 }// Find them.
 }// Found.
 
 }}// Loop.
 }// Gah.


 // and love.
 if(@(me.love)!=null) {
 m += "[love]\n";
 for(uint x2=0; x2<map.length(); x2++) {
 for(uint y2=0; y2<map[x2].length(); y2++) {
  if(@(me.love.gloc)==@(map[x2][y2])) {
 m += "" + x2 + ", " + y2 + ", ";
 for(uint j=0; j<map[x2][y2].chars.length(); j++) {
 if(@(map[x2][y2].chars[j])==@(me.love)) {m += "" + j + "\n"; j=map[x2][y2].chars.length();}
 }// Find them.
 }// Found.
 
 }}// Loop.
 }// Gah.

 }// *Cries*.

 file mapfile(); mapfile.open(
((name=="") ? "m" + num : name ) + "_" + xx + "_" + yy + ".dat", "w");
 mapfile.write(m);
 mapfile.close();
 }}// Oh, the pain...

 file savefile; savefile.open((name=="") ? "sjsave" + num + ".dat" : name, "w");
 savefile.write(txt);
 savefile.close();
 voice.speak_interrupt("Saved.");
 }// Save Game.
 void loadGame(int m=-1, string fname="") {
 int num=-1;
if((m<0)&&(fname=="")) {
 voice.speak_interrupt("Choose save file to load, 0-9.");

 while(num<0) {
 num=number_pressed();
 wait(5);
 }
} else num=m;

 string txt=""; //"[settings]";

 // Put all the data in here.
 voice.speak("Loading. Please wait.");
 string fn=""; if(m>=0) fn="campaignes/"; else if(fname!="") fn="maps/";
 file savefile; savefile.open(fn + ((fname=="") ? "sjsave" + num + ".dat" : fname), "r");
 txt=savefile.read(0);
 savefile.close();
 string[] lines=string_split(txt, "\n", true);

 for(uint i=0; i<lines.length(); i++) {
 if(lines[i].length()==0) continue;
 if(lines[i][0]=="[") {
 bool inc=true;
 if(lines[i]=="[difficulty]") difficulty=string_to_number(lines[i+1]);
 else if(lines[i]=="[speed]") speed=string_to_number(lines[i+1]);
 else if(lines[i]=="[volume]") BGMVolume=string_to_number(lines[i+1]);
 else if(lines[i]=="[friendly_fire]") {friendly_fire=true; inc=false;}
 else if(lines[i]=="[counter]") counter=string_to_number(lines[i+1]);
 else if(lines[i]=="[ychar]") ychar=string_to_number(lines[i+1]);
 else if(lines[i]=="[voicerate]") {;;; } //voice.rate=string_to_number(lines[i+1]);
 else if(lines[i]=="[missions]") {
 string[] msn=string_split(lines[i+1], " ", true);
 missions.resize(msn.length());
 for(uint iik=0; iik<msn.length(); iik++) missions[iik]=string_to_number(msn[iik]);
}// Load missions.
 else if(lines[i]=="[mode]") mode=string_to_number(lines[i+1]);
 else if(lines[i]=="[mission]") mission=string_to_number(lines[i+1]);
 else if(lines[i]=="[map]") {
 string[] dims=string_split(lines[i+1], ", ", true);
 map.resize(string_to_number(dims[0]));
 for(uint j=0; j<map.length(); j++) map[j].resize(string_to_number(dims[1]));

 // We need to associate characters with other characters after the entire population has been loaded, so we need to keep a list of all characters that need this done.
 // We also need to save the commands that they'll need executed. -_-.
 Char@[] postprocess; string[] postcmds;

 // We're going to have to clear the army.
 myArmy.resize(0);
 // Otherwise, if we load a game after having already played, we'll have a bigger army than we should.
 
 // Now, we need to load the file for the map in question.
 file mapfile;
 for(uint xx=0; xx<map.length(); xx++) {
 for(uint yy=0; yy<map[xx].length(); yy++) {
 mapfile.open(fn + ((fname=="") ? "m" + num : fname) + "_" + xx + "_" + yy + ".dat", "r");
 string m;
 m=mapfile.read(0);
 mapfile.close();
 string[] sections=string_split(m, "|", true);

 // Sections[0] is the definition for the map itself;
 // All subsequent sections are characters, offset by their index in map[xx][yy].chars by 1.

 // So, Map definition:
 for(uint j=0; j<sections.length(); j++) {
 string[] mlines=string_split(sections[j], "\n", true);
 if(j==0) {
 map[xx][yy]=newMap(50, 50, "ocean");
 for(uint k=0; k<mlines.length(); k++) {
 bool inc2=true;
 if(mlines[k]=="[type]") map[xx][yy].type=mlines[k+1];
 else if(mlines[k]=="[weather]") map[xx][yy].weather=mlines[k+1];
 else if(mlines[k]=="[size]") {
 string[] parts=string_split(mlines[k+1], ", ", true);
 map[xx][yy].width=string_to_number(parts[0]); map[xx][yy].height=string_to_number(parts[1]);
 map[xx][yy].map.resize(map[xx][yy].width); for(int w=0; w<map[xx][yy].width; w++) {map[xx][yy].map[w].resize(map[xx][yy].height);}
 }// Ick.
 else if(mlines[k]=="[map]") {
 string hex="0123456789ABCDEFGHIJKLMNOP";
 for(int x2=0; x2<map[xx][yy].width; x2++) {
 for(int y2=0; y2<map[xx][yy].height; y2++) {
 map[xx][yy].map[x2][y2]=string_contains(hex, "" + mlines[k+1+x2][y2], 1);
 // Let's try this:
 for(uint index=0; index<hex.length(); index++) { if(hex[index]==mlines[k+1+x2][y2]) {map[xx][yy].map[x2][y2]=index; index=20;}}
 if(map[xx][yy].map[x2][y2]<0) {
 alert("Debug storm!", mlines[k+1+x2]);
 string entered=input_box("What do you think it should be?", "Value:");
 int index=string_to_number(entered);
 alert("Comparison", "The value to be checked is " + mlines[k+1+x2][y2] + ". You think it is " + hex[index] + ", but bgt insists that trying to compare the two results in " + (hex[index]==mlines[k+1+x2][y2]) + ". ");
 x2=50; y2=50;
 }// There's an error.
 }}// Loops. If these numbers don't match what's in the map file, we're bound to have a runtime error.
 k+=map[xx][yy].width; inc2=false;
 }// Individual spaces.
 else if(mlines[k]=="[item]") {
 string[] parts=string_split(mlines[k+1], ", ", true);
 map[xx][yy].items.insert_last(parts[0]);
 Point point(string_to_number(parts[1]), string_to_number(parts[2]));
 map[xx][yy].itemPositions.insert_last(point);
 }// Items.
 else inc2=false;
 if(inc2) k++;
 }// Sigh.
 }// Map definition.
 else {
 // Head go boom, head go boom!
 Char@ me;
 @me=newChar(-1);
 me.name=mlines[0];
 me.male=(mlines[1]=="1"); // I think that's how that work. Would be weird to swap genders on loading.
 bool addToArmy=false; // Boolean, because rank definition comes after the army check, and the shogun must be in slot 0.
 for(uint k=2; k<mlines.length(); k++) {
 bool inc2=true;
 if(mlines[k]=="[pose]") {
 string[] parts=string_split(mlines[k+1], ", ", true);
 Point point(string_to_number(parts[0]), string_to_number(parts[1]));
// @(me.pose)=point;
 me.x=point.x; me.y=point.y;
 }
 else if(mlines[k]=="[army]") {addToArmy=true; inc2=false;}
 else if(mlines[k]=="[orders]") me.orders=mlines[k+1];
 else if(mlines[k]=="[state]") me.state=string_to_number(mlines[k+1]);
 else if(mlines[k]=="[rank]") me.rank=string_to_number(mlines[k+1]);
 else if(mlines[k]=="[weapon]") me.weapon=string_to_number(mlines[k+1]);
 else if(mlines[k]=="[inv]") {
 if(lines[k+1][0]=="[") {
 // No inv to speak of.
 inc2=false;
 }
 else me.inv=string_split(mlines[k+1], ", ", true);
 }// Inv.
 else if(mlines[k]=="[counter]") me.counter=string_to_number(mlines[k+1]);
 else if(mlines[k]=="[hp]") me.hp=string_to_number(mlines[k+1]);
 else if(mlines[k]=="[fatigue]") me.fatigue=string_to_number(mlines[k+1]);
 else if(mlines[k]=="[shield]") {me.hasShield=true; inc2=false;}
 else if(mlines[k]=="[armor]") {me.hasArmor=true; inc2=false;}
 else if(mlines[k]=="[arrows]") me.arrows=string_to_number(mlines[k+1]);
 else if(mlines[k]=="[food]") me.food=string_to_number(mlines[k+1]);
 else if(mlines[k]=="[ninjaAmmo]") me.ninjaAmmo=string_to_number(mlines[k+1]);
 else if(mlines[k]=="[weapons]") {
 // Make sure we're not canibalizing a face!
 if((k<mlines.length()-1)&&(mlines[k+1].length()>0)&&(mlines[k+1][0]!="[")) me.weapons=string_split(mlines[k+1], ", ", true);
 else inc2=false;
 }// Weapons.
 else if(mlines[k]=="[face]") me.face=mlines[k+1];
 else if(mlines[k]=="[riding]") {me.riding=true; inc2=false;}
 else if(mlines[k]=="[hiding]") {me.hiding=true; inc2=false;}
 else if(mlines[k]=="[climbing]") {me.climbing=true; inc2=false;}
 else if(mlines[k]=="[charged]") me.charged=string_to_number(mlines[k+1]);
 else if(mlines[k]=="[blocked]") {me.blocked=true; inc2=false;}
 else if((mlines[k]=="[destination]")||(mlines[k]=="[base]")) {
 string[] parts=string_split(mlines[k+1], ", ", true);
 Point point(string_to_number(parts[0]), string_to_number(parts[1]));
 if(mlines[k]=="[base]") {
(me.base)=point;}
 else @(me.destination)=point;
 }// Destination or base.
 else if(mlines[k]=="[sounds]") me.sounds=string_split(mlines[k+1], ", ", true);
 else if((mlines[k]=="[daimyou]")||(mlines[k]=="[shogun]")||(mlines[k]=="[target]")||(mlines[k]=="[love]")) {
 if((postprocess.length()==0)||(@(postprocess[postprocess.length()-1])!=@me)) {
 postprocess.insert_last(me); postcmds.insert_last(mlines[k] + "\n" + mlines[k+1]);
 }// Add.
 else postcmds[postcmds.length()-1] += "\n" + mlines[k] + "\n" + mlines[k+1];
 } // Add to the postprocess list.
 else inc2=false;
 if(inc2) k++;
 }// K Loop.
 if(addToArmy) {if(me.rank==SHOGUN) myArmy.insert_at(0, me); else myArmy.insert_last(me);}
 map[xx][yy].chars.insert_last(me); @(me.gloc)=map[xx][yy];
 }// Character definition.
 }// Sections.

 }}// Loops.

 for(uint pp=0; pp<postprocess.length(); pp++) {
 Char@ me; @me=postprocess[pp];
 string[] mlines=string_split(postcmds[pp], "\n", true);
 for(uint k=0; k<mlines.length(); k++) {
 bool inc2=true;
 if((mlines[k].length()>0)&&(mlines[k][0]=="[")) {
 string[] parts=string_split(mlines[k+1], ", ", true);
 // In some cases, people are still loyal to dead leaders, and therefore the save file doesn't include the index where they are located.
 Map@ where;
 @where=map[string_to_number(parts[0])][string_to_number(parts[1])];
 if((parts.length()<3)||(parts[2]=="")) {; } // Probably means the person is dead.
 else {
 Char@ who;
 @who=where.chars[string_to_number(parts[2])];
 if(mlines[k]=="[daimyou]") @(me.daimyou)=who;
 else if(mlines[k]=="[shogun]") @(me.shogun)=who;
 else if(mlines[k]=="[target]") @(me.target)=who;
 else if(mlines[k]=="[love]") @(me.love)=who;
 else {voice.speak_wait("Bizarre loyalty found: " + mlines[k] + ". ");}
 }// Found.
 }
 else inc2=false;
 if(inc2) k++;
 }// Oy. And Oy.
 }// Post processing.
 }// Initialize map.
 else inc=false;
 if(inc) i++;
 }// Field name.
 else {

 }// Do something with these... syntactically awkward parts.
 }// Iterating through lines.

 voice.speak_wait("Loaded.");
 // Change loc to game, start, play sound, whatever.
 }// Load.

 void main() {
 show_game_window("Sengoku Chambara! version 0.1B by CAE Jones");
 if(screen_reader_is_running(JAWS)) install_keyhook();
 playsong("music/intro.wav");
// voice.rate=4; // I'm tired of that starting out slow.
 voice.config_path="voice.cfg"; voice.load_config();
 while((bgm.playing)&&(!key_down(KEY_SPACE))&&(!key_down(KEY_RETURN))) {wait(5);}
 if(bgm.playing) fadeOut();
// voice.speak("Welcome. If you\'re hearing this, then someone forgot to remove it in the public release, and you should remind him to do so.");

 // Initialize weapon descriptions.
 weaponDescriptions.set("katana", "the sword that symbolizes the samurai.");
 weaponDescriptions.set("tanto", "a dagger-like weapon.");
 weaponDescriptions.set("wakazushi", "a samurai\'s short sword, typically ceremonial and used for ritual suicide more than combat.");
 weaponDescriptions.set("naginata", "a spear-like weapon consisting of a blade on the end of a long shaft.");
 weaponDescriptions.set("yumi", "an asymmetrical longbow.");
 weaponDescriptions.set("kanabo", "a massive spiked club designed for breaking through shields and armor.");
 weaponDescriptions.set("kunai", "short diamond-shaped knives with a variety of functions. They can be thrown, used in close-quarters combat, and can be used to assist in climbing walls.");
 weaponDescriptions.set("shuriken", "Small disposable multi-pointed weapons used primarily as projectiles.");
 weaponDescriptions.set("blow-dart", "A poisonous dart that can be fired with enough accuracy as to penetrate a samurai\'s armor.");
 weaponDescriptions.set("black-egg", "a shell containing crushed glass. When broken at close range, the glass fragments will leave enemies temporarily blinded and unable to fight.");
 weaponDescriptions.set("rocket-bow", "A bow capable of firing rocket-propelled arrows. Unlike the arrows fired from the yumi, rocket-propelled arrows are always destroyed after being launched.");
 weaponDescriptions.set("jo", "A relatively short staff with astounding speed and defensive ability.");
 weaponDescriptions.set("bo", "A long staff capable of combatting enemies from all sides.");
 weaponDescriptions.set("arcbus", "An early gun with lengthy load time and poor accuracy, attached bayonet can be used in place of firing.");
 weaponDescriptions.set("empty arcbus", "An early gun with lengthy load time and poor accuracy, attached bayonet can be used in place of firing.");
 weaponDescriptions.set("kusurigami", "A sickle connected to a ball and chain, mostly used as a special weapon by shinobi.");
 weaponDescriptions.set("ihatsu", "The bowl for donated food carried by monks. Most warriors will not attack someone believed to be a monk without very good reason.");

 // Initialize directions.
 directions.set("n", "north");
 directions.set("e", "east");
 directions.set("ne", "northeast");
 directions.set("se", "southeast");
 directions.set("s", "south");
 directions.set("sw", "southwest");
 directions.set("w", "west");
 directions.set("nw", "northwest");
 opposite_directions.set("s", "n");
 opposite_directions.set("n", "s");
 opposite_directions.set("ne", "sw");
 opposite_directions.set("sw", "ne");
 opposite_directions.set("e", "w");
 opposite_directions.set("w", "e");
 opposite_directions.set("se", "nw");
 opposite_directions.set("nw", "se");

 pool.behind_pitch_decrease=5;
 pool.max_distance=30;
 pool.pan_step=3; pool.volume_step=3;
 setLoc(MAIN);
 while(true) {

bool neg=false;
 if((myArmy.length()>ychar)&&(myArmy[ychar].counter<0.0)) {clipboard_copy_text("Before keycheck, me.counter is negative."); neg=true;}
 keycheck();

 if((!neg)&&(myArmy.length()>ychar)&&(myArmy[ychar].counter<0.0)) {clipboard_copy_text("After keycheck, me.counter is negative."); neg=true;
 if(myArmy[ychar].state!=recovering) {myArmy[ychar].counter=0; myArmy[ychar].state=0; clipboard_copy_text("I WISH I KNEW WHAT WAS CAUSING THIS PROBLEM!!");}
}
 step();
 if((myArmy.length()>ychar)&&(myArmy[ychar].counter<0.0)) {
//clipboard_copy_text("After step, me.counter is negative."); neg=true;
 myArmy[ychar].counter=absolute(myArmy[ychar].counter);
}

 if((key_down(KEY_LMENU))&&(key_down(KEY_F4))) {
// disconnect from server!
exit();
}// exit.
 wait(5);
}
 }// Main.
 int menuX=5; int menuY=0;

 void setLoc(int tl) {
 bool change=true;
 switch (tl) {
 case MAIN : {
 pool.destroy_all();
 fadeIn("music/mainmenu.ogg", "music/storm.ogg");
 counter=0.0;
 menuX=5;
 voice.speak("Sengoku Chambara main menu. Use the arrow keys and enter to select an option.");
 if(mode==online) {host.send_reliable(server_id, "quit, " + uac.id, 2); disconnect_everyone();}
 }; break;
 case game : {
 menuX=0; menuY=0; tmr.restart();
 if(loc!=paused) {
 ychar=0;
 // And so on.
 }// FadeIn.
 tmr.restart();
 }; break;
 case paused : {
 if(bgm.playing) bgm.pause();
 if(amb.playing) amb.pause();
 menuX=0;
 voice.speak_interrupt("paused. Press escape to return to game.");
 }; break;
 case help : {menuX=0;
 menuY=0;
 voice.speak_interrupt("Use the arrow keys to select a topic. Press enter to hear about that topic.");

 }; break;
 }
 if(change) loc=tl;
 }// SetLoc.

 // Returns the numeric value of the key being pressed, or -1 if no numbers are being pressed.
 int number_pressed() {
 int ret=-1;
// for(long i=KEY_0; i<=KEY_9; i++) {if(key_pressed(i)) {ret=i-KEY_0;}}
 if(key_pressed(KEY_0)) return 0;
 else if(key_pressed(KEY_1)) return 1;
 else if(key_pressed(KEY_2)) return 2;
 else if(key_pressed(KEY_3)) return 3;
 else if(key_pressed(KEY_4)) return 4;
 else if(key_pressed(KEY_5)) return 5;
 else if(key_pressed(KEY_6)) return 6;
 else if(key_pressed(KEY_7)) return 7;
 else if(key_pressed(KEY_8)) return 8;
 else if(key_pressed(KEY_9)) return 9;

 else if((key_down(KEY_LMENU))&&(key_down(KEY_F4))) exit();
 return ret;
 }// Number check.
 bool confirm(string message) {
 voice.speak_interrupt(message + " press y for yes, or n for no, or space to repeat the prompt.");
 if(braille%4!=0) show_game_window(message + " (Y/N)");
 while((!key_pressed(KEY_Y))&&(!key_pressed(KEY_N))) {
 wait(5);
 if(key_pressed(KEY_SPACE)) voice.speak_interrupt(message);
 else if((key_down(KEY_LMENU))&&(key_down(KEY_F4))) exit();
 else if((key_pressed(KEY_LCONTROL))||(key_pressed(KEY_RCONTROL))) voice.stop();
 }

 return key_down(KEY_Y);
 }// Confirm.

