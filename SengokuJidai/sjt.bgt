}
 else {
 me.gloc.map[p.x][p.y]=clear; me.gloc.map[targetPoint.x][targetPoint.y]=boulder;
 }
 EchoD echo("sfx/manyRocks.ogg");
 echo.x=p.x; echo.y=p.y;
 echoes.insert_last(echo);
 // Any people in the path of the boulder are injured.
 for(uint tci=0; tci<me.gloc.chars.length(); tci++) {
 if((me.gloc.chars[tci].x==targetPoint.x)&&(me.gloc.chars[tci].y==targetPoint.y)) {
 me.gloc.chars[tci].sounds.insert_last("sfx/HITMK.wav");
 double mydmg=random(3, 13);
 if(me.gloc.chars[tci].hasArmor) mydmg-=random(0, 3);
 if(me.gloc.chars[tci].hasShield) mydmg-=random(1, 7);
 me.gloc.chars[tci].hp-=mydmg;
}// hit.
 }// Loop to find people to hit.
}// Open space.
}// In range.
}// Push boulders.
 // Rarely, strong kanabo strikes can cause walls to collapse.
 else if((cur==castle_wall)&&(cur!=broken_wall)&&(me.weapon<me.weapons.length())&&(me.weapons[me.weapon]=="kanabo")&&(me.charged>0.5)&&(random(1, 7)==4)) {
 for(uint glass=0; glass<6; glass++) {
 EchoD echo("sfx/icebreak" + glass + ".ogg", p.x, p.y, random(-20, 0), 0.05*random(0, 10), random(80, 105));
 echoes.insert_last(echo);
}// Shattering sounds.
 me.gloc.map[p.x][p.y]=broken_wall;
}// Broken wall.
}// Loop for interacting with the environment.
 me.charged=0.0;
 }// Attacking. The agony.
 else if(me.state==recovering) {me.state=standing;
 string toplay="f"; if(me.male) toplay="m";
 me.sounds.insert_last("voice/breath_" + toplay + ".wav");
 }// Recovered.
 else if(me.state==sepuku) {
// me.state="dead";
 me.hp=-1.0; me.counter=0.0; me.sounds.insert_last("sfx/gutspray.wav");
