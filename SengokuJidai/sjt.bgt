 if((absolute(v.x-me.x)>1)||(absolute(me.y-v.y)>1)||(@(me.shogun)==@(v.shogun))||(@(me.daimyou)==@(v.daimyou))) continue;
// Does not work if they're facing you. That makes them likely to take you as an enemy.
bool found=false;
 if(me.x>v.x) {
if(v.face=="e") found=true;
 else if((me.y<v.y)&&(v.face=="ne")) found=true;
