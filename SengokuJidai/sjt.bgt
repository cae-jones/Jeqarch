 else if(key_pressed(KEY_DOWN)) hy++;
 else hspeak=false;
 if(hx<me.x-order_range) hx=me.x-order_range; else if(hx>me.x+order_range) hx=me.x+order_range;
 if(hy<me.y-order_range) hy=me.y-order_range; else if(hy>me.y+order_range) hy=me.y+order_range;

 if(hspeak) {
