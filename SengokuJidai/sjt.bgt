  if(me.weapons[me.weapon]=="black-egg") {
 for(uint rider=0; rider<me.gloc.chars.length(); rider++) {
 if((me.gloc.chars[rider].riding)&&(me.gloc.chars[rider].x==p.x)&&(me.gloc.chars[rider].y==p.y)) {
 me.gloc.chars[rider].riding=false;
 me.gloc.chars[rider].state=recovering;
 me.gloc.chars[rider].counter=1.0;
 me.gloc.chars[rider].hp-=random(1, 5);
 string toplay="sfx/dirtfall.wav";
 if(me.gloc.type=="planes") toplay="sfx/grassfall1.wav";
 else if(me.gloc.type=="ocean") toplay="sfx/pikkonfall.wav";
 if(me.gloc.weather=="snow") toplay="sfx/snowfall.wav";
 me.gloc.chars[rider].sounds.insert_last(toplay);
 pool.play_2d("sfx/horse.wav", cam.x, cam.y, p.x, p.y, false);
 }// Bucked.
}
 }// Buck.
 // Otherwise, only blades can kill horses.
 else if((me.weapons[me.weapon]=="katana")||(me.weapons[me.weapon]=="tanto")||(me.weapons[me.weapon]=="shuriken")||(me.weapons[me.weapon]=="wakazushi")) {
 me.gloc.map[p.x][p.y]=clear;
 EchoD echo("sfx/squish1.ogg", p.x, p.y, 0, 0.15, random(80, 110));
