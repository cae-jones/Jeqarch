#include "world.bgt"
#include "c:\\bgincludes\\stdlib.bgt" //?
#include "c:\\bgincludes\\game.bgt"
#include "c:\\bgincludes\\keyconfig.bgt"
#include "c:\\bgincludes\\JMenu.bgt"

enum locs {
	PG_MAIN, PG_OPTIONS, PG_GAME, PG_EDIT, PG_PAUSED,
	PG_SWING, PG_TAG, PG_SOCCER
};
const int K_FORWARD=0, K_BACK=1, K_LEFT=2, K_RIGHT=3,
          K_TURNLEFT=4, K_TURNRIGHT=5, K_ENTER=6, K_ACTION=7,
          K_INFO=8, K_PAUSE=9;
const ulong[] K_ARROWS = {KEY_UP, KEY_DOWN, KEY_LEFT, KEY_RIGHT};

class Playground : game {
	
	Person@ player;
	keyconfig@ keyc;
	V3DVector@ camera; // GRR.
	V3DVector@ ori; // Match player.theta.
	double master_theta=0.0; // Ugh. Ugh. Ughledy Ugh.
	int loc=PG_MAIN;
	int subloc=PG_GAME; // FOr minigames.
	custom_voice@ voice, npcvoice;
	// Do we want a different menu voice Vs NPC voice?
	
	Menu@ mainmenu;
	Map@ gloc=null;
	string[] kvf; // NPC voice files.
	
	// Minigame vars will be numerous. Maybe just use quickdict?
	
	Playground() {
		SoundManager.setLoadingDirectory("V3D\\bin\\");
		SoundManager.load();
		
		@camera=V3DVector(0,0,0);
		@ori=V3DVector(1,0,0);
		if(!file_exists("keyconfig.ini")) {
			string[] lines={
				"Move forward/jump:W", "Move backward:S", "Sidestep left:A", "Sidestep right:D", "Continuous turn left:Q", "Continuous turn right:E", "Interact:ENTER", "Action:SPACE", "Hear location:V", "Pause/unpause:ESC"
			};
			string txt = lines.length() + "\r\n";
			for(uint i=0; i<lines.length(); i++) txt += lines[i] + "\r\n";
			file fout;
			fout.open("keyconfig.ini", "w");
			fout.write(txt);
			fout.close();
		}
		@keyc=load_keyconfig("keyconfig.ini");
		custom_voice temp; @voice=temp;
		custom_voice npctemp; @npcvoice=npctemp;
		if(file_exists("voice.cfg")) voice.load_config("voice.cfg");
		voice.config_path="voice.cfg";
		if(file_exists("npcvoice.cfg")) npcvoice.load_config("npcvoice.cfg");
		npcvoice.config_path="npcvoice.cfg";
		this.kvf=find_files("voice/*.*");
		
		@mainmenu=newMenu("Main Menu");
		mainmenu.add("Play!", MENU_ENTER);
		mainmenu.add("Menu Voice Options", MENU_ENTER);
		mainmenu.add("NPC Voice Options", MENU_ENTER);
		// (...)
		mainmenu.add("Exit...", MENU_ENTER);
		
		this.reset(50);
		a.set("BGMVolume", -15);
		this.setLoc(PG_MAIN); // Music, announcements, whatever.
		this.start("Time for Recess!");
	}
	
	void key_pressed(int k) {
		if(k==KEY_F4 and (key_down(KEY_LMENU) or key_down(KEY_RMENU))) exit();
		int c = keyc.press(k);
		if(c<0 and loc!=PG_GAME) {
			c=K_ARROWS.find(k);
		}
		
		switch (loc) {
			case PG_MAIN :
			case PG_PAUSED : {
				if(c==K_FORWARD) mainmenu.selectPrevious();
				else if(c==K_BACK) mainmenu.selectNext();
				else if(k==K_LEFT) mainmenu.changeBy(-1);
				else if(c==K_RIGHT) mainmenu.changeBy(1);
				else if(c==K_ENTER or c==K_ACTION) {
					int n=mainmenu.selected;
					if(n==1) voice.options_menu();
					else if(n==2) npcvoice.options_menu();
					else if(n==mainmenu.items.length()-1) exit();
					else if(n==0) {
						//How does newGame work, anyway?
						if(this.gloc is null) {
							@(this.gloc)=default_map();
						}// What do?
						if(this.gloc is /*still*/ null) return;
						if(this.player is null or this.player.bounds is null) {
							Person me;
							@(this.player)=me;
							me.setGloc(this.gloc);
						}
						//if(@(this.player.gloc)!=@(this.gloc)) this.player.setGloc(this.gloc);
						// Umm. Missing anything?
						this.player.theta=this.ori.position;
						
						this.setLoc(PG_GAME);
					}//Play!
				}// Activate.
				else if(c==K_PAUSE and loc==PG_PAUSED) this.setLoc(PG_GAME);
				//if(mainmenu.toplay!="") pool.play_stationary(toplay, false);
				if(loc==PG_MAIN or loc==PG_PAUSED) voice.speak_interrupt(mainmenu.getCurrent().toString());
				
			}; break; //main menu.
			case PG_GAME : {
				if(c==K_PAUSE) this.setLoc(PG_PAUSED);
				else this.player_press(c);
			}; break; // Game.
			default : {
				voice.speak_interrupt("Unknown loc: " + this.loc + ". Returning to main menu.");
				this.loc=PG_MAIN;
			}// Error.
		}// Can we switch enums?
	}//Key Pressed.
	void setLoc(int tl) {
		
		int[] loops = {10, 13, 14, 15, 18, 20, 3, 4};
		if(tl==PG_GAME and random(0, 10)>5) nextTrack=sounds2 + "Ambient - High Quality/windlight_01.ogg";
		else nextTrack = DL + "fx/Complete Music/Loops/Loop " + loops[random(0, loops.length()-1)] + ".wav";
		if(nextTrack!=curbgm) crossfade(nextTrack, 1);
		this.loc=tl;
	}// Set Loc.
	
	void player_press(int c) {
		if(player is null) return;
		bool is2d=player.gloc.is_2d;
		if(key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)) {
			if(c==K_FORWARD) {
				double theta = arc_cosine(player.theta.x);
				if(player.theta.z<0.0) theta += PI;
				int closest=0;
				double[] dirs={0, PI/2.0, PI, 3.0*PI/2.0};
				for(uint i=0; i<dirs.length(); i++) {if(absolute(dirs[i]-theta)<absolute(dirs[closest]-theta)) closest=i;}
				string[] dirnames={"East", "North", "West", "South"};
				vector v(2.0*cosine(dirs[closest]), 0, 2.0*sine(dirs[closest]));
				V3DVector v3(v.x+camera.position.x, v.y+camera.position.y, v.z+camera.position.z);
				playsound(Swamp + "Nav/" + dirnames[closest] + ".wav", v3, false);
			}// I want to do the compass Swamp style...
			else if(c==K_LEFT) this.rotate(PI/4.0);
			else if(c==K_RIGHT) this.rotate(-PI/4.0);
			else if(c==K_BACK) this.rotate(PI);
			else if(c==K_INFO) {
				this.player.update_position();
				voice.speak(vecstr(player.position.position));
			}

		}// Shift.
		else if(this.subloc==PG_SWING) {
			// Hold the direction you're moving to accelerate? Hold the opposite direction to decelerate?
			// Seems sketchy.
		}// Swing.
		else if(c==K_INFO) {
			if(player.atop is null) {
				if(is2d and @(player.gloc.parent)!=null) voice.speak_interrupt("You are at the " + player.gloc.parent.name);
				else voice.speak_interrupt("You are on the playground.");
			}//Nothing?
			else voice.speak_interrupt("You are on the " + player.atop.name);
		}//V.
		else if(c==K_FORWARD) {
			if(is2d) {
				if(player.atop is null and !player.gloc.onGround(player.bounds)) {;} // Can't double-jump. Can we do something interesting this way?
				else if(((player.flags)&P_CLIMBING)!=0) player.v.y=player.climbY;
				else {
					string terrain=player.gloc.terrain;
					if(@(player.atop)!=null and player.atop.terrain!="") terrain=player.atop.terrain;
					player.addSound(getJump(terrain));
					player.v.y=player.jump;
					@(player.atop)=null; // Do we want any surfaces that react? Probably not.
				}//Jump.
			}// 2d.
			else player.v=player.theta*player.speed; // Is that all?
		}//Forward.
		else if(c==K_ENTER) {
			MObj@ o=null;
			if(@(player.atop)!=null and (((player.atop.flags)&MENTER)!=0)) @o=player.atop;
			else {
				rect@ r=cast<rect>(player.bounds.scale(2.5, 2.5)); // Give a little more reach.
				for(uint i=0; i<player.gloc.objs.length(); i++) {
					if(((player.gloc.objs[i].flags)&MENTER)!=0 and player.gloc.objs[i].intersects(r)) @o=player.gloc.objs[i];
				}//Loop for enterable objects.
			}// Find candidates in range. What is the range? Not sure.
			if(o is null) return;
			else this.enter_obj(player, o);
		}// Hmm.
		
	}// Player input.
	
	void rotate(double delta) {
		this.master_theta+=delta;
		if(this.master_theta<0) this.master_theta+=2.0*PI;
		else while(this.master_theta>=2.0*PI) this.master_theta-=2.0*PI;
		this.ori.setValues(cosine(this.master_theta), 0, sine(this.master_theta));
		// Update the player?
		if(@(this.player)!=null) {
			this.player.theta=this.ori.position;
			// Under what conditions do we not rotate V?
			double av=this.player.v.length();
			// Umm. We need direction on that v. And I don't think using sum_angles to rotate it is going to work. Otherwise, I wouldn't bother with master_theta.
			this.player.v=av*this.player.theta; // WRONG! You might be sidestepping or backstepping!
		}//Update player.
		SoundManager.setListenerPosition(this.camera, this.ori);
	}
	V3DSound@ playsound(string fn, V3DVector@ pose, bool looping=false) {
		V3DSound@ snd = getGlobalSB().load_sound(fn);
		if(snd is null) return snd;
		snd.stop();
		if(@pose!=null) snd.set3DPosition(pose);
		if(looping) snd.play_looped(true);
		else snd.play(true);
		return snd;
	}
	// I'd like for mapsounds to play rectangularly.
	
	void key_released(int k) {
		int c=keyc.release(k);
		if(this.loc==PG_GAME and @(this.player)!=null) {
			// Do we have friction, or do we just stop immediately?
			if(c==K_TURNLEFT or c==K_TURNRIGHT) a.set("spinv", 4.0); // Reset fast spin. Maybe the bottom should be lower?
			if(this.subloc==PG_SWING) {
				// I don't think it does anything in particular?
			}//Swing.
			else {
				Person@ me=this.player; // Tired of typing that.
				if(this.player.gloc is null or !(this.player.gloc.is_2d)) {
					if(c==K_FORWARD or c==K_BACK or c==K_LEFT or c==K_RIGHT) {
						if(key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)) return; // Never mind.
						me.v=vector(0,0,0);
						// Sigh. I'm going to need a setVForKeys method, because it just gets more and more confusing with rotate.
						this.setVForKeys();
					}// Directions.
				}// 3d.
				else {
					// Slides are the only real problem, aren't they?
					if(c==K_FORWARD and me.v.y>0.0) me.v.y=0.0; // Analog jumping. Almost want to voice it.
					else if(c==K_BACK) {
						// You could be hiding, crawling, or climbing. Otherwise, I don't think releasing it should do anything.
						if(((me.flags)&P_CLIMBING)!=0) me.v.y=0;
						else if(((me.flags)&P_HIDDEN)!=0) {
							me.flags&=~P_HIDDEN;
							// What sound do we play? The Swamp uncrouch sound seems a little weird.
						}// No longer hidden.
						// What happens if you try to uncrouch while crawling in a small space? Do you bump your head and get stunned for a few seconds?
						// Else do nothing, I guess.
					}//Releasing down in 2d.
					else if(c==K_LEFT or c==K_RIGHT) {
						if(me.atop is null or (((me.atop.flags)&MSLIDE)==0)) me.v.x=0.0;
						else if(@(me.atop)!=null) {
							//If you're moving against the slope, give up. Otherwise, Idk.
							if((((me.atop.flags)&MSLIDEDR)==MSLIDEDR and me.v.x<0 and c==K_LEFT) or
							(((me.atop.flags)&MSLIDEDL)==MSLIDEDL and me.v.x>0 and c==K_RIGHT)) me.v.x=0.0;
						}// Slides are so complifusing!
					}//Left and right... Hmmph.
				}// How does keyReleased work in 2D?
			}//Not in a minigame.
		}// Otherwise it doesn't really matter, does it?
	}//Key released.
	
	void setVForKeys() {
		/*Sets the player's velocity based on their theta and what keys are held.*/
		if(this.player is null) return;
		double theta=this.master_theta;
		//For composits, take the average?
		uint8 kds=3; // Maybe there should be an array for the rotations, to make things faster?
		if(keyc.key_down(K_LEFT)) theta+=PI/2.0;
		else if(keyc.key_down(K_RIGHT)) theta-=PI/2.0;
		else kds=2;
		if(keyc.key_down(K_FORWARD)) theta = (theta+this.master_theta)/2.0;
		else if(keyc.key_down(K_BACK)) {
			if(theta==this.master_theta) theta+=PI;
			else theta = (theta+PI)/2.0;
		}//Backward.
		else kds&=~2;
		if(kds==0) this.player.v=vector(0, this.player.v.y, 0);
		else this.player.v=this.player.speed*nv(cosine(theta), 0, sine(theta));
	}//Keep player v matching the keys.
	
	void tick(double dt) {
		dt*=0.001;
		
		SoundManager.update(); // Probably better to do that at the end of the frame, though?
		updatebgm();
		if(this.loc!=PG_GAME) {
			return;
		}// Hmm.
		
		Person@ me=this.player;
		if(me is null or me.gloc is null) {
			this.setLoc(PG_MAIN);
			voice.speak_interrupt("ERROR: null player or gloc. " + (me is null)); return;
		}//NPE.
		
		// In what situations do we step this.gloc and me.gloc?
		this.glocstep(me.gloc, dt);
		if(@(me.gloc)!=@(this.gloc)) {
			// Do we step this one, or not?
		}// Multiple glocs.
	}//Tick.
	
	void glocstep(Map@ g, double dt, bool muted=false) {
		if(g is null) return;
		// Let chars take priority over objects. I think that might have something to do with why Swamp platforms are screwy.
		for(uint i=0; i<g.chars.length(); i++) {
			this.stepChar(g.chars[i], dt, muted);
		}// Char loop.
		for(uint i=0; i<g.objs.length(); i++) {
			MObj@ o = g.objs[i];
			if((!muted) and (o.snd is null or !(o.snd.isPlaying())) and o.snd_fn!="" and file_exists(o.snd_fn)) {
				o.update_position(!g.is_2d);
				if(o.snd is null) @(o.snd) = this.playsound(o.snd_fn, o.position, true);
			}//Play the sound?
			// Todo: Rectangular sounds?
			if(((o.flags)&MMOVING)==0) {
				continue;
			}//Fixed objects probably shouldn't do anything.
			else {
				vector v(o.v.x, o.v.y, o.v.z);
				o.step(dt); // Hmm. Need to figure out how angle of deflection is supposed to work.
				if(v!=o.v) {
				}//Bump
			}//Moving objects.
		}//Objs loop.
		g.update_all();
	}// Glocstep
	
	void stepChar(Person@ me, double dt, bool muted=false) {
		if(me is null) return;
		if(me.position is null) me.update_position();
		double x = me.position.getX(), y=me.position.getY(), z=me.position.getZ();
		me.step(dt);
		if(!muted) for(uint i=0; i<me.sounds.length(); i++) {
			playsound(me.sounds[i], me.position, false);
		}// Sounds.
		me.sounds.resize(0);
		if(me is this.player) {
			bool updatev=true;
			//Anything that blocks updating? Slipping, sliding, falling, etc?
			bool shifts=(key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT));
			if(updatev and !shifts) this.setVForKeys();
			// Turning:
			
			if(keyc.key_down(K_TURNLEFT) or keyc.key_down(K_TURNRIGHT)) {
				double delta=2.0;
				if(shifts) {
					delta=getd("spinv");
					if(delta<3.0) delta=4.0;
					else if(delta>=8.0) delta=8.0;
					a.set("spinv", delta+dt); // Maybe a fraction of dt?
				}//Spin faster.
				
				this.rotate(delta*dt);
				
			}// Turning.
			
			me.update_position(!me.gloc.is_2d);
			if(me.position.position != camera.position) {
				camera.setValues(me.position.getX(), me.position.getY(), me.position.getZ());
				//Orientation? ... Fmodex doesn't use east as the positive x axis, does it?
				SoundManager.setListenerPosition(camera, ori);
			}//Update camera.
		}// What to do with players?
		else {
			int f=game_clock.frame%50;
			// We did not send the index of this char in the gloc array, and we really should have. Now, AI and voices will play at the same time if we don't get it ourselves.
			int i =random(0, 10);
			if(@(me.gloc)!=null) i = me.gloc.chars.find(me); // @me?
			if(i<0) i=random(0, 5);
			if(me.snd is null) {
				if(f==i and ((me.flags)&P_HIDDEN)==0) {
					// While cutting off vocals isn't too outlandish, it is a good idea to minimize it.
					int tries=0;
					uint l = this.kvf.length()-1;
					string toplay=this.kvf[random(0, l)];
					V3DSound@ snd=getGlobalSB().load_sound(toplay);
					while((snd is null or snd.isPlaying()) and tries<10) {
						tries++;
						toplay=this.kvf[random(0, l)];
						@snd=globalSB.load_sound(toplay);
					}// Find a suitable sound.
					me.update_position();
					@(me.snd)=snd;
					if(@snd!=null) {
						snd.stop();
						snd.set3DPosition(me.position);
						snd.play(true);
					}
				}// Play sound?
				else {

				}// What to do when quiet?
			}// Sounds they can make.
			else if(!me.snd.isPlaying()) {
				// We probably want to remove the reference, and let the sound_buffer keep it in memory.
				// Otherwise, sounds will bounce around even when only one char should be playing it.
				@(me.snd)=null;
			}// Sound has stopped.
			
			// When do we want to update AI?
			// And what does AI do?
			// Well, we want to stay inside the map. If we are not inside the map, we need to aim for a spot inside the map.
			//And it differs depending on if this map is 2d or 3d.
			if(me.gloc is null) me.setGloc(this.gloc); // How?
			if(me.gloc.is_2d) {

			}//2D AI.
			else {
				// Subloc should affect AI, shouldn't it?
				// But let's just have people run around more or less at random if subloc is game.
				// Maybe toward specific people or equipment, since they might have friends / goals / whatever.
				
			}// 3D AI.

		}// What to do with NPCs?
		
	}// StepChar.
	
	Map@ default_map() {
		Map ret(400,200);
		ret.is_2d=false;
		ret.terrain="Grass";
		MObj@ o=newObj("Blacktop", new_rect(25, 25, 200, 50), "Concrete");
		o.snd_fn=sounds2 + "sounds2/Children Playing-SoundBible.com-591301488.wav"; // Really want rectangles for these...
		o.flags=0;
		ret.add(o);
		double h2=o.bounds.height/2.0, w2=o.bounds.width/2.0;
		double btop=o.bounds.y+h2, bbottom=o.bounds.y-h2, bleft=o.bounds.x-w2, bright=o.bounds.x+w2;
		@o=newObj("Sidewalk", rect_tl(bleft, btop, 4, ret.top-btop), "Concrete");
		o.flags=0;
		ret.add(o);
		// I feel like the Peagravel Pit without having to jump the boundaries is hardly the peagravel pit at all. So I have to make those, I guess, since this system does not support subtraction. ... It should totally support subtraction.
		@o=newObj("Peagravel Pit", rect_tl(bright, bbottom, h2*2, h2*2), "Rock");
		ret.add(o);
		// Ugh. I need to make jumping to get the ties, don't I?
		@o=newObj("Sidewalk", rect_tl(bright+(h2*2)-4, btop, 4, ret.top-btop), "Concrete");
		ret.add(o);
		// Crap, I want to add trees, but those will slow things down dramatically. Maybe make 3d submaps autoenter?
		return ret;
	}//Default map for testing?
	
	void enter_obj(Person@ me, MObj@ o) {
		
	}// Enter Obj.
}

void main() {
	Playground pg;
}