/**
* BGT header file for the BASS library.
* This file contains the constants and signatures of some of the library functions.
* For more information, see the documentation for the BASS library.
*/

/* BASS_Init flags */
const uint BASS_DEVICE_8BITS	=	1;
const uint BASS_DEVICE_MONO	=	2;
const uint BASS_DEVICE_3D = 4;
const uint BASS_DEVICE_LATENCY		= 256	;

// Load sample flags.
const uint BASS_SAMPLE_8BITS	= 1;	// 8 bit
const uint BASS_SAMPLE_FLOAT	= 256;	// 32-bit floating-point
const uint BASS_SAMPLE_MONO		= 2;	// mono
const uint BASS_SAMPLE_LOOP		= 4;	// looped
const uint BASS_SAMPLE_3D		=8;	// 3D functionality
const uint BASS_SAMPLE_SOFTWARE	=16;	// not using hardware mixing
const uint BASS_SAMPLE_MUTEMAX		=32;	// mute at max distance (3D only)
const uint BASS_SAMPLE_VAM			=64;	// DX7 voice allocation & management
const uint BASS_SAMPLE_FX			=128;	// old implementation of DX8 effects
const uint BASS_SAMPLE_OVER_VOL	=0x10000;	// override lowest volume
const uint BASS_SAMPLE_OVER_POS = 0x20000; // override longest playing
const uint BASS_SAMPLE_OVER_DIST	=0x30000; // override furthest from listener (3D only)

//Seeking flags
const int BASS_POS_BYTE          =0;        // byte position


const string BASS_GetVersion = "int BASS_GetVersion();";
const string BASS_Init = "BOOL  BASS_Init(int, unsigned int, unsigned int, void*, void*);";
const string BASS_Free = "void 	BASS_Free();";
const string BASS_SetDevice = "int BASS_SetDevice(unsigned int);";
const string BASS_GetDevice = "unsigned int BASS_GetDevice()";
const string BASS_Start = "BOOL BASS_Start();";
const string BASS_Stop = "BOOL BASS_Stop();";
const string BASS_Pause = "BOOL BASS_Pause();";
const string BASS_SetVolume = "BOOL BASS_SetVolume(float);";
const string BASS_Set3DFactors = "BOOL BASS_Set3DFactors(float,float,float);";
const string BASS_Set3DPosition = "BOOL BASS_Set3DPosition(int,int,int,int);";
const string BASS_Get3DPosition = "BOOL BASS_Get3DPosition(int*,int*,int*,int*);";

const string BASS_Apply3D = "BOOL BASS_Apply3D();";

/* sample */
const string BASS_SampleLoad = "unsigned int   BASS_SampleLoad(BOOL,char*,int,int, unsigned int,unsigned int, unsigned int);";
const string BASS_SampleGetChannel = "int BASS_SampleGetChannel(unsigned int,int);";
const string BASS_SampleFree = "BOOL BASS_SampleFree(unsigned int);";
const string BASS_SampleSetData = "BOOL BASS_SampleSetData(unsigned int,void*);";
const string BASS_SampleGetData = "BOOL BASS_SampleGetData(unsigned int,void*);";
const string BASS_SampleStop = "BOOL BASS_SampleStop(unsigned int);";


/* channel */
const string BASS_ChannelIsActive = "BOOL BASS_ChannelIsActive(unsigned int);";
const string BASS_ChannelPlay = "BOOL BASS_ChannelPlay(unsigned int, int);";
const string BASS_ChannelStop = "BOOL BASS_ChannelStop(unsigned int);";
const string BASS_ChannelPause = "BOOL BASS_ChannelPause(unsigned int);";
const string BASS_ChannelSetAttribute = "BOOL BASS_ChannelSetAttribute(unsigned int,unsigned int,float);";
const string BASS_ChannelGetAttribute= "BOOL BASS_ChannelGetAttribute(unsigned int,unsigned int,float*);";
const string BASS_ChannelSet3DAttributes = "BOOL BASS_ChannelSet3DAttributes(unsigned int,int,float,float,int,int,float);";
const string BASS_ChannelGet3DAttributes = "BOOL BASS_ChannelGet3DAttributes(unsigned int,int*,float*,float*,int*,int*,float*);";
const string BASS_ChannelSet3DPosition = "BOOL BASS_ChannelSet3DPosition(unsigned int,int,void*,void*);";
const string BASS_ChannelGet3DPosition = "BOOL BASS_ChannelGet3DPosition(unsigned int,void*,void*,void*);";
const string BASS_ChannelSetPosition = "BOOL BASS_ChannelSetPosition(int,int,int,int);";
const string BASS_ChannelGetLength = "int* BASS_ChannelGetLength(int,int);";
const string BASS_ChannelFlags = "unsigned int BASS_ChannelFlags(unsigned int handle, unsigned int flags, unsigned int mask);";


const string BASS_ErrorGetCode = "int BASS_ErrorGetCode();";
