void find_food_source(Actor@ me) {
	if(me is null) return;
	if(me.meat+me.sake+me.sushi+me.fruit+me.vegies > 0) {
	}// Eat.
	// Check if we have a net for fishing.
	if(st is null) return;
	Item@ closest_food = null;
	double best_distance = 1000000;
	for(uint i=0; i<st.items.length(); i++) {
		Item@ it = st.items[i];
		if (it is null or it.category!=9) continue;
		double distance = len2(it.pose-me.pose);
		if(closest_food is null or distance<best_distance) {
			@closest_food = it;
			best_distance = distance;
		}
	}
	if(@closest_food != null) {
		me.dest = closest_food.pose;
		st.pathfind(st.actors.find(me), me.dest);
	}
}

void handle_feeding_behavior(Actor@ me) {
					bool eaten=false;
					string[] foods = {"Meat", "Sushi", "Vegies", "Fruit", "Sake"};
					int[] vals = {me.meat, me.sushi, me.vegies, me.fruit, me.sake};
					int wf = random(0, 4);
					while(foods.length()>0 and vals[wf]<=0) {
						vals.remove_at(wf);
						foods.remove_at(wf);
						if(foods.length()==1) wf=0;
						else if(foods.length()>1) wf = random(0, foods.length()-1);
						else break;
					}
					if(wf>=0 and wf<vals.length() and vals[wf]>0) {
						int wi = me.inv_find(foods[wf]);
						if(wi<0) {
							// I don't feel like copy-editing the eat code from Actor::setState, so we're doing this instead:
							if(foods[wf]=="Sake") {
								me.sake--;
								me.food+=25;
								me.drunk+=25;
							}
							else {
								me.food=100.0;
							if(foods[wf]=="Sushi") me.sushi--;
								else if(foods[wf]=="Vegies") me.vegies--;
								else if(foods[wf]=="Fruit") me.fruit--;
								else me.meat--;
							}
						}// We have the ammo, but not the item.
						else {
							@(me.weapon)=me.inv[wi];
							me.setState(attacking);
						}
						eaten=true;
					}// Foun something to eat.
					if(!eaten) {
						if((me.mission==WANDER)||(me.rank==ASHIGARU)||(me.rank==SHINOBI)||(me.rank==KODOMO)||(me.rank==INU)) me.mission=FEED;
						else if((me.mission==HALT or me.mission==DEFEND) and me.inv_find("Net")>=0 and string_contains("Wade Water Swamp Swim2", st.get_terrain(me.pose), 1)>=0) {
							st.getItem(me, get_item("Sushi"));
						}// Looking for food without moving.
						else if(me.path.length()>0) st.navigate(me);
						else {
							for(uint i=0; i<st.items.length(); i++) {
								Item@ it = st.items[i];
								if(it is null or it.category!=9 or len2(it.pose-me.pose)>100) continue;
								st.getItem(me, it);
								st.items.remove_at(i);
							}
						}//Gather food from nearby.
					}// What to do if you don't have any food.
					else if(me.food>20) me.mission = (me.leader is null) ? WANDER : me.leader.mission;

}// Feed.

void handle_attack_mission(Actor@ me) {
    // First, verify if we still have a valid target
    if(@me.target != null && me.target.hp > 0) {
        // Check if the target is still valid based on leadership hierarchy
        if(!is_same_faction(me, me.target)) {
            // Continue attacking the current target
            engage_target(me, me.target);
            return;
        } else {
            // Target is now invalid (leadership changes)
            @me.target = null;
        }
    }
    
    // Finding a new target with priority: enemy leaders/followers > zombies > unaffiliated
    Actor@ enemy_target = null;
    Actor@ zombie_target = null;
    Actor@ unaffiliated_target = null;
    double enemy_distance = 1000000;
    double zombie_distance = 1000000;
    double unaffiliated_distance = 1000000;
    int best_unaffiliated_rank = -1;
    
    for(uint i=0; i<st.actors.length(); i++) {
        Actor@ potential_target = st.actors[i];
        if(potential_target is null || @potential_target == @me || potential_target.hp <= 0) continue;
        
        double distance = len2(potential_target.pose - me.pose);
        
        // Check range (don't chase targets too far away)
        if(distance > 10000) continue;
        
        if(potential_target.rank == ZOMBIE) {
            // Zombie target
            if(distance < zombie_distance) {
                @zombie_target = potential_target;
                zombie_distance = distance;
            }
        } else if(!is_same_faction(me, potential_target)) {
            // Enemy faction target (with leadership hierarchy consideration)
            if(distance < enemy_distance) {
                @enemy_target = potential_target;
                enemy_distance = distance;
            }
        } else if(@potential_target.leader == null && @me.leader != null) {
            // Unaffiliated target - prioritize by rank (higher rank = higher priority)
            if(best_unaffiliated_rank < potential_target.rank || 
               (best_unaffiliated_rank == potential_target.rank && distance < unaffiliated_distance)) {
                @unaffiliated_target = potential_target;
                unaffiliated_distance = distance;
                best_unaffiliated_rank = potential_target.rank;
            }
        }
    }
    
    // Set the target based on priority
    if(@enemy_target != null) {
        @me.target = enemy_target;
    } else if(@zombie_target != null) {
        @me.target = zombie_target;
    } else if(@unaffiliated_target != null) {
        @me.target = unaffiliated_target;
    } else {
        // No valid targets - continue patrolling or return to base
        if(random(0, 10) < 5) {
            me.mission = WANDER;
        } else {
            me.mission = RETURN;
        }
        return;
    }
    
    // Engage the selected target
    engage_target(me, me.target);
}

void handle_defend_mission(Actor@ me) {
    // Determine home location
    vector home_location = me.home;
    
    // If leader has a different home, use that instead
    if(@me.leader != null && len2(me.leader.home - vector(0,0,0)) > 0 && 
       len2(me.leader.home - me.home) > 0) {
        home_location = me.leader.home;
    }
    
    // If no valid home, switch to follow mission
    if(len2(home_location - vector(0,0,0)) == 0) {
        me.mission = FOLLOW;
        handle_follow_behavior(me);
        return;
    }
    
    // Check if we're under attack
    bool under_attack = check_if_under_attack(me);
    if(under_attack) {
        Actor@ attacker = find_attacker(me);
        if(@attacker != null) {
            @me.target = attacker;
            engage_target(me, attacker);
            return;
        }
    }
    
    // Check if allies need help
    if(random(0, 15) == 0) {  // Occasional check to avoid constant ally checking
        Actor@ ally_in_need = check_allies_under_attack(me);
        if(@ally_in_need != null) {
            // Go help the ally
            me.dest = ally_in_need.pose;
            if(len2(me.pose - ally_in_need.pose) > 100) {
                st.pathfind(st.actors.find(me), ally_in_need.pose);
            } else {
                me.setState(walking);
                vector dir = ally_in_need.pose - me.pose;
                dir.y = 0;
                if(dir.length() > 0) {
                    me.face = dir / dir.length();
                }
            }
            return;
        }
    }
    
    // Look for enemies within the patrol area
    Actor@ nearby_enemy = null;
    double enemy_distance = 1000000;
    
    for(uint i=0; i<st.actors.length(); i++) {
        Actor@ potential_enemy = st.actors[i];
        if(potential_enemy is null || potential_enemy.hp <= 0) continue;
        
        // Calculate distance from home rather than from actor
        double distance_from_home = len2(potential_enemy.pose - home_location);
        
        // If enemy is in range of home
        if(distance_from_home <= 100) {
            if(potential_enemy.rank == ZOMBIE || !is_same_faction(me, potential_enemy)) {
                double distance_from_me = len2(potential_enemy.pose - me.pose);
                if(distance_from_me < enemy_distance) {
                    @nearby_enemy = potential_enemy;
                    enemy_distance = distance_from_me;
                }
            }
        }
    }
    
    // If found an enemy in patrol range, attack
    if(@nearby_enemy != null) {
        @me.target = nearby_enemy;
        engage_target(me, nearby_enemy);
        return;
    }
    
    // No enemies - patrol the area
    patrol_around_home(me, home_location);
}

// Helper functions

bool is_same_faction(Actor@ actor1, Actor@ actor2) {
    // Check direct leadership relationship
    if(@actor1.leader == @actor2 || @actor2.leader == @actor1) {
        return true;
    }
    
    // Get top leaders
    Actor@ leader1 = actor1.getLeader();
    Actor@ leader2 = actor2.getLeader();
    
    // If either has no leader, they're not in same faction
    if(@leader1 == null && @actor1.leader == null && 
       @leader2 == null && @actor2.leader == null) {
        return false;
    }
    
    // If one has a leader and other doesn't
    if((@leader1 == null && @actor1.leader == null) || 
       (@leader2 == null && @actor2.leader == null)) {
        return false;
    }
    
    // Compare top leaders
    return @leader1 == @leader2;
}

void engage_target(Actor@ me, Actor@ target) {
    // Update destination
    me.dest = target.pose;
    
    // Calculate distance
    double distance = len2(target.pose - me.pose);
    
    if(distance <= 100) {
        // Close enough to directly approach
        vector dir = target.pose - me.pose;
        dir.y = 0;
        if(dir.length() > 0) {
            me.face = dir / dir.length();
        }
        
        // Choose weapon based on distance
        select_combat_weapon(me, distance);
        
        // If in attack range, attack
        double attack_range = me.height() / 2;
        if(@me.weapon != null) {
            attack_range += me.weapon.range;
        }
        
        if(distance <= attack_range * attack_range) {
            // In attack range - engage
            if(me.state != attacking && me.state != charging) {
                me.setState(charging);
                me.charged = 0.3 + (random(0, 7) * 0.1);
                
                // Release attack after a short charge
                if(random(0, 10) > 5) {
                    me.charged = 0.7 + (random(0, 3) * 0.1);
                    me.setState(attacking);
                }
            }
        } else {
            // Move toward target
            me.setState(walking);
            
            // Occasionally use jumping to close distance faster
            if(random(0, 20) == 0 && me.onGround()) {
                me.setState(JUMPING|walking);
            }
        }
    } else {
        // Too far - pathfind
        if(me.path.length() == 0 || st.game_clock.frame % 50 == 0) {
            st.pathfind(st.actors.find(me), target.pose);
        }
    }
}

Actor@ find_attacker(Actor@ me) {
    for(uint i=0; i<st.actors.length(); i++) {
        Actor@ potential_attacker = st.actors[i];
        if(potential_attacker is null || @potential_attacker == @me) continue;
        
        if(potential_attacker.state == attacking || potential_attacker.state == charging) {
            // Check if attack is aimed at this actor
            double attack_range = potential_attacker.height() + 
                (@(potential_attacker.weapon) != null ? potential_attacker.weapon.range : potential_attacker.height());
            
            if(len2(potential_attacker.pose - me.pose) <= attack_range * attack_range) {
                // Check if attacker is facing this actor
                vector direction = me.pose - potential_attacker.pose;
                direction.y = 0;
                if(direction.length() > 0) {
                    direction = direction / direction.length();
                    // Dot product for direction check
                    double facing_dot = potential_attacker.face.x * direction.x + 
                                        potential_attacker.face.z * direction.z;
                    
                    if(facing_dot > 0.5) { // Roughly in the same direction
                        return potential_attacker;
                    }
                }
            }
        }
    }
    return null;
}

Actor@ check_allies_under_attack(Actor@ me) {
    for(uint i=0; i<st.actors.length(); i++) {
        Actor@ ally = st.actors[i];
        if(ally is null || @ally == @me || ally.hp <= 0) continue;
        
        // Check if they're in same faction
        if(!is_same_faction(me, ally)) continue;
        
        // Check if they're being attacked
        if(check_if_under_attack(ally)) {
            return ally;
        }
    }
    return null;
}

void patrol_around_home(Actor@ me, vector home_location) {
    // If we're far from home, go back
    double distance_from_home = len2(me.pose - home_location);
    
    if(distance_from_home > 100) {
        // Return to home
        me.dest = home_location;
        if(me.path.length() == 0) {
            st.pathfind(st.actors.find(me), home_location);
        }
    } else {
        // Patrol around home
        if(me.path.length() == 0 && random(0, 10) == 0) {
            // Generate a random patrol point around home
            double angle = random(0, 628) / 100.0; // Random angle 0-2p
            double radius = random(3, 10);
            
            vector patrol_point = home_location + 
                vector(cosine(angle) * radius, 0, sine(angle) * radius);
            
            // Ensure the point is valid
            int x = floor(patrol_point.x / 10);
            int z = floor(patrol_point.z / 10);
            
            if(x >= 0 && z >= 0 && x < st.map.length() && z < st.map[0].length() && 
               st.map[x][z] != "") {
                me.dest = patrol_point;
                st.pathfind(st.actors.find(me), patrol_point);
            }
        }
    }
    
    // Move along the path
    if(me.path.length() > 0) {
        st.navigate(me);
    } else if(len2(me.dest - me.pose) > 4) {
        vector dir = me.dest - me.pose;
        dir.y = 0;
        if(dir.length() > 0) {
            me.face = dir / dir.length();
        }
        me.setState(walking);
    } else {
        // At patrol point, occasionally look around
        if(random(0, 20) == 0) {
            double look_angle = random(0, 628) / 100.0;
            me.face = vector(cosine(look_angle), 0, sine(look_angle));
        }
    }
}

void select_combat_weapon(Actor@ me, double distance) {
    // Find suitable weapon based on distance
    if(@me.weapon == null || 
       (distance < 16 && (me.weapon.category == 2 || me.weapon.category == 6)) || // Too close for ranged
       (distance > 16 && me.weapon.category != 2 && me.weapon.category != 6)) {   // Too far for melee
        
        Item@ best_weapon = null;
        double best_score = -1;
        
        for(uint i=0; i<me.inv.length(); i++) {
            if(me.inv[i] is null) continue;
            
            double score = 0;
            
            // Distance scoring
            if(distance <= 16) { // Close range
                if(me.inv[i].category == 0) score += 5; // Swords
                else if(me.inv[i].category == 3) score += 4; // Heavy weapons
                else if(me.inv[i].category == 5) score += 3; // Staff
            } else { // Long range
                if(me.inv[i].category == 2 && me.arrows > 0) score += 5; // Bows
                else if(me.inv[i].category == 6) {
                    if(me.inv[i].name == "Shuriken" && me.shuriken > 0) score += 4;
                    else if(me.inv[i].name == "Kunai" && me.kunai > 0) score += 4;
                    else if(me.inv[i].name == "Blow-dart" && me.darts > 0) score += 4;
                }
            }
            
            // Role appropriate weapons
            if(me.rank == SAMURAI && me.inv[i].category == 0) score += 2;
            if(me.rank == SHINOBI && me.inv[i].category == 6) score += 2;
            
            if(score > best_score) {
                best_score = score;
                @best_weapon = me.inv[i];
            }
        }
        
        if(@best_weapon != null) {
            @me.weapon = best_weapon;
            if(me.weapon.drawsound != "") {
                me.sounds.insert_last(me.weapon.drawsound);
            }
        }
    }
}

void handle_follow_behavior(Actor@ me) {
	if(me is null or st is null) return;
	Actor@ leader = me.leader;
	if(leader is null) @leader = me.target;
	if(leader is null) {
		me.mission = WANDER;
		return;
	}
	double distance = len2(me.pose-leader.pose);
	if(distance>100) {
		if(me.path.length() < distance/100) st.pathfind(st.actors.find(me), leader.pose);
	}
	st.navigate(me);
}

void handle_recruit_mission(Actor@ me) {
    // Check if already has a target
    if(@me.target != null && me.target.hp > 0) {
        // Verify target is still valid for recruitment
        bool valid_target = (@me.target.leader == null || @me.target.leader == @me) && 
                            !is_same_faction(me, me.target);
        
        if(valid_target) {
            if(len2(me.pose - me.target.pose) <= 16) {
                // Close enough to attempt recruitment
                attempt_recruitment(me, me.target);
            } else {
                // Navigate to target
                approach_recruit(me, me.target);
            }
            return;
        } else {
            // Target is no longer valid (has been recruited by someone else)
            @me.target = null;
        }
    }
    
    // Find a new recruitment target
    find_recruitment_target(me);
    
    // If found a target, approach
    if(@me.target != null) {
        approach_recruit(me, me.target);
    } else {
        // No targets found - switch to wandering and search
        if(random(0, 10) > 5) {
            me.mission = WANDER;
        } else {
            // Continue searching by moving to a new area
            vector new_dest = st.floortiles[random(0, st.floortiles.length()-1)] * 10;
            me.dest = new_dest;
            st.pathfind(st.actors.find(me), new_dest);
        }
    }
}

void find_recruitment_target(Actor@ me) {
    Actor@ best_target = null;
    double best_distance = 1000000;
    
    for(uint i=0; i<st.actors.length(); i++) {
        Actor@ potential_recruit = st.actors[i];
        
        // Skip invalid recruits
        if(potential_recruit is null || 
           @potential_recruit == @me || 
           potential_recruit.hp <= 0 || 
           potential_recruit.rank == ZOMBIE || 
           is_same_faction(me, potential_recruit)) continue;
        
        // Only target unaffiliated actors (no leader or followers)
        bool is_unaffiliated = @potential_recruit.leader == null;
        bool has_no_followers = st.countFollowers(potential_recruit) == 0;
        
        // Special case: can recruit those with followers if you're higher rank
        if(!is_unaffiliated && !has_no_followers) {
            if(me.rank <= potential_recruit.rank) continue;
        }
        
        // Calculate score based on distance and desirability
        double distance = len2(potential_recruit.pose - me.pose);
        if(distance > 400) continue; // Too far
        
        // Adjust distance by desirability factor
        double adjusted_distance = distance;
        
        // Prefer higher ranks (except Daimyou which should be left alone)
        if(potential_recruit.rank < DAIMYOU) {
            adjusted_distance *= (1.0 - (potential_recruit.rank * 0.1));
        }
        
        // Prefer those with weapons or food
        if(potential_recruit.inv.length() > 0) {
            adjusted_distance *= 0.8;
        }
        
        // Prefer same rank
        if(potential_recruit.rank == me.rank) {
            adjusted_distance *= 0.7;
        }
        
        if(adjusted_distance < best_distance) {
            @best_target = potential_recruit;
            best_distance = adjusted_distance;
        }
    }
    
    // Also check for animals (dogs and horses)
    for(uint i=0; i<st.actors.length(); i++) {
        Actor@ animal = st.actors[i];
        if(animal is null || animal.hp <= 0) continue;
        
        if((animal.rank == INU || animal.rank == MOUNT) && 
           @animal.leader == null && 
           !is_same_faction(me, animal)) {
            
            double distance = len2(animal.pose - me.pose);
            if(distance < best_distance) {
                @best_target = animal;
                best_distance = distance;
            }
        }
    }
    
    @me.target = best_target;
}

void approach_recruit(Actor@ me, Actor@ target) {
    // Update destination
    me.dest = target.pose;
    
    // Check for items along the way
    check_for_items_on_path(me);
    
    // Calculate distance
    double distance = len2(target.pose - me.pose);
    
    if(distance <= 100) {
        // Close enough to directly approach
        vector dir = target.pose - me.pose;
        dir.y = 0;
        if(dir.length() > 0) {
            me.face = dir / dir.length();
        }
        
        // Walk toward target
        me.setState(walking);
    } else {
        // Too far - pathfind
        if(me.path.length() == 0) {
            st.pathfind(st.actors.find(me), target.pose);
        }
    }
}

void check_for_items_on_path(Actor@ me) {
    // Check for nearby items to collect
    for(uint i=0; i<st.items.length(); i++) {
        if(st.items[i] is null) continue;
        
        double distance = len2(st.items[i].pose - me.pose);
        if(distance <= 25) {
            // Item is close - collect it
            st.getItem(me, st.items[i]);
            st.items.remove_at(i);
            return; // Only collect one item per call
        }
    }
}

void attempt_recruitment(Actor@ me, Actor@ target, Item@ gift_item = null) {
    // Find a suitable gift to offer
    if(gift_item is null) @gift_item = find_suitable_gift(me, target);
    
    if(@gift_item == null) {
        // No suitable gift available
        if(random(0, 10) > 5) {
            // Try again later - keep the target
            return;
        } else {
            // Give up on this target
            @me.target = null;
            me.mission = WANDER;
            return;
        }
    }
    
    // Calculate acceptance chance
    double acceptance_chance = calculate_acceptance_chance(me, target, gift_item);
    
    // Determine if recruitment succeeds
    if(random(0, 100) < acceptance_chance) {
        // Success - recruit joins
        recruit_success(me, target, gift_item);
    } else {
        // Failure - determine if target becomes hostile
        if(check_if_target_becomes_hostile(me, target)) {
            target_becomes_hostile(me, target);
        } else {
            // Target declines peacefully
            target_declines_peacefully(me, target);
        }
    }
    
    // Either way, this recruitment attempt is complete
    @me.target = null;
}

Item@ find_suitable_gift(Actor@ me, Actor@ target) {
    // For animals, only food is acceptable
    bool is_animal = (target.rank == INU || target.rank == MOUNT);
    
    // Track best item to give
    Item@ best_item = null;
    double best_score = -1;
    
    // Count duplicate items to avoid giving last copy
    dictionary item_counts;
    
    // First count all items
    for(uint i=0; i<me.inv.length(); i++) {
        if(me.inv[i] is null) continue;
        
        string item_name = me.inv[i].name;
        if(!item_counts.exists(item_name)) {
            item_counts.set(item_name, 1);
        } else {
            int count=1;
            item_counts.get(item_name, count);
            item_counts.set(item_name,count + 1);
        }
    }
    
    // Now evaluate each item
    for(uint i=0; i<me.inv.length(); i++) {
        if(me.inv[i] is null) continue;
        
        // Skip if this is the only copy, unless it's a gift category item
        int count = 1;
        item_counts.get(me.inv[i].name, count);
        if(count< 2 && me.inv[i].category != 8) {
            continue;
        }
        
        // Check if target already has this item
        bool already_has = false;
        for(uint j=0; j<target.inv.length(); j++) {
            if(target.inv[j] is null) continue;
            if(target.inv[j].name == me.inv[i].name) {
                already_has = true;
                break;
            }
        }
        
        // Skip if target already has this item
        if(already_has) continue;
        
        // For animals, only consider food
        if(is_animal && me.inv[i].category != 9) continue;
        
        // Score this item
        double score = score_gift_item(me, target, me.inv[i]);
        
        if(score > best_score) {
            best_score = score;
            @best_item = me.inv[i];
        }
    }
    
    // Special case for food items (handled by amounts)
    if(@best_item == null && is_animal) {
        // Check direct food supplies
        if(me.meat > 1) {
            @best_item = get_item("Meat");
        } else if(me.fruit > 1) {
            @best_item = get_item("Fruit");
        } else if(me.sushi > 1) {
            @best_item = get_item("Sushi");
        } else if(me.vegies > 1) {
            @best_item = get_item("Vegies");
        }
    }
    
    return best_item;
}

double score_gift_item(Actor@ me, Actor@ target, Item@ item) {
    double score = 50; // Base score
    
    // Adjust based on category
    if(item.category == 8) {
        // Gifts are highly valued
        score += 30;
    } else if(item.category == 9) {
        // Food is generally useful
        if(target.rank == INU || target.rank == MOUNT) {
            score += 40; // Animals love food
        } else {
            score += 15;
        }
    } else if(item.category == 0) {
        // Swords
        if(target.rank == SAMURAI) {
            score += 25; // Samurai value swords
        } else {
            score += 10;
        }
    } else if(item.category == 6) {
        // Projectiles
        if(target.rank == SHINOBI) {
            score += 25; // Shinobi value projectiles
        } else {
            score += 5;
        }
    } else if(item.category == 1) {
        // Armor
        score += 15;
    } else {
        // Other weapons
        score += 10;
    }
    
    // Adjust based on item rarity
    if(((item.flags)&PRIZED) == PRIZED) {
        score += 20; // Prized items
    }
    
    // Discount if not appropriate for rank
    if(target.rank == KODOMO && (item.category == 3 || item.category == 7)) {
        score -= 15; // Kids shouldn't have heavy weapons or guns
    }
    
    return score;
}

double calculate_acceptance_chance(Actor@ me, Actor@ target, Item@ gift) {
    double chance = 50; // Base chance
    
    // Rank factors
    if(me.rank > target.rank) {
        chance += 15; // Higher rank is respected
    } else if(me.rank < target.rank) {
        chance -= 25; // Lower rank is less persuasive
    }
    
    // Special cases by target rank
    if(target.rank == RONIN) {
        chance -= 20; // Ronin are independent
    } else if(target.rank == DAIMYOU) {
        chance -= 30; // Daimyou rarely follow others
    } else if(target.rank == KODOMO) {
        chance += 10; // Children are easier to recruit
    }
    
    // Gift quality factor
    double gift_score = score_gift_item(me, target, gift);
    chance += (gift_score - 50) * 0.4; // Convert item score to chance modifier
    
    // Special case for animals
    if(target.rank == INU || target.rank == MOUNT) {
        if(gift.category != 9) {
            chance = 0; // Animals only accept food
        } else {
            chance = 70; // Animals like food
        }
    }
    
    // Hunger factor - hungry targets are more likely to accept food
    if(gift.category == 9 && target.food < 30) {
        chance += 30;
    }
    
    // Cap chance between 5% and 95%
    if(chance < 5) chance = 5;
    if(chance > 95) chance = 95;
    
    return chance;
}

bool check_if_target_becomes_hostile(Actor@ me, Actor@ target) {
    // Base hostility chance
    double hostility_chance = 10;
    
    // Rank factors
    if(target.rank == RONIN) {
        hostility_chance += 30; // Ronin are aggressive
    } else if(target.rank == SAMURAI) {
        hostility_chance += 20; // Samurai are proud
    } else if(target.rank == DAIMYOU) {
        hostility_chance += 40; // Daimyou may take offense
    } else if(target.rank == KODOMO) {
        hostility_chance -= 5; // Children less likely to attack
    }
    
    // Food factor
    if(target.food < 20) {
        hostility_chance -= 15; // Hungry targets less likely to fight
    }
    
    // Lower rank factor
    if(me.rank < target.rank) {
        hostility_chance += 15; // How dare a lower rank try to recruit
    }
    
    // Cap hostility between 0% and 90%
    if(hostility_chance < 0) hostility_chance = 0;
    if(hostility_chance > 90) hostility_chance = 90;
    
    return (random(0, 100) < hostility_chance);
}

void recruit_success(Actor@ me, Actor@ target, Item@ gift) {
    // Determine which leader the recruit should follow
    Actor@ leader_to_follow = null;
    
    if(me.rank >= target.rank) {
        // Follow the recruiter directly
        @leader_to_follow = me;
    } else {
        // Follow the recruiter's leader
        @leader_to_follow = me.leader;
        if(@leader_to_follow == null) {
            @leader_to_follow = me; // Fallback
        }
    }
    
    // Set up the follower relationship
    @target.leader = leader_to_follow;
    target.mission = FOLLOW;
    
    // Give the gift
    int gift_index = me.inv.find(gift);
    if(gift_index >= 0) {
        // Direct inventory transfer
        target.inv.insert_last(me.inv[gift_index]);
        me.inv.remove_at(gift_index);
    } else {
        // Indirect food transfer (for cases where we use count-based foods)
        if(gift.name == "Meat") {
            me.meat--;
            target.meat++;
        } else if(gift.name == "Sushi") {
            me.sushi--;
            target.sushi++;
        } else if(gift.name == "Fruit") {
            me.fruit--;
            target.fruit++;
        } else if(gift.name == "Vegies") {
            me.vegies--;
            target.vegies++;
        } else if(gift.name == "Sake") {
            me.sake--;
            target.sake++;
        }
    }
    
    // Play success sound
    st.playsound(Swamp + "Player/AddFriend.wav", target.pose, false, false);
    
    // Announce if player is involved
    if(st.ychar >= 0 && (st.actors[st.ychar] is me || st.actors[st.ychar] is target)) {
        st.voice.speak_interrupt(target.getRankString() + " " + target.name + 
                              " has joined " + leader_to_follow.name + "'s group.");
    }
}

void target_becomes_hostile(Actor@ me, Actor@ target) {
    // Target becomes hostile and attacks the recruiter
    target.mission = ATTACK;
    @target.target = me;
    
    // Set up for attack
    target.setState(charging);
    target.charged = 0.1 * random(1, 10);
    
    // Play attack sound
    if(target.rank == RONIN || target.rank == SAMURAI) {
        target.voiceplay(voices + "kiai_" + target.g + random(0, 9) + ".wav");
    }
    
    // Announce if player is involved
    if(st.ychar >= 0 && (st.actors[st.ychar] is me || st.actors[st.ychar] is target)) {
        st.voice.speak_interrupt(target.getRankString() + " " + target.name + 
                              " has taken offense to the recruitment attempt!");
    }
}

void target_declines_peacefully(Actor@ me, Actor@ target) {
    // Target turns away
    vector dir = target.pose - me.pose;
    dir.y = 0;
    if(dir.length() > 0) {
        target.face = dir / dir.length();
    }
    
    // Move away slightly
    target.setState(walking);
    
    // Announce if player is involved
    if(st.ychar >= 0 && (st.actors[st.ychar] is me || st.actors[st.ychar] is target)) {
        st.voice.speak_interrupt(target.getRankString() + " " + target.name + 
                              " has declined to join.");
    }
}


void handle_dog_logic(Actor@ me, int i, int f) {
    // Skip processing if it's not this actor's frame to think
    if(f != i) return;
    
    // Check survival needs
    bool low_food = me.food < 15.0;
    
    // Dogs first check if they're hungry
    if(low_food) {
        // First try to eat what they have
        if(try_to_eat(me)) {
            return;
        }
        
        // If they have a leader, follow them for food
        if(@me.leader != null) {
            me.mission = FOLLOW;
            handle_follow_behavior(me);
            return;
        }
        
        // Otherwise look for food
        me.mission = FEED;
        
        // Dogs can hunt better than humans
        Actor@ prey = null;
        double best_distance = 400;
        
        // Look for small animals or undefended humans to hunt
        for(uint j=0; j<st.actors.length(); j++) {
            Actor@ potential_prey = st.actors[j];
            if(potential_prey is null || @potential_prey == @me || 
               potential_prey.hp <= 0 || potential_prey.rank == ZOMBIE) continue;
            
            // Only target if smaller or defenseless
            bool is_valid_prey = (potential_prey.rank == KODOMO || 
                                 potential_prey.rank == INU && potential_prey.name == "Fox" ||
                                 potential_prey.rank != INU && @potential_prey.weapon == null);
                                 
            if(is_valid_prey) {
                double distance = len2(potential_prey.pose - me.pose);
                if(distance < best_distance) {
                    @prey = potential_prey;
                    best_distance = distance;
                }
            }
        }
        
        // Found prey? Hunt it
        if(@prey != null) {
            @me.target = prey;
            me.mission = HUNT;
            
            // If close enough, attack
            if(best_distance < 25) {
                // Turn to face prey
                vector dir = prey.pose - me.pose;
                dir.y = 0;
                if(dir.length() > 0) {
                    me.face = dir / dir.length();
                }
                
                // Attack
                me.setState(attacking);
            } else {
                // Otherwise approach
                me.dest = prey.pose;
                st.pathfind(st.actors.find(me), me.dest);
            }
            return;
        }
        
        // No prey, look for food items
        find_food_source(me);
        return;
    }
    
    // Handle following behavior if they have a leader
    if(@me.leader != null) {
        me.mission = FOLLOW;
        handle_follow_behavior(me);
        return;
    }
    
    // Pack behavior - look for other dogs to join
    if(random(0, 20) == 0) {
        for(uint j=0; j<st.actors.length(); j++) {
            Actor@ other_dog = st.actors[j];
            if(other_dog is null || @other_dog == @me || 
               other_dog.hp <= 0 || other_dog.rank != INU) continue;
               
            // Only join dogs of the same type
            if(other_dog.name == me.name || 
              (me.name == "Wolf" && other_dog.name == "Ookami") ||
              (me.name == "Ookami" && other_dog.name == "Wolf") ||
              (me.name == "Fox" && other_dog.name == "Kitsune") ||
              (me.name == "Kitsune" && other_dog.name == "Fox")) {
                
                double distance = len2(other_dog.pose - me.pose);
                if(distance < 100) {
                    // Join this dog's pack
                    @me.leader = other_dog;
                    me.mission = FOLLOW;
                    return;
                }
            }
        }
    }
    
    // If no specific goal, wander
    if(me.mission == WANDER || me.state == 0) {
        // Dogs prefer to wander in forests and fields
        if(me.path.length() == 0 && random(0, 15) == 0) {
            vector target = st.floortiles[random(0, st.floortiles.length()-1)];
            int tries = 0;
            
            // Try to find appropriate terrain
            string preferred_terrain = (me.name == "Fox" || me.name == "Kitsune") ? 
                                      "Leaves" : "Grass";
            
            while(tries < 10) {
                if(st.map[target.x][target.z] != "" && 
                   string_contains(st.map[target.x][target.z], preferred_terrain, 1) >= 0) {
                    break;
                }
                target = st.floortiles[random(0, st.floortiles.length()-1)];
                tries++;
            }
            
            st.pathfind(st.actors.find(me), target * 10);
        }
        
        // Occasionally make dog sounds
        if((me.voiceslot < 0 || !st.pool.sound_is_playing(me.voiceslot)) && random(1, 20) == 1) {
            if(me.name == "Fox" || me.name == "Kitsune") {
                me.voiceplay("nsounds/dogs/foxbark" + random(1, 2) + ".wav");
            } else if(me.name == "Wolf" || me.name == "Ookami") {
                if(random(1, 5) == 1) {
                    me.voiceplay("nsounds/dogs/wolf_howl_0" + random(1, 5) + ".wav");
                } else {
                    me.voiceplay("nsounds/dogs/wolf_growl_0" + random(1, 6) + ".wav");
                }
            } else {
                me.voiceplay("nsounds/dogs/wardog_bark_0" + random(1, 5) + ".wav");
            }
        }
        
        // Move around more dynamically - dogs move erratically
        if(me.state == 0 && random(0, 10) == 0) {
            double angle = random(0, 628) / 100.0;
            me.face = vector(cosine(angle), 0, sine(angle));
            me.setState(walking);
            
            // Occasionally jump
            if(random(0, 15) == 0 && me.onGround()) {
                me.setState(JUMPING|walking);
            }
        }
    }
}

void handle_mount_logic(Actor@ me, int i, int f) {
    // Skip processing if it's not this actor's frame to think
    if(f != i) return;
    
    // Check if we have a rider
    if(@me.mount != null) {
        // Let rider control movement
        return;
    }
    
    // Boat logic
    if(me.name == "boat") {
        // Boats don't move on their own
        return;
    }
    
    // For horses and other mounts
    
    // First, handle basic needs - food for horses
    bool low_food = me.food < 25.0;
    if(low_food) {
        // Find grass or leaves to eat
        vector grass_location = vector(0, 0, 0);
        double best_distance = 1000000;
        
        for(uint j=0; j<st.floortiles.length(); j++) {
            vector tile = st.floortiles[j];
            if(st.map[tile.x][tile.z] == "Grass" || st.map[tile.x][tile.z] == "Leaves2") {
                vector location = tile * 10 + vector(5, 0, 5);
                double distance = len2(location - me.pose);
                
                if(distance < best_distance) {
                    grass_location = location;
                    best_distance = distance;
                }
            }
        }
        
        if(len2(grass_location - vector(0, 0, 0)) > 0) {
            me.dest = grass_location;
            if(me.path.length() == 0) {
                st.pathfind(st.actors.find(me), grass_location);
            }
            
            // If we're at grass, stand still and eat
            if(best_distance < 4) {
                me.state = 0;
                me.v = vector(0, 0, 0);
                me.food += 0.5; // Eating
            }
            return;
        }
    }
    
    // Horses wander to find grass or return to their owners
    if(@me.leader != null) {
        // Return to owner if too far away
        double distance_to_leader = len2(me.leader.pose - me.pose);
        if(distance_to_leader > 400) {
            me.mission = FOLLOW;
            handle_follow_behavior(me);
            return;
        }
    }
    
    // Otherwise, wander in fields
    if(me.mission == WANDER || me.state == 0) {
        if(me.path.length() == 0 && random(0, 15) == 0) {
            vector target = st.floortiles[random(0, st.floortiles.length()-1)];
            int tries = 0;
            
            // Try to find grass
            while(tries < 10) {
                if(st.map[target.x][target.z] == "Grass") {
                    break;
                }
                target = st.floortiles[random(0, st.floortiles.length()-1)];
                tries++;
            }
            
            st.pathfind(st.actors.find(me), target * 10);
        }
        
        // Occasionally make horse sounds
        if((me.voiceslot < 0 || !st.pool.sound_is_playing(me.voiceslot)) && random(1, 30) == 1) {
            me.voiceplay("nsounds/horse/whinny_0" + random(1, 3) + ".wav");
        }
    }
}

bool can_move_direction(Actor@ me, vector direction, double distance) {
    // Check if the actor can move in the given direction
    vector test_pos = me.pose + (direction * distance);
    return st.is_clear(test_pos);
}

vector find_best_direction(Actor@ me, vector target_dir) {
    // If direct path is blocked, find an alternative
    if(can_move_direction(me, target_dir, 0.5)) {
        return target_dir;
    }
    
    // Try 45 degree angles
    vector dir_right = vector(target_dir.z, 0, -target_dir.x);
    vector dir_left = vector(-target_dir.z, 0, target_dir.x);
    
    vector diag_right = target_dir + dir_right;
    if(diag_right.length() > 0) diag_right = diag_right / diag_right.length();
    
    vector diag_left = target_dir + dir_left;
    if(diag_left.length() > 0) diag_left = diag_left / diag_left.length();
    
    if(can_move_direction(me, diag_right, 0.5)) {
        return diag_right;
    } else if(can_move_direction(me, diag_left, 0.5)) {
        return diag_left;
    }
    
    // Try 90 degree angles
    if(can_move_direction(me, dir_right, 0.5)) {
        return dir_right;
    } else if(can_move_direction(me, dir_left, 0.5)) {
        return dir_left;
    }
    
    // Try moving backward as last resort
    if(can_move_direction(me, target_dir * -1, 0.5)) {
        return target_dir * -1;
    }
    
    // If all else fails, return original direction and deal with collision normally
    return target_dir;
}
