#include "amaze.bgt"
#include "clock.bgt"
#include "custom_voice2.bgt"
#include "FiniteStateMachine.bgt"
#include "game.bgt"
#include "JMenu2.bgt"
#include "keyconfig.bgt"
#include "sound_pool.bgt"
#include "vecmath.bgt"

// irrational numbers we will need:
const double sqr2 = 0.70710678118654752440084436210485, pi = 3.1415926535897932384626433832795, pi2 = pi/2.0, pi4=pi/4.0, HALFSTEP=1.059463;;


enum chartypes {
	KODOMO, ASHIGARU, SAMURAI, SHINOBI, RONIN, DAIMYOU, INU, ZOMBIE, MOUNT
};

// State constants:
const int WAIT=0, walking=1, drawing=2, charging=4, attacking=8, talking=16, recovering=32, stunned=64, seppuku=128, regen=256, grabbed=512, comboing=1024, JUMPING=2048, DUCKING=4096;
// Death constants?
enum deaths {
	STARVE, DROWN, BURN, FIGHT, BITE, SELF, PLAGUE
};
// ^ ... Those should have just been strings, shouldn't they?

enum missions {
	WANDER, GO, FOLLOW, RETURN, ATTACK, DEFEND, FEED, HUNT, RECRUIT, HALT
};

// Sound path constants, so I don't have to pack everything until it's ready to ship:

const string Swamp = "c:/games/Swamp/Sounds/", sj = "c:/games/SengokuJidai/sfx/", voices = "c:/games/SengokuJidai/voice/", steps = "c:/my programs/jeqocon/ps2023iso/bgt/sounds/steps/", sounds2=steps + "../../sounds2/", MHI = steps + "../MHI/", CA = "c:/games/castaways/sounds/";
// Possible terrains, for map generation:
const string[] terrains = {"Grass", "Dirt", "Rock", "Leaves", "Mud", "Swamp", "Water", "Wade", "Swim", "Soil", "Dirt2", "Sand", "Sand2", "Grass", "Leaves", "Grass", "Dirt2"};
const string wets = "Water Swim2 Swamp Wade";
const string hards="Big bktile Concrete Cement Marble Stone Tile Dirt Roof Wood Bridge Plank Stairs Wood2 Roof2";
const string softs="Sand Sand2 Soil Dirt2 Carpet CarpetedStairs Crawl Leaves Leaves2 Mud";
const string metals="Metal Metal2 Steel Pipe Roof";
const string dirty="Rock2 Dirt Gravel Soil Sand Snow Glass Debris Rock";

const string[] categorynames = {"swords", "armor", "bows", "heavy weapons", "pole arms", "staff", "projectile", "gun", "gifts", "food", "tools"};

// Item flags:
const int ARMOR=1, WEAPON=2, FOOD=4, WOOD=8, HEAVY=16, ZOMBABLE=32, PRIZED=64, PIERCE=128;
class Item {
	int flags=0;
	int slot=-1; // Sound.
	int category=8; // Index for drawing.
	string name="";
	double hp=100.0; // If we let it be damaged. For food, this is how much hp it gives you on consumption.
	vector v; // I assume these are to be motionless, but just in case that changes, or they can be thrown, or whathaveyou. Catching moving items might be fun, anyway.
	vector pose; // Was considering using actual shapes, but then I thought, "nah.". Just treat them as 2m cubes.
	double defense = 0.0; // How much damage armor can ignore, or how much damage is unblockable for weapons.
	double maxDamage=0.0, minDamage=0.0;
	double range=0.0; // But I really want to make projectiles track, rather than hit instantly. For sound if nothing else.
	double arc=pi4; // Arc of a melee attack.
	double duck=50, jump=50; // Likelyhood that ducking or jumping will evade attacks from this item, if it's a weapon. Multiplier on startup lag for jumping or ducking if armor.
	double maxswing=0.5, minswing=0.2; // How long an attack takes to hit, based on charge.
	// Hit, miss, and block should have different recovery times, and those should also have max/min depending on charge, and that is 6 vars that will almost never need to be so distinct as all that. Sigh.
	double minrec=0.2, maxrec=1.0;
	double drawtime=0.25;
	
	hitcallback@ callback=null; // For weapons, special things if they connect. For armor, special things for if struck.
	int combo=0;
	
	// I think we want some sounds in here, too.
	string drawsound="", blocksound="", swingsound="", hitsound="";
	// Projectiles should move! How do we handle those?
	
	Item() {}
	Item(string n, double x=0, double y=0, double z=0) {
		this.name=n;
		this.pose = vector(x, y, z);
		// Determine if it's a weapon, armor, or food?
	}
	bool intersects(vector c, double height=1.64) {
		// Colliding with actors.
		vector d = c-this.pose;
		return (absolute(d.x)<1.5 and absolute(d.y)<1.0+(height/2) and absolute(d.z)<1.5);
	}
	
	bool opEquals(Item@ o) {return @o == @this; }
	bool opEquals(string n) {return (this.name==n); }
}

// List of zombie names, in order of size:
const string[] zomnames = {"Canine", "Lamprey", "Amorphous", "Dire", "Stalker", "Normal", "Reaper", "Giant", "Matriarch", "Tyrant", "Flayer", "Hulk", "Behemoth"};
// Default zombie stats:
const double[] zomHP = {90, 100, 350, 300, 100, 100, 175, 200, 300, 500, 375, 700, 1000};
//dognames:
const string[] dognames = {"Dog", "Hound", "Wardog", "Fox", "Wolf", "Pup", "Dog", "Canine"};

class Actor : FSM {
	int slot=-1, voiceslot=-1, hitslot=-1;
	Actor@ target=null, grabbing=null, grabber=null, lastKilled=null, leader=null, besty=null, mount=null, rival=null, killer=null;
	string name="";
	string g=""; // m/f. If you want to add more voices, be my guest.
	int mission=WANDER;
	// Why do I want a mood property, or something like that?
	int combo=0;
	int kills=0;
	double food=100, stamina=100, plague=0;
	vector pose;
	double hp=100.0, maxHP=100.0, maxStamina=100.0;
	double charged=0.0;
	// Ammo:
	int arrows=0, shuriken=0, kunai=0, balls=0, darts=0, sushi=0, fruit=0, meat=0, sake=0, vegies=0;
	// ... Eh, why not? :
	double drunk=0.0; // From sake.
	
	//Todo: Do we want a more Swamply armor system, or should we stick with a more SJ-esque generic?
	Item@ armor=null, weapon=null;
	
	vector home; // Where AI returns to with the RETURN mission.
	vector dest; // For the GO mission.
	vector[] path; // For AI.
	int rank=0;
	// Be careful with how names and zombies interact.
	vector face(1,0,0); // cos(theta), phi, sin(theta). I highly doubt phi will ever matter, hence why I didn't include it more thoroughly. Now, watch me live to regret it.
	double speed=4.0; // Default runspeed.
	vector v;
	ST@ gloc=null; // Handle to the game, so the class can access the map.
	Item@[] inv; // Huh, somehow forgot this one.
	bool blocked=false; // Are we waiting to process an attack that has been blocked?
	int deathtype=-1;
	
	Actor() {this.g = ((random(1, 10)>5) ? "F" : "M");}
	
	bool isPlayer() {
		return (@(this.gloc)!=null and this.gloc.ychar>=0 and this.gloc.ychar<this.gloc.actors.length() and this.gloc.actors[this.gloc.ychar] is this);
	}
	bool onGround() {
		// The name is a bit misleading, since sitting in a tree counts, too.
		// Beware: castles and trees. We generally want them to function like platforms that are only solid from above.
		if(@(this.gloc)!=null) return this.pose.y<=this.gloc.get_height(this.pose.x, this.pose.y, this.pose.z);
		return this.pose.y<=0;
	}
	
	void always(double dt) {
		if(this.gloc is null) return;
		vector d = this.v*dt;
		bool move = this.gloc.is_clear(this.pose+d);
		if(@(this.mount)!=null or this.name=="boat") {
			if(this.name=="boat" or this.mount.name=="boat") {
				string t = this.gloc.get_terrain(this.pose+d);
				if(t!="Swim" and t!="Swim2" and t!="Wade") move=false;
			}//Boats
		}//Where can't mounts go?
		if(move) {
			this.pose = this.pose+d;
			if(@(this.mount) !=null) this.mount.pose = this.pose;
		}//Moved.
		else {
			// Get the appropriate bump sound.
			// Also, maybe round coordinates for simplicity's sake?
			if(this.v.x==0 and this.v.z==0 and this.v.y==0) {
				// Subtract this.face to try and bounce us out.
				// (This really wants a more elegant solution.)
				this.pose = this.pose-this.face; 
			}// You glitched inside a tree or something.

			if(this.isPlayer() and d.x+d.z!=0) {
				this.gloc.play_bump(this, this.pose+d);
				this.v = vector(0,0,0);
			}// Only play the player's bump sounds, otherwise things will be quite annoying.
			else {
				// Pick a truly random cardinal direction to escape stuck states
				// This prevents the southward bias from predictable v.x/v.z swaps
				int escape_dir = random(0, 3);
				double sp = this.speed;
				if(sp<=0) sp = 1.0;
				if(escape_dir==0) this.face = vector(1, 0, 0);      // East
				else if(escape_dir==1) this.face = vector(-1, 0, 0); // West
				else if(escape_dir==2) this.face = vector(0, 0, 1);  // North
				else this.face = vector(0, 0, -1);                   // South
				this.v = sp * this.face;
			}
		}// No move.
		
		if(this.onGround() == false) {
			this.v.y-=9.8*dt;
		}// falling.
		else if(this.v.y<0.0) {
			// I don't think rounding is the best way to stick to the floor, but maybe...?
			double h = this.gloc.get_height(this.pose.x, this.pose.y+1, this.pose.z);
			// (Etc)
			this.pose.y=h;
			if(this.state==stunned or this.hp<=0.0) this.setSlot(this.gloc.play_fall(this));
			else this.gloc.play_land(this);
			// (I kinda want really violent falls to lead to bouncing. :P.)
			this.v.y=0.0;
		}// Landing.
		
		// Actions which update continuously:
		if(this.state==charging and this.charged<1.0) this.charged+=dt;
		else if(this.state==attacking and @(this.weapon)!=null and (this.weapon.category==2 or this.weapon.category==6)) {

		}//Projectiles need their sounds updated?
		
		// Food:
		if(((this.rank==MOUNT and this.name=="Horse") or (this.rank==INU and (this.name=="Fox" or this.name=="Kitsune"))) and this.food<100) {
			if(@(this.gloc)!=null and string_contains("Grass Leaves2", this.gloc.get_terrain(this.pose), 1)>=0) {
				if(this.rank==MOUNT) this.food+=dt;
				else this.food+=0.5*dt;
			}// Passive eating.
		}//Horses and foxes feed off grass and leaves.
		if(this.food<=0.0) {
			this.hp-=0.5*dt;
			if(this.hp<=0.0) {
				if(this.hp+0.5*dt>0) {
					this.deathtype=STARVE;
					// Watch out for plague and drowning, though.
					@(this.killer)=null;
					if(this.rank==INU or this.rank==MOUNT) {

					}// Starving animals.
					else if(this.rank==ZOMBIE) {
						
					}// Starving zombie.
					else {
						if(this.g=="M" or this.g=="m") this.voiceplay(CA + "Population/StarvationMale.wav");
						else this.voiceplay(CA + "Population/StarvationFemale.wav");
					}//Starving humans.
				}// Die sound or message or whathaveyou.
			}
		}// Starving.
		else {
			this.food-=0.25*dt;
			if(this.hp<this.maxHP and this.rank!=ZOMBIE) {
				this.hp+=0.5*dt; // Hmm.
				this.food-=0.25*dt;
			}//healing through digestion.
			// Cold, swimming, plague, healing, etc.
			// Let plague increase your food-burning rate, but only up to 0.5*dt
			if(this.plague>0 and this.rank!=ZOMBIE) this.food -= 0.005*this.plague*dt;
			if(@(this.gloc)!=null and this.gloc.weather=="snow" and string_contains(hards, this.gloc.get_terrain(this.pose), 1)<0) {
				// If we add armor that protects against cold, or ways to stay warm in places like forests or campsites, we need to catch those, here.
				this.food-=0.25*dt;
			}// Cold burns food faster.
			
			// Swimming penalties - deep water ("Swim") terrain affects non-zombies
			if(@(this.gloc)!=null and this.rank!=ZOMBIE and @(this.mount)==null) {
				string terrain = this.gloc.get_terrain(this.pose);
				if(terrain=="Swim" or terrain=="Swim2") {
					// Swimming drains stamina and food
					this.stamina -= 1.0*dt;
					this.food -= 0.25*dt;
					// Heavy items make swimming harder
					if(@(this.weapon)!=null and (((this.weapon.flags)&HEAVY)==HEAVY or this.weapon.category==1)) {
						this.stamina -= 1.5*dt;
						this.food -= 0.25*dt;
					}
					if(@(this.armor)!=null) {
						this.stamina -= 0.5*dt;
					}
					// Slow down swimming speed
					if(this.v.x != 0 or this.v.z != 0) {
						//this.v.x *= 0.6;
						//this.v.z *= 0.6;
					}
					// Risk of drowning if stamina depleted
					if(this.stamina <= 0) {
						this.hp -= 5.0*dt;
						if(this.hp <= 0 and this.hp + 5.0*dt > 0) {
							this.deathtype = DROWN;
							@(this.killer) = null;
							if(this.g=="M" or this.g=="m") this.voiceplay(CA + "Population/DrownMale.wav");
							else this.voiceplay(CA + "Population/DrownFemale.wav");
						}
					}
				}
				// Wading slows you down but doesn't drain as much
				else if(terrain=="Wade" or terrain=="Swamp") {
					if(this.v.x != 0 or this.v.z != 0) {
						this.v.x *= 0.8;
						this.v.z *= 0.8;
					}
					this.stamina -= 0.5*dt;
				}
			}// Swimming penalties.
		}//Digesting.
		
	}//Always.
	
	void fromAbove() {
		
		bool stopmoving=true;
		
		int s = this.state;
		this.state=0;
		if(s==charging) this.setState(attacking);
		else if(s==attacking) {
			// And look at us, saving orientation as a vector instead of a theta value, having to do rotations.
			// Luckily:
			double h = this.height();
			double r = h/2.0;
			double harc = pi4;
			double dmg=0.0; // Umm...
			double fatigue=0.0;
			// Default, which we can override later:
			this.state=recovering;
			this.counter=0.0;
			this.combo+=1;
			bool breaksArmor=false;
			if(@(this.weapon)!=null and (((this.weapon.flags)&WEAPON)==WEAPON)) {
				r += this.weapon.range;
				harc = this.weapon.arc/2.0;
				dmg = this.weapon.minDamage + (this.weapon.maxDamage*this.charged);
				this.counter = this.weapon.minrec+(this.charged*this.weapon.maxrec);
				if(((this.weapon.flags)&PIERCE)==PIERCE) {
					breaksArmor=(random(1, 15)<10.0*this.charged);
					if(this.weapon.category>2) fatigue += this.charged;
					else if(this.stamina<100) fatigue += 0.01*(100.0-this.stamina);
				}//Pierce rules.
				else if(((this.weapon.flags)&HEAVY)==HEAVY or this.weapon.category==3) {
					// In Sengoku Jidai, kanabo cost a wapping 10-20 stamina. Should we tone that down, here, or leave it be?
					fatigue += 10.0+(10.0*this.charged);
					breaksArmor=(random(-1, 5)<=10.0*this.charged);
					if(this.stamina<100) this.counter += 0.015*(100.0-this.stamina);
					// Todo: armor breaking should be more likely if the distance between this and targets is shrinking, and lower if the distance is increasing.
					// Also, force. These should have a chance of knocking people down.
				}// Heavy weapons.
				else if(this.weapon.category==0) {
					fatigue = 1.0 + (2.0*this.charged);
					if(this.stamina<100.0) this.counter += 0.015*(100-this.stamina);
					//breaksArmor=(random(1, 15)<10.0*me.charged);
					dmg *=5; // The damage on swords was not properly callibrated.
				}// Swords.
				else if(this.weapon.category==5 or this.weapon.category==4) {
					fatigue += this.charged;
					if(this.weapon.arc>=pi) fatigue = 2.0*(fatigue+1);
					if(this.stamina<100) this.counter+=0.015*(100-this.stamina);
				}// Staves.
				else if(this.weapon.minDamage>this.weapon.maxDamage) {
					// Multi-mode weapons, like Kunai and arquebus.
					if(this.weapon.category==7) {
						if(this.charged < 0.25) {
							if(this.balls>0) {
								this.counter = 10.0; // Reloading.
								this.sounds.insert_last(Swamp + "Weapons/Winchester/Reloading.wav");
							}//Reload.
							//this.balls -= 1;
							dmg = random(this.weapon.maxDamage, this.weapon.minDamage); //!
							r += random(5, 15); // Highly inaccurate.
							// We need to remember which this is when it does damage!
						}// Projectile mode.
						else {
							dmg = 100.0 * this.charged;
							fatigue = 2.0*this.charged;
						}// Bayonet.
					}// Guns.
					else if(this.weapon.name=="Kunai") {

					}// Kunai are complicated.
				}//Special weapons.
			}//Attacking weapons.
			else {
				// Adjust details for different actors.
				dmg=this.charged;
				this.counter=1.0-(this.stamina/this.maxStamina)+(0.5*this.charged);
				fatigue += this.charged;
				harc=pi;
				double gb = 1.0;
				if(this.g=="M" or this.g=="m") gb=2.0; // Shshsh... It's not as bad as it looks, other than ashigaru.
				if(this.rank==ASHIGARU) dmg+=gb;
				else if(this.rank==SHINOBI) dmg += 2.5;
				else if(this.rank==SAMURAI or this.rank==RONIN) dmg += 4.0;
				else if(this.rank==DAIMYOU) {
					if(this.g=="F" or this.g=="f") gb+=0.5;
					dmg += gb;
				}// Daimyou train to reduce the gender gap, but aren't quite so successful as professional warriors.
				else if(this.rank==INU) dmg = 10.0*h;
				else if(this.rank==ZOMBIE) {
					string n=string_to_lower_case(name);
					dmg=15.0*this.charged;
					this.counter=4.5; // Increased base recovery time for zombies
					r = h*2; // Let zombies have greater range, because they don't stand up straight or something.
					if(n=="canine" or n=="kitsune" or n=="ookami") {
						dmg = (n=="canine") ? 2 : (n=="ookami") ? 5 : 0;
						dmg += 10*this.charged;
						if(n=="kitsune") this.counter-=1.0;
					}
					else if(n=="normal") {
						this.counter=4.0;
					}// Normal.
					else if(n=="giant") {
						dmg=25*this.charged;
						this.counter=4.0;
					}//Giant
					else if(n=="tyrant") {
						dmg=10+(40*this.charged);
					}
					else if(n=="stalker") {
						dmg = 10+(10*this.charged);
						this.counter=3; // Increased from 2
					}
					else if(n=="matriarch") {
						dmg = 25 + (15.0*this.charged);
					}
					else if(n=="reaper") {
						dmg = 10+(20*this.charged);
					}// Reaper
					else if(n=="lamprey") {
						dmg +=10.0*this.charged;
					}// Lamprey.
					else if(n=="dire") {
						dmg=10+(40*this.charged);
						this.counter=3.5; // Increased from 2.5
					}// Dires.
					else if(name=="Amorphous") {
						this.counter=3.5; // Increased from 2.5
						dmg = 30.0*this.charged;
					}// Amorphous
					else if(n=="hulk") {
						dmg = 25.0+(35*this.charged);
						this.counter=3.0;
					}// Hulks.
				else if(n=="tentacle") {
						dmg = 25.0*this.charged;
						this.counter=4.0;
					}// Tentacles.
					else if(n=="behemoth") {
						dmg=50+(100.0*this.charged); // Shut up; you have armor by now.
						this.counter=3.5; // Increased from 2.5
					}// Behemoth.
					this.counter /= random(2, 8); // Reduced randomness for predictable recovery
				}// Zombies.
			}// Unarmed attacks are kinda weird.
			
			if(this.drunk>random(0, 50)) {
				fatigue += 0.1*this.drunk;
				this.counter+=0.005*this.drunk;
				harc+=pi/12;
				dmg *= 0.1*random(5, 20);
			}// trying to attack while drunk.
			
			// Do things differently if the attack has been blocked:
			if(this.blocked) {
				//Heavy weapons have a chance of breaking shields and wooden weapons.
				// Wooden weapons have a medium chance of disarming.
				//Naginata have a low chance of disarming.
				//Sai have a high chance of disarming.
			}
			else {
				if(this.rank!=ZOMBIE) dmg *=5.0;
				//vector arc_start = dif_angles(this.face.x, this.face.z, cosine(harc), sine(harc));
				//vector arc_end = sum_angles(this.face.x, this.face.z, cosine(harc), sine(harc));
				vector arc(cosine(harc), 0, sine(harc)); // These should be between 0 and 1, unless weapon.arc>pi. And in that case, we're going to do something rather different.
				double r2 = r*r;
				bool hit=false;
				string rep = "Hit Report:\r\n" + this.getRankString() + " " + this.name + ", attacking from " + vecstr(this.pose) + ", toward " + vecstr(this.face) + ", halfarc " + harc + ", v" + vecstr(arc) + ", r" + r + "\r\nPossible Targets:";
				for(uint i=0; i<this.gloc.actors.length(); i++) {
					Actor@ them = this.gloc.actors[i];
					if(them is null or them.hp<=0.0) continue;
					if(@them == @this) continue;
					else if(this.rank==ZOMBIE and them.rank==ZOMBIE) continue;
					else if(them is this.leader or them is this.besty or them is this.mount or (@(them.leader)!=null and them.leader is this.leader) or them.leader is this or them.mount is this) continue;
					// Todo: a deeper team check. Let's not execute underlings; let's allow a hierarchy rather than a single leader; etc.
					// Vertical range is complicated. Mostly because I don't want us attacking through the floors of multistory castles, but I do want us capable of shooting over the exterior walls.
					double h2 = them.height();
					h2*=0.5;
					
					rep += "\r\n" + them.getRankString() + " " + them.name + ": at " + vecstr(them.pose) + ", ";
					if(absolute(them.pose.x-this.pose.x)>r+h2 or absolute(them.pose.z-this.pose.z)>r+h2) continue;
					// Get a unit vector and rotate it by this.face, so we can do math as though we're facing right:
					vector d = them.pose-this.pose;
					d.y=0;
					if(d.x==0 and d.z==0) d=vector(1, 0, 0);
					else d = dif_angles(d/d.length(), this.face);
					bool hit2 = (harc>=pi or (d.x>=arc.x and d.z<=arc.z and d.z>=-arc.z));
					rep += " d" + vecstr(d) + ", hit2: " + hit2 + ". ";
					if(!hit2) continue; // Because I don't want to go 6 levels in, or create a new method/function for this.
					if(them.state==attacking and @(this.weapon)!=null and this.weapon.category!=2 and (this.weapon.category<6 or this.weapon.category==10 or (this.weapon.category==7 and this.charged>0.4)) and (them.weapon is null or them.weapon.category==0 or (them.weapon.category>2 and them.weapon.category<6) or them.weapon.category==10 or (them.weapon.category==7 and them.charged>0.4))) {
						them.blocked=true;
						// Whose blocksound do we play?
						string toplay = sj + "pipeblock" + random(1, 2) + ".ogg";
						Item@ it = this.weapon;
						if(it is null or it.blocksound=="") {
							if(@(them.weapon)!=null and @it!=null and (((them.weapon.flags)|(it.flags))&WOOD)==WOOD) {
								// Find out if it's wood-on-wood, or wood-on-steel:
								if ((((them.weapon.flags)&(it.flags))&WOOD)==0) toplay = MHI + "staff_tap_pole" + random(0, 2) + ".ogg";
								else toplay = MHI + "staff_tap" + random(0, 2) + ".ogg";
								
							}// Woodblocks.
							else if(@(them.weapon)!=null and (them.weapon.blocksound!="" or it is null)) @it=them.weapon;
						}
						if(@it!=null and it.blocksound!="") toplay = it.blocksound;
						them.sounds.insert_last(toplay);
					}// Block.
					else if(@(them.weapon) != null and them.weapon.category == 1 and (random(0, 100) < them.weapon.defense)) {
						if(breaksArmor) {
							if(them.inv.find( them.weapon ) >=0 ) them.inv.remove_at(them.inv.find(them.weapon));
							@(them.weapon) = null;
							them.sounds.insert_last(sj + "selected.wav");
						}
						else {
							them.blocked = true;
							them.sounds.insert_last(Swamp + "Weapons/Shield/Block" + random(1, 3) + ".wav");
						}
					}//Shields.
					else if(@(them.armor)!=null and dmg<=them.armor.defense and !breaksArmor) {
						them.blocked=false;
						// Todo: some weapons might not care about armor, but shouldn't break it.
						them.sounds.insert_last(sj + "arm_hit_" + random(1, 15) + ".wav");
					}// Deflected by armor.
					else {
						them.blocked=false;
						if(this.weapon is null) {
							// If we're a zombie, we're already playing the appropriate sound.
							if(this.rank==KODOMO) them.sounds.insert_last(MHI + "h" + random(0, 5) + ".wav");
							else if(this.rank!=ZOMBIE and this.rank!=INU and this.rank!=MOUNT) {
								// Can we check to see if we're kicking or punching, and play the appropriate sound?
								// Also scale the strength of the impact according to charge.
								// But also let certain people throw or disarm or steal.
							}//Umm.
						}// Unarmed.
						else if(them.rank==ZOMBIE) {
							string w = "Machete";
							if(this.weapon is null) w = "Shield";
							else if((this.weapon.category==3 or ((this.weapon.flags)&HEAVY)==HEAVY) and this.weapon.name!="Nodachi") w = "Hammer";
							else if(this.weapon.category==2) w = "Arrow";
							else if(this.weapon.category==10) w = this.weapon.name;
							else if(this.weapon.category==5) w="Shield"; // Umm?
							else if(((this.weapon.flags)&PIERCE)==PIERCE or this.weapon.name=="Kunai") w = "Knife";
							else if(((this.weapon.flags)&WOOD)==WOOD) w = "Shield";
							else if(this.weapon.category==7) {
								w="Bullet";
								if(this.charged>0.4) w="Knife";
							}//Guns.
							//dart -> sniper, egg ->flame? And Shuriken... uh.... 
							clipboard_copy_text(Swamp + "Zombies/" + them.name + "/" + w + random(1, 4) + ".wav");
							them.voiceplay(Swamp + "Zombies/" + them.name + "/" + w + random(1, 4) + ".wav");
						}// Zombies conveniently have the hitsounds we need already.
						else if(this.weapon.hitsound!="") them.sounds.insert_last(this.weapon.hitsound);
						else if(this.weapon.category==2) them.sounds.insert_last(Swamp + "Zombies/Normal/Arrow1.wav");
						else if(this.weapon.category==3 and this.weapon.name!="Nodachi") them.sounds.insert_last(Swamp + "Zombies/Normal/Hammer1.wav");
						else if(this.weapon.category==7 and this.charged<=0.4) them.sounds.insert_last(Swamp + "Zombies/Normal/Bullet1.wav");
						else if(this.weapon.name=="Kunai" or ((this.weapon.flags)&PIERCE)==PIERCE) them.sounds.insert_last(Swamp + "Zombies/Normal/Knife1.wav");
						else if(this.weapon.category==10) them.sounds.insert_last(Swamp + "Zombies/Normal/" + this.weapon.name + "1.wav");
						else if(this.weapon.category==1) them.sounds.insert_last(Swamp + "Zombies/Normal/Shield1.wav");
						else if(((this.weapon.flags)&WOOD)==WOOD) them.sounds.insert_last("nsounds/staff_0" + random(1, 7) + ".wav");
						else them.sounds.insert_last(Swamp + "Zombies/Normal/Machete.wav");
						
						them.damage(this, dmg);
						if(them.hp<=0.0) {
							@(this.lastKilled)=them;
							if(them.rank==INU or them.rank==KODOMO or them.rank==MOUNT) this.upgrade_check(1);
							else this.upgrade_check(2);
						}//killed.
					}// Enemy is not attacking.
				}//Targets loop.
				if(key_down(KEY_C)) clipboard_copy_text(rep);
			}//Can hit.
		}// Attack complete...
		else if(s==recovering) {
			this.state=0;
			this.combo=0;
			if(this.rank==KODOMO) this.sounds.insert_last("../pgs21/voice/breathe*.wav");
			else if(this.rank!=ZOMBIE and this.rank!=MOUNT) this.sounds.insert_last(voices + "breath_" + g + ".wav");
		}// Recovery.
		
		if(stopmoving) {
			// We do not change v.y. 
			this.v.x=0;
			this.v.z=0;
		}//Stop moving latterally.
		
		this.process_sounds();
	}//from above
	double height() {
		if(this.rank==INU) {
			if(this.name=="Fox") return 0.5;
			else if(this.name=="Kitsune" or this.name=="Ookami") return 0.2*this.kills;
			return 0.25*this.name.length();
			//return 1.0*this.name.length()/14; // If we have a fox named kitsune, it needs to be no more than 0.5m tall... and that's kinda big for a fox.
		}
		else if(this.rank==ZOMBIE) {
			int i = zomnames.find(this.name);
			if(i<0) return 2.0;
			return 1.0+(0.25*i);
		}// Zombies.
		else if(this.rank==KODOMO) {
			return 1.0 + (0.05*this.name.length());
		}//Children.
		else if(this.rank==MOUNT) return 1.5; // Eh...
		else if(this.g=="F") return 1.4+(0.03*this.name.length());
		else return 1.5+(0.05*this.name.length());
	}
	void damage(Actor@ attacker, double dmg) {
		if(this.hp<=0.0) return; // No point in hitting the dead.
		this.hp-=dmg;
		if(this.hp<=0.0) {
			// Set slot to -1, so fall animation can be a thing:
			this.setSlot(-1);
			// Play deathsound:
			if(this.rank==ZOMBIE) this.voiceplay(Swamp + "Weapons/kill" + random(1, 4) + ".wav");
			else if(this.rank==KODOMO) this.voiceplay("../pgs21/voice/Child Scream-SoundBible-1951741114.wav");
			else if(this.rank==INU) {
				if(this.name=="Fox" or this.name=="fox") this.voiceplay("nsounds/dogs/foxcry.wav");
				else if(this.name=="Wolf" or this.name=="wolf" or this.name=="Ookami" or this.name=="ookami") this.voiceplay("nsounds/dogs/wolf_die_0" + random(1, 4) + ".wav");
				else if(this.name=="Kitsune" or this.name=="kitsune") this.voiceplay("nsounds/Kitsune/killed1.wav");
				else this.voiceplay("nsounds/dogs/wardog_die_0" + random(1, 5) + ".wav");
			}// Inu diesounds.
			else this.voiceplay(voices + "die_" + this.g + ".wav");
			this.deathtype = FIGHT;
			if(@attacker!=null and (attacker.rank==ZOMBIE or (attacker.rank==INU and attacker.plague>0))) this.deathtype=BITE;
			// Track killer, so we can respawn, transfer power, or whatever.
			@(this.killer)=attacker;
		}//Dead.
		else if(this.rank==ZOMBIE) {
			// Zombie hitcries?
		}
		else if(this.rank==INU) {
			// Dogs, etc.
		}
		else if(this.rank==MOUNT) {
			
		}// Mounts.
		else this.voiceplay(voices + "hit_" + this.g + random(0, 4) + ".wav");
	}// Damage.
	
	void keyPressed(int k) {
		// Should there be states that you cannot cancel out of by just hitting another button? Ex, attacking?
		if(((this.state)&k)==0) this.setState(this.state|k);
	}
	void keyReleased(int k) {
		// More or less exclusively for attacking.
		if(this.state==k) {
			if(k==charging) this.setState(attacking);
			else if(k==DUCKING and this.counter==0.0) {
				string toplay = Swamp + "M40/CrouchOff.wav";
				// How long does this take?
				this.counter = 0.125*this.height();
				// Armor and heavy items should decrease stand speed.
				// Also drunkenness and fatigue.
			}// Unducking.
		}
	}// Key released.
	bool setState(int s) {
		if(this.counter<0.0 or this.state==s or (this.state==attacking and this.counter>0.0)) return false;
		else if(this.state==recovering and this.counter==0.0) this.state=0; // Glitch for 0 recovery attacks.
		// (If we want wakeups or similar, this is probably the place to put them.)
		if(((this.state)&stunned)!=0) return false;
		if(s==walking and this.state==talking) {
			this.state=0;
			this.counter=0.0;
		}
		
		//Since every human character has the exact same moveset, we are obligated to do the obnoxious big ol' if-else block.
		// However, there are nonhumans who work differently, so let's check for those first:
		if(this.rank==INU or this.rank==ZOMBIE or this.rank==MOUNT) {
			if(this.rank==ZOMBIE and this.name!="Canine" and this.name!="Ookami" and this.name!="Kitsune") {
				if(s==attacking and this.state!=attacking and this.state!=stunned and this.state!=recovering) {
					// Charging is kinda weird, isn't it?
					if(this.charged==0.0) this.charged = 0.1*random(1, 10);
					this.counter=0.4; // Default.
					if(this.name=="Behemoth" or this.name=="Giant") this.counter=0.5;
					else if(this.name=="Lamprey" or this.name=="Tyrant") this.counter=0.3;
					else if(this.name=="Matriarch" or this.name=="Normal" or this.name=="Stalker") this.counter=0.2;
					this.counter*=this.charged;
					this.state=s;
					this.voiceplay(Swamp + "Zombies/" + this.name + "/Attack" + random(1, 3) + ".wav");
					if(this.name == "Kitsune" or this.name == "kitsune") this.voiceplay("nsounds/kitsune/attack1.wav"); // umm.
				}// Attacking should interrupt most things.
				else if(this.counter!=0.0 or this.hp<=0.0) return false;
				else if(s==walking) {
					// Player zombies should run at their max speed, yeah?
					double sp = this.getSpeed();
					if(@(this.target)!=null) sp*=2.0;
					if(sp==0.0) this.counter=2.0;
					else this.counter=1.0/sp;
					this.state=s;
					// Todo: let play_step take a pitch parameter, to distinguish sizes of zombies?
					if(this.name=="Behemoth") {
						if(string_contains(wets, this.gloc.get_terrain(this.pose), 1)>=0) this.gloc.playsound(Swamp + "Zombies/Behemoth/Water" + random(1, 4) + ".wav", this.pose, false, false);
						else this.gloc.playsound(Swamp + "Zombies/Behemoth/Walk" + random(1, 4) + ".wav", this.pose, false, false);
					}
					else if(@(this.gloc)!=null) this.gloc.play_step(this.pose);
					this.v = sp*this.face;
				}// Zombie walk.
				else if(s==talking) {
					this.voiceplay(Swamp + "Zombies/" + this.name + "/Growl" + random(1, 7) + ".wav");
					if(this.name == "Kitsune" or this.name == "kitsune") {
						string[] kvs = {"attack", "selected", "invade"};
						this.voiceplay("nsounds/kitsune/" + kvs[random(0, 3)] + "1.wav"); // umm.
					}
				}//Talking zombies
				
			}// Zombies.
			else if(this.rank==MOUNT) {
				if(s==talking) {

				}//Talking mounts. Mostly horses.
				else if(s==walking) {

				}// Walking mounts.
			}// Mounts.
			else {
				if(s==attacking and this.state!=attacking and this.state!=stunned and this.state!=recovering) {
					// Charging is kinda weird, isn't it?
					if(this.charged==0.0) this.charged = 0.1*random(1, 10);
					this.counter=0.4; // Default.
					if(this.name=="Fox" or this.name=="fox" or this.name=="Kitsune" or this.name=="kitsune") this.counter=0.25;
					else if(this.name=="Wolf" or this.name=="wolf" or this.name=="Ookami" or this.name=="ookami") this.counter=0.5;
					this.counter*=this.charged;
					this.state=s;
					if(this.name=="Fox" or (this.name=="Kitsune" and random(1, 10)>5)) this.voiceplay("nsounds/dogs/foxgrowl" + random(1, 9) + ".wav");
					else if(this.name=="Kitsune") this.voiceplay("nsounds/Kitsune/attack1.wav"); // Hmm.
					else if(this.name=="Wolf" or this.name=="Ookami") this.voiceplay("nsounds/dogs/wolf_attack_0" + random(1, 5) + ".wav");
					else if(this.rank==INU) this.voiceplay("nsounds/dogs/wardog_attack_0" + random(1, 5) + ".wav");
					else this.voiceplay(Swamp + "Zombies/Canine/Attack" + random(1, 3) + ".wav");
				}// Attacking should interrupt most things.
				//else if(this.counter!=0.0 or this.hp<=0.0) return false;
				else if(s==walking or s==(JUMPING|walking)) {
					this.state=s;
					double sp = this.getSpeed();
					if(@(this.target)!=null) sp*=1.5;
					if(sp==0.0) this.counter=0.25;
					else this.counter=1.0/sp;
					this.state=s;
					// Todo: let play_step take a pitch parameter, to distinguish sizes?
					if((s&JUMPING)!=0) {
						sp*=0.707;
						this.v=vector(sp*this.face.x, this.getJump()*0.707, sp*this.face.z);
						if(@(this.gloc)!=null) this.setSlot(this.gloc.play_jump(this, false));
					}// Running jump.
					else {
						if(@(this.gloc)!=null) this.gloc.play_step(this.pose);
						this.v = sp*this.face;
					}
				}// dogwalk.
				else if(s==talking) {
					if(this.rank==ZOMBIE and this.name != "Kitsune") this.voiceplay(Swamp + "Zombies/" + this.name + "/Growl" + random(1, 7) + ".wav");
					else if (this.name == "Dog") this.voiceplay("nsounds/dogs/dog_bark_0" + random(1, 7) + ".wav");
					else if (this.name == "Hound") this.voiceplay("nsounds/dogs/dog_bark_b_0" + random(1, 9) + ".wav");
					else if(this.name=="Fox") this.voiceplay("nsounds/dogs/foxbark" + random(1, 2) + ".wav");
					else if(this.name=="Wolf" or this.name=="Ookami") {
						// Are we growling, or howling?
						if(random(1, 5)==4) this.voiceplay("nsounds/dogs/wolf_howl_0" + random(1, 5) + ".wav");
						else this.voiceplay("nsounds/dogs/wolf_growl_0" + random(1, 6) + ".wav");
					}// Wolves can growl and howl.
					else if(this.name=="Kitsune") {
						if(random(1, 6)>3) this.voiceplay("nsounds/Kitsune/selected1.wav");
						else this.voiceplay("nsounds/Kitsune/invade1.wav");
					}//Kitsune.
				}//Talking dogs.
				
			}// Inu.
		}// Nonhumans.
		else {
			if(s==JUMPING or s==(JUMPING|DUCKING)) {
				// When can you vertical jump? Pretty much only from wait.
				if(((this.state)&(DUCKING|JUMPING))!=this.state) return false;
				// If you're not on the ground, you can't jump... but can some people (read: ninjas) double-jump?
				if(((this.state)&JUMPING)!=0 and (this.combo>0 or this.rank!=SHINOBI)) return false;
				if(this.onGround()) {
					// If we're jumping from a crouch, we jump higher, but it has longer startup lag.
					this.v.y = this.getJump();
					this.setSlot(this.gloc.play_jump(this, (s&DUCKING)!=0));
					this.counter=1.0; // Wait, what is the duration for these?
					if((s&DUCKING) != 0 ) {
						this.v.y *=1.25;
						this.counter *=1.25;
					}//Super-jump.
				}// On ground.
				else {
					if(this.combo==0 and this.rank==SHINOBI) {
						this.combo = 1;
						this.v.y = this.getJump();
						if(@(this.gloc) != null) this.setSlot(this.gloc.playsound(MHI + "flag" + random(0, 4) + ".ogg", this.pose, false));
					}// Shinobi can double-jump.
					return false;
				}// Trying to jump in air?
			}//jump
			else if(((s&(walking|JUMPING))==s) and (((this.state)&(walking|talking))==this.state)) {
				double sp = this.getSpeed();
				// Check stamina and other status effects.
				
				if((s&JUMPING)!=0) {
					if(this.onGround()==false) return false;
					sp*=sqr2; //0.707;
					this.v.y=this.getJump()*sqr2; //0.707;
					this.setSlot(this.gloc.play_jump(this, false));
					this.counter=1.0; // Wait, what is the duration for these?
				}//Jumping.
				else {
					// Since bump-spamming is annoying, let's do a test before we start moving:
					vector test (this.pose.x+(this.face.x*sp*0.025), this.pose.y, this.pose.z+(this.face.z*sp*0.025));
					if(this.gloc.is_clear(test)) {
						if(@(this.mount) != null) {
							if((this.mount.name == "Horse" or this.mount.name == "horse") and (this.slot<0 or !this.gloc.pool.sound_is_playing(this.slot) )) this.setSlot( this.gloc.playsound( "nsounds/horse/gallop.wav", this.pose, false, true));
						}
						else this.gloc.play_step(this.pose);
						this.counter=0.25; // Check for modifiers, like fatigue.
					}//Success!
					else return false;
				}// Walking.
				this.v.x=sp*this.face.x;
				this.v.z=sp*this.face.z;
				this.state=s;
			}// Normal movement.
			else if(s==charging) {
				// Consider jumping, crouching, falling, etc. Are there weapons which cannot be used from those states?
				if(((this.state)&(walking|JUMPING|DUCKING))!=this.state) {
					// Consider special situations, ex, grappling.
					if(this.state==recovering) {
						// Can we combo?
						if(@(this.weapon)!=null and this.combo>this.weapon.combo) return false;
						else if(this.weapon is null and this.combo>this.rank) return false;
					}
					else return false;
				}
				
				this.charged=0.0;
				this.counter=1.0;
				this.state=s;
				// Sound for starting.
				if(this.weapon is null) {
					// I don't think we have a sound for this?
					if(random(0, 3)==1) this.sounds.insert_last(MHI + "s" + random(0, 5) + ".wav");
				}// Unarmed combat.
				else  if(this.weapon.category==2) {
					this.sounds.insert_last(sj + "drawbow" + random(1, 2) + ".wav");
				}// Drawing a bow.
				else if(this.weapon.name=="ihatsu" or this.weapon.category==9) {
					this.counter=1.0;
					this.state=attacking;
				}//food
				else if(this.rank==ZOMBIE or this.rank==INU) {
					// Do Zombies and animals get to charge?
				}// Nonhumans.
				else if((this.rank!=SHINOBI and this.rank!=KODOMO)&&(this.weapon.category!=1 and (this.weapon.category<7 or this.weapon.category==10))) {
					string toplay=voices + "kiai_" + this.g;
					toplay = toplay + "" + random(0, 9) + ".wav";
					this.sounds.insert_last(toplay);
				}// Battlecries.
			}//Charging an attack.
			else if(s==attacking) {
				//Fatigue, other status effects, etc come into play.
				int old_state = this.state;
				this.state=s;
				
				if(this.rank==INU) {

				}// Dogs.
				else if(this.rank==ZOMBIE) {
					// Zombies with weapons are confusing, ne?
					this.sounds.insert_last(Swamp + "Zombies/" + this.name + "/Attack" + random(1, 3) + ".wav");
					// What's the duration? Does it depend on the zombie? Randomness? Charge?
					this.counter=0.01*random(30, 40); // Standard.
					if(this.name=="Matriarch" or this.name=="Normal") this.counter=0.01*random(20, 30);
					else if(this.name=="Behemoth" or this.name=="Tentacle" or this.name=="Giant") this.counter=0.01*random(40, 50);
					// Zombies shouldn't suffer fatigue.
				}// Zombies.
				else if(this.weapon is null) {
					this.counter=0.1*random(1,3);
					if(this.rank==KODOMO) this.sounds.insert_last(MHI + "s" + random(0, 5) + ".wav");
					else {
						string lvl = (this.charged>0.75) ? "H" : (this.charged>0.35) ? "M" : "L";
						string pk = (random(1, 10)>5) ? "punch" : "kick";
						this.sounds.insert_last("../../fx/weapon swings/swing_" + pk + "_" + lvl + "_wav.ogg");
					}
				}// Unarmed.
				else if(this.weapon.category==2) {
					this.counter=0.2;
					if(this.arrows>0) {
						if(this.weapon.swingsound!="") this.sounds.insert_last(this.weapon.swingsound);
						else if(this.weapon.name=="Yumi") this.sounds.insert_last(sj + "bow" + random(1, 3) + ".wav");
						else this.sounds.insert_last(sj + "rocket.wav");
						this.arrows--;
					}// Ammo check.
					else this.state=0;
				}// Arrows.
				else {
 if(this.weapon.name=="kanabo") {counter=0.75; if((rank==DAIMYOU)||(rank==ASHIGARU)) counter=1.0;
 sounds.insert_last(sj + "zstaff" + random(1, 5) + ".wav");
 }// Kanabo.
					else if(this.weapon.name=="Kunai") {
						// Make sure one has kunai to use!
						if(this.kunai<=0) {
							this.state=0;
							this.counter=0.0;
							return false;
						}
						if((this.charged>0.5)||(this.rank!=SHINOBI)) this.counter=0.25;
						else this.counter=0.15;
						// What sound should kunai make when used?
						if(this.charged>=0.5) this.sounds.insert_last(this.weapon.swingsound);
					}// Kunai.
					else if((this.weapon.name=="Wakizashi")||(this.weapon.name=="Tanto")) {
						this.counter=0.25;
						this.counter=this.weapon.minswing+(this.weapon.maxswing*this.charged); // Phew. ... I mean, Fuu.
						this.sounds.insert_last(this.weapon.swingsound);
					}
					//else if(this.weapon.name=="black-egg") {
 //if((ninjaAmmo&0xF000)==0) {state=standing; counter=0.0; return false;}

//counter=0.1; sounds.insert_last(sj + "icebreak" + random(0, 5) + ".ogg");}
					else if(this.weapon.name=="jo") {
						this.counter=0.2;
						sounds.insert_last(sj + "staff" + random(1, 4) + ".wav");
					}
					else if((this.weapon.name=="Arquebus")&&(charged<0.25)&&(this.balls>0)) {
						this.counter=0.075;
						this.sounds.insert_last(sj + "shot.wav");
						this.balls-=1;
						// Uh, this game doesn't really handle reloading well, does it? 
					}
					else if(this.weapon.name=="Kusarigama") {
						this.counter=0.1*random(5, 8);
						sounds.insert_last(sj + "bo" + random(1, 6) + ".wav"); // ...
					}// Kusarigama
					else if(this.weapon.category==9) {
						this.counter=0.5+(0.1*random(0, 5));
						// (Anything that can alter this?)
						string n = string_to_lower_case(this.weapon.name);
						if(n=="sushi") {
							if(this.sushi<=0) this.state=recovering;
							else {
								this.food=100.0; // ???
								if(this.stamina<this.maxStamina) this.stamina += 15;
								this.hp = (this.hp<this.maxHP+30) ? this.hp+30 : this.maxHP;
								this.sushi-=1;
								this.sounds.insert_last(CA + "Population/Fisherman.wav");
							}
						}//sushi
						else if(n=="fruit" or n=="kudamono") {
							if(this.fruit<=0) this.state=recovering;
							else {
								this.food=(this.food>50) ? 100.0 : this.food+50; // ???
								this.stamina = (this.stamina>this.maxStamina-50) ? this.maxStamina : this.stamina+50;
								this.hp = (this.hp<this.maxHP+15) ? this.hp+15 : this.maxHP;
								this.fruit-=1;
								this.sounds.insert_last(CA + "Upgrade/Chef.wav");
							}
						}// Fruit.
						else if(n=="vegies" or n=="vegetables" or n=="rice" or n=="gohan" or n=="yasai") {
							if(this.vegies<=0) this.state=recovering;
							else {
								this.food=100.0; // ???
								if(this.stamina<this.maxStamina) this.stamina += 5;
								this.hp = (this.hp<this.maxHP+30) ? this.hp+30 : this.maxHP;
								this.vegies-=1;
								this.sounds.insert_last(CA + "Population/Farmer.wav");
							}
						}// Vegetables.
						else if(n=="sake") {
							if(this.sake<=0) this.state=recovering;
							else if(this.drunk>80) {
								this.sounds.insert_last(voices + "nomitsugi_" + this.g + ".wav");
								this.state=recovering;
								this.counter=3.5; // Increased from 2.5
							}// Can't drink no more!
							else {
								if(this.food<80.0) this.food+=25.0;
								if(this.stamina<this.maxStamina) this.stamina += 15;
								this.hp = (this.hp<this.maxHP+10) ? this.hp+10 : this.maxHP;
								this.sake-=1;
								if(this.drunk>=75.0 or (this.drunk>=50.0 and (this.rank==KODOMO or this.rank==INU))) {
									this.setSlot(this.gloc.play_fall(this));
									this.counter=random(3, 10);
									this.state=recovering;
								}//Nomitsugi!
								else this.sounds.insert_last(CA + "Upgrade/Innkeeper.wav");
								this.plague=0.0;
								if(this.drunk<100.0) this.drunk+=25.0;
							}
						}// Sake.
						else {
							if(this.meat<=0) this.state=recovering;
							else {
								this.food=100.0; // ???
								if(this.stamina<this.maxStamina) this.stamina += 15;
								this.hp = (this.hp<this.maxHP+40) ? this.hp+40 : this.maxHP;
								this.meat-=1;
								this.sounds.insert_last(CA + "Upgrade/Chef.wav");
							}
						}// Meat.
						if(n!="sake" and this.state==recovering) this.sounds.insert_last(Swamp + "Fieldkit/Empty.wav");
					}// Food.
					else {
						this.counter=0.3;
						this.counter=this.weapon.minswing+(this.weapon.maxswing*this.charged);
						if(this.weapon.swingsound!="") this.sounds.insert_last(this.weapon.swingsound);
						else if(this.weapon.name=="naginata") sounds.insert_last(sj + "thrust.wav");
						else this.sounds.insert_last(sj + "" + this.weapon.name + random(1, 6) + ".wav"); // ...
					}// Katana.
					
					this.counter*=1.0+(0.015*(1.0-(this.stamina/this.maxStamina)));
				}// Fatigue matters if it isn't a projectile.
				this.blocked=false;
			}// Attacking.
			else if(s==talking) {
				if(this.state!=walking) this.counter=2.0;
				// Use this.combo to determine what we're saying.
				string toplay=voices + this.state + "_" + random(0, 2) + this.g + ".wav";
				if(this.combo==0) {
					// Todo: Actually pick based on what time of day it is.
					toplay = voices + "greeting" + random(0, 2) + this.g + ".wav";
					if(this.gloc.weather=="crickets2") toplay = voices + "greeting2" + this.g + ".wav";
					this.combo+=1;
				}// Greetings.
				else if(this.combo<9) {
					toplay=voices + (this.gloc.weather) + (random(0, 2)) + this.g + ".wav";
			}// Weather-specific stuff.
				this.voiceplay(toplay); //this.sounds.insert_last(toplay);
			}

		}//Standard humans.
		this.process_sounds();
		return (this.state==s);
	}// Set State.
	
	void process_sounds() {
		if(this.gloc is null or this.gloc.pool is null) return;
		for(uint i=0; i<this.sounds.length(); i++) {
			if(this.sounds[i].length()>=5 and this.sounds[i][this.sounds[i].length()-5]=="*") {
				string fn = this.sounds[i];
				int val = random(1, 9);
				fn = string_replace(fn, "*", "" + val, true);
				while(val>0 and !file_exists(fn)) {
					val = 2*val/3; // Come to think of it, this might be a wee bit insane.
					fn = string_replace(this.sounds[i], "*", val, true);
				}
				this.sounds[i] = fn;
			}//Random selections.
			if(string_contains(this.sounds[i], "oice", 1)>0) {
				// Do we actually want voices to cut off previously playing vocals?
				this.voiceplay(this.sounds[i]);
			}//Vocal.
			else this.gloc.playsound(this.sounds[i], this.pose, false, false);
		}// Clear sounds array.
		this.sounds.resize(0);
		if(this.slot>=0 and this.gloc.pool.sound_is_playing(this.slot)) this.gloc.pool.update_sound_3d(this.slot, this.pose.x, this.pose.y, this.pose.z);
		if(this.voiceslot>=0 and this.gloc.pool.sound_is_playing(this.voiceslot)) this.gloc.pool.update_sound_3d(this.voiceslot, this.pose.x, this.pose.y, this.pose.z);
	}//Processing sounds.
	
	double getSpeed() {
		// Gets running speed, modified for equipment and status effects.
		double ret = this.speed;
		if(@(this.armor)!=null) {
			ret-=0.5;
			if(((armor.flags)&HEAVY)==HEAVY) speed-=0.5;
		}// Armor has a speed cost.
		if(@(this.weapon)!=null and (((this.weapon.flags)&HEAVY)==HEAVY)) ret-=0.5;
		
		// Mount speed bonuses
		if(@(this.mount)!=null) {
			if(this.mount.name=="horse" or this.mount.name=="Horse") {
				ret = 8.0; // Horses are significantly faster than humans
				// But slow down in water terrain
				if(@(this.gloc)!=null) {
					string terrain = this.gloc.get_terrain(this.pose);
					if(terrain=="Wade" or terrain=="Water") ret = 5.0;
					else if(terrain=="Swamp") ret = 4.0;
				}
			}
			else if(this.mount.name=="boat") {
				ret = 6.0; // Boats are faster than swimming
			}
			else if(this.mount.name=="Dragon" or this.mount.name=="dragon") {
				ret = 12.0; // Dragons are the fastest
			}
		}
		// Slow down if swimming without a boat
		else if(this.rank!=ZOMBIE and @(this.gloc)!=null) {
			string terrain = this.gloc.get_terrain(this.pose);
			if(terrain=="Swim" or terrain=="Swim2") {
				ret *= 0.4; // Swimming is much slower
				// Heavy items make it even worse
				if(@(this.weapon)!=null and (((this.weapon.flags)&HEAVY)==HEAVY or this.weapon.category==1)) ret *= 0.7;
				if(@(this.armor)!=null) ret *= 0.8;
			}
		}
		
		return ret;
	}
	double getJump() {
		// Returns jump velocity, with modifiers as appropriate.
		double ret = 7.0;
		if(this.rank==ZOMBIE and zomnames.find(this.name)>0) return 0.0; // Zombies can't jump!
		else if(this.rank==SHINOBI) ret +=1.0;
		else if(this.rank==DAIMYOU) ret -=1.0;
		else if(this.rank==INU) ret=5.0; // And that feels generous.
		else if(this.rank==MOUNT) {
			// This should depend on the type of mount, but really, it's mostly something that should be handled through the rider, isn't it?
			if(this.name=="horse") ret=5.0;
		}// Mounts.
		
		// Check for heavy equipment.
		// Fatigue and drunkenness should cut things dramatically.
		
		return ret;
	}//get jump
	
	void setSlot(int s) {
		if(this.slot>=0) {
			if(this.gloc is null) this.slot=-1;
			else this.gloc.pool.destroy_sound(this.slot);
		}
		this.slot=s;
	}
	void voiceplay(string fn) {
		if(this.voiceslot>=0) this.gloc.pool.destroy_sound(this.voiceslot);
		this.voiceslot = this.gloc.playsound(fn, this.pose, false, true);
	}
	
	string getRankString() {
		string ret = "";
		if(this.rank==KODOMO) ret = "child";
		else if(this.rank==ASHIGARU) ret = "Ashigaru";
		else if(this.rank==SAMURAI) ret = "Samurai";
		else if(this.rank==SHINOBI) {
			if(this.g=="F") ret = "Kunoichi";
			else ret = "Shinobi";
		}//Ninjas.
		else if(this.rank==DAIMYOU) ret = "Daimyou";
		else if(this.rank==INU) ret = "Dog";
		else if(this.rank==ZOMBIE) ret = "Zombie"; // Eh...
		else if(this.name == "Horse" or this.name == "horse") ret = (this.g == "M") ? "a stalion" : (this.g=="F") ? "a mare" : "a " + this.name;
		else if(this.g=="M") ret = "a man";
		else ret = "a woman";
		
		return ret;
	}// Rank String.
	
	int inv_find(string n) {
		for(int i=0; i<this.inv.length(); i++) {
			if(this.inv[i].name==n) return i;
		}
		return -1;
	}
	
	void upgrade_check(int xp) {
		this.kills += xp;
		// We upgrade every 5 kills?
		if(this.kills<5 or floor((this.kills-xp)/5) == floor(this.kills/5)) return;
		if(this.rank==KODOMO) {
			// If we have samurai or ninja weapons, become whichever we have the most of. Else, ashigaru.
			// Well, skipping directly to Daimyou isn't out of the question, but should be least likely.
			this.rank=ASHIGARU;
				this.rank=this.upgrade_by_weapons();
			this.gloc.playsound(CA + "Population/GrownUp.wav", this.pose, false, false);
			if(this.isPlayer()) this.gloc.voice.speak_interrupt(this.name + " has grown up to become " + this.getRankString() + "!");
			return;
		}// Do we grow up, now? :(
		else if(this.rank==ZOMBIE) {
			string targname="";
			if(this.name=="Lamprey") targname="Amorphous";
			else if(this.name=="Amorphous") targname="Flayer";
			else if(this.name=="Normal") targname="Giant";
			else if((this.name=="Canine" or this.name=="Ookami") and this.kills>=5) targname="Dire";
			else if(this.name=="Giant") targname="Tyrant";
			else if(this.name=="Stalker") targname="Reaper";
			else if(this.name=="Reaper") targname="Matriarch";
			else if((this.name=="Flayer" or this.name=="Matriarch" or this.name=="Tyrant" or this.name=="Dire") and this.kills>=10) targname="Hulk";
			else if(this.name=="Hulk" and random(1, 6)>3) targname="Behemoth";
			else if(this.name=="Behemoth" and @(this.gloc)!=null) {
				Actor@ tentacle = this.gloc.get_char(ZOMBIE, "Tentacle");
				@(tentacle.leader)=this;
				tentacle.pose=this.pose;
				@(tentacle.gloc) = this.gloc;
				// Find a target for the tentacle to go after?
				if(this.gloc.actors.length()<50) {
					this.gloc.actors.insert_last(tentacle);
					tentacle.voiceplay(Swamp + "Zombies/Tentacle/Spawn" + random(1, 3) + ".wav");
				}
			}// Spawn tentacles.
			else if(this.name=="Kitsune") {
				this.maxHP+=25;
				this.hp+=25;
				if(this.speed<8.0) this.speed+=0.25;
			}// Kitsune.
			this.stamina+=150;
			this.food+=50;
			if(targname!="" and @(this.gloc)!=null) {
				this.gloc.playsound(Swamp + "Player/rank.wav", this.pose, false, false);
				Actor@ z = this.gloc.get_char(ZOMBIE, targname);
				this.maxHP=z.maxHP;
				this.hp=this.maxHP;
				this.speed=z.speed+random(0, 3);
				// Armor?
				this.name=z.name;
				this.dest=vector(0, 0, 0);
				this.path.resize(0);
				// Target?
			@(this.target)=null;
			}// Upgrade.
		}// Zombies are more complicated.
		else if(this.rank==INU) {
			this.maxHP+=25;
			this.hp+=25;
			this.maxStamina+=25;
			this.stamina=this.maxStamina;
			if (this.food<100.0) this.food = 100.0;
		}// Can canines have upgrades?
		// Do we only play the upgrade sound for the player, or do we play it for everyone?
		this.gloc.playsound(CA + "General/upgrade.wav", this.pose, false, false);

	}//Upgrade check.
	
	int upgrade_by_weapons() {
			/* Returns the rank that makes most sense based on what equipment we have. */
			int sw = 0, nw=0, dw=0;
			for(uint i=0; i<this.inv.length(); i++) {
				if(this.inv[i] is null or this.inv[i].category>=9) continue;
				string n = string_to_lower_case(this.inv[i].name);
				if(n=="katana" or n=="wakizashi" or n=="nodachi" or n=="kanabo" or n=="naginata" or n=="shield" or n=="yumi") sw++;
				else if(n=="kunai" or string_contains(n, "dart", 1)>0 or string_contains(n, "egg", 1)>0 or string_contains(n, "ocket", 1)>0 or this.inv[i].category==7 or n=="ninjaken") nw++;
				else if(((this.inv[i].flags)&PRIZED)==PRIZED) dw++;
				if(n=="naginata" or n=="tanto") dw++;
			}// Inv loop.
			// I think, before we grow up to become a daimyou, we should see if we have any followers. A lack of followers probably means we do not go daimyou.
			if(dw>sw and dw>nw) return DAIMYOU;
			else if(nw>0 and nw>=sw) return SHINOBI;
			else if(sw>0) return SAMURAI;
			return ASHIGARU;
	}
	
	Actor@ findLeader(Actor@ test=null) {return this.getLeader(test);}
	Actor@ getLeader(Actor@ test=null) {
		/*Returns the Actor in charge, if we have a leader. The top leader with no leader above them.
			* if test is not null, we return test if test is in the hierarchy.
		*/
		
		if(this.leader is null) return null;
		// (No circular references allowed!)
		Actor@[] ls;
		Actor@ ret=this.leader;
		if(ret is test) return ret;
		while(@(ret.leader)!=null) {
			if(ls.find(ret.leader)>=0) return ret; // Circular references I disagree!
			ls.insert_last(ret);
			@ret=ret.leader;
			if(ret is test) return ret;
		}
		return ret;
	}//Find leader.
	bool opEquals(Actor@ o) {return @this == @o; }
	bool is_monk() {
		if(this.rank!=SHINOBI and this.rank!=KODOMO and this.rank!=ASHIGARU) return false;
		return (@(this.weapon)!=null and this.weapon.name=="ihatsu" or @(this.armor)!=null and this.armor.name=="ihatsu");
	}
	string honorific() {
		// These are the honorifics for leadership. chan/kun/etc are for other situations.
		if(this.rank==KODOMO) {
			if(this.leader is null) {
				if(this.g=="F" or this.g=="f") return "hime";
				else return "koushi"; // koutaishi?
			}
			else return "senpai";
		}//Child leaders.
		else if(this.rank==SHINOBI) return "sensei";
		else if(this.rank==DAIMYOU or this.leader is null) return "sama";
		else return "san"; // Eh...
	}
}//Character class.


funcdef bool hitcallback(Item@ it, Actor@ attacker, Actor@ defender, bool blocked);

// player object, for networking:
class Player {
	int peer=-1;
	string username="";
	int ychar=-1; // index in actors.
	bool muted=false, host=false;
	// This... feels... desperately incomplete.
	Player() {}
}


// Constructs a name from random kana / kanji.
// These are not meant to represent realistic Japanese names accurately, just get vaguely close.
string random_name() {

	string[] kana= {
		"a", "i", "u", "e", "o",
		"ka", "ki", "ku", "ke", "ko",
		"ga", "gi", "gu", "ge", "go",
		"sa", "shi", "su", "se", "so",
		"ta", "chi", "tsu", "te", "to",
		"ra", "ri", "ru", "re", "ro",
		"za", "ji", "zu", "ze", "zo",
		"da", "ji", "dzu", "de", "do",
		"ha", "hi", "hu", "he", "ho",
		"ba", "bi", "bu", "be", "bo",
		"pa", "pi", "pu", "pe", "po",
		"ma", "mi", "mu", "me", "mo",
		"na", "ni", "nu", "ne", "no",
		"wa", "n\'", "ya", "yu", "yo"
	};
	string[] kanji = string_split("tori yama akira moto hashi shinji tsuki no kage hiru haru ko sakura han suzuki ki hayashi guchi nori waka usagi tojo ryu ai yuki mizu mi sui"
	+ "tana hana rai ro aka aki o kawa saki tabe mitsu nobu hide", " ", true);
	int kanjinum = random(0, 2);
	int kananum=random(1, 4);
	while((kanjinum+kananum>3)&&(kanjinum>0)) {
		if(random(1, 10)>5) kananum--;
		else kanjinum--;
	}
	if(kanjinum+kananum==0) {
		kanjinum=random(0, 2);
		kananum=2-kanjinum;
		if(kanjinum==0) kananum=random(1, 4);
	}
	
	string kanjiname="";
	string kananame="";
	for(uint i=0; i<kananum; i++) kananame += kana[random(0, kana.length()-1)];
	for(uint i=0; i<kanjinum; i++) kanjiname += kanji[random(0, kanji.length()-1)];
	string newName="";
	if(random(0, 10)>=5) newName=kanjiname + kananame;
	else newName=kananame + kanjiname;
	/* Commenting out the small tsu support, because .
while(newName.indexOf("q")>=0) {
if(newName.indexOf("q")==newName.length-1) {newName=newName.substring(0, newName.length-1); newName += newName.charAt(newName.length-1); }
else if(newName.indexOf("q")==0) {newName=newName.substring(1, newName.length); newName=newName.charAt(0) + newName;}
else newName=newName.substring(0, newName.indexOf("q")) + newName.charAt(newName.indexOf("q")+1) + newName.substring(newName.indexOf("q")+1, newName.length);
}
	*/
	return newName;
}// Build Name.



// The game itself:
const uint max_loot_distance = 20; // Loot max distance should be smaller than pool max distance, yeah?

class ST : game {
	Actor@[] actors, mounts;
	Item@[] items;
	keyconfig@ key=null;
	Menu@ mainmenu=null, pausemenu=null, menu=null;
	sound@ bgm=null, weatheramb=null;
	string weather=""; // Eh...
	string curbgm="", nextTrack="";
	int ychar=0; // The index in the actors list being controlled by the player.
	sound_pool@ pool=null;
	custom_voice@ voice=null;
	network host;
	Player@[] players;
	
	// Map properties:
	string[][] map;
	// Notice: settings attached to the menus need to be synchronized across clients. Making the menus mirror the host's would be kinda silly, though, so we need to store them separately:
	int maxloot=10, maxzom=10, maxdog=10, maxbot=10, maxplay=10, maxteam=4;
	
	ST() {
		// If we want to make this portable to python, we should initialize all the vars here, yes?
		this.init();
		// Simple game for testing:
		this.generate_map();
		this.actors.insert_last(this.get_char(KODOMO));
		this.ychar=this.actors.length()-1;
		this.actors.insert_last(this.get_char(RONIN));
		for(uint i=0; i<zomnames.length()-4; i++) {
			this.actors.insert_last(this.get_char(ZOMBIE));
			this.actors[this.actors.length()-1].name=zomnames[i];
			this.actors.insert_last(this.get_char(random(0, 8))); // For testing?
			this.actors[this.actors.length()-1].mission = random(WANDER, HALT);
			this.actors.insert_last(this.get_char(random(0, 8))); // For testing?
			this.actors[this.actors.length()-1].mission = random(WANDER, HALT);
		}
		this.update_floortiles();
		for(uint i=0; i<this.floortiles.length(); i++) {
			vector ft = this.floortiles[i];
			if(this.map[ft.x][ft.z]=="Swim") {
				Actor boat();
				boat.rank=MOUNT;
				boat.name="boat";
				// pick a shore.
				int x=random(-1, 1), y=random(-1, 1);
				int tries=0;
				while(ft.x+x<0 or ft.x+x>=this.map.length() or ft.y+y<0 or ft.y+y>=this.map[ft.x].length() or this.map[ft.x+x][ft.z+y]=="") {
					tries++;
					x=random(-1, 1);
					y=random(-1, 1);
					if(tries>20) {
						x=0;
						y=0;
						break;
					}
				}// Loop.
				boat.pose = (10*ft);
				vector d (5*(x+1), 0, 5*(y+1));
				boat.pose+=d;
				@(boat.gloc)=this;
				this.mounts.insert_last(boat);
			}//Add boat.
		}// Add boats.
	}// Keep the constructor light.
	
	void init() {
		if(file_exists("keyconfig.ini")) @(this.key) = load_keyconfig("keyconfig.ini");
		else {
			if(file_exists("default_keyconfig.ini")) @(this.key) = load_keyconfig("default_keyconfig.ini");
			else {
				// Generate the default keyconfig.
			}
			if(this.key is null) alert("ERROR!", "Unable to load keyboard configuration!");
			this.key.save("keyconfig.ini", "If you receive load errors when running Sengoku Tide, try deleting this file.");
		}//No keyconfig.
		sound_pool temp;
		@(this.pool)=temp;
		this.pool.behind_pitch_decrease=5.0;
		this.pool.max_distance=40.0;
		custom_voice cv("voice.cfg");
		@(this.voice)=cv;
		this.voice.config_path = "voice.cfg";
		
		// Set up the main menu:
		Menu@ m = newMenu("Main Menu");
		m.add("Start Game", MENU_ENTER);
		m.add("Minimum Online Players", MENU_VALUE_SELECT).max=10;
		m.add("Maximum online players (must be at least minimum)", MENU_VALUE_SELECT).max=10;
		m.add("How much loot should appear on the map? ", MENU_VALUE_SELECT).value=10;
		m.add("How many AI zombies to start with? ", MENU_VALUE_SELECT).value=10;
		m.add("How many players start as zombies? ", MENU_VALUE_SELECT).value=4;
		m.add("Starting number of bot-led teams: ", MENU_VALUE_SELECT).value=4;
		m.add("Starting number of independent human bots:", MENU_VALUE_SELECT).value=10;
		m.add("Number of wild animal bots? ", MENU_VALUE_SELECT).value=10;
		m.add("Odds that a player spawns as a wild animal? (1d10 must roll less than this value to animal-spawn)", MENU_VALUE_SELECT).value=10;
		m.add("Text-to-speech Options...", MENU_ENTER).value=5;
		m.add("Join an online game...", MENU_ENTER).value=10;
		m.add("Host an online game...", MENU_ENTER).value=20;
		m.add("Exit.", MENU_ENTER).value=99;
		m.move=Swamp + "Menu/Select.wav";
		m.toggle=Swamp + "Menu/Server.wav";
		m.activate=Swamp + "Menu/Enter.wav";
		@(this.mainmenu)=menu;
		
	}//Init.
	
	bool is_clear(vector p) {
		int x = floor(p.x/10);
		int z = floor(p.z/10);
		if(x<0 or z<0 or x>=this.map.length() or z>=this.map[x].length() or this.map[x][z]=="") return false;
		// Check for special situations, like castles and forests, or sinking in water.
		if(p.y<=0.0) {
			// So, if we return false, we can't land. We don't want to return true if we could possibly fall through the ground, though.
			return true;
		}//Ground.
		else if(this.map[x][z]=="Stone" or this.map[x][z] == "Wood" or this.map[x][z]=="Leaves" or this.map[x][z]=="Leaves2") return this.get_height(p.x, p.y, p.z)<=p.y;
		
		return true;
	}//is the spot clear?
	
	vector get_camera() {
		if(this.ychar>=0 and this.ychar<this.actors.length() and @(this.actors[this.ychar]) != null) return this.actors[this.ychar].pose;
		return vector(this.pool.last_listener_x, this.pool.last_listener_y, this.pool.last_listener_z);
	}
	string get_terrain(vector p) {
		int x = floor(p.x/10);
		int z = floor(p.z/10);
		if(x<0 or z<0 or x>=this.map.length() or z>=this.map[x].length()) return "";
		return this.map[x][z];
	}
	int play_step(vector p) {
		string terrain = this.get_terrain(p);
		if(terrain=="") return -1;
		if(terrain=="Stone" or terrain=="Wood" or terrain=="Wood2") {
			if(p.y>=3) terrain="Roof2";
			else if(p.y>=2) terrain=sj + "squeakystep" + random(1, 2) + ".wav";
			// Identify stairs? I think get_terrain is a better place for that, really.
		}// Indoors.
		else if(this.weather=="snow") {
			if(string_contains(wets, terrain, 1)>=0) terrain="Ice";
			// Forests?
			else if(string_contains(hards, terrain, 1)<0) terrain="Snow";
		}//Snow.
		else if(this.weather=="rain" or this.weather=="storm") {
			// Should we increase water levels, or make things muddy?
			// Estimate how long it's been raining. This resets if the rain lasts for more than one minute, but shshsh.
			int f = this.game_clock.frame%3000;
			if(f<223) f+=3000;
			f-=223;
			if(f<500) {
				;
			}// Do nothing in the first 10s.
			if(terrain=="Dirt" or terrain=="Soil" or terrain=="Dirt2") {
				terrain="Mud";
				if(f>2000) terrain="Swamp";
			}// Dirt.
			else if(terrain=="Mud" or terrain=="Swamp") {
				if(terrain=="Mud") terrain="Swamp";
				else terrain="Water";
				if(f>2000) terrain="Water";
			}//Rising water.
		}//Rain.
		vector l = this.get_camera();
		uint max=9;
		if(terrain=="Cave" or terrain=="Metal2" or terrain=="Puddle" or terrain=="Rock2" or terrain=="Roof2" or terrain=="Wood2") max=6;
		else if(terrain=="Snow" or terrain=="Crawl" or terrain=="Ice") max=7;
		else if(string_right(terrain, 4)==".wav") return this.pool.play_3d(terrain, l.x, l.y, l.z, p.x, p.y, p.z, false);
		return this.pool.play_3d(steps + terrain + "/run" + random(1, max) + ".wav", l.x, l.y, l.z, p.x, p.y, p.z, false);
	}// Play stepsound.
	int play_jump(Actor@ me, bool is_big=false) {
		if(me is null) return -1;
		string terrain = this.get_terrain(me.pose);
		if(terrain=="") return -1;
		vector l = this.get_camera();
		
		string toplay = Swamp + "Weapons/M40/CrouchOff.wav";
		if(file_exists(steps + terrain + "/jump.wav")) toplay = steps + terrain + "/jump.wav";
		else if(string_contains("Water Swamp Wade", terrain, 1)>=0) toplay = sj + "waterwake2.ogg"; //+ ((random(0, 10)>=5) ? "wake2.ogg" : "walk1.ogg");
		else if(string_contains("Dirt2 Sand2", terrain, 1)>=0) toplay=steps + "CarpetedStairs/jump.wav";
		else if(terrain=="Leaves") toplay=steps + "Leaves2/jump.wav";
		//		else if(string_contains(dirty, terrain, 1)>=0) toplay=steps + terrain + "/run" + random(1, 6) + ".wav";
		else if(terrain=="Ice") toplay=steps + terrain + "/run" + random(7, 9) + ".wav";
		//else return steps + "Stone/jump.wav"; // no LCJUMP? I kinda feel like that needs to be used, honestly.
		if(is_big) this.pool.play_3d(Swamp + "Zombies/Reaper/Evade" + random(1, 3) + ".wav", l.x, l.y, l.z, me.pose.x, me.pose.y, me.pose.z, false);
		return this.pool.play_3d(toplay, l.x, l.y, l.z, me.pose.x, me.pose.y, me.pose.z, false, true);
	}//play jump.
	int play_bump(Actor@ me, vector p) {
		if(me is null) return -1;
		string terrain = this.get_terrain(me.pose);
		// Really, though, it's tempting to take the terrain at p into consideration, too.
		string toplay = Swamp + "Obstacles/Wall.wav";
		if(terrain=="Leaves" or terrain=="Leaves2") toplay = Swamp + "Obstacles/Brush.wav";
		else if(terrain=="Water" or terrain=="Swim" or terrain=="Swim2" or terrain=="Wade") {
			toplay = Swamp + "Obstacles/Sand.wav";
			if(p.x<=0 or p.z<=0 or p.x>=10*this.map.length() or p.z>=this.map[0].length()) toplay = Swamp + "Obstacles/River.wav";
		}//Water.
		// This feels extremely inadequate.
		
		vector l = this.get_camera();
		return this.pool.play_3d(toplay, l.x, l.y, l.z, p.x, p.y, p.z, false);
	}//play bump.
	int play_fall(Actor@ me) {
				if(me is null) return -1;
				string toplay = "";
				double x=me.pose.x, y=me.pose.y, z=me.pose.z;
				vector camera = this.get_camera();
				string terrain = this.get_terrain(me.pose);
				if(terrain=="") return -1;
				if(y>=2 and terrain=="Leaves2" and random(0, 10)>=5) toplay=sounds2 + "bodyfall_treeAB_0" + random(1, 3) + ".wav";
				else if(file_exists(steps + terrain + "/fall1.wav")) toplay=steps + terrain + "/fall" + random(1, 4) + ".wav";
				else if(file_exists(steps + terrain + "/fall1.ogg")) toplay=steps + terrain + "/fall" + random(1, 4) + ".ogg";
				else if(terrain=="Dirt2") toplay = steps + "Soil/fall" + random(1, 4) + ".wav";
				else toplay="pickle.pie";
				if(!file_exists(toplay)) {
					if(string_contains(wets, terrain, 1)>=0) toplay=steps + "Swim/fall" + random(1, 4) + ".wav";
					else if(terrain=="Plank") toplay=steps + "Wood/fall" + random(1, 4) + ".wav";
					//else if(terrain=="Metal2") return toplay=steps + terrain + "/" + randstring(newString("fall1.wav", "fall1.ogg", "bump.ogg", "slide.wav"));
					else if(string_contains(hards, terrain, 1)>=0) toplay=steps + "/bktile/fall" + random(1, 4) + ".wav";
					else if(string_contains(softs, terrain, 1)>=0) toplay=steps + "CarpetedStairs/fall" + random(1, 4) + ".ogg";
					else if(string_contains(dirty, terrain, 1)>=0) {
						toplay=steps + "Rock/fall" + random(1, 4) + ".wav";
						for(uint i=0; i<random(4, 6); i++) pool.play_extended_3d(steps + terrain + "/run" + random(1, 9) + ".wav", camera.x, camera.y, camera.z, x+(0.1*random(-20, 20)), y-1+(0.02*random(0, 100)), z, 0, 0, 0, 0, 0, 0, 0, false, random(-100, 10), 0, random(-10, 0), 92.0+(0.16*random(0, 100)), false);
					}// DANGER!
				}// categories.
				
				// (Anything extra? pitch for hard falls, armor sounds, etc?)
				// ... Feh, zombies need special treatment, don't they?
				
				return this.playsound(toplay, me.pose, false, true);
	}// falls.


	int play_land(Actor@ me) {
					if(me is null) return -1;
					int min=1, max=9;
					string terrain = this.get_terrain(me.pose);
					if(terrain=="Cave" or terrain=="Puddle" or terrain=="Crawl" or terrain=="Metal2" or terrain=="Rock2" or terrain=="Roof2" or terrain=="Wood2") max=6;
					else if(terrain=="Snow" or terrain=="Ice") min=7;
					string toplay = "";
					if(terrain=="Swim") toplay = steps + "Wade/fall" + random(1, 4) + ".wav";
					else if(terrain=="Swim2") toplay = steps + "Swim2/fall1.wav";
					else toplay=steps + terrain + "/run" + random(min, max) + ".wav";
					return this.playsound(toplay, me.pose, false);
	}//play landing sound
	
	void generate_map() {
		int[][] maze = amaze(20, 3, 6);
		this.map.resize(maze.length());
		for(uint i=0; i<maze.length(); i++) {
			this.map[i].resize(maze[i].length());
			for(uint j=0; j<maze[i].length(); j++) {
				if(maze[i][j]==0) {
					this.map[i][j] = terrains[random(0, terrains.length()-1)];
					if(i==1 or j==1 or i==maze.length()-2 or j==maze[i].length()-2) {
						string ter = (random(0, 5)<3) ? "Stone" : "Wood";
						if(i==1) this.map[0][j] = ter;
						if(j==1) this.map[i][0] = ter;
						if(i==1 and j==1) this.map[0][0] = ter;
						if(i == maze.length()-2) {
						this.map[i+1].resize(maze[i+1].length());
							this.map[i+1][j]=ter;
						}
						if(j==maze[i].length()-2) this.map[i][j+1] = ter;
						if(i>1 and i==j) this.map[i+1][j+1] = ter;
						else if(i==1 and j==maze[i].length()-2) this.map[0][j+1] = ter;
						else if(j==1 and i == maze.length()-2) this.map[i+1][0] = ter;
						if(string_contains( wets, this.map[i][j], 1)<0) {
							Actor@ horse = this.get_char(MOUNT, "Horse");
							horse.pose = vector((i*10)+5.0, 0, (j*10)+5.0);
							this.mounts.insert_last(horse);
						}// Add a horse for every castle?
						else {
							Actor@ boat = this.get_char(MOUNT, "boat");
							boat.pose = vector(i*10, 0, j*10);
							if (i==1) boat.pose.z += 5.0;
							else if(j==1) boat.pose.x += 5.0;
							else if(i== maze.length()-2) {boat.pose.x += 10; boat.pose.z += 5.0;} //?
							else {boat.pose.z += 10; boat.pose.x += 5.0; }
							this.mounts.insert_last(boat);
						}// Add a boat, which is more complicated.
					}// Found a border spot for castles.
				}
				else if (this.map[i][j] !="Stone" and this.map[i][j] != "Wood") this.map[i][j]="";
			}//j
		}//i
		
		// We update floortiles at the end, in case we want to make map generation more complicated in the future:
		this.update_floortiles();
	}// Generate the map.
	Actor@ get_char(int type, string name="", string ge="") {
		Actor ret;
		ret.rank=type;
		if(name!="") ret.name=name;
		else ret.name=random_name();
		if(ge!="") ret.g=ge;
		if(type==ZOMBIE) {
			ret.speed=1.0;
			ret.maxHP=50;
			//aspeed=3.0;
			//exp=1;
			//strength=15;
			if(name=="") name=zomnames[random(0, zomnames.length()-1)];
			if(name.length()>1) name=string_to_upper_case(name[0]) + string_right(name, name.length()-1);
			ret.name=name;
			string n=string_to_lower_case(name);
			if(n=="canine") {
				ret.maxHP=60;
				ret.speed=4;
				//awareness=5;
				//ret.strength=10;
			}
			else if(n=="normal") {
				ret.maxHP=100;
				//awareness=2;
				ret.speed=1;
				//aspeed=4;
			}// Normal.
			else if(n=="giant") {
				ret.maxHP=150;
				ret.speed=0.1*random(7, 13);
				//strength=25;
				//aspeed=4;
				//exp=4;
			}//Giant
			else if(n=="tyrant") {
				ret.maxHP=500;
				ret.speed=0.1*random(7,20);
				//ret.strength=40;
				//awareness=4;
				//exp=10;
			}
			else if(n=="stalker") {
				ret.maxHP=100;
				ret.speed=2;
				//ret.strength=random(10, 20);
				//aspeed=2;
				//awareness=4;
				//exp=3;
			}
			else if(n=="matriarch") {
				ret.maxHP=300;
				//exp=8;
				//ret.strength=random(25, 40);
				//awareness=4;
			}
			else if(n=="reaper") {
				//exp=4;
				ret.speed=2;
				//strength=random(10, 30);
				//awareness=3;
				ret.maxHP=150;
			}// Reaper
			else if(n=="lamprey") {
				//exp=2;
				ret.speed=1.5;
				//strength+=random(-5, 10);
				//awareness=1;
				ret.maxHP=150;
				//exp++;
			}// Lamprey.
			else if(n=="dire") {
				ret.maxHP=400;
				ret.speed=4;
				//awareness=5;
				//ret.strength=40;
				//aspeed=2.5;
				//exp=15;
			}// Dires.
			else if(name=="Amorphous") {
				ret.speed=2.5; 
				//aspeed=2.5;
				//exp=15;
				//ret.strength=30;
				ret.maxHP=700;
			}// Amorphous
			else if(n=="hulk") {
				//ret.strength=60;
				ret.maxHP=1500;
				ret.speed=2.5;
				// aspeed=3;
				//awareness=3;
				//exp=30;
			}// Hulks.
			else if(n=="tentacle") {
				// I actually want these to ignore gravity and slide along walls.
				ret.maxHP=100;
				//strength=25; // Much?
				ret.speed=3.5;
				//awareness=3;
				//aspeed=4.0; // It drags you more than damages you.
				//exp=7; // Hopefully.
			}// Tentacles.
			else if(n=="behemoth") {
				//ret.strength=100; // Shut up; you have armor by now.
			ret.speed=1.0; // Hmm.
				//awareness=5; //???
				//aspeed=2.5; //???
				//exp=35;
				ret.maxHP=2000;
			}// Behemoth.
		}// Init zombies.
		else if(ret.rank==INU) {
			if(name=="") ret.name = dognames[random(0, dognames.length()-1)];
			if(ret.name=="Fox" or ret.name=="Kitsune") {
				if(ret.name=="Fox") ret.maxHP=50;
				ret.speed=5.0;
			}
			else if(ret.name=="Wolf" or ret.name=="Ookami") {
				ret.maxHP+=25;
				ret.speed=3.0;
			}
		}
		else if(ret.rank==MOUNT and name!="boat") {
			if(name=="") name="Horse";
			ret.name=name;
			ret.speed=6.0; // Eh?
		}// Mounts.
		else if(random(0, 10)!=4) {
			// Give people starting equipment.
			string ops="bo jo bouken sai tanto axe hammer net nagamaki";
			if(ret.rank==KODOMO) ops = "bouken jo tanto net shuriken";
			else if(ret.rank==SAMURAI or ret.rank==RONIN) ops = "katana wakizashi naginata nodachi kanabo yumi tachi katana wakizashi yumi Shield Armor";
			else if(ret.rank==SHINOBI) ops = "ihatsu katana tachi nagamaki sai tanto bo jo kunai shuriken black-egg blow-dart kunai rocket-bow kusarigama";
			else if(ret.rank==DAIMYOU) ops = "tanto naginata tachi tanto naginata tachi Meat Sushi Sake Arquebus";
			string[] ino = string_split(ops, " ", true);
			string nn = ino[random(0, ino.length()-1)];
			nn = string_to_upper_case(nn[0]) + string_trim_left(nn, 1);
			this.getItem(ret, get_item(nn));
		}
		
		ret.hp=ret.maxHP;
		@(ret.gloc)=this;
		if(this.floortiles.length()>0) ret.pose = 10*this.floortiles[random(0, this.floortiles.length()-1)];
	ret.pose=this.findclearspot();
		return ret;
	}// Get char.
	
	vector[] floortiles; // Annoying. We can have thousands of these.
	void update_floortiles(string walls="") {
		this.floortiles.resize(0);
		this.floortiles.reserve(512); // :(
		for(uint x=0; x<this.map.length(); x++) {
			for(uint y=0; y<this.map[x].length(); y++) {
				if(this.map[x][y]=="" or string_contains(walls, this.map[x][y], 1)>=0) continue;
				else this.floortiles.insert_last(vector(x, 0, y));
			}//y
		}//x
	}
	
	vector findclearspot(double o = 5.0) {
		if(this.floortiles.length()==0) this.update_floortiles();
		vector v = 10*this.floortiles[random(0, this.floortiles.length()-1)];
		vector offset(o, 0, o);
		// If some sections are not big open squares, adjust offset accordingly.
		return v+offset;
	}
	
	void handle_input(int k, int p=-1, keyconfig@ kc=null) {
		if(p==-1) p = this.ychar;
		if(p<0 or p>=this.actors.length() or this.actors[p] is null) {
			return;
		}// No character associated with p.
		
		// It is important to know if we're dealing with the player or not.
		Actor@ me = this.actors[p];
		
		if(me.hp<=0.0) {

		}// What to do with a dead actor?
		else {
			if(k==Q and p==this.ychar) {
				string tosay = me.getRankString() + " " + me.name;
				if(@(me.leader)!=null) {
					tosay += ", follows " + me.leader.name + "-" + me.leader.honorific();
					if(@(me.leader.leader)!=null) {
						Actor@ l = me.getLeader();
						tosay += ", in the army of " + l.getRankString() + " " + l.name + "-" + l.honorific();
					}// Multi-level hierarchy.
				}
				
				int f = this.countFollowers(me);
				if(f>0) tosay += ", with " + f + " followers";
				if(me.rank == ZOMBIE) {
					int zc=0, hc=0;
					for(uint i=0; i<this.actors.length(); i++) {
						if(this.actors[i] is null or this.actors[i].rank==MOUNT or this.actors[i].rank==INU) continue;
						else if(this.actors[i].rank == ZOMBIE) zc+=1;
						else hc+=1;
					}
					tosay += ". There are " + zc + " zombies, and " + hc + " humans remaining. ";
				}// Zombie data should be more population-level.
				this.voice.speak_interrupt(tosay);
			}//Q.
			else if(k==L or k==R or k==U or k==D) {
				//We are allowed to turn under most circumstances, but we should be sure this isn't one of the exceptions.
				// (Todo: if grappling happens, it should probably have a rather different interaction with directions.)
				if(me.state==stunned) return;
				if(@kc!=null) {
					if(kc.key_down(L)) {
						if(kc.key_down(U)) me.face = vector(-sqr2, 0, sqr2);
						else if(key_down(D)) me.face = vector(-sqr2, 0, -sqr2);
						else me.face = vector(-1, 0, 0);
					}
					else if(kc.key_down(R)) {
						if(kc.key_down(U)) me.face = vector(sqr2, 0, sqr2);
						else if(key_down(D)) me.face = vector(sqr2, 0, -sqr2);
						else me.face = vector(1, 0, 0);
					}
					else if(k==U) me.face = vector(0, 0, 1);
					else if(k==D) me.face = vector(0, 0, -1);
				}// Diagonals plz.
				else if(k==L) me.face = vector(-1, 0, 0);
				else if(k==R) me.face=vector(1, 0, 0);
				else if(k==U) me.face = vector(0, 0, 1);
				else if(k==D) me.face = vector(0, 0, -1);
				// Do notice: if we're already in motion, our velocity is unaffected!
				if(me.state==talking) me.setState(walking);
				else me.keyPressed(walking);
			}// Walk.
			else if(k==JL or k==JR or k==JU or k==JD) {
				// I feel I've made a terrible mistake of organization, here. It's literally the same as L|R|U|D, but the keypress goes JUMPING|walking instead of walking.
				// Also, diagonals with jumping are even worse, because is the jump button down, or the walk button? Since it could go either way, we have to be just as tedious for JU and JD.
				if(me.state==stunned) return;
				if(@kc!=null) {
					if(kc.key_down(JL)) {
						if(kc.key_down(JU) or kc.key_down(U)) me.face = vector(-sqr2, 0, sqr2);
						else if(key_down(JD) or kc.key_down(D)) me.face = vector(-sqr2, 0, -sqr2);
						else me.face = vector(-1, 0, 0);
					}
					else if(kc.key_down(JR)) {
						if(kc.key_down(JU) or kc.key_down(U)) me.face = vector(sqr2, 0, sqr2);
						else if(key_down(JD) or kc.key_down(D)) me.face = vector(sqr2, 0, -sqr2);
						else me.face = vector(1, 0, 0);
					}
					else if(k==JU) {
						if(kc.key_down(L)) me.face = vector(-sqr2, 0, sqr2);
						else if(kc.key_down(R)) me.face = vector(sqr2, 0, sqr2);
						else me.face = vector(0, 0, 1);
					}
					else if(k==JD) {
						if(kc.key_down(L)) me.face = vector(-sqr2, 0, -sqr2);
						else if(kc.key_down(R)) me.face = vector(sqr2, 0, -sqr2);
						else me.face = vector(0, 0, -1);
					}
				}// Diagonals plz.
				else if(k==JL) me.face = vector(-1, 0, 0);
				else if(k==JR) me.face=vector(1, 0, 0);
				else if(k==JU) me.face = vector(0, 0, 1);
				else if(k==JD) me.face = vector(0, 0, -1);
				me.keyPressed(JUMPING|walking);
			}//Directional jumping.
			if(k==J) me.keyPressed(JUMPING);
			else if(k==C) me.keyPressed(DUCKING);
			else if(k>=W1 and k<=WF) {
				int index = k-W1;
				int i = -1;
				if(@(me.weapon)!=null and me.weapon.category==index) i = me.inv.find(me.weapon);
				int j=i;
				// I have experience with while loops like this one getting stuck. I'm not sure what mistake I consistently make in them. Beware, I guess.
				do {
					j+=1;
					if(j>=me.inv.length()) {
						j=0;
						if(i==-1) break;
					}
					else if(me.inv[j] is null) {
						me.inv.remove_at(j);
						continue;
					}
					if(me.inv[j].category==index) break;
					if(j>=me.inv.length()-1) j=-1;
				} while (j!=i); //Search for weapons.
				if(j<0 or j>=me.inv.length() or me.inv[j] is null or me.inv[j].category!=index) {
					if(p==this.ychar) this.voice.speak_interrupt("No " + categorynames[index]);
					return;
				}
				@(me.weapon)=me.inv[j];
				me.state=drawing;
				me.counter=me.weapon.drawtime;
				// Todo: can certain armors or status effects alter drawspeed?
				if(me.weapon.drawsound!="") this.playsound(me.weapon.drawsound, me.pose, false, false);
				else if(me.weapon.category==4) this.playsound(MHI + "../../fx/WIELD/1.ogg", me.pose, false, false);
				else if(me.weapon.range<1.0) this.playsound(MHI + "../../fx/WIELD/4.ogg", me.pose, false, false);
				else if(me.weapon.category==0) this.playsound(MHI + "../../fx/WIELD/" + random(2, 5) + ".ogg", me.pose, false, false);
				//else clipboard_copy_text("Drawsound failed because drawsound is empty. " + me.weapon.drawsound);
				if(p==this.ychar) this.voice.speak_interrupt(me.weapon.name + " equipped");
			}// Draw weapons.
			else if(k==E or k==RR or k==RU or k==RD or k==RL) {
				if(this.rdir==k) {
					this.last_rdir=k;
					this.rdir=-1;
				}//Turn it off.
				else {
					this.rdir=k;
					this.last_rdir=-1;
					this.radartime=this.game_clock.delay*0.001;
					this.radarstep=0;
				}//On
			}//Radar.
			else if(k==A) {
				if(me.rank==ZOMBIE) {
					me.charged=0.1*random(1, 10);
					me.setState(attacking);
				}// Zombie attacks are less munchkinable.
				else if(me.weapon is null or me.weapon.category==0 or (me.weapon.category>1 and me.weapon.category<8) or me.weapon.category==10) me.setState(charging);
				else if(me.weapon.category==1) {

				}// Armor.
				else if(me.weapon.category==8) {
					if(me.target is null or me.target.rank == ZOMBIE or me.target is me or me.target.leader is me or me is me.target.leader or me.getLeader() is me.target.getLeader() ) {
						for(uint j = 0; j<this.actors.length(); j++) {
							Actor@ them = this.actors[j];
							if (them is null or them.hp<=0.0 or them.rank==ZOMBIE or them is me or (them.pose-me.pose).length() > 4.0) continue;
							// Leader comparison. We can share with people on the same team, but we prioritize people who are not in our team.
							if(me.target is null or me.target.getLeader() is me.getLeader()) @(me.target) = them;
						}
					}// Find a suitable target.
					if(me.target is null or me.target.rank == ZOMBIE) {;}
					//If we're in the same group, just share the items:
					else if(me.target.leader is me or me.leader is me.target or me.getLeader() is me.target.getLeader()) {
							me.target.inv.insert_last(me.weapon);
							me.inv.remove_at(me.inv.find(me.weapon));
							@(me.weapon) = null;
							this.voice.speak_interrupt(me.name + " gave the " + me.target.inv[ me.target.inv.length()-1 ].name + " to " + me.target.getRankString() + " " + me.target.name + ". ");
					}//Same team.
					else if(@(me.target) != null) {
						attempt_recruitment(me, me.target, me.weapon);
						if(@(me.weapon) != null and (me.target is null or (me.target.inv.length()>0 and me.target.inv[ me.target.inv.length()-1 ] is me.weapon))) @(me.weapon) = null;
					}
				}//gifts?
				else if(me.weapon.category==9) {
					me.setState(attacking);
				}// Food.
				else me.setState(charging);
			}//Attack.
			else if(k==ENTER) {
				// How many things can we interact with, other than mounts?
				if(@(me.mount)!=null) {
					@(me.mount.mount)=null;
					if(me.mount.name=="boat") me.setState(walking|JUMPING); // Jump out of the boat so you don't land in the water.
					else me.setState(JUMPING);
					@(me.mount)=null;
					this.playsound(Swamp + "M40/CrouchOff.wav", me.pose, false, false);
				}// Dismount.
				else {
					for(uint i=0; i<this.mounts.length(); i++) {
						if(this.mounts[i] is null or absolute(me.pose.x-this.mounts[i].pose.x)>2 or absolute(me.pose.z-this.mounts[i].pose.z)>2) continue;
						@(me.mount)=this.mounts[i];
						@(me.mount.mount)=me;
						me.pose.x=me.mount.pose.x;
						me.pose.z=me.mount.pose.z;
						me.pose.y=me.mount.pose.y;
						// Face? V?
					}// Mounts loop.
					if(me.mount is null) {
						// what else is there?
					}// No mount found.
					else if(p==this.ychar) this.voice.speak_interrupt("Riding " + me.mount.name);
				}// Find something to interact with.

			}//Interact.
			// Information and stuff to follow. All actions which online players can perform should happen above this line!
			else if(p!=this.ychar) return;
			else if(k==V) this.voice.speak_interrupt(me.name + " is at " + round(me.pose.x, 0) + ", " + round(me.pose.y, 0) + ", " + round(me.pose.z, 0) + ".");
			else if(k==Z) {
				string tosay="";
				if(me.weapon is null) tosay = "unarmed";
				else if(me.weapon.category==1 or (((me.weapon.flags)&ARMOR)==ARMOR)) "considering wearing " + me.weapon.name;
				else if(me.weapon.category==9 or (((me.weapon.flags)&FOOD)==FOOD)) tosay = "holding " + me.weapon.name;
				else if(me.weapon.category==2) tosay = "wielding a " + me.weapon.name + ", with " + me.arrows + " arrows";
				else if(me.weapon.category==6) {
					tosay = "wielding " + me.weapon.name + ", with ";
					if(me.weapon.name=="Kunai") tosay += me.kunai;
					else if(me.weapon.name=="Black-egg") tosay = "wielding a black egg";
					else if(me.weapon.name=="Shuriken") tosay += me.shuriken;
					else if(me.weapon.name=="Blow-dart") tosay += me.darts;
					if(me.weapon.name!="Black-egg") tosay += " in reserve";
				}//Thrown projectiles.
				else if(me.weapon.category==7) {

				}// Guns.
				else tosay = "wielding a " + me.weapon.name;
				this.voice.speak_interrupt(me.name + " is " + tosay + ".");
			}//Say weapon and ammo.
			else if(k==X) this.voice.speak_interrupt(round(me.hp, 0) + " health, out of " + me.maxHP + ". " + round(me.stamina, 0) + " stamina, out of " + me.maxStamina + ". " + ((me.armor is null) ? "" : ("Wearing " + me.armor.name)) );
			else if(k==STATUS) {
				this.voice.speak_interrupt(round(me.food, 0) + " food, level " + me.kills + ". You are " + round(me.plague, 0) + "% sick, and " + round(me.drunk, 0) + "% drunk.");
			}// Status.
		}//Alive.
	}// Input.
	
	//Radar vars:
	double radartime=0.0, navtime=0.0;
	int radarstep=0, rdir=-1, last_rdir=-1;
	void tickRadar(double dt) {
		if(rdir<0) return;
		this.radartime-=dt;
		if(this.radartime>0.0) return;
		else this.radartime=0.16; // Maybe try different speeds?
		
		// If the sounds don't exist, create them.
		
		double rtheta=pi4*this.radarstep/2;
		
		if(this.rdir == RU) rtheta+=pi4/2.0;
		else if(this.rdir==RR) rtheta = (rtheta+(1.5*pi)+(pi4/2))%(2.0*pi);
		else if(this.rdir==RL) rtheta = rtheta + pi2 + (pi4/2);
		else if(this.rdir==RD) rtheta = rtheta + pi + (pi4/2);
		
		
		vector c = this.get_camera(); // Dangerous if there is no active player, but why is the radar on in that case, anyway?
		vector d(cosine(rtheta), 0, sine(rtheta));
		double rrange = 10.0; //(this.rdir < radar_fl) ? 4 : 8;
		
		string toplay="Radar";
		bool found=false;
		double r=1.0;
		for(r=1; r<rrange; r+=1) {
			double h = this.get_height(c.x+(d.x*r), c.y, c.z+(d.z*r));
			found=true;
			if(h<0 or (c.y>=2 and h<2)) toplay="Lower";
			else if(h>c.y) {
				if(h==3) toplay="Impassable";
				else if(h<3) toplay = "Higher";
				else toplay="Wall";
			}//Walls and such.
			else found=false;
			if(found) break;
		}//Casting loop.
		this.playsound(Swamp + "Radar/" + toplay + ".wav", vector(c.x+(r*d.x), c.y, c.z+(r*d.z)), false);
		this.radarstep += 1;
		if(this.rdir==E) {
			if(this.radarstep>15) this.radarstep=0;
		}// All.
		else if(this.radarstep>=7) this.radarstep=0;
	}//Tick radar.
	
	int playsound(string filename, vector s, bool looping, bool persistent=false) {
		// (We could cache sounds that exist, so we can return early if we get a bad sound.)
		vector l = this.get_camera();
		return this.pool.play_3d(filename, l.x, l.y, l.z, s.x, s.y, s.z, looping, persistent);
	}
	
	int get_height(double x, double y, double z) {
		/* Returns the height of obstacles on the map at (x, y, z).
		 * Notice that y matters, because we ignore overhangs unless we're above them.
		 * We return the max value for castle walls if y is on the bottom floor, even if the walls are only a few meters high, so the radar doesn't trick players into thinking they can climb when they really cannot.
		*/
		
		int ix = floor(x/10);
		int iz = floor(z/10);
		if(ix<0 or iz<0 or ix>=this.map.length() or iz>=this.map[ix].length() or this.map[ix][iz]=="") return 9001;
		// Castles, forests, ocean, pits...
		if(this.map[ix][iz]=="Leaves" or this.map[ix][iz]=="Leaves2") {
			// How many trees are there in this section?
			int trees = (ix+iz)%8;
			// We mostly arrange the trees like the pips on dice, but some aren't quite symmetrical enough for that, so let's select orientation:
			// Evens and odds should select differently, probably. There was a reason for this, but it's been like two or three days since I thought of it, and I don't remember what it was.
			int angle = (trees%2==0) ? ix%4 : iz%4;
			//To simplify climbing, we make branches solid from above, but not below, like so:
			double r = (y>=2) ? 2 : 1;
			// Divide the forest into 9 squares:
			double q = 10.0/3.0;
			int sqx = ((x%10.0)/q);
			int sqz = ((z%10.0)/q);
			int sq = (sqz*3)+sqx+1;
			if(sq<1 or sq>9) clipboard_copy_text("Error: Bad value for forest square: " + sq + ", (" + sqx + ", " + sqz + "), " + x + ", " + z);
			else if(key_down(KEY_X)) clipboard_copy_text("Forest debug: Pose (" + x + ", " + y + ", " + z + "), tile " + ix + ", " + iz + ", square " + sq + " (" + sqx + ", " + sqz + "), angle " + angle + ", r" + r + ", trees " + trees + ".");
			//If we're too far from the center of the square, we just return 0:
			if(absolute(x-(ix+(q*sqx)+q/2.0))>r or absolute(z-(iz+(q*sqz)+q/2.0))>r) return 0;
			
			if(sq==5) {
				// Odd treecounts always fill the center, and evens do not:
				if(trees%2==0) return 0;
				else return 2;
			}//Center.
			else if(trees<2) return 0; // 0 and 1 have no other trees.
			else if(sq%2==1) {
				// 6 and 7 always fill the corners, but the others can be rotated:
				if(trees>5) return 2;
				else if(trees>3 and angle%2==0) return 2;
				else if(angle%2==1) {
					if(angle==1 and (sq==3 or sq==7)) return 2;
					else if(angle==3 and (sq==1 or sq==9)) return 2;
				}//2 and 3 are more tedious.
				return 0;
			}//Corners.
			else {
				//The middles of the sides are basically the corners, rotated by 1... with a couple exceptions:
				if(trees>3 and angle%2==1) return 2;
				else if(angle%2==0) {
					if(angle==0 and (sq==4 or sq==6)) return 2;
					else if(angle==2 and (sq==2 or sq==8)) return 2;
				}//2 and 3 are more tedious.
				return 0;
			}//Middles.
		}// Forests have trees.
		else if(this.map[ix][iz] == "Stone" or this.map[ix][iz] == "Wood") {
			// Instead of being creative, let's just go with a cross shape. Axis-aligned on bottom, X-shaped on top, with a path around the outside to shoot from.
			float ox = x%10.0, oz = z%10.0;
			if(absolute(ox-5)<=1.0 and absolute(z-5)<=1.0) {
				return 0; // The center is for climbing.
			}//Ladder / stairs.
			else if (y>=3) {
				if(ox<=2.0 or oz<=2.0 or x>=8.0 or z>=8.0) return 3;
				ox = absolute(ox-5);
				oz = absolute(z-5);
				if (absolute(ox-oz)<=1.25) return 3;
				return 9001;
			}// Top floor.
			if(absolute(ox-5)>1.25 and absolute(oz-5)>1.25) return 9001;
			return 0;
		}//Castles.
		
		return 0;
	}//get height
	
	void key_pressed(int k) {
		// Todo: input_box breaks network connections, so we probably want a custom chat box. If it's open, do that and return early.
		
		int mods=0;
		if(key_down(KEY_LMENU) or key_down(KEY_RMENU)) mods|=alt;
		if(key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)) mods|=shift;
		if(key_down(KEY_LCONTROL) or key_down(KEY_RCONTROL)) {
			mods+=ctrl;
			voice.stop();
		}
		if(k==KEY_F4 and (mods&alt)==alt) {
			//save_settings();
			// Disconnect from online.
			exit();
		}
		else if(k==KEY_BACK and ((mods&alt)==alt)) {
			string rep="Sound Pool Diagnostics:\nHighest Slot: " + pool.highest_slot + "\n";
			for(uint i=0; i<this.pool.highest_slot; i++) {
			sound_pool_item@ snd = this.pool.items[i];
				rep += "" + i + ": ";
				if(snd is null) {
					rep += "null\n";
					continue;
				}//Null sound.
				rep += snd.filename + ", " + snd.x + ", " + snd.y + ", " + snd.z + ". Handle is " + ((snd.handle is null) ? "null" : ((snd.handle.active) ? "active" : "closed")) + "\n";
			}//Sound loop.
			clipboard_copy_text(rep);
			alert("Sound Pool", rep);
			pool.destroy_all();
		}//Report on the sound_pool.
		else if(k==KEY_GRAVE and mods==ctrl) {
			string rep = "";
			for(uint i=0; i<this.actors.length(); i++) {
				Actor@ me = this.actors[i];
				if(me is null) continue;
				rep += me.getRankString() + " " + me.name + ", " + me.g + ", at (" + me.pose.x + ", " + me.pose.y + ", " + me.pose.z + "); v = (" + me.v.x + ", " + me.v.y + ", " + me.v.z + "). State = " + number_to_hex_string(me.state) + ", counter " + me.counter + ". Onground: " + me.onGround() + ", gloc height " + this.get_height(me.pose.x, me.pose.y, me.pose.z) + ", is_clear: " + this.is_clear(me.pose+(0.02*me.v)) + ".\r\n";
			}//actors loop
			clipboard_copy_text(rep);
			alert("Debug", rep);
			wait(250);
			if(key_down(KEY_M)) {
				Actor@ me = this.actors[this.ychar];
				me.pose.x = string_to_number(input_box("X", "X?", me.pose.x));
				me.pose.y = string_to_number(input_box("y", "y?", me.pose.y));
				me.pose.z = string_to_number(input_box("z", "z?", me.pose.z));
			}
		}//Debug.
		
		int c = this.key.press(k, mods);
		Actor@ me=null;
		if(this.ychar>=0 and this.ychar<this.actors.length()) @me=this.actors[this.ychar];
		if(me is null) {
			// In menu, probably.
		}//No char.
		else if(me.hp<=0.0) {
			// You're dead. What do?
		}//Dead char.
		else {
			// Send the input ove the network, if online.
			this.handle_input(c, this.ychar, this.key);
		}// Alive!

	}// key pressed.
	void key_released(int k) {
		int mods=0;
		if(key_down(KEY_LMENU) or key_down(KEY_RMENU)) mods|=alt;
		if(key_down(KEY_LSHIFT) or key_down(KEY_RSHIFT)) mods|=shift;
		if(key_down(KEY_LCONTROL) or key_down(KEY_RCONTROL)) {
			mods+=ctrl;
		}
		int c = this.key.release(k, mods);
		Actor@ me=null;
		if(this.actors.length()>0 and this.ychar>=0 and this.ychar<this.actors.length()) @me = this.actors[this.ychar];
		if(me is null) {
			// No player; does releasing matter?
		}// No player.
		else if(c==A) {
			if(me.state==charging) me.setState(attacking);
		}// Releasing attack.
		else if(c==C) {
			if(me.state==DUCKING) me.setState(0);
		}// Releasing crouch.

	}// key released.
	
	void tick(double dt) {
		dt *= 0.001; // Put it in seconds.
		
		// In case we return early for some reason, let's update bgm and network first:
		this.system_update();
		
		if(this.map.length()>0 and this.actors.length()>0) {
			
			vector camera = this.get_camera();
			this.pool.update_listener_3d(camera.x, camera.y, camera.z);
			
			int zomcount=0, food=0;
			int humans = 0;
			Actor@[] leaders;
			
			// update actors:
			for(uint i=0; i<this.actors.length(); i++) {
				if(this.actors[i] is null) {
					this.actors.remove_at(i);
					i--;
					continue;
				}//Remove invalid actors.
				this.update_actor(i, dt, camera);
				if(this.actors[i].rank==ZOMBIE) zomcount+=1;
				else if(@(this.actors[i].leader)!=null) {
					Actor@ leader = this.actors[i].getLeader();
					if(@leader!=null and leaders.find(leader)<0) leaders.insert_last(leader);
				}
				if(this.actors[i].rank!=ZOMBIE) {
					if(this.actors[i].rank != MOUNT and this.actors[i].rank != INU ) humans +=1;
					food += this.actors[i].food+this.actors[i].meat+this.actors[i].sushi+this.actors[i].vegies+this.actors[i].fruit+this.actors[i].sake;
					if(((this.actors[i].state)&(walking|JUMPING|DUCKING))==this.actors[i].state and this.game_clock.frame%50==i and random(1, 10)>6 and (this.actors[i].voiceslot<0 or !this.pool.sound_is_playing(this.actors[i].voiceslot)) and this.actors[i].hp>0) this.actors[i].setState(talking);
				}
			}//actors.
			
			// Update the map.
			if(this.game_clock.frame%3000==223) {
				string[] weathers = {"rain", "storm", "wind", "snow", "", "crickets2"};
				string w = weathers[random(0, weathers.length()-1)];
				if(w!=this.weather) {
					if(this.weatheramb is null) {

						sound temp;
						@(this.weatheramb)=temp;
					}//Init weatheramb.
					else this.weatheramb.close();
					if(w=="wind") this.weatheramb.stream(sj + "windy.wav");
					else if(file_exists(sj + w + ".wav")) this.weatheramb.stream(sj + w + ".wav");
					else if(w=="snow") this.weatheramb.stream("../dle2/sfx/Blizard.ogg");
					// Todo: Let the player adjust the volume of weather sounds.
					if(this.weatheramb.active) this.weatheramb.play_looped();
					this.weather=w;
				}// Change weather.
			}// Change weather.
			else if(this.weather=="rain" or this.weather=="storm" and random(1, 10)>5) {
				if(this.floortiles.length()>0 and this.items.length()<random(0, 40) and string_contains("Grass Leaves2", this.get_terrain(10*this.floortiles[this.game_clock.frame%this.floortiles.length()]), 1)>=0 and zomcount<this.actors.length() and random(0, 100)>food/this.actors.length()) {
					vector f = this.floortiles[this.game_clock.frame%this.floortiles.length()];
					Item@ it=get_item("Vegies");
					if(this.map[f.x][f.z]!="" and this.map[f.x][f.z][0]=="L") @it = get_item("Fruit");
					it.pose = vector(f.x*10+random(0, 9), 0, random(0, 9)+(f.z*10));
					it.pose.y=this.get_height(it.pose.x, it.pose.y, it.pose.z);
					this.items.insert_last(it);
				}// Spawn fruits and vegetables.
			}// Raining.
			
			// update items:
			for(uint i=0; i<this.items.length(); i++) {
				Item@ it = this.items[i];
				// (Can items move?)
			
			//remove dead or null items:
				if(it is null or it.hp==0.0) {
					this.items.remove_at(i);
					i--; // If we're only updating sounds, is this necessary?
					continue;
				}//Dead item.
				else if((it.slot<0 or !this.pool.sound_is_playing(it.slot)) and absolute(it.pose.x-camera.x)<=max_loot_distance and absolute(it.pose.z-camera.z)<=max_loot_distance) {
					string toplay = Swamp + "Items/Corpse" + random(1, 5) + ".wav";
					// (Todo: other sounds?)
					if(it.category==9) toplay = Swamp + "Items/Key.wav"; // Food.
					else if(it.category==8 or (((it.flags)&PRIZED)==PRIZED)) toplay = Swamp + "Items/Quest.wav";
					if(it.slot>=0) this.pool.destroy_sound(it.slot);
					it.slot = this.playsound(toplay, it.pose, true);
					// If items are in motion, should this be when they stop moving?
					it.v.x=0;
					it.v.z=0;
					// If items are in the air, should they keep falling? It seems like they should keep falling.
				}//Play sound.
				else if(it.v.x!=0 or it.v.y!=0 or it.v.z!=0) {
					vector d = it.v*dt;
					// Say you're disarmed while atop a castle wall, or in a tree. Items should be able to fall, shouldn't they?
					if(this.is_clear(it.pose+d)) {
						it.pose = it.pose+d;
						if(it.slot>=0 and this.pool.sound_is_playing(it.slot)) this.pool.update_sound_3d(it.slot, it.pose.x, it.pose.y, it.pose.z);
					}//move
					else {
						it.v*=0;
					}//Bump. Should it play a bump sound?
				}// Moving items.
			}//Items loop.
			
			// Keep the number of items from falling too low:
			if(this.game_clock.frame%50==0 and this.items.length()<this.maxloot) this.populate_loot();
			
			//Update mounts:
			for(uint i=0; i<this.mounts.length(); i++) {
				Actor@ me = this.mounts[i];
				if(me is null) continue;
				if(me.counter!=0.0 or me.state!=0 or me.v.x!=0 or me.v.y!=0 or me.v.z!=0) me.step(dt);
				if(me.hp<=0.0) {

				}// What to do with dead mounts?
				else if(me.mount is null and me.name=="boat" and this.game_clock.frame%125==(2*i)%125 and (me.voiceslot<0 or !this.pool.sound_is_playing(me.voiceslot))) me.voiceplay(CA + "Open/Ship.wav");
			}// Mounts.
			
			this.tickRadar(dt);
			
			// Check for victory or round over conditions.
			if(humans==0) {
				//reset game.
				this.voice.speak_interrupt("Zombies win!");
				this.pool.destroy_all();
				this.pool.play_stationary(Swamp + "Player/Hardcore.wav", false);
				wait(1000);
				this.reset_game();
			}// Zombies win.
			
		}//Advance the game.
		
	}//tick.
	
	void update_actor(int i, double dt, vector l) {
		if(i<0 or i>=this.actors.length() or this.actors[i] is null) return;
		// (Todo: should actors far from the camera be updated less frequently?)
		
		Actor@ me = this.actors[i];
		bool npc = (i!=this.ychar);
		if(npc) {
			// Check for online players.
			for(uint j=0; j<this.players.length(); j++) {
				if(this.players[j] is null or this.players[j].ychar!=i) continue;
				// Other things we need to check, such as if the player is valid.
				npc=false;
				if(!npc) break;
			}
		}
		
		//We'll probably need this later:
		int f = this.game_clock.frame%this.actors.length();
		
		me.step(dt);
		
		if(me.hp<=0.0) {
			if(me.voiceslot<0 or !this.pool.sound_is_playing(me.voiceslot)) {
				if(me.slot<0) me.setSlot(this.play_fall(me));
				else if(!this.pool.sound_is_playing(me.slot)) {
					me.setSlot(-1);
					// Respawn conditions can get complicated.
					if(me.rank==ZOMBIE or me.rank==MOUNT) {
						me.pose=this.findclearspot();
						me.hp=me.maxHP;
						me.stamina=me.maxStamina;
						me.food=150;
						me.mission=WANDER; //???
						me.counter=0.0;
						me.state=0;
						// Should we play a sound where zombies respawn?
						if(me.rank==ZOMBIE) {
							me.setSlot(this.play_jump(me, true));
							me.voiceplay(Swamp + "Zombies/" + me.name + "/Growl" + random(1, 7) + ".wav");
						}
					}// Zombies respawn the simplest.
					else if(me.killer is null or me.killer.rank==ZOMBIE) {
						if(me.plague>=random(10, 50) or (@(me.killer)!=null and me.killer.rank==ZOMBIE)) {
							if(@(me.killer)!=null and me.killer.rank==ZOMBIE) me.killer.food+=100; // Zombies eat their victims.
							if(me.rank==INU) {
								if(me.name=="Fox" or me.name=="Kitsune") me.name="Kitsune";
								else if(me.name=="Wolf" or me.name=="Ookami") me.name="Ookami";
								else me.name="Canine";
							}// Zombie dogs.
							else if(me.rank==KODOMO) me.name="Lamprey";
							else if(me.g=="F") me.name="Stalker";
							else me.name="Normal";
							me.rank=ZOMBIE;
							me.kills=random(0, me.kills/2);
							me.voiceplay(Swamp + "Zombies/" + me.name + "/Growl" + random(1, 7) + ".wav");
							if(@(me.weapon)!=null and (((me.weapon.flags)&ZOMBABLE)==0)) {
								me.weapon.pose=me.pose;
								this.items.insert_last(me.weapon);
								for(uint j=0; j<me.inv.length(); j++) {
									if(((me.inv[j].flags)&ZOMBABLE)==ZOMBABLE) {
										@(me.weapon)=me.inv[j];
										me.inv.resize(0);
									}
								}//Look for zombable weapons.
							}// Drop your weapon, maybe replace it with others.
							me.food += 10*me.meat;
							me.food+=10*me.sushi;
							// Actually, do this:
							@(this.actors[i])=this.get_char(ZOMBIE, me.name);
							@(this.actors[i].weapon)=me.weapon;
							if(this.actors[i].armor is null) @(this.actors[i].armor)=me.armor;
							this.actors[i].pose=me.pose;
							// Anything else we want to copy over?
							if(this.actors[i].speed<4) this.actors[i].speed+=random(3, 5);
						}//Respawn as a zombie.
						else this.standardRespawn(me);
					}// No killer, standard respawn.
					else if(me.rank==INU) {
						// Inu of the same species can recruit victims of the same species to their pack, with the exception of foxes.
						if(me.killer is null or me.name=="Fox" or me.name=="Kitsune" or ((me.killer.rank!=ZOMBIE and me.killer.rank!=INU) or me.killer.name=="Fox" or me.killer.name=="Kitsune")) this.standardRespawn(me);
						else {
							this.join(me, me.killer);
							this.standardRespawn(me);
						}//Join a pack.
					}//Inu.
					else if(me.killer.rank==KODOMO) {
						if(me.rank==KODOMO or me.rank==MOUNT or me.rank==INU) this.join(me, me.killer);
						else {
							@(me.leader)=me.killer.leader;
							me.rank=KODOMO;
							// Do we take away inventory?
							// Do we reset stats?
							// Does our killer take our rank if we're not ashigaru?
						}// Adults killed by a child respawn as a child.
						this.standardRespawn(me);
					}// Killed by a child.
					else {
						if((me.killer.rank==ASHIGARU or me.killer.rank==SHINOBI) and (me.rank==SAMURAI or me.rank==DAIMYOU) and (me.killer.leader is null or me.killer.leader.rank==SHINOBI)) {
							if(me.rank==DAIMYOU or random(0, 10)<me.killer.kills) {
								me.killer.rank=me.rank;
								me.rank=ASHIGARU;
								this.join(me, me.killer);
							}//Swap ranks.
						}
						else this.join(me, me.killer);
						// Under what conditions do we drop items?
						this.standardRespawn(me);
					}// Generic kill.
					
				}// Done falling.
			}// Play fall sound.
		}// Dead.
		else if(npc) {
			// When can NPCs interact with loot?
			if(me.rank==ZOMBIE) {
				if((me.voiceslot<0 or !pool.sound_is_playing(me.voiceslot)) and f==i and random(1, 10)==9) me.voiceplay(Swamp + "Zombies/" + me.name + "/Growl" + random(1, 7) + ".wav");
				
				// Are they wandering or hunting?
				if(me.mission==HALT or me.mission==WANDER or me.mission==DEFEND or me.mission==RETURN) {
					if(@(me.target)!=null and me.target.rank!=ZOMBIE and me.target.hp>0.0) me.mission=HUNT;
					//else if(me.food<random(0, 60)) me.mission=FEED;
					if(me.state==0 or me.state==stunned) {
						// Scan for nearby non-zombie actors
						for(uint j=0; j<this.actors.length(); j++) {
							if(this.actors[j].rank==ZOMBIE or this.actors[j].hp<=0 or absolute(this.actors[j].pose.x-me.pose.x)>30 or absolute(this.actors[j].pose.z-me.pose.z)>30) continue;
							if(me.target is null or power(me.pose.x-me.target.pose.x, 2)+power(me.pose.z-me.target.pose.z, 2)>power(me.pose.x-this.actors[j].pose.x, 2)+power(me.pose.z-this.actors[j].pose.z, 2)) @(me.target)=this.actors[j];
						}
						
						// Improved wandering: zombies pick a random direction and walk
						// Using truly random cardinal directions to avoid southward bias
						if(random(0, 10)>4) {
							int dir_choice = random(0, 7);
							double theta = pi4*dir_choice;
							me.face = vector(cosine(theta), 0, sine(theta));
						}// Zombies randomly change direction more often.
						me.setState(walking);
						
						// If no target found and we've been standing still, pathfind to a random location
						if(me.target is null and random(0, 20) == 0 and me.path.length() == 0) {
							vector dest = this.floortiles[random(0, this.floortiles.length()-1)] * 10;
							this.pathfind(i, dest);
						}
						// Should we allow zombies to randomly switch to hunting mode?
					}
				}// Wandering zombies.
				else if(me.state!=attacking and me.state!=stunned and me.state!=recovering) {
					if(me.target is null or (f%100==i and random(1, 10)>7)) {
						// Distance to best target:
						double d=1000000;
						if(@(me.target)!=null) d = len2(me.target.pose-me.pose);
						for(uint j=0; j<this.actors.length(); j++) {
							Actor@ them = this.actors[j];
							if(them is null or them.rank==ZOMBIE or them.hp<=0.0) continue;
							//Within 20m or so, the closest takes priority.
							double d2=len2(them.pose-me.pose);
							// Otherwise, the candidate with the lower sum of hp and plague wins.
							if((d2<=500 and d2<d) or (@(me.target)!=null and them.hp+them.plague <me.target.hp+me.target.plague)) {
								d=d2;
								@(me.target)=them;
							}// Select.
						}
						if(me.target is null) me.mission=WANDER;
						else me.dest=me.target.pose;
						// We should update the path, but if there's any excuse we can use to avoid doing that, we should take it.
						this.pathfind(i, me.dest);
					}//Target select.
					
					// We shouldn't let navigating get in the way of attacking and pursuing.
					if(me.path.length()>0) {
						this.navigate(me);
						// Keep dest updated:
						if(@(me.target)!=null) me.dest=me.target.pose;
					}// Follow the path.
					else if(len2(me.dest-me.pose)<=100) {
						// Call navigate, since that already should deal with complicated environments.
						this.navigate(me);
					}// In range, path clear.
					else if(me.target is null) {
						double d = 1000000;
						for(uint j=0; j<this.items.length(); j++) {
							if(this.items[j].category!=9 or (this.items[j].name!="Meat" and this.items[j].name!="Sushi")) continue;
							double d2 = len2(this.items[j].pose-me.pose);
							if(d2<d) {
								d=d2;
								me.dest=this.items[j].pose;
							}
						}//Items loop.
						if(d<1000000) this.pathfind(i, me.dest);
					}// No target, hunt food.
					else this.pathfind(i, me.target.pose);
					// If we're in range, go in for the kill, or whatever.
					// Keep in mind, castles and forests are awful, but navigate should be able to handle those.
					if(@(me.target)!=null) {
						double d = len2(me.target.pose-me.pose);
						if(d<=100) {
							if( d>power(me.height(), 2)) {
								// Should we clear path, if it isn't already clear?
								// The only catch is if we're outside a castle, and our target is inside... but, I mean, Zombies aren't known for being good at navigation.
								if(me.path.length()>0) me.path.resize(0);
								me.dest=me.target.pose;
								this.navigate(me);
								}// Get closer.
							else me.setState(attacking); // Huh. Something seems... off.
							if(me.target.hp<=0.0) @(me.target)=null;
						}//In range.
					}//Fighting!
				}// Hunting zombies.
			}// Zombies.
			else if(me.rank==INU) {
				// Umm. Tricky.
            handle_dog_logic(me, i, f);
			}//INU.
			else if(me.rank==MOUNT) {
				if(me.name=="boat") return; // Just... why?
				// A horse without a rider or mission probably wants to go find grass or leaves to eat.
            handle_mount_logic(me, i, f);
			}//Mounts.
			else {
				handle_human_npc(me, i, f, st.get_camera());
				bool underattack=false;
				Actor@ attacker=null;
				// Survival takes priority over mission, so determine if we're fighting first.
				// So we don't have to go through this entire loop again, organize characters that we find into enemies and allies.
				Actor@[] allies;
				Actor@[] enemies;
				bool playCommand=false;
				if(f==i) for(uint i=0; i<this.actors.length(); i++) {
					if(@(this.actors[i])==@me) continue;
				// Orders are not being directed correctly, so let's do this:
					Actor@ you=this.actors[i];
						if( // 1, general
							( // 2, in the same unit
								((me.leader is you.leader or me.findLeader() is you.findLeader()) ) ||
								(you.findLeader(me) is me)
							)&&((me.rank==DAIMYOU)||(me.rank==you.rank)) &&(me.mission!=you.mission)
						) {
							this.actors[i].mission=me.mission;
							playCommand=true; 
						}// This is when orders should trickle down.
						
						if(@(you.leader)!=null and you.findLeader() is me.findLeader()) {
							allies.insert_last(this.actors[i]);
							// 7:15 AM 6/29/2012: Monks act as medics.
							if(me.is_monk() and absolute(me.pose.x-you.pose.x)<=4 and absolute(me.pose.z-you.pose.z)<=4) {
								if(this.actors[i].hp<this.actors[i].maxHP) {
									this.actors[i].hp+=random(0, 15);
									this.actors[i].sounds.insert_last(Swamp + "Weapons/Fieldkit/Apply.wav");
									if(i==this.ychar) this.voice.speak_interrupt(me.name + " treats " + this.actors[i].getRankString() + " " + this.actors[i].name + "\'s wounds.");
								}//Heal.
								else if((this.actors[i].food<random(10, 45))||(this.actors[i].food<me.food)) {
									if(me.sake<you.sake) {you.sake+=1; me.sake-=1;}
									if(me.meat>you.meat) {you.meat+=1; me.meat-=1;}
									if(me.sushi>you.sushi) {you.sushi+=1; me.sushi-=1;}
									if(me.vegies>you.vegies) {you.vegies+=1; me.vegies-=1;}
									if(me.fruit>you.fruit) {you.fruit+=1; me.fruit-=1;}
									you.food+=random(0, 10);
								}// Monks might share food if they have enough.
							}// Monks heal / feed people.
							/*
							else if((this.actors[i].weapon<this.actors[i].weapons.length())&&(this.actors[i].weapons[this.actors[i].weapon]=="ihatsu")&&(absolute(this.actors[i].x-me.x)<=2)&&(absolute(this.actors[i].y-me.y)<=2)) {
 if((this.actors[i].food<random(10, 45))||(this.actors[i].food<me.food)) {
 int[] foods;
 for(uint j=0; j<me.inv.length(); j++) {
 if((me.inv[j]=="yasai")||(me.inv[j]=="kudamono")||(me.inv[j]=="sushi")) foods.insert_last(j);
 }// Food loop.
 if(foods.length()>1) {
 int f=random(0, foods.length()-1);
 this.actors[i].getItem(me.inv[f]); me.inv.remove_at(f);
 if(@(this.actors[i])==@(myArmy[ychar])) voice.speak_interrupt("" + me.name + " gave food to " + this.actors[i].rankString() + " " + this.actors[i].name + ". ");
 }// Food can be given.
 }// Monks might share food if they have enough.

 }// Give food to monks, maybe.
							*/
							if((me.mission!=WANDER)&&(this.actors[i].mission!=me.mission)&&(absolute(me.pose.x-this.actors[i].pose.x)<=order_range)&&(absolute(me.pose.z-this.actors[i].pose.z)<=order_range)&&(me.leader is this.actors[i].leader)&&(me.rank==this.actors[i].rank)) {
								// this.actors[i].mission=me.mission;
								// playCommand=true; 
							}// Give orders.
							continue;
						}
						enemies.insert_last(this.actors[i]);
						if((this.actors[i].state==attacking)||(this.actors[i].state==charging)) {
							Actor@ enemy;
							@enemy=this.actors[i];
							if(enemy.weapon is null) underattack = (absolute(me.pose.x-enemy.pose.x)<=enemy.height() and absolute(me.pose.z-enemy.pose.z)<enemy.height());
							else if(((enemy.weapon.flags)&WEAPON)==WEAPON) {
								// Same hitcheck as in attacking:
								double r = (enemy.height()/2.0)+enemy.weapon.range;
								double harc = enemy.weapon.arc/2.0;
								if(absolute(enemy.pose.x-me.pose.x)>r or absolute(enemy.pose.z-me.pose.z)>r) continue;
								vector arc(cosine(harc), 0, sine(harc)); // These should be between 0 and 1, unless weapon.arc>pi. And in that case, we're going to do something rather different.
								double r2 = r*r;
								vector d = me.pose-enemy.pose;
								d.y=0;
								if(d.x==0 and d.z==0) d=vector(1, 0, 0);
								else d = dif_angles(d/d.length(), enemy.face);
								if(harc>=pi or (d.x>=arc.x and d.z<=arc.z and d.z>=-arc.z)) {
									underattack=true;
								}
								else continue;
								
							}// Arc check.
						}// See if this attack is anywhere near capable of hitting.
						else {
							double range = 10;
							if(me.mission==ATTACK) range=25;
							if((absolute(me.home.x-this.actors[i].pose.x)<=range)&&(absolute(me.home.z-this.actors[i].pose.z)<=range)&&(absolute(me.pose.x-this.actors[i].pose.x)<=range)&&(absolute(me.pose.z-this.actors[i].pose.z)<=range)) underattack=true;
						}// Check to see if there is intrusion on your base.
						
						// While we're here, check for orders:
						if(me.mission==ATTACK) {
							// 5:18 PM 6/28/2012. Don't attack people with monk-bowls.
							if(((this.actors[i].rank==ASHIGARU)||(this.actors[i].rank==KODOMO)||(this.actors[i].rank==SHINOBI))&&(@(this.actors[i].weapon)!=null)&&(this.actors[i].weapon.name=="ihatsu")) continue;
							if(@(me.target)==null) @(me.target)=this.actors[i];
							else if((absolute(me.pose.x-this.actors[i].pose.x)<=absolute(me.pose.x-me.target.pose.x))&&(absolute(me.pose.z-this.actors[i].pose.z)<=absolute(me.pose.z-me.target.pose.z))) {
								// If this one is closer, only target them if they are of a more valuable class.
								if(me.target.rank==this.actors[i].rank) @(me.target)=this.actors[i];
								else if(((me.target.rank==ASHIGARU)||(me.target.rank==SHINOBI)||(me.target.rank==KODOMO)||(me.target.rank==INU))&&((this.actors[i].rank!=ASHIGARU)&&(this.actors[i].rank!=SHINOBI)&&(this.actors[i].rank!=KODOMO)&&(this.actors[i].rank!=INU))) @(me.target)=this.actors[i];
								else if(this.actors[i].rank==DAIMYOU) @(me.target)=this.actors[i];
								// Can't help but feel that this is wrong.
							}// Closer.
						}// Attack.
						else if(me.mission==RECRUIT) {
							if(this.actors[i].rank!=DAIMYOU and this.actors[i].leader is null and (this.countFollowers(this.actors[i])==0 or this.actors[i].rank==KODOMO or this.actors[i].rank==INU)) {
								if(@(me.target)==null) @(me.target)=this.actors[i];
								else if((absolute(me.pose.x-this.actors[i].pose.x)<=absolute(me.pose.x-me.target.pose.x))&&(absolute(me.pose.z-this.actors[i].pose.z)<=absolute(me.pose.z-me.target.pose.z))) {
									@(me.target)=this.actors[i];
								}
							}// AI can only recruit independent targets.
						}// Recruit.
						if(underattack) {
							@attacker=this.actors[i];
							i=this.actors.length();
						}
					}// Check for attackers.
				if(playCommand) {
					string toplay="_" + me.g;
					if(me.rank==INU) {

					}// Inu barking orders.
					else if(me.rank==MOUNT) {

					}// Horses and Dragons?
					else if(me.rank==KODOMO) toplay="_K";
					if(toplay!="") me.sounds.insert_last(voices + missionString(me.mission) + toplay + ".wav");
				}// Play Commands.
				// Whew.
				
				
				if(f!=i) {
					// Only run AI for 1 npc per frame. Maybe. Probably.
				}
				else if((@(me.target)!=null)&&(@(me.target.gloc)==@(me.gloc))&&(me.target.hp>0.0)) {
					me.dest = me.target.pose;
					if((absolute(me.pose.x-me.target.pose.x)<=order_range)&&(absolute(me.pose.z-me.target.pose.z)<=order_range)) {
						if(me.mission==ATTACK) {
							underattack=true;
							if(@attacker==null) @attacker=me.target;
						}// Attacking.
						else if(me.mission==RECRUIT) {
							// Try to recruit independent people.
							if((absolute(me.pose.x-me.target.pose.x)<=4)&&(absolute(me.pose.z-me.target.pose.z)<=4)&&(@(me.target.leader)==null)) {
								// Find an item that can be offered.
								if((me.target.rank==RONIN)&&(random(0, 8)==4)) {
									vector d = me.pose-me.target.pose;
									d.y=0;
									if(d.x==0 and d.z==0) {;} // No change.
									else me.target.face = d/d.length();
									me.target.charged=0.1*random(1, 10);
									me.target.setState(attacking);
								}// The ronan would rather fight than talk.
								else if(random(0, 10)>4) {
									bool alreadyHas=false;
									int togive=-1;
									for(uint it=0; it<me.inv.length(); it++) {
										//for(uint i2=0; i2<me.target.weapons.length(); i2++) {if(me.target.weapons[i2].name==me.inv[it].name) alreadyHas=true;}
										for(uint i2=0; i2<me.target.inv.length(); i2++) {if(me.target.inv[i2].name==me.inv[it].name) alreadyHas=true;}
										if(!alreadyHas) {togive=it; it=me.inv.length();}
									}// Check and see if the target already has this item or not.
									if((!alreadyHas)&&(togive>=0)) {
										this.getItem(me.target, me.inv[togive]);
										me.inv.remove_at(togive);
										@(me.target.leader)=me.leader;
										// (sound)
										this.playsound(Swamp + "Player/Join.wav", me.target.pose, false, false);
									}// Might work.
								}// Otherwise, everyone else rejects.
							}
						}// Recruiting.
					}// In range to do order-specific things.
				}
				else @(me.target)=null;
				
				if(underattack) {
					// alert("Under attack!", "Because AI needs more feedback.");
					// Note that escaping a fight and following orders might be one in the same, so sometimes orders are worth paying attention to even here.
					
					// First, let's see if we notice the enemy. If our back is to the enemy, there's a good chance we won't notice.
					bool noticed=false;
					if(me.face.x>0 and attacker.pose.x>me.pose.x) noticed=true; // DANGER!
					else if(me.face.z>0 and attacker.pose.z>me.pose.z) noticed=true;
					else if(me.face.x<0 and attacker.pose.x<me.pose.x) noticed=true;
					else if(me.face.z<0 and me.pose.z>attacker.pose.z) noticed=true;
					else {
						if(attacker.rank==SHINOBI) noticed=(random(0, 10)>7);
						else noticed=(random(0, 10)>=4);
						if(noticed) {
							vector d = attacker.pose-me.pose;
							d.y=0;
							if(d.x!=0 or d.z!=0) me.face = d/d.length();
						}// Turn.
					}// In this situation, we need to turn if we notice.
					
					// Civilians and Shinobi will flee fights if they must.
					if(!noticed) underattack=false;
					else {
						//If you're a civilian, your default course of action should be running away if possible.
						// Running away is possible only if the attacker is not going to hit in the next 0.3 seconds.
						bool canRun=((attacker.state!=attacking)||(attacker.counter>0.3));
						if((canRun)&&(me.state==attacking)) canRun=false;
						bool canBlock=((attacker.weapon is null)||(attacker.weapon.category!=2 and attacker.weapon.category!=6));
						if(canBlock) canBlock= (@(me.weapon)!=null and (me.weapon.category==0 or (me.weapon.category>2 and me.weapon.category<8)));
						
						if((me.state==0)||(me.state==walking)) {
							double distance=absolute(me.pose.x-attacker.pose.x);
							double yd=absolute(me.pose.z-attacker.pose.z);
							if(yd>distance) distance=yd;
							// string[] options;
							// Are you blocking, or counter-attacking?
							uint[] options;
							for(uint w=0; w<me.inv.length(); w++) {
								// Todo: Shields?
								if(me.inv[w] is null or (((me.inv[w].flags)&WEAPON)==0) or distance>me.inv[w].range) continue;
								if(me.inv[w].category==2 or me.inv[w].category==6) {
									if(me.inv[w].category==6 and (string_contains(me.inv[w].name, "art", 1)<0 or me.darts<=0)) continue;
									else if(attacker.counter<0.2) continue;
									options.insert_last(w);
								}// Projectiles if you can shoot fast enough.
								else if((me.inv[w].category==3 or (((me.inv[w].flags)&PIERCE)==PIERCE)) and (@(attacker.armor)!=null)) {
									// Armor and shield-breakers get extra tickets.
									options.insert_last(w);
									options.insert_last(w);
								}
								options.insert_last(w);
							}// Loop for weapons.
							if(options.length()<1) {options.insert_last(me.inv.find(me.weapon)); options.insert_last(0);}
							int w=me.inv.find(me.weapon);
							if(w>=0 and !canBlock) {
								if(me.inv.length()>0) @(me.weapon) = me.inv[options[random(0, options.length()-1)]];
								canBlock=((attacker.weapon is null)||(attacker.weapon.category!=2 and attacker.weapon.category!=6));
								if(canBlock) canBlock = (@(me.weapon)!=null and me.weapon.category!=2 and me.weapon.category<6);
							}// Can't block with your current weapon.
							else {
								if(options.length()>0 and random(0, 10)<=2 and me.inv.length()>0) {
									int o = options[random(0, options.length()-1)];
									if(o>=0 and o<me.inv.length()) @(me.weapon) = me.inv[o];
								}
								canBlock = (@(me.weapon)!=null and me.weapon.category!=2 and me.weapon.category<6);
							}
							if((me.inv.find(me.weapon)!=w)&&(@(me.weapon)!=null)) {
								me.sounds.insert_last(me.weapon.drawsound);
							}// Sound for switching weapons.
						}// Weapon selection.
						
						if((canRun)&&(me.rank==ASHIGARU or me.rank==KODOMO or me.rank==INU)) {
							// They should try to find the best path out of there. The opposite direction that they're currently facing isn't necessarily it.
							me.setState(walking);
							// Rotate v by 90dg?
							me.v = vector(me.v.z, me.v.y, me.v.x);
							if(random(1, 10)>5) me.v.z*=-1;
							if(random(1, 5)>5) me.v.x*=-1;
						}// Civilians try to run away.
						else if(me.state!=attacking) {
							if(canBlock) {
								// You might want to keep charging the attack, or you might want to go ahead and release.
								if(me.state==charging) {
									if(0.1*random(0, 10)<me.charged) me.setState(attacking);
								}
								else {
									me.setState(charging);
									if(random(1, 4)<=2) {
										double cheat=0.1*random(1, 10);
										me.charged=cheat;
										me.setState(attacking);
									}
								}// Yeah.
							}// judge whether or not it's safe to try to block.
							else {
								if((attacker.state==charging)||(attacker.counter>0.3)) {
									me.setState(walking);
									me.v = vector(me.v.z, me.v.y, me.v.x);
									if(random(1, 10)>5) me.v.z*=-1;
									if(random(1, 10)>5) me.v.x*=-1;
									int pitch=100;
									if(me.v.z>0)  pitch=120+pool.behind_pitch_decrease;
									else if(me.v.z<0) pitch=80;
									this.playsound(sj + "select.wav", me.pose, false, false); // pitch?
								}// Dodging is worth it.
								else if(me.state==charging) {
									if(0.1*random(1, 10)<=me.charged) me.setState(attacking); // Gah, difficulty needs to matter. -_-
								}// Already charging.
								else {
									me.setState(charging);
									if(random(1, 4)<=2) {double cheat=0.1*random(1, 10); me.charged=cheat; me.setState(attacking);}
								}// Not ready.
							} //try to dodge.
						}// Can we block?
					}// Fight!
				}// Fighting AI.
				
				if(me.food<=30.0) {
					bool eaten=false;
					string[] foods = {"Meat", "Sushi", "Vegies", "Fruit", "Sake"};
					int[] vals = {me.meat, me.sushi, me.vegies, me.fruit, me.sake};
					int wf = random(0, 4);
					while(foods.length()>0 and vals[wf]<=0) {
						vals.remove_at(wf);
						foods.remove_at(wf);
						if(foods.length()==1) wf=0;
						else if(foods.length()>1) wf = random(0, foods.length()-1);
						else break;
					}
					if(wf>=0 and wf<vals.length() and vals[wf]>0) {
						int wi = me.inv_find(foods[wf]);
						if(wi<0) {
							// I don't feel like copy-editing the eat code from Actor::setState, so we're doing this instead:
							if(foods[wf]=="Sake") {
								me.sake--;
								me.food+=25;
								me.drunk+=25;
							}
							else {
								me.food=100.0;
							if(foods[wf]=="Sushi") me.sushi--;
								else if(foods[wf]=="Vegies") me.vegies--;
								else if(foods[wf]=="Fruit") me.fruit--;
								else me.meat--;
							}
						}// We have the ammo, but not the item.
						else {
							@(me.weapon)=me.inv[wi];
							me.setState(attacking);
						}
						eaten=true;
					}// Foun something to eat.
					if(!eaten) {
						if((me.mission==WANDER)||(me.rank==ASHIGARU)||(me.rank==SHINOBI)||(me.rank==KODOMO)||(me.rank==INU)) me.mission=FEED;
						else if((me.mission==HALT or me.mission==DEFEND) and me.inv_find("Net")>=0 and string_contains("Wade Water Swamp Swim2", this.get_terrain(me.pose), 1)>=0) {
							this.getItem(me, get_item("Sushi"));
						}// Looking for food without moving.
					}// What to do if you don't have any food.
				}// Eat.
				
				if(me.mission==HALT) {
					me.dest = me.pose;
				}
				else if(me.mission==WANDER) {
					
				// Ronan will wander around in search of something to do.
					if(me.rank==RONIN or (me.rank==SAMURAI and me.leader is null)) {
						if(me.dest==me.pose or (me.dest.x==0 and me.dest.z==0)) {
							// Pick a random floortile to target
							vector tf = this.floortiles[random(0, this.floortiles.length()-1)];
							this.pathfind(i, tf);
						}// Pick a random destination.
						// If a ronan happens across someone to fight, think about fighting them.
						
					}// Do whatever.
					// Civilians will tend to cluster together, look for food, or head for houses.
					else if((me.rank==ASHIGARU)||(me.rank==SHINOBI)||((me.rank==SAMURAI)&&(@(me.target)==null))||(me.rank==KODOMO and string_contains("rain storm snow", this.weather, 1)>=0)) {
						
						if(((me.dest==me.pose or (me.dest.x==0 and me.dest.z==0))||((absolute(me.pose.x-me.dest.x)<5)&&(absolute(me.pose.z-me.dest.z)<5)) )&&(random(0, 10)==7)) {
							// Be less likely to leave houses, especially if the weather is bad or if someone is nearby.
							bool domove=true;
							string ter = this.get_terrain(me.pose);
							if(string_contains("Stone Wood2 Stairs", ter, 1)>=0) {
								if((me.gloc.weather=="rain")||(me.gloc.weather=="storm")||(me.gloc.weather=="snow")) domove=false;
								
								if((me.stamina<random(50, 70))&&(me.food>random(40, 80))) domove=false;
								// else if((me.gloc.weather=="rain")||(me.gloc.weather=="storm")||(me.gloc.weather=="snow")) domove=false;
								else {
									//?
								}// Find someone to hang out with.
							}// Look for reasons not to move from a house. 
							if(domove) {
								// Look for possible destinations nearby, which include... basically anything that isn't a clear space or deep water.
								string weather=me.gloc.weather;
								int mx = floor(me.pose.x/10), my = floor(me.pose.z/10);
								// I pity anyone trying to port this section. In my defense, this is copy-edited from, like, 2011 or 2012.
								for(int mxx=-order_range; mxx<=order_range; mxx++) {for(int myy=-order_range; myy<=order_range; myy++) {
									if((mxx+mx<0)||(mxx+mx>=this.map.length())||(myy+my<0)||(myy+my>=this.map[mx].length())||(this.map[mxx+mx][myy+my]=="")) continue;
									string cn=me.gloc.map[mxx+mx][myy+my];
									bool gothere=false;
									// Also, check for people to talk to.
									// If the weather is bad, priority goes to finding houses, or castles if this character is aligned.
									if((string_contains(hards, cn, 1)>=0)&&((me.stamina<random(65, 85))||(random(0, 8)==2)||(weather=="rain")||(weather=="storm")||(weather=="snow"))) gothere=true;
									//else if((cn==garden)&&(random(0, 5)==2)) gothere=true;
									else if(string_contains(wets, cn, 1)>=0 and me.sushi<random(1, 10) and me.inv_find("Net")>=0) gothere=true;
									else if((cn=="Leaves" or cn=="Leaves2")&&(random(0, 10)==2)) gothere=true;
									if(gothere) {
										this.pathfind(i, vector(me.pose.x+(10*mxx), 0, me.pose.z+(10*myy)));
										me.dest=10*vector(mx+mxx+0.5, 0, my+myy+0.5);
										mxx=order_range+1; myy=order_range+1;
									}// Destination found.
								}}// Looking for a destination.
							}// Meep?
						}// Wandering around.
						// If in range of people to talk to, and there's nothing better to do, try to talk to them.
						// Be careful that you don't interrupt someone who is already speaking.
						if(((me.state==0)||(round(me.counter, 2)==0))&&(random(0, 20)==9)) {
							//talkTimer.restart(); talkTimer.resume();
							for(uint i=0; i<this.actors.length(); i++) {
								if(@(this.actors[i])==@me) continue;
								Actor@ them=this.actors[i];
								if((absolute(this.actors[i].pose.x-me.pose.x)<=order_range)&&(absolute(this.actors[i].pose.z-me.pose.z)<=order_range)) {
									if(((me.face.x>0 and them.pose.x>me.pose.x) or (me.face.x<0 and them.pose.x<me.pose.x) or (me.face.x==0 and absolute(them.pose.x-me.pose.x)<=absolute(them.pose.z-me.pose.z))) and 
										((me.face.z==0 and absolute(them.pose.z-me.pose.z)<=absolute(them.pose.x-me.pose.x)) or (me.face.z<0 and them.pose.z<me.pose.z) or (me.face.z>0 and them.pose.z>=me.pose.z))) {
										me.setState(talking);
										
										// Have the target react accordingly.
										i=this.actors.length();
									}
								}// In range.
							}// Do we talk to someone?

						}// Look for talkings.

					}// Civilians or Shinobi in disguise will wander around and maybe try to talk to people.
					else if(me.rank==KODOMO) {
						// Children will behave about the same as ashigaru in bad weather, but otherwise prefer to go to water or trees to wander around, or chase animals.
						if(me.path.length()==0 and (me.target is null or me.target.hp<=0.0 or me.target.leader is me)) {
							// Do we have a preference between water and trees?
							// We should, but I'm not sure what the deciding factor should be. Maybe just i%2?
							vector targ = this.floortiles[random(0, this.floortiles.length()-1)];
							int tries=0;
							while(tries<25 and this.map[targ.x][targ.z]=="" or (this.map[targ.x][targ.z][0]!="L" and string_contains(wets, this.map[targ.x][targ.z], 1)<0)) {
								targ=this.floortiles[random(0, this.floortiles.length()-1)];
								tries++;
							}
							this.pathfind(i, targ*10);
						}//Look for a destination.
						else {
							// If we're not in immediate danger, maybe randomly jump or something.
							// And voice.
							if(me.state==0 and random(0, 20)==5) me.keyPressed((random(1, 10)>5) ? JUMPING : (JUMPING|walking));
							if((me.voiceslot<0 or !(this.pool.sound_is_playing(me.voiceslot))) and random(1, 10)==9) me.voiceplay("../pgs21/voice/" + ((random(1, 10)>5) ? "Kid Giggle 3x-SoundBible.com-91159045.wav" : "Kid_Laugh-Mike_Koenig-1673908713.wav"));
						}// What to do when we already have a destination, and aren't there yet?
					}// Children.
				}// Most common, so put it at the top.
				else if(me.mission==FOLLOW) {
					// (Be sure that when we change mission, we reset path and dest!)
					if(@(me.leader)!=null and me.leader.hp>0) me.dest=me.leader.pose;
					else if(@(me.target)!=null and me.target.hp>0) me.dest=me.target.dest;
					else if(@(me.besty)!=null) me.dest=me.besty.pose;
					else if(@(me.rival)!=null) me.dest=me.rival.pose;
					else me.mission=WANDER;
					if(me.mission==FOLLOW and me.path.length()==0 and (absolute(me.pose.x-me.dest.x)>5 or absolute(me.pose.z-me.dest.z)>5)) this.pathfind(i, me.dest);
					this.navigate(me); // <-- does this belong here, or are we using one in a central location, and this will just cost us unnecessary cycles?
				}// Follow the leader...
				else if(me.mission==FEED) {
					// Look for the closest food sources.
					int foods = me.sushi+me.sake+me.meat+me.vegies+me.fruit;
					//vector[] sources;
					double d = 9000000;
					bool found=false;
					for(uint j=0; j<this.items.length(); j++) {
						if(this.items[j] is null or (this.items[j].category!=9 and this.items[j].name!="Net")) continue;
						double d2 = len2(this.items[j].pose-me.pose);
						if(d2<d) {
							d=d2;
							if(me.dest!=this.items[j].pose and !found) {
								me.path.resize(0);
								found=true;
							}
							me.dest=this.items[j].pose;
						}//Closer than last slosest.
					}//Items loop.
					if(me.inv_find("Net")>=0) {
						for(uint j=0; j<this.mounts.length(); j++) {
							if(this.mounts[j] is null or this.mounts[j].name!="boat") continue;
							double d2 = len2(this.mounts[j].pose-me.pose);
							if(d2>=d) continue;
							d=d2;
							if(me.dest!=this.mounts[j].pose and !found) {
								me.path.resize(0);
								found=true;
							}
							me.dest=this.mounts[j].pose;
						}// Search for boats, even though you can fish in shallower water as well.
					}// Nets let you catch fish.
					
					// Except you should return to base and distribute the food to allies when you have enough.
					if(foods>=random(3, 10)) {
						me.mission=WANDER;
						//if((@(me.shogun)==@(myArmy[0]))&&(@(me.gloc)==@(myArmy[ychar].gloc))) pool.play_extended_2d("sfx/beacon.wav", myArmy[ychar].x, myArmy[ychar].y, me.x, me.y, 0, 0, 0, 0, false, 0, 0, 0, 250);
						me.dest=me.home;
						if(!found) {
							me.path.resize(0);
							found=true;
						}
					}// Plenty of food.
					// Avoid doing this more often than necessary!
					//if(found) this.pathfind(i, me.dest);
				}// Looking for food.
				//} // 1:31 PM 8/31/2012. I think this was here because the loop for a net was not closed properly. No wonder there was so much lag!
				// }
				
				// Path-finder.
				if(f==i and (me.dest.x!=0 or me.dest.z!=0) and len2(me.dest-me.pose)>25) {
					if( me.path.length()==0) this.pathfind(i, me.dest);
					if(me.state!=charging and me.state!=attacking and me.state!=stunned) this.navigate(me);
				}// Navigating.
				else if(@(me.target)!=null and me.target.hp>0 and len2(me.target.pose-me.pose)<400) {

				}// Hone in on a target?
				
				// Passive interactions with terrain, such as fire and drowning.

				
			}// Generic living human AI.
		}//Stepping NPCs.
		else {
			// If buttons are being held, stuff needs to happen.
			keyconfig@ kc = null;
			if(i==this.ychar) @kc = this.key;
			//else, get the virtual keyconfig associated with the online player.
			
			if(@kc!=null) {
				// Danger! : joysticks! We do not want to explicitly link joystick and keyboard input, if it can be helped, so we need to test _both_ for the local player!
				if(kc.key_down(R) or kc.key_down(U) or kc.key_down(L) or kc.key_down(D)) {
					// The simplest way to do this is to just call handle_action... but with what direction?
					int k = U;
					if(kc.key_down(L)) k=L;
					else if(kc.key_down(R)) k=R;
					else if(kc.key_down(D)) k=D;
					this.handle_input(k, i, kc);
				}// Holding walk.

			}// Holding buttons.
			
			// Item check:
			for(uint j=0; j<this.items.length(); j++) {
				// (Maybe it's better to do these by frame, instead of all at once, if lag becomes an issue.)
				Item@ it = this.items[j];
				if(it is null) {
					this.items.remove_at(j);
					continue;
				}
				if(it.intersects(me.pose)) {
					if(me.rank!=ZOMBIE or ((it.flags)&ZOMBABLE)==ZOMBABLE) this.getItem(me, it);
					if(it.category ==9 or random(0, 5)>2 ) this.items.remove_at(j);
					else it.pose = (10*this.floortiles[random(0, this.floortiles.length()-1)])+vector(random(0, 10), 0, random(0, 10));
				}
			}// Items loop.
		}// Updating players.
	}//updating actors.
	
	void system_update() {
		/* This method updates things which need to be advanced every frame, even if something else blocks normal simulation. */
		
		// BGM:
		//Network:
	}//system update.
	
	
	void populate_loot() {
		// Generic item distribution.
		string[] loots = {"Katana", "Yumi", "Tanto", "Kanabo", "Naginata", "Jo", "Bo", "Arrows", "Shuriken", "Sushi", "Fruit", "Vegies", "Sake", "Meat", "Armor", "*", "Nodachi", "Bouken", "Nagamaki", "Tachi", "Wakizashi", "Sai", "Arrows", "*", "*", "Vegies", "Fruit", "Meat", "Sushi"};
		string[] rares = {"Kunai", "Blow-dart", "Rocket Bow", "Arquebus", "Jade Broche", "Azure Fan", "Lavinder Fan", "Silk veil", "Kunai", "Black Egg", "Lead ball", "Ghost Lantern", "Rocket Bow", "Kusarigama", "Axe", "Hammer", "Net"};
		string[] armors = {"Armor", "Shield"}; // Expand later.
		string rep="Item report:\r\n"; // For debug
		while(this.items.length()<this.maxloot) {
			string name = loots[random(0, loots.length()-1)];
			if(name=="*") name = rares[random(0, rares.length()-1)];
			else if(name=="Armor") name = armors[random(0, armors.length()-1)];
			Item@ it = get_item(name);
			if(it is null) continue;
			it.pose = this.findclearspot(random(0, 9)); // Uh, doesn't that put it on a diagonal line through the center? ... Eh, 'tevs.
			rep += it.name + ": " + it.pose.x + ", " + it.pose.z + "\r\n";
			this.items.insert_last(it);
		}//Loot loop.
		clipboard_copy_text(rep);
	}//Generic loot spawning.
	
	void getItem(Actor@ me, Item@ it) {
		if(me is null or it is null) return;
		bool addme=true;
		string toplay = "Get/Melee";
		string n = string_to_lower_case(it.name);
		if(it.category==9) {
			toplay = "Get/Food";
			if(n=="sake") me.sake++;
			else if(n=="sushi") me.sushi+=1;
			else if(n=="fruit" or n=="kudamono") me.fruit++;
			else if(n=="vegies" or n=="vegetables" or n=="yasai" or n=="gohan") me.vegies++;
			else me.meat++;
		}//get food
		else if(it.category==1) {
			toplay = "Get/Armor";
			if((me.armor is null or me.armor.name != it.name) and string_to_lower_case(it.name) != "shield") {
				if (@(me.armor) != null) {
					me.armor.category = 8; // Turn it into a gift.
					me.inv.insert_last(me.armor);
				}// Hmm.
				@(me.armor) = it;
				addme=false;
			}// Wear it.
		}
		else if(it.category==2) {
			toplay = "Get/Projectile";
			if(me.inv_find(it.name)>=0) {
				toplay = "Get/Arrow";
				me.arrows+=10;
			}// Already have it. Add arrows?
			if(me.arrows==0) me.arrows=10; //random(1, 10);
		}//Bows.
		else if(it.category==6) {
			if(me.inv_find(it.name)>=0) {
				toplay = "Get/Knife";
				addme=false;
				if(n=="shuriken") me.shuriken+=10;
				else if(n=="kunai") me.kunai+=10; //Too much?
				else if(n=="blow-dart") me.darts+=5; // Eh...
				else addme=true;
			}
			else toplay = "Get/Projectile";
		}//Projectiles.
		else if(it.category==7) {
			toplay = "Items/Weapon";
			me.balls+=3;
			if(me.inv_find(it.name)>=0) {
				me.balls+=4;
				toplay = "Get/762";
			}
		}// Guns.
		else if(it.category==8) toplay = "Get/Quest";
		else if(it.category==10) toplay = "Items/misc";
		else if(n=="arrows" or me.inv_find(it.name)>=0) {
			addme=false;
			// (Adjust number of arrows received based on how balanced things seem in gameplay.)
			me.arrows+=10;
			toplay = "Get/Arrow";
			// If there are no bows on the map, maybe add one?
			if(me.inv_find("Yumi")<0 and me.inv_find("Rocket bow")<0) {
				bool found=false;
				for(uint i=0; i<this.items.length(); i++) {
					if(this.items[i].category == 2) found=true;
				}
				if(!found) {
					string[] names = {"Yumi", "Yumi", "Rocket bow", "Yumi", "*"};
					string name = names[random(0, names.length()-1) ];
					if(name == "*") {
						string[] n2 = {"Yumi", "Rocket bow", "Arquebus"};
						name = n2[random(0, n2.length()-1)];
					}
					Item@ it = get_item(name);
					it.pose = this.findclearspot(random(0, 9)); // Uh, doesn't that put it on a diagonal line through the center? ... Eh, 'tevs.
					this.items.insert_last(it);

				}// Add bow for arrows.
			}
		}
		this.playsound(Swamp + toplay + ".wav", me.pose, false, false);
		if(addme) me.inv.insert_last(it);
		if(it.slot>=0) pool.destroy_sound(it.slot);
		if(this.ychar>=0 and this.ychar<this.actors.length() and me is this.actors[this.ychar]) {
			string tosay = "got " + it.name;
			this.voice.speak_interrupt(tosay);
		}// Speak.
	}// Get item.
	int countFollowers(Actor@ me) {
		if(me is null or me.rank==ZOMBIE) return 0;
		int count=0;
		for(uint i=0; i<this.actors.length(); i++) {
			if(this.actors[i] is null or this.actors[i] is me or this.actors[i].rank==ZOMBIE) continue;
			if(this.actors[i].leader is me) count++;
			else if(this.actors[i].getLeader(me) is me) count++;
			// Yes, but... if we have more than two levels in our hierarchy, the middle levels get lost.
		}// Loop.
		return count;
	}
	
	void standardRespawn(Actor@ me) {
		if(me is null) return;
		vector dest = this.findclearspot();
		Actor@ l = me.getLeader();
		if(l is null) {
			if(this.countFollowers(me)>0) @l=me;
		}//No leader.
		
		if(@l!=null) {

		}//Find bases to respawn at.
		me.pose=dest;
		me.hp=me.maxHP;
		me.food=100.0;
		me.stamina=me.maxStamina;
		me.drunk=0;
		me.plague=0;
		me.path.resize(0);
	}// StandardRespawn.
	void join(Actor@ me, Actor@ them) {
		// Consider hierarchies:
		// If we're joining someone who is at the bottom of a multi-tiered team, which tier do we join at?
		// I'm tempted to say the same level as our recruiter, unless our recruiter is a daimyou.
		if(them.rank==DAIMYOU or them.leader is null) @(me.leader)=them;
		else @(me.leader)=them.leader;
		// Todo: incorporate the rivalry system into this, somehow?
	}//Joining another character's team.
	
	//AI:
	pathfinder holmes;
	bool pathfinder_init=false;
	void pathfind(int i, vector d) {
		if(!this.pathfinder_init) {
			this.holmes.create_map(this.map.length(), this.map[0].length());
			this.holmes.set_callback_function(pf_callback);
			this.pathfinder_init=true;
		}//Init pathfinder.
		if(i<0 or i>=this.actors.length() or this.actors[i] is null) return;
		this.actors[i].path = this.holmes.find(this.actors[i].pose.x/10, this.actors[i].pose.z/10, d.x/10, d.z/10, "" + i);
	}//Pathfinder.
	
	/*void navigate(Actor@ me) {
