void navigate(Actor@ me) {
    if(me is null || me.hp <= 0.0) return;
    
    bool pathly = (me.path.length() > 0);
    vector targ = me.dest;
    
    if(pathly) {
        targ = me.path[0] * 10;
        // Check if we've reached this waypoint
        if(len2(targ - me.pose) < 9) {
            me.path.remove_at(0);
            if(me.path.length() > 0) {
                targ = me.path[0] * 10;
            } else {
                targ = me.dest;
            }
        }
    }
    
    // Calculate direction to target
    vector dir = targ - me.pose;
    dir.y = 0;
    
    if(dir.length() > 0.1) {
        dir = dir / dir.length();
        
        // Check if movement is obstructed and find alternative path
        dir = find_best_direction(me, dir);
        
        // Set facing direction
        me.face = dir;
    }
    
    // Apply movement
    me.v = me.speed * me.face;
    
    // Set movement state
    if(me.state != walking && me.state != attacking && me.state != charging) {
        me.setState(walking);
    }
}	
	void reset_game() {
		// Test
		this.test_reset();
	}// Reset game.
	void test_reset() {
		this.items.resize(0);
		this.actors.resize(0);
		this.mounts.resize(0);
		this.generate_map();
		this.actors.insert_last(this.get_char(KODOMO));
		this.ychar=this.actors.length()-1;
		this.actors.insert_last(this.get_char(RONIN));
		for(uint i=0; i<zomnames.length()-3; i++) {
			this.actors.insert_last(this.get_char(ZOMBIE));
			this.actors[this.actors.length()-1].name=zomnames[i];
			this.actors.insert_last(this.get_char(random(0, 8))); // For testing?
			this.actors[this.actors.length()-1].mission = random(WANDER, HALT);
		}
		this.update_floortiles();
		for(uint i=0; i<this.floortiles.length(); i++) {
			vector ft = this.floortiles[i];
			if(this.map[ft.x][ft.z]=="Swim") {
				Actor boat();
				boat.rank=MOUNT;
				boat.name="boat";
				// pick a shore.
				int x=random(-1, 1), y=random(-1, 1);
				int tries=0;
				while(ft.x+x<0 or ft.x+x>=this.map.length() or ft.y+y<0 or ft.y+y>=this.map[ft.x].length() or this.map[ft.x+x][ft.z+y]=="") {
					tries++;
					x=random(-1, 1);
					y=random(-1, 1);
					if(tries>20) {
						x=0;
						y=0;
						break;
					}
				}// Loop.
				boat.pose = (10*ft);
				vector d (5*(x+1), 0, 5*(y+1));
				boat.pose+=d;
				@(boat.gloc)=this;
				this.mounts.insert_last(boat);
			}//Add boat.
		}// Add boats.
		
		// Add some horses to the world
		for(uint i=0; i<3; i++) {
			Actor@ horse = this.get_char(MOUNT, "Horse");
			horse.pose = this.findclearspot();
			this.mounts.insert_last(horse);
		}
		
		// Add some dogs/wolves for variety
		this.actors.insert_last(this.get_char(INU, "Dog"));
		this.actors.insert_last(this.get_char(INU, "Wolf"));
		if(random(0, 10) > 5) this.actors.insert_last(this.get_char(INU, "Fox"));

	}// Test version.
}//Game.

ST@ st=null; // We couldn't get away without global functions that reference it, after all.
void main() {
	ST temp();
	@st=temp;
	st.start("Sengoku Tide, the crossover no one was asking for!");
}

// Key constants:
const int L=0, R=1, D=2, U=3,
          JL=4, JR=5, JD=6, JU=7,
          Q=8, E=9, RU=10, RR=11, RD=12, RL=13,
          W1=14, W2=15, WF=24,
          SETFAV1=25, FAV1=26, SETFAV2=27, FAV2=28,
          A=29, TAB=30, STAB=31, F=32,
          J=33, C=34, ENTER=35,
          Z=36, X=37, PAUSE=38, STATUS=39,
          V=40, F5=41, CHAT=42, CHECKONLINE=43,
          MSGNEXT = 44, MSGPREV=45, RADIO=46, CHANNELNEXT=47,
          CHANNELPREV=48, PING=49, B1=50, BF=61, BH=62;


Item@ get_item(string name) {
	string n = string_to_lower_case(name);
	if(n=="katana") {
		Item ret(name);
		ret.category=0;
		ret.flags=WEAPON; // Too big and skill-based for zombies.
		ret.range=1.2;
		ret.arc=pi2;
		ret.jump=30;
		ret.duck=30;
		ret.maxDamage=25; // Eh?
		ret.drawsound=sj + "bladedraw.wav";
		ret.swingsound=sj + "katana*.wav";
		return ret;
	}//Katana
	else if(n=="tachi") {
		Item ret(name);
		ret.category=0;
		ret.swingsound=Swamp + "Weapons/AK47/bfire.wav";
		//ret.swingsound="../../fx/weapon swings/stab\\*.ogg";
		ret.drawsound=sj + "old_bladedraw.wav";
		ret.flags=WEAPON|PIERCE|ZOMBABLE;
		//A little faster than the katana for attack and recovery, but slower to draw.
		ret.range=1.0;
		ret.arc=pi4; // Maybe smaller?
		ret.duck=90;
		ret.jump=80;
		ret.maxDamage=10; // But with the critical pierce bonus as an option.

		return ret;
	}//Tachi.
	else if(n=="tanto") {
		// Basically a smaller tachi.
		Item ret(name);
		ret.category=0;
		ret.flags=WEAPON|ZOMBABLE|PIERCE;
		ret.range=0.5;
		ret.arc=pi4; // Hmm.
		ret.maxDamage=35; // Umm...
		// Should it be comboable?
		ret.combo=1;
		ret.swingsound=Swamp + "Machete/FireM.wav";
		ret.drawsound=Swamp + "Weapons/Machete/Draw.wav";
		// Or...
		ret.drawsound = steps + "../../fx/wield/4.ogg";
		ret.swingsound=steps + "../../fx/weapon swings/pierce\\*.ogg";
		ret.duck=50;
		ret.jump=90;
		return ret;
	}// Tanto.
	else if(n=="wakizashi") {
		Item ret(name);
		ret.category=0;
		// Basically, a smaller katana.
		ret.arc=pi;
		ret.range=0.5;
		ret.flags=WEAPON|ZOMBABLE;
		ret.maxDamage=25; // Hmm. It's faster though, right?
		ret.jump=75;
		ret.duck=75;
		// Should it sound different from the tanto? I'm not sure that it should.
		ret.swingsound=Swamp + "Weapons/Machete/Fire.wav";
		ret.drawsound=Swamp + "Weapons/Machete/Draw.wav";
		return ret;
	}// Wakizashi.
	else if(n=="nagamaki") {
		Item ret(name);
		ret.category=0;
		ret.range=1.25;
		ret.arc=pi;
		ret.flags=WEAPON;
		ret.duck=90;
		ret.jump=75;
		ret.maxDamage=20; // Hmm.
		ret.swingsound = Swamp + "Weapons/M16/bfire.wav";
		ret.drawsound=steps + "../../fx/wield/3.ogg";
		// Why does it feel like I've forgotten something important?
		return ret;
	}// Nagamaki.
	else if(n=="bouken") {
		Item ret(name);
		ret.category=0;
		ret.flags=WEAPON|WOOD;
		// This makes me want to use those crappy sword sounds I recorded with my swordclub sword. Mais non?
		//Use the katana swing / pool queue, instead.
		ret.swingsound=sj + "katana*.wav";
		ret.range=1.2;
		ret.arc=pi/2;
		// Make it a wee bit faster than the katana.
		ret.maxDamage=10;
		ret.duck=30;
		ret.jump=30;
		return ret;
	}//Bouken.
		else if(n=="nodachi" or n=="oudachi" or n=="odachi") {
		Item ret(name);
		ret.category=3;
		ret.flags=WEAPON|HEAVY;
		ret.range=2.0;
		ret.arc=pi4; // Maybe it should be smaller, even.
		// Jump and duck should stay at 0, though, because it's used with vertical attacks.
		ret.maxDamage=250;
		ret.minDamage=50;
		// What in the world is the swingsound for one of these?
		ret.swingsound = steps + "../../fx/weapon swings/chop\\*.ogg";
		return ret;
	}//Nodachi.
	else if(n=="kanabo") {
		Item ret(name);
		ret.category=3;
		ret.arc=pi;
		ret.range=1.25;
		ret.flags=WEAPON|HEAVY;
		ret.maxDamage=150;
		ret.minDamage=25;
		//Really big recovery / stamina cost.
		ret.jump=90;
		ret.duck=25;
		ret.swingsound=Swamp + "Weapons/Hammer/Fire.wav";
		ret.drawsound=Swamp + "Weapons/Hammer/Draw.wav";
		return ret;
	}//Kanabo.
	else if(n=="naginata") {
		Item ret(name);
		ret.category=4;
		ret.range=3; // Umm...
		ret.arc=pi/8.0; // I'm not sure I like this, actually.
		ret.maxDamage=20;
		ret.swingsound=sj + "thrust.wav";
		ret.flags=WEAPON|PIERCE; // The pierce is debatable, though.
		// Since the shaft is long and probably wooden, should it also have the wood flag?
		//blocksound = MHI + pole*.ogg
		ret.jump=25;
		ret.duck=25;
		ret.minDamage=10;
		// I kinda want it to have a combo where it turns into a sharp bo for one hit... but that's... complicated.
		return ret;
	}// Naginata.
	else if(n=="bo") {
		Item ret(name);
		ret.category=5;
		ret.flags=WEAPON|WOOD;
		ret.maxDamage=10;
		ret.jump=60;
		ret.duck=10;
		ret.range=1.5;
		ret.arc=2.0*pi;
		ret.swingsound = MHI + "swing_big*.ogg";
		ret.combo=1;
		return ret;
	}//bo-staff
	else if(n=="jo") {
		Item ret(name);
		ret.category=5;
		ret.flags=WEAPON|WOOD|ZOMBABLE;
		ret.maxDamage=15; // Hmm.
		ret.arc=pi2;
		ret.range=1.2;
		ret.duck=25;
		ret.jump=35;
		ret.swingsound = sj + "staff*.wav";
		ret.combo=3;
		return ret;
	}// Jo-staff.
	else if(n=="yumi") {
		Item ret(name);
		ret.category=2;
		ret.range=15;
		// I want to ignore arc on these.
		//0.2s is the maximum loosetime?
		ret.jump=75;
		ret.duck=60;
		ret.maxDamage=30; // Hmm.
		ret.flags=WEAPON;
		ret.drawsound=Swamp + "Weapons/Longbow/Draw.wav";
		return ret;
	}//Yumi.
	else if(n=="shuriken") {
		Item ret(name);
		ret.maxDamage=10;
		ret.flags=WEAPON;
		// I think we'd use the hitcallback to allow it to sometimes bypass blocking.
		ret.category=6;
		ret.swingsound=MHI + "throw_weapon_mono.ogg";
		ret.duck=90;
		ret.jump=50;
		ret.range=10;
		return ret;
	}//Shuriken? Bah.
	else if(n=="kunai") {
		Item ret(name);
		// And for my next trick:
		ret.minDamage=50; // If mindamage>maxdamage, it's a special case, like Kunai and Arquebus.
		ret.range=7;
		ret.flags=WEAPON|ZOMBABLE;
		ret.duck=50;
		ret.jump=90;
		ret.swingsound = Swamp + "Weapons/Knives/FireM.wav";
		return ret;
	}//Kunai.
	else if(n=="fruit" or n=="vegies" or n=="sake" or n=="meat" or n=="sushi") {
		Item ret(name);
		ret.category=9;
		ret.flags=FOOD;
		// Etc.
		return ret;
	}// Food.
	else if(n=="sai") {
		Item ret(name);
		ret.category=0;
		ret.combo=4;
		ret.maxDamage=10; // These do the least damage.
		// They're too blunt to pierce armor, yes?
		// Their main advantage is that they are great at blocking, and can disarm.
		ret.minswing=0.0;
		ret.maxswing=0.35;
		ret.range=0.3;
		ret.arc=3.0*pi4; // There are two of them, so give them a wide arc.
		ret.swingsound = steps + "../../fx/weapon swings/whoosh_fast*.wav";
		// Do we make disarm chance into a flag?
		return ret;
	}//Sais
	else if(n=="axe" or n=="hammer") {
		Item ret(name);
		ret.category=10;
		ret.range = ceiling(n.length())*0.5;
		if(n=="hammer") ret.flags|=HEAVY;
		ret.swingsound=Swamp + "Weapons/" + name + "/Fire.wav";
		ret.drawsound=Swamp + "Weapons/" + name + "/Draw.wav";
		// Somewhy, it's tempting to make the axe capable of piercing.
		ret.maxDamage=30*n.length();
		ret.minswing=0.1*ceiling(n.length());
		ret.maxswing=ret.minswing;
		ret.minrec=ret.minswing;
		ret.maxrec=ret.maxswing;
		if(n=="axe") ret.blocksound=Swamp + "Weapons/Axe/Block*.wav";
		return ret;
	}//Axe.
	else if(n=="rocket bow") {
		Item ret(name);
		ret.category=2;
		ret.range=25;
		ret.jump=25;
		ret.duck=75;
		ret.maxDamage=100; // Hmm.
		ret.minDamage=25;
		ret.flags=WEAPON;
		ret.drawsound=Swamp + "Weapons/Crossbow/Draw.wav";
		return ret;
	}
	else if(n=="net") {
		Item ret(name);
		ret.category = 10;
		ret.minswing = 3.0;
		ret.maxswing = ret.minswing;
		ret.maxDamage = 0.0; // It's for catching fish.
	}//Net
	else if(n == "arquebus") {
		Item ret(name);
		ret.category = 7;
		ret.minDamage = 300.0; // DANGER!
		ret.maxDamage = 150.0;
		ret.maxswing = 1.0;
		ret.arc = pi/4.0;
		// How do we reload?
		ret.minrec = 0.1;
		ret.maxrec = 1.0;
		ret.flags |= PIERCE;
		ret.duck = 50;
		ret.jump = 90;
		ret.range = 2.5; // Umm.
		// The sounds on these, though...
		ret.drawsound = Swamp + "Weapons/Winchester/Draw.wav";
		
		return ret;
	}// Arquebus.
	else if(n=="armor" or n == "shield" or n == "ihatsu") {
		Item ret(name);
		ret.category = 1;
		ret.flags |= ARMOR;
		ret.drawsound = Swamp + "Weapons/Shield/Draw.wav";
		if (n == "shield") ret.flags |= HEAVY;
		if (n=="shield") ret.defense = 75; // Umm.
		// IIRC, Samurai shields are more tower-like, so they should be stronger against ducking attacks and weaker against jumping attacks?
		// The opposite is true for armor.
		return ret;
	}//Armor, shield, ihatsu.
	else if(n=="arrows" or name=="Arrows") {
		Item ret(name);
		ret.category=-1;
		return ret;
	}// Arrows
	return Item(name);
}

// Callback for the pathfinder:
int pf_callback(int x, int y, int parent_x, int parent_y, string user_data) {
	if(st is null) return 0;
	int i=-1;
	if(user_data!="") i = string_to_number(user_data); // DANGER!!!
	Actor@ me=null;
	if(i>=0 and i<st.actors.length()) @me=st.actors[i];
	if(x<0 or y<y or x>=st.map.length() or y>=st.map[x].length() or st.map[x][y]=="") return 10;
	
	bool badWeather = (st.weather=="rain" or st.weather=="storm" or st.weather=="snow");
	
	// Softs are generally fine:
	if(string_contains(softs, st.map[x][y], 1)>=0) return 0;
	else if(string_contains(hards, st.map[x][y], 1)>=0) {
		// We don't want AI to jump out of castles, do we? It might be easier if we allow this.
		if(badWeather or (@me!=null and (me.pose.y>=2.0 or string_contains(hards, st.get_terrain(me.pose), 1)>=0))) return 0;
		else return 5;
	}// Hards are probably castles.
	else if (st.map[x][y]=="Leaves" or st.map[x][y]=="Leaves2") {
		if(@me!=null and (me.rank==INU or me.rank==SHINOBI or me.rank==KODOMO or me.pose.y>=2.0)) return 0;
		return 1;
	}//Forests.
	else if(st.map[x][y]=="Swim" or st.map[x][y]=="Swim2") {
		// Do we treat swimming as easier or harder than going through castles?
		if(badWeather) return 9;
		// If you're mounted, it's not so bad... but AI usually won't know about mounts when choosing a path.
		// Todo: add breathing reed, but still discourage samurai and daimyou from swimming.
		if(@me!=null and (me.rank==KODOMO or me.rank==SHINOBI)) return 1;
		else if(@me!=null and (me.rank==SAMURAI or me.rank==DAIMYOU)) return 6;
		else if(@me!=null and me.rank==ZOMBIE) return 0;
		return 3;
	}// Deep water.
	else if((badWeather or (@me!=null and (me.plague>0 or me.hp<=75))) and string_contains(wets, st.map[x][y], 1)>=0) return 7;
	
	return 0;
}//Pathfinder callback.

const int order_range=10; // Copied some code from Sengoku Jidai which used this, didn't feel like replacing it in every case.

string missionString(int m) {
	/* Return a string description of a mission. */
	if(m==WANDER) return "none";
	else if(m==GO) return "go";
	else if(m==FOLLOW) return "follow";
	else if(m== RETURN) return "return to base";
	else if(m== ATTACK) return "attack";
	else if(m== DEFEND) return "defend";
	else if(m== FEED) return "find food";
	else if(m== HUNT) return "hunt";
	else if(m==RECRUIT) return "recruit";
	else if(m== HALT) return "wait";
	return "none";
}


void handle_human_npc(Actor@ me, int i, int f, vector camera) {
    // Skip processing if it's not this actor's frame to think
    if(f != i) return;
    
    // 1. ASSESS SITUATION (highest priority first)
    bool under_attack = check_if_under_attack(me);
    Actor@ attacker = find_attacker(me);
    bool low_health = me.hp < me.maxHP * 0.3;
    bool low_food = me.food < 15.0;
    bool has_leader = @(me.leader) != null;
    
    // 2. RESPOND TO IMMEDIATE THREATS (combat & survival)
    if(under_attack) {
        handle_combat_response(me, attacker);
        return; // Skip lower priority behaviors when in combat
    }
    
    // 3. HANDLE SURVIVAL NEEDS
    if(low_food) {
        if(try_to_eat(me)) {
            return; // Successfully eating
        }
        me.mission = FEED;
        find_food_source(me);
        return;
    }
    
    // 4. FOLLOW MISSION DIRECTIVES
    switch(me.mission) {
        case WANDER:
            handle_wander_behavior(me);
            break;
        case FEED:
            handle_feeding_behavior(me);
            break;
        case FOLLOW:
            handle_follow_behavior(me);
            break;
        case ATTACK:
            handle_attack_mission(me);
            break;
        case DEFEND:
            handle_defend_mission(me);
            break;
        case RECRUIT:
            handle_recruit_mission(me);
            break;
        default:
            handle_wander_behavior(me);
            break;
    }
    
    // 5. SOCIAL BEHAVIORS (lowest priority)
    if(me.state == 0 && random(0, 20) == 5) {
        me.setState(talking); //try_social_interaction(me);
    }
}

// Each function handles a specific aspect of behavior clearly
bool check_if_under_attack(Actor@ me) {
    // Simple logic to determine if being attacked
    for(uint i=0; i<st.actors.length(); i++) {
        Actor@ potential_attacker = st.actors[i];
        if(potential_attacker is null || @potential_attacker == @me) continue;
        
        if(potential_attacker.state == attacking || potential_attacker.state == charging || (potential_attacker.rank==ZOMBIE and me.rank!=ZOMBIE and len2(me.pose-potential_attacker.pose)<255)) {
            // Check if attack is aimed at this actor
            double attack_range = potential_attacker.height() + 
                (@(potential_attacker.weapon) != null ? potential_attacker.weapon.range : (2*potential_attacker.height()));
            
            if(len2(potential_attacker.pose - me.pose) <= attack_range * attack_range) {
                // Check if attacker is facing this actor
                vector direction = me.pose - potential_attacker.pose;
                direction.y = 0;
                if(direction.length() > 0) {
                    direction = direction / direction.length();
                    // Dot product for direction check
                    double facing_dot = potential_attacker.face.x * direction.x + 
                                        potential_attacker.face.z * direction.z;
                    
                    if(facing_dot > 0.5) { // Roughly in the same direction
                        return true;
                    }
                }
            }
        }
    }
    return false;
}

void handle_combat_response(Actor@ me, Actor@ attacker) {
    if(attacker is null) return;
    
    // Turn to face attacker
    vector direction = attacker.pose - me.pose;
    direction.y = 0;
    if(direction.length() > 0) {
        me.face = direction / direction.length();
    }
    
    // Choose appropriate response based on equipment and distance
    double distance = len2(me.pose - attacker.pose);
    
    // Find best weapon for the situation
    Item@ best_weapon = find_best_weapon(me, attacker, distance);
    if(@best_weapon != null && @me.weapon != @best_weapon) {
        @me.weapon = best_weapon;
        if(me.weapon.drawsound != "") {
            me.sounds.insert_last(me.weapon.drawsound);
        }
    }
    
    // Calculate attack range
    double my_range = me.height() / 2;
    if(@me.weapon != null) my_range += me.weapon.range;
    
    // Against zombies - be more aggressive, ranged attacks preferred
    if(attacker.rank == ZOMBIE) {
        // If we have a ranged weapon and are at good distance, shoot
        if(@me.weapon != null && (me.weapon.category == 2 || me.weapon.category == 6) && distance > 16 && distance < 400) {
            if(me.state != attacking && me.state != charging) {
                me.setState(charging);
                me.charged = 0.5 + (random(0, 5) * 0.1);
                me.setState(attacking);
            }
            return;
        }
        // If zombie is close, dodge away then counterattack
        if(distance <= 25) {
            if(random(0, 10) < 7) {
                dodge_attack(me, attacker);
                // After dodging, prepare counterattack
                if(me.state == 0) {
                    me.setState(charging);
                    me.charged = 0.3 + (random(0, 5) * 0.1);
                }
            } else {
                // Quick counterattack
                me.setState(charging);
                me.charged = 0.4 + (random(0, 6) * 0.1);
                me.setState(attacking);
            }
            return;
        }
    }
    
    // Combat strategy based on role and equipment
    if(me.rank == SHINOBI || me.rank == ASHIGARU) {
        // Higher chance to dodge, but also counterattack
        if(random(0, 10) < 5) {
            dodge_attack(me, attacker);
            // Shinobi counterattack after dodge
            if(me.rank == SHINOBI && me.state == 0 && distance <= my_range * my_range) {
                me.setState(charging);
                me.charged = 0.5;
                me.setState(attacking);
            }
            return;
        }
    }
    
    // Samurai and Ronin are more aggressive
    if(me.rank == SAMURAI || me.rank == RONIN) {
        if(distance <= my_range * my_range) {
            // In range - attack!
            if(me.state != attacking && me.state != charging) {
                me.setState(charging);
                me.charged = 0.5 + (random(0, 5) * 0.1);
                if(random(0, 10) > 3) me.setState(attacking);
            }
            return;
        } else if(distance <= 100) {
            // Close in for attack
            me.setState(walking);
            return;
        }
    }
    
    // Block or counter based on weapon type
    if(@me.weapon != null && me.weapon.category == 0) {
        // Swords are good for blocking
        if(attacker.state == charging || attacker.counter > 0.2) {
            me.setState(charging);
            me.charged = 0.4 + (random(0, 10) * 0.06);
        } else if(me.state == charging && me.charged > 0.3) {
            me.setState(attacking);
        } else if(me.state == 0 && distance <= my_range * my_range) {
            // Not waiting - attack proactively
            me.setState(charging);
            me.charged = 0.3 + (random(0, 7) * 0.1);
            me.setState(attacking);
        }
    } else {
        // Other weapons or unarmed - balance dodge and attack
        if(attacker.state == charging || attacker.counter > 0.2) {
            if(random(0, 10) < 5) {
                dodge_attack(me, attacker);
            } else {
                me.setState(charging);
                me.charged = 0.3 + (random(0, 10) * 0.07);
            }
        } else if(me.state == charging && me.charged > 0.3) {
            me.setState(attacking);
        } else if(me.state == 0 && distance <= my_range * my_range) {
            // Attack when in range
            me.setState(charging);
            me.charged = 0.4 + (random(0, 6) * 0.1);
            me.setState(attacking);
        }
    }
}

void dodge_attack(Actor@ me, Actor@ attacker) {
    // Move perpendicular to attack direction
    vector attack_dir = me.pose - attacker.pose;
    attack_dir.y = 0;
    if(attack_dir.length() > 0) {
        attack_dir = attack_dir / attack_dir.length();
        
        // Create perpendicular vector
        vector dodge_dir(attack_dir.z, 0, -attack_dir.x);
        
        // Randomize dodge direction (left or right)
        if(random(0, 1) == 0) {
            dodge_dir *= -1;
        }
        
        me.face = dodge_dir;
        me.setState(walking);
        
        // Occasionally jump or duck
        if(random(0, 10) < 3) {
            if(random(0, 1) == 0 && me.onGround()) {
                me.setState(JUMPING|walking);
            } else {
                me.setState(DUCKING);
            }
        }
    }
}

Item@ find_best_weapon(Actor@ me, Actor@ attacker, double distance) {
    // Logic to pick best weapon based on situation
    double best_score = -1;
    int best_index = -1;
    
    for(uint i=0; i<me.inv.length(); i++) {
        if(me.inv[i] is null) continue;
        
        double score = 0;
        
        // Range score - higher for weapons that match the current distance
        if(distance <= 4) {
            // Close range
            if(me.inv[i].category == 0) score += 5; // Swords
            else if(me.inv[i].category == 3) score += 4; // Heavy weapons
            else if(me.inv[i].category == 5) score += 3; // Staff
        } else {
            // Long range
            if(me.inv[i].category == 2) score += 5; // Bows
            else if(me.inv[i].category == 4) score += 4; // Pole arms
            else if(me.inv[i].category == 6) score += 3; // Projectiles
        }
        
        // Against armored opponents
        if(@attacker.armor != null) {
            // Armor breaking weapons
            if(((me.inv[i].flags)&PIERCE) == PIERCE) score += 3;
            if(((me.inv[i].flags)&HEAVY) == HEAVY) score += 2;
        }
        
        // Rank-appropriate weapons
        if(me.rank == SAMURAI && me.inv[i].category == 0) score += 2; // Samurai prefer swords
        if(me.rank == SHINOBI && me.inv[i].category == 6) score += 2; // Shinobi prefer projectiles
        
        if(score > best_score) {
            best_score = score;
            best_index = i;
        }
    }
    
    if(best_index >= 0) {
        return me.inv[best_index];
    }
    return null;
}

bool try_to_eat(Actor@ me) {
    // First check if we have any food
    string[] foods = {"Meat", "Sushi", "Vegies", "Fruit", "Sake"};
    int[] vals = {me.meat, me.sushi, me.vegies, me.fruit, me.sake};
    
    // Find available food with preference
    for(uint i=0; i<foods.length(); i++) {
        if(vals[i] <= 0) continue;
        
        int wi = me.inv_find(foods[i]);
        if(wi >= 0) {
            @(me.weapon) = me.inv[wi];
            me.setState(attacking);
            return true;
        } else {
            // Directly consume food
            if(foods[i] == "Sake") {
                me.sake--;
                me.food += 25;
                me.drunk += 25;
            } else {
                me.food = 100.0;
                if(foods[i] == "Sushi") me.sushi--;
                else if(foods[i] == "Vegies") me.vegies--;
                else if(foods[i] == "Fruit") me.fruit--;
                else me.meat--;
            }
            return true;
        }
    }
    return false;
}

void handle_wander_behavior(Actor@ me) {
    // Different wander behaviors based on NPC rank
    if(me.rank == KODOMO) {
        wander_as_child(me);
    } else if(me.rank == RONIN || (me.rank == SAMURAI && me.leader is null)) {
        wander_as_ronin(me);
    } else {
        wander_as_civilian(me);
    }
}

void wander_as_child(Actor@ me) {
    // Children prefer to play near trees or water
    // Occasionally jump or make sounds
    if(me.state == 0 && random(0, 20) == 5) {
        me.keyPressed((random(1, 10) > 5) ? JUMPING : (JUMPING|walking));
    }
    
    // Seek out interesting locations
    if(me.path.length() == 0 && random(0, 15) == 0) {
        vector target = st.floortiles[random(0, st.floortiles.length()-1)];
        int tries = 0;
        
        // Try to find water or trees
        while(tries < 10) {
            if(st.map[target.x][target.z] != "" && 
               (st.map[target.x][target.z][0] == "L" || 
                string_contains(wets, st.map[target.x][target.z], 1) >= 0)) {
                break;
            }
            target = st.floortiles[random(0, st.floortiles.length()-1)];
            tries++;
        }
        
        st.pathfind(st.actors.find(me), target * 10);
    }
    
    // Make child sounds occasionally
    if((me.voiceslot < 0 || !st.pool.sound_is_playing(me.voiceslot)) && random(1, 20) == 1) {
        me.voiceplay("../pgs21/voice/" + ((random(1, 10) > 5) ? 
            "Kid Giggle 3x-SoundBible.com-91159045.wav" : 
            "Kid_Laugh-Mike_Koenig-1673908713.wav"));
    }
}

void wander_as_ronin(Actor@ me) {
    // Ronin search for challenges or food
    if((me.dest == me.pose || (me.dest.x == 0 && me.dest.z == 0)) && random(0, 10) == 0) {
        // Pick a random destination
        vector tf = st.floortiles[random(0, st.floortiles.length()-1)];
        st.pathfind(st.actors.find(me), tf * 10);
    }
    
    // Look for potential enemies or challenges
    if(random(0, 15) == 0) {
        for(uint i=0; i<st.actors.length(); i++) {
            Actor@ potential_enemy = st.actors[i];
            if(potential_enemy is null || @potential_enemy == @me || 
               potential_enemy.rank == ZOMBIE || potential_enemy.hp <= 0) continue;
               
            // Ronin may challenge other warriors
            if((potential_enemy.rank == SAMURAI || potential_enemy.rank == RONIN) && 
               len2(potential_enemy.pose - me.pose) < 100) {
                @me.target = potential_enemy;
                me.mission = ATTACK;
                break;
            }
        }
    }
}

void wander_as_civilian(Actor@ me) {
    // Civilians seek shelter, especially during bad weather
    if(((me.dest == me.pose || (me.dest.x == 0 && me.dest.z == 0)) || 
       ((absolute(me.pose.x - me.dest.x) < 5) && 
        (absolute(me.pose.z - me.dest.z) < 5))) && random(0, 10) == 0) {
        
        bool need_shelter = (st.weather == "rain" || st.weather == "storm" || 
                            st.weather == "snow");
        string current_terrain = st.get_terrain(me.pose);
        
        // Stay in buildings during bad weather
        if(string_contains("Stone Wood2 Stairs", current_terrain, 1) >= 0 && need_shelter) {
            // Stay put
            return;
        }
        
        // Search for interesting locations (buildings during bad weather, otherwise varied)
        int x = floor(me.pose.x / 10);
        int z = floor(me.pose.z / 10);
        bool destination_found = false;
        
        for(int search_radius = 1; search_radius <= 10 && !destination_found; search_radius++) {
            for(int dx = -search_radius; dx <= search_radius && !destination_found; dx++) {
                for(int dz = -search_radius; dz <= search_radius && !destination_found; dz++) {
                    // Only check perimeter for efficiency
                    if(absolute(dx) < search_radius && absolute(dz) < search_radius) continue;
                    
                    int nx = x + dx;
                    int nz = z + dz;
                    
                    if(nx < 0 || nz < 0 || nx >= st.map.length() || 
                       nz >= st.map[0].length() || st.map[nx][nz] == "") continue;
                    
                    string terrain = st.map[nx][nz];
                    bool go_here = false;
                    
                    if(need_shelter && string_contains(hards, terrain, 1) >= 0) {
                        go_here = true; // Buildings during bad weather
                    } else if(!need_shelter) {
                        if(string_contains(wets, terrain, 1) >= 0 && 
                           me.sushi < random(1, 10) && me.inv_find("Net") >= 0) {
                            go_here = true; // Water if we have a net
                        } else if((terrain == "Leaves" || terrain == "Leaves2") && 
                                 random(0, 10) == 2) {
                            go_here = true; // Sometimes go to forests
                        } else if(random(0, 15) == 0) {
                            go_here = true; // Occasionally go anywhere
                        }
                    }
                    
                    if(go_here) {
                        vector new_dest(nx * 10 + 5, 0, nz * 10 + 5);
                        me.dest = new_dest;
                        st.pathfind(st.actors.find(me), new_dest);
                        destination_found = true;
                    }
                }
            }
        }
    }
}

