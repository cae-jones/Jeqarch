 void extendStage(Track@ tr) {
  Track@ cur;
 @cur=tr;
 int tries=0;
 while((tries<10000)&&(@cur!=null)) {
  cur.bgm=tr.bgm;
 @cur=cur.next;
 tries++;
 }

 }// Extend Stage.


 Item@ ring(double x, double y) {
 Item@ ret; @ret=newItem("ring", x, y, 1, 1);
 return ret;}

 Item@ newItem(string n, double x, double y, double w, double h) {
 Item ret(n, x, y, w, h);
 return ret;
 }
Track@ newTrack(double a, double l) {
 Track ret(a, l); return ret;
 }



