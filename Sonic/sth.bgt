#include "sound_pool.bgt"

 // If given the endpoints for two line segments, this function returns the point at which they intersect.
 // If the segments do not intersect, the return value will be null.
 Point@ lineIntersects(Point@ p1, Point@ p2, Point@ p3, Point@ p4) {
 // Let's be sure that our points are in left-right order.
 double x1=p1.x; double x2=p2.x; double x3=p3.x; double x4=p4.x;
 double y1=p1.y; double y2=p2.y; double y3=p3.y; double y4=p4.y;
 if(x3>x4) {x3=p4.x; x4=p3.x; y3=p4.y; y4=p3.y;}
 if(x1>x2) {x1=p2.x; x2=p1.x; y1=p2.y; y2=p1.y;}

 // Now, find the slopes.
 // Ur, be aware that vertical lines might happen...
 double m1;
 if(x1==x2) m1=1999999999;
 else m1=(y2-y1)/(x2-x1); 
 double m2;
 if(x3==x4) m2=1999999999;
 else m2=(y4-y3)/(x4-x3);

 double b1=y1-(m1*x1);
 double b2=y3-(m2*x3);
 if(m1==m2) {
 if(b1==b2) {
 // One point must be between the other two.
 if((x3>=x1)&&(x3<=x2)) return newPoint(x3, y3);
 else if((x4>=x1)&&(x4<=x2)) return newPoint(x4, y4);
 else if((x1>=x3)&&(x1<=x4)) return newPoint(x1, y1);
 else if((x2>=x3)&&(x2<=x4)) return newPoint(x2, y2);
 else return null;
 }
 else return null;
 }// They don't collide unless b1 and b2 are the same.
 else {
double rx=(b2-b1)/(m1-m2);
 if((rx>=x1)&&(rx<=x2)&&(rx>=x3)&&(rx<=x4)) {
 double ry = (m1*rx)+b1;

 return newPoint(rx, ry);
} else return null;
}
// return null;
 }

 class Rectangle {

 double x; double y; double width; double height;
 Rectangle(double xx, double yy, double w, double h) {
x=xx; y=yy; width=w; height=h;}

 bool collide(Rectangle@ r) {
 double x1=x;
 double x2=x+width;
 double x3=r.x;
 double x4=r.x+r.width;
 double y1=y;
 double y2=y+height;
 double y3=r.y;
 double y4=r.y+r.height;
 return (
 (
( ((x1>=x3)&&(x1<=x4))||((x2>=x3)&&(x2<=x4)))&&
 (((y1>=y3)&&(y1<=y4))||((y2>=y3)&&(y2<=y4)))
 )||
 (
 (((x3>=x1)&&(x3<=x2))||((x4>=x1)&&(x4<=x2)))&&
 (((y3>=y1)&&(y3<=y2))||((y4>=y1)&&(y4<=y2))))
);
}
 bool contains(Point@ p) {
 double x1=x; double x2=x+width;
 double y1=y; double y2=y+height;
 double x3=p.x; double y3=p.y;

 return ((x3>=x1)&&(x3<=x2)&&(y3>=y1)&&(y3<=y2));
 }

 // Does this Rectangle intersect a line, as defined by two points?
 bool intersects(Point p1, Point p2) {
 if((contains(p1))||(contains(p2))) return true;

 double x1=x; double x2=x+width;
 double y1=y; double y2=y+height;

 Point@ p;
 @p=lineIntersects(p1, p2, newPoint(x1, y1), newPoint(x2, y1));
 if(@p==null) @p=lineIntersects(p1, p2, newPoint(x1, y1), newPoint(x1, y2));
 if(@p==null) @p=lineIntersects(p1, p2, newPoint(x2, y1), newPoint(x2, y2));
 if(@p==null) @p=lineIntersects(p1, p2, newPoint(x1, y2), newPoint(x2, y2));
 return (@p!=null);
 }
}// rectangle

 class Point {
 double x; double y;
 Point() {x=0; y=0;}
 Point(double xx, double yy) {x=xx; y=yy;}
 }

 Rectangle@ newRectangle(double xx, double yy, double w, double h) {Rectangle ret(xx, yy, w, h); return ret;}
 Point@ newPoint(double xx, double yy) {Point ret(xx, yy); return ret;}




 // Trying again!
 const double pi=3.14159265;
 class Track {
 double angle; double length;
 Item@[] items;
 Particle@[] particles;
 string bgm;
 Track@ next;
 Track@ prev;

 Track(double an, double len) {angle=an; length=len; @next=null; @prev=null; underwater=false;}
 bool underwater;

 /* Returns the y value where the ground can be found at a given x, measured from the start of the track (0.0).
 * If the given x value is out of the bounds of the track, the slope is extended.
 */
 double getGroundHeight(double x) {
  return tangent(angle)*x;
 }// Feh. It took me three minutes to come up with that. Where have all my math skills gone?


 Track@ getEnd() {
 Track@ ret;
 @ret=this;
 Track@ nxt;
 @nxt=next;
// watch out for looping tracks.
 int tries=0;
 while((@nxt!=null)&&(tries<10000)) {
 @ret=nxt; @nxt=nxt.next;
 tries++;
 }
 return ret;
 }// GetEnd.

 void addNext(double an, double len) {addNext(newTrack(an, len));}

 void addNext(Track@ n) {
 @next=n;
 if(@n!=null) @(n.prev)=this;
 }
 void addToEnd(double an, double len) {addToEnd(newTrack(an, len));}
 void addToEnd(Track@ n) {
 Track@ en; @en=getEnd();
 en.addNext(n);
 }//Ad to end.


 void addRing(double x, double y) {
 addItem(ring(x, y));
 }
 void addItem(Item@ it) {items.insert_last(it);}
 void addItem(string n, double x, double y, double w, double h) {addItem(newItem(n, x, y, w, h));}

 string[] getDescriptions() {
string[] ret;
 ret.insert_last("This section of track is " + length + " units long.");
 ret.insert_last("This section of track is at an angle of " + (angle/pi) + " times pi, radians.");
 for(uint i=0; i<items.length(); i++) {
 ret.insert_last("There is a " + items[i].type + ", at " + items[i].x + ", " + items[i].y + ". It is " + items[i].width + " wide, and " + items[i].height + " high.");
 }// Items.
 for(uint i=0; i<particles.length(); i++) {
 ret.insert_last("There is a " + particles[i].name + ", at " + particles[i].x + ", " + particles[i].y + ". It is " + particles[i].radius*2.0 + " in diameter.");
 }
 return ret;
 }// Get Descriptions.

 void addEnemy(string n, double x, double y) {
 Particle@ enemy;
 @enemy=newParticle(n, x, y);
 enemy.weightless=true; enemy.intangible=true;
 enemy.setTrack(this);
 }

 }

 class Item {
 double y; // Distance from track.
 double x; // Position along the track.
 double width;
 double height;
 string type;
 Track@ door;
 Item(string n, double xx, double yy, double w, double h) {
 type=n; width=w; height=h; x=xx; y=yy;
 @door=null;
 @bounds=null;
 state=0;
}
 Rectangle@ bounds;
 bool intersects(Point@ p1, Point@ p2) {
  if(@bounds==null) @bounds=newRectangle(x, y, width, height);
 else if((bounds.x!=x)||(bounds.y!=y)||(bounds.width!=width)||(bounds.height!=height)) @bounds=newRectangle(x, y, width, height);

 return bounds.intersects(p1, p2);
}
 bool collide(Rectangle@ r) {
  if(@bounds==null) @bounds=newRectangle(x, y, width, height);
 else if((bounds.x!=x)||(bounds.y!=y)||(bounds.width!=width)||(bounds.height!=height)) @bounds=newRectangle(x, y, width, height);

 return bounds.collide(r);
 }
 int state; // *headdesk*
 }// Item.

class Particle {

 double x; double y;
 double vx; double vy;
 double ax; double ay;
 bool weightless;
 bool intangible; // Can it pass through things, like the ground?
 string name;
 Track@ track;
 int state;
 Particle(string n) {init(); name=n;}
 void init() {
 x=0; y=0; vx=0; vy=00; ax=0; ay=0; weightless=true;
 intangible=false;
 @track=null;
 radius=0.5;
 state=0;
 }

 bool onGround() {
 double tg=0.0;
 if(@track!=null) tg=track.getGroundHeight(x);

 if(y<=tg) return true;

 // Check for items that one can stand on. Mostly platforms and walls, in this case, but...
 if(@track!=null) {
 for(uint i=0; i<track.items.length(); i++) {
 if((string_contains(track.items[i].type, "latform", 1)>0)||(string_contains(track.items[i].type, "wall", 1)>=0)) {
 if((y>=track.items[i].y)&&(y<=track.items[i].y+track.items[i].height)) return true;
 }// Check for standing atop said wall.
 }// Things to stand on.
 }
 return false;
 }
 void step (double dt) {

 // Ok. So. Yeah. Woo-hoo...

 if((@track!=null)&&(track.underwater)) dt*=0.6;

 double ground=0.0;
 if(@track!=null) ground=track.getGroundHeight(x);

 // Be sure that we aren't going through the ground when we move, unless we're intangible.
 if(intangible) {x+=vx*dt; y+=vy*dt;

 vx+=ax*dt; vy+=ay*dt;
 if(!weightless) vy-=9.0*dt;
}// Intangible is simple.
 else {


 double tx=x+(vx*dt);
 double ty=y+(vy*dt);

 double tg=0.0; if(@track!=null) tg=track.getGroundHeight(tx);
 // Well, we need to run collision detection on solid objects

 // But if we're landing on the ground, do that, too!
 if(ty<tg) {
if(y<=tg)  {
ty=tg;
 
}
 else {
 Point@ tp;
 double tl=tx+10.0;
 double th=0.0;
 if(@track!=null) {tl=track.length; th=track.getGroundHeight(tl);}

 @tp=lineIntersects(
 newPoint(x, y), newPoint(tx, ty),
 newPoint(0, 0), newPoint(tl, th)
 );
 if(@tp!=null) {tx=tp.x; ty=tp.y;}
 else ty=tg;
}// Point of intersection ftw?
 // Good place to tell it to play a sound...
 if(y>ty) addSound("sfx/landing.wav");
 vy=0.0;
 // Good time to add friction?
 }// How to handle this? Make ty into tg?

 if((tx!=x)&&(@track!=null)) ground=track.getGroundHeight(tx); // Since x might have changed.
 x=tx; y=ty;

 vx+=ax*dt; vy+=ay*dt;
 if(!onGround()) {
 if(!weightless) vy-=9.0*dt;
}// In the air.
 else if(@track!=null) {
  // Friction. Woo hoo?
 // Basically, our velocity changes by -9.0*sine(track.angle).
 // Unfortunately, vectors.
 if(track.angle!=0.0) {
 vy-=9.0*sine(track.angle)*sine(track.angle)*dt;
 vx-=9.0*cosine(track.angle)*sine(track.angle)*dt;
}
 // Also, friction.
 if(vx>0.0) {vx-=4.5*dt; if(vx<0.0) {vx=0.0; if((name=="Sonic")||(name=="Tails")||(name=="Knuckles")) addSound("sfx/breaks.wav"); }} //?
 else if(vx<0.0) {vx+=4.5*dt; if(vx>=0.0) {vx=0.0; if((name=="Sonic")||(name=="Tails")||(name=="Knuckles")) addSound("sfx/breaks.wav");}}
 }// Some... inclined plane... stuff.
 }// Not so simple.

 if(@track!=null) {
 if(x<0.0) {
 if(@(track.prev)!=null) {
 double dy=y-track.getGroundHeight(0.0); // Usually 0, right?
setTrack(track.prev); x=track.length;
 // But! y needs to remain relative, as though the tracks are connected at the ends.
 y=track.getGroundHeight(x)+dy;
}
 else x=0.0;
 }// Left.
 else if(x>track.length) {
 if(@(track.next)!=null) {
 double dy=y-track.getGroundHeight(x); // Or track.length, whichever works best.
 double an=track.angle;
setTrack(track.next); x=0.0;
 y=track.getGroundHeight(0)+dy;
 // Adjust velocity!
 if(y<=track.getGroundHeight(x)) {
 double v=square_root((vx*vx)+(vy*vy));
 vx=absolute(v*cosine(track.angle));
 vy=v*sine(track.angle);
 if(tangent(track.angle)<0.0) vy=-absolute(vy);

}

}
 else x=track.length;
 }// Right.

 }// Check for going out of bounds.
 }

 void setTrack(Track@ t) {
 bool splash=false;
 if(@track!=null) {
 for(uint i=0; i<track.particles.length(); i++) {
 if(@(track.particles[i])==@this) {track.particles.remove_at(i); i--; continue;}
 }
 splash=track.underwater;
 }// Remove from track's particles list.
 @track=t;
 if(@track!=null) {track.particles.insert_last(this);
 if((splash!=track.underwater)&&((name=="Sonic")||(name=="Tails")||(name=="Knuckles"))) addSound("sfx/splash.wav");
}
 }
 string[] sounds;
 void addSound(string snd) {sounds.insert_last(snd);}
 double radius;
 }// There you go.


 Particle@ newParticle(string n) {Particle ret(n); return ret;}
 Particle@ newParticle(string n, double x, double y) {return newParticle(n, x, y, 0.5);}
 Particle@ newParticle(string n, double x, double y, double w, double h) {return newParticle(n, x, y, (w+h)/4.0);}
 Particle@ newParticle(string n, double x, double y, double r) {
 Particle ret(n); ret.x=x; ret.y=y; ret.radius=r;
 return ret;
 }

